# Copia in .env e compila i valori.
# Chiave API Groq per il chatbot "Bella"
GROQ_API_KEY=
# Modello Groq (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
# Password dashboard admin (/login)
DASHBOARD_PASSWORD=
# Cartella dati runtime (eventi, analytics, sessioni, upload). Default: ./data
# DATA_DIR=./data
# Chiave Google Maps JS (pubblica, usata nel browser per le recensioni)
# PUBLIC_GOOGLE_MAPS_KEY=
