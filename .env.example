# Copia in .env e compila i valori. Niente virgolette intorno ai valori.

# ---------- Chatbot Étoile ----------
# Catena di modelli "fornitore:modello", in ordine di priorità: se il primo non
# risponde si passa al successivo; i fornitori senza chiave API vengono saltati.
# Se non risponde nessuno, Étoile risponde con le FAQ (senza AI).
# Fornitori: anthropic, gemini, mistral, groq, openrouter, openai, cerebras
#
# Test gratis (default): Gemini (chiave gratuita su aistudio.google.com) con Mistral e Groq di riserva
# CHATBOT_MODELLI=gemini:gemini-flash-latest,gemini:gemini-flash-lite-latest,mistral:mistral-small-latest,groq:openai/gpt-oss-120b
# Produzione consigliata (economica, ~1-3 $/mese): Claude Haiku con Mistral (UE) di riserva
# CHATBOT_MODELLI=anthropic:claude-haiku-5-5,mistral:mistral-small-latest,gemini:gemini-flash-lite-latest

# Fornitori usati col piano gratuito: la loro spesa conta zero nella dashboard e nel tetto
# CHATBOT_GRATUITI=gemini,mistral,groq
# Tetto di spesa giornaliero in dollari: superato, solo risposte dalle FAQ (0 = nessun tetto). Default: 1
# CHATBOT_BUDGET_GIORNO=1
# Header con l'IP reale del visitatore se il sito è dietro un proxy che lo aggiunge
# (Cloudflare: cf-connecting-ip). Lasciare vuoto se non si è sicuri: è falsificabile.
# CHATBOT_IP_HEADER=

# Chiavi API (solo quelle dei fornitori usati)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=
# Fornitore "compatibile": qualsiasi API in stile OpenAI (Ollama, DeepSeek, Together…),
# da usare nella catena come compatibile:<modello>
# CHATBOT_COMPATIBILE_URL=http://localhost:11434/v1
# CHATBOT_COMPATIBILE_KEY=ollama

# ---------- Sito ----------
# Password dashboard admin (/login)
DASHBOARD_PASSWORD=
# Cartella dati runtime (eventi, analytics, conversazioni, sessioni, upload). Default: ./data
# DATA_DIR=./data
# Chiave Google Maps JS (pubblica, usata nel browser per le recensioni)
# PUBLIC_GOOGLE_MAPS_KEY=
