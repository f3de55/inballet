{
  "name": "inballet",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "predev": "npm run icons",
    "dev": "astro dev",
    "prebuild": "npm run icons",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "precheck": "npm run icons",
    "check": "astro check",
    "format": "prettier --write src scripts tests astro.config.mjs",
    "format:check": "prettier --check src scripts tests astro.config.mjs",
    "test": "node --test tests/carosello.test.mjs tests/ricerca.test.mjs tests/protezioni.test.mjs",
    "test:demo": "node --test tests/locandine-demo.test.mjs",
    "test:statuto": "node --test tests/statuto.test.mjs",
    "verifica:stile": "node scripts/verifica-stile.mjs",
    "deploy:stato": "node scripts/stato-build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@astrojs/node": "^11.1.11",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@types/node": "^24.19.2",
    "chart.js": "^4.6.1",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "printWidth": 160,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
