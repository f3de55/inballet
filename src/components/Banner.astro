---
import { fineEvento, giornoBreve, maiuscola, MESI, prossimiEventi, urlEvento } from '../lib/eventi';
import { mbLen, mbSlice } from '../lib/text';
import '../styles/components/banner.css';

const eventi = (await prossimiEventi(12))
  .filter((e) => e.stato !== 'annullato')
  .slice(0, 10)
  .map((evento) => {
    const [, m, d] = evento.data.split('-').map(Number);
    let quando = `${giornoBreve(evento.data)} ${d} ${maiuscola(MESI[m - 1].slice(0, 3))}`;
    if (evento.ora) quando += ` • ${evento.ora}`;
    const titolo = mbLen(evento.titolo) > 20 ? mbSlice(evento.titolo, 20) + '…' : evento.titolo;
    return { id: evento.id, ts: fineEvento(evento), titolo, quando, href: urlEvento(evento) };
  });
const primo = eventi[0];

Astro.response.headers.set('Cache-Control', 'no-store');
---

{primo && (
    <event-banner data-eventi={JSON.stringify(eventi)}>
        <aside class="event-banner" aria-label="Prossimo evento">
            <div class="event-banner-content">
                <div class="event-banner-icon"><i class="fas fa-calendar-alt" aria-hidden="true"></i></div>
                <div class="event-banner-info">
                    <p class="event-banner-title">{primo.titolo}</p>
                    <div class="event-banner-meta">
                        <p class="event-banner-date">{primo.quando}</p>
                        <a href={primo.href} class="event-banner-link">Scopri di più <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
                <button type="button" class="event-banner-close" aria-label="Chiudi banner"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
        </aside>
    </event-banner>
)}

<script>
    const root = document.documentElement;

    interface EventoBanner {
        id: string;
        ts: number;
        titolo: string;
        quando: string;
        href: string;
    }

    const chiave = (id: string) => `banner_dismissed_${id}`;
    const chiuso = (id: string) => {
        try {
            return localStorage.getItem(chiave(id)) !== null;
        } catch {
            return false;
        }
    };

    class EventBanner extends HTMLElement {
        #interval = 0;
        #eventi: EventoBanner[] = [];
        #corrente: string | null = null;
        #observer = new ResizeObserver(() => this.#updateHeight());

        connectedCallback() {
            this.#eventi = JSON.parse(this.dataset.eventi ?? '[]');

            const dismiss = () => {
                if (!this.#corrente) return;
                try {
                    localStorage.setItem(chiave(this.#corrente), '1');
                } catch {}
                this.#hide();
            };
            this.querySelector('.event-banner-close')!.addEventListener('click', dismiss);
            this.querySelector('.event-banner-link')!.addEventListener('click', dismiss);

            this.#aggiorna();
            if (this.isConnected) this.#interval = window.setInterval(() => this.#aggiorna(), 60000);
        }

        disconnectedCallback() {
            clearInterval(this.#interval);
            this.#observer.disconnect();
            this.#hide();
        }

        #aggiorna() {
            const evento = this.#eventi.find((e) => e.ts >= Date.now());
            if (!evento) return this.remove();
            if (evento.id === this.#corrente) return;
            this.#corrente = evento.id;

            if (chiuso(evento.id)) return this.#hide();

            const banner = this.querySelector<HTMLElement>('.event-banner')!;
            this.querySelector('.event-banner-title')!.textContent = evento.titolo;
            this.querySelector('.event-banner-date')!.textContent = evento.quando;
            this.querySelector<HTMLAnchorElement>('.event-banner-link')!.href = evento.href;
            banner.classList.add('visible');
            document.body.classList.add('has-event-banner');
            this.#observer.observe(banner, { box: 'border-box' });
        }

        #updateHeight() {
            const banner = this.querySelector<HTMLElement>('.event-banner');
            if (!banner) return;
            const altezza = `${banner.getBoundingClientRect().height}px`;
            root.style.setProperty('--banner-height', altezza);
            if (!root.classList.contains('is-scrolled') || !root.style.getPropertyValue('--banner-spazio')) {
                root.style.setProperty('--banner-spazio', altezza);
            }
        }

        #hide() {
            this.#observer.disconnect();
            this.querySelector('.event-banner')?.classList.remove('visible');
            document.body.classList.remove('has-event-banner');
            root.style.setProperty('--banner-height', '0px');
            root.style.removeProperty('--banner-spazio');
        }
    }

    customElements.define('event-banner', EventBanner);
</script>
