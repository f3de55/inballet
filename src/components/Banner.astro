---
/**
 * Banner evento prossimo. Usato come Server Island (`server:defer`): le pagine
 * restano HTML statico e solo questo frammento viene renderizzato a ogni
 * richiesta leggendo gli eventi aggiornati dalla dashboard.
 * Il comportamento è un custom element: si attiva quando l'island arriva.
 */
import { prossimiEventi } from '../lib/eventi';
import { decodeHtml, mbLen, mbSlice } from '../lib/text';

const giorni = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];
const mesi = ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre'];

// Anche gli eventi successivi: se il primo viene chiuso, alla sua scadenza
// il banner passa al prossimo senza ricaricare la pagina
const eventi = (await prossimiEventi()).map(({ evento, ts }) => {
  const [y, m, d] = evento.data.split('-').map(Number);
  let quando = `${giorni[new Date(Date.UTC(y, m - 1, d)).getUTCDay()]} ${d} ${mesi[m - 1]}`;
  if (evento.ora) quando += ` • ${evento.ora}`;
  // Titolo troncato a 20 caratteri (salvato con escape HTML: si tronca il testo, non le entità)
  const testo = decodeHtml(evento.titolo);
  const titolo = mbLen(testo) > 20 ? mbSlice(testo, 20) + '...' : testo;
  return { id: evento.id, ts, titolo, quando, href: `/spettacoli-eventi?evento=${encodeURIComponent(evento.id)}` };
});
const primo = eventi[0];

// Il frammento non va messo in cache: dipende dagli eventi correnti
Astro.response.headers.set('Cache-Control', 'no-store');
---

{primo && (
    <event-banner data-eventi={JSON.stringify(eventi)}>
        <div class="event-banner" id="eventBanner">
            <div class="event-banner-content">
                <div class="event-banner-icon"><i class="fas fa-calendar-alt" aria-hidden="true"></i></div>
                <div class="event-banner-info">
                    <div class="event-banner-title">{primo.titolo}</div>
                    <div class="event-banner-meta">
                        <span class="event-banner-date">{primo.quando}</span>
                        <a href={primo.href} class="event-banner-link">Scopri di più <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
                <button type="button" class="event-banner-close" aria-label="Chiudi banner"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
        </div>
    </event-banner>
)}

<style>
    event-banner {
        display: contents;
    }
</style>

<script>
    const root = document.documentElement;

    interface EventoBanner {
        id: string;
        ts: number;
        titolo: string;
        quando: string;
        href: string;
    }

    const chiave = (id: string) => `banner_dismissed_${id}`;
    const chiuso = (id: string) => {
        try {
            return localStorage.getItem(chiave(id)) !== null;
        } catch {
            return false;
        }
    };

    class EventBanner extends HTMLElement {
        #interval = 0;
        #eventi: EventoBanner[] = [];
        /** Evento corrente (il primo non ancora scaduto), mostrato o chiuso */
        #corrente: string | null = null;
        // Segue l'altezza a ogni fotogramma, anche mentre si riduce allo scroll:
        // la navbar sotto (top: --banner-height) resta sempre attaccata
        #observer = new ResizeObserver(() => this.#updateHeight());

        connectedCallback() {
            this.#eventi = JSON.parse(this.dataset.eventi ?? '[]');

            // Chiusura con X o con click su "Scopri di più": vale solo per l'evento corrente,
            // alla sua scadenza compare il successivo (se c'è)
            const dismiss = () => {
                if (!this.#corrente) return;
                try {
                    localStorage.setItem(chiave(this.#corrente), '1');
                } catch {}
                this.#hide();
            };
            this.querySelector('.event-banner-close')!.addEventListener('click', dismiss);
            this.querySelector('.event-banner-link')!.addEventListener('click', dismiss);

            this.#aggiorna();
            // Controllo scadenza ogni minuto
            if (this.isConnected) this.#interval = window.setInterval(() => this.#aggiorna(), 60000);
        }

        disconnectedCallback() {
            clearInterval(this.#interval);
            this.#observer.disconnect();
            this.#hide();
        }

        /** Mostra il primo evento non scaduto, a meno che non sia stato chiuso. */
        #aggiorna() {
            const evento = this.#eventi.find((e) => e.ts >= Date.now());
            // Nessun evento successivo: niente banner
            if (!evento) return this.remove();
            if (evento.id === this.#corrente) return;
            this.#corrente = evento.id;

            if (chiuso(evento.id)) return this.#hide();

            const banner = this.querySelector<HTMLElement>('.event-banner')!;
            this.querySelector('.event-banner-title')!.textContent = evento.titolo;
            this.querySelector('.event-banner-date')!.textContent = evento.quando;
            this.querySelector<HTMLAnchorElement>('.event-banner-link')!.href = evento.href;
            banner.classList.add('visible');
            document.body.classList.add('has-event-banner');
            // border-box: allo scroll cambia il padding, non il contenuto
            this.#observer.observe(banner, { box: 'border-box' });
        }

        #updateHeight() {
            const banner = this.querySelector<HTMLElement>('.event-banner');
            if (!banner) return;
            const altezza = `${banner.offsetHeight}px`;
            root.style.setProperty('--banner-height', altezza);
            // Spazio che sposta la pagina sotto il banner: solo l'altezza piena (in cima),
            // così quando il banner si riduce allo scroll il contenuto non salta
            if (!root.classList.contains('is-scrolled') || !root.style.getPropertyValue('--banner-spazio')) {
                root.style.setProperty('--banner-spazio', altezza);
            }
        }

        #hide() {
            this.#observer.disconnect();
            this.querySelector('.event-banner')?.classList.remove('visible');
            document.body.classList.remove('has-event-banner');
            root.style.setProperty('--banner-height', '0px');
            root.style.removeProperty('--banner-spazio');
        }
    }

    customElements.define('event-banner', EventBanner);
</script>

<style>
.event-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1001;
  background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
  color: var(--dark-navy);
  padding: 0.7rem 1.5rem;
  display: none;
  box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  transition: padding .3s ease;
}

.event-banner.visible {
  display: block;
}

/* Ridotto dopo lo scroll, insieme alla navbar (classe is-scrolled da navbar.ts) */
:global(html.is-scrolled) .event-banner {
  padding-block: 0.35rem;
}

.event-banner-content {
  display: flex;
  align-items: center;
  gap: 1rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
}

.event-banner-icon {
  width: 24px;
  height: 24px;
  background: rgba(255,255,255,0.2);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.event-banner-icon :global(i) {
  font-size: 10px;
  color: var(--dark-navy);
}

.event-banner-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  padding-right: 3rem;
}

.event-banner-title {
  font-size: var(--text-sm);
  font-weight: 700;
  line-height: 1;
}

.event-banner-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: var(--text-xs);
}

.event-banner-date {
  font-weight: 600;
}

.event-banner-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--dark-navy);
  text-decoration: none;
  font-size: var(--text-xs);
  font-weight: 700;
  border-bottom: 1px solid rgba(0,0,0,0.4);
  padding-bottom: 1px;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.event-banner-link:hover {
  border-color: var(--dark-navy);
  gap: 0.6rem;
}

.event-banner-link :global(i) {
  font-size: 9px;
}

.event-banner-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 24px;
  height: 24px;
  background: rgba(0,0,0,0.25);
  border: none;
  border-radius: var(--radius-full);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  transition: background 0.2s;
}

.event-banner-close:hover {
  background: rgba(0,0,0,0.4);
}

.event-banner-close :global(i) {
  font-size: 11px;
}

@media (max-width: 768px) {
  .event-banner {
    padding: 0.6rem 1rem;
  }

  .event-banner-content {
    gap: 0.8rem;
  }

  .event-banner-icon {
    display: none;
  }
}

@media (max-width: 480px) {
  .event-banner {
    padding: 0.5rem 0.8rem;
  }

  :global(html.is-scrolled) .event-banner {
    padding-block: 0.3rem;
  }

  .event-banner-info {
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .event-banner-close {
    width: 24px;
    height: 24px;
  }

}
</style>
