---
/**
 * Breadcrumb delle pagine interne (Home › Sezione › Pagina), ricavato dalla
 * struttura della navigazione in src/data/navigazione.ts, con i dati
 * strutturati BreadcrumbList per i motori di ricerca.
 */
import { altrePagine, menu } from '../data/navigazione';

interface Props {
  /** Nome della pagina se non è nel menu né in altrePagine. */
  nome?: string;
  /** Pagina genitore (es. "/spettacoli-eventi" per un singolo evento): il percorso passa da lì. */
  genitore?: string;
}

interface Passo {
  nome: string;
  href?: string;
}

const corrente = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const { nome, genitore } = Astro.props;

/** Passi da Home fino a `percorso` (dal menu, da altrePagine o col nome indicato). */
function passiFino(percorso: string, nomePagina?: string): Passo[] {
  const passi: Passo[] = [{ nome: 'Home', href: '/' }];
  const sezione = menu.find((m) => m.href === percorso || m.sezioni.some((s) => s.voci.some((v) => v.href === percorso)));
  if (sezione?.href === percorso) {
    passi.push({ nome: sezione.label, href: percorso });
  } else if (sezione) {
    const voce = sezione.sezioni.flatMap((s) => s.voci).find((v) => v.href === percorso)!;
    passi.push({ nome: sezione.label, href: sezione.href }, { nome: voce.nome, href: percorso });
  } else {
    passi.push({ nome: altrePagine[percorso] ?? nomePagina ?? '', href: percorso });
  }
  return passi;
}

const passi = genitore ? [...passiFino(genitore), { nome: nome ?? '', href: corrente }] : passiFino(corrente, nome);

const ultimo = passi.length - 1;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: passi
    .filter((p) => p.href)
    .map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.nome, item: new URL(p.href!, Astro.site).href })),
};
---

<nav class="breadcrumb" aria-label="Percorso">
  <ol>
    {passi.map((p, i) => (
      <li>
        {i === ultimo ? (
          <span aria-current="page">{p.nome}</span>
        ) : p.href ? (
          <a href={p.href}>{p.nome}</a>
        ) : (
          <span>{p.nome}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
