---
/** Chat con Étoile, l'assistente virtuale di InBallet. Logica in src/scripts/chatbot.ts. */
import { scuola } from '../data/scuola';

const domande = ['Corsi per bambini', 'Sedi e orari', 'Come contattarvi', 'Come iscriversi'];
---

<button type="button" id="cb-toggle" aria-controls="cb-box" aria-expanded="false" aria-label="Chiedi a Étoile, l'assistente IA di InBallet">
    <i class="fas fa-comments" aria-hidden="true"></i>
    <span class="cb-toggle-ia" aria-hidden="true">IA</span>
</button>

<section id="cb-box" role="dialog" aria-labelledby="cb-title" tabindex="-1" hidden data-tel={scuola.telefono} data-tel-href={scuola.telefonoHref}>
    <header id="cb-head">
        <span class="cb-avatar" aria-hidden="true"><i class="fas fa-star"></i></span>
        <div class="cb-head-testo">
            <h2 id="cb-title">Étoile</h2>
            <p>Assistente virtuale di InBallet</p>
        </div>
        <button type="button" id="cb-reset" class="cb-head-btn" aria-label="Nuova conversazione" title="Nuova conversazione">
            <i class="fas fa-redo-alt" aria-hidden="true"></i>
        </button>
        <button type="button" id="cb-close" class="cb-head-btn" aria-label="Chiudi la chat" title="Chiudi (Esc)">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
    </header>

    <div id="cb-msgs" role="log" aria-live="polite" aria-label="Conversazione"></div>

    <div id="cb-suggerimenti" class="cb-suggerimenti" hidden>
        {domande.map((d) => <button type="button" class="cb-chip">{d}</button>)}
    </div>

    <form id="cb-inp">
        <label for="cb-txt" class="cb-sr-only">Scrivi la tua domanda</label>
        <input type="text" id="cb-txt" placeholder="Scrivi la tua domanda…" maxlength="500" autocomplete="off" enterkeyhint="send">
        <button type="submit" id="cb-send" aria-label="Invia">
            <i class="fas fa-paper-plane" aria-hidden="true"></i>
        </button>
    </form>
    <p class="cb-nota">Risposte automatiche; chat anonime, conservate 30 giorni: non scrivere dati personali. Conferme al <a href={scuola.telefonoHref}>{scuola.telefono}</a>.</p>
</section>

<script>
    import '../scripts/chatbot';
</script>

<style>
.cb-sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

/* ---------- Pulsante ---------- */
/* Solo icona, con il bollino "IA" in alto a destra */
#cb-toggle {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 998;
  display: grid;
  place-items: center;
  width: 58px;
  height: 58px;
  padding: 0;
  border: none;
  border-radius: var(--radius-full);
  background: var(--primary-blue);
  box-shadow: 0 8px 24px rgba(26, 26, 26, .18);
  color: var(--dark-navy);
  cursor: pointer;
  transition: background-color .2s ease, color .2s ease;
}

#cb-toggle i {
  font-size: 1.375rem;
}

.cb-toggle-ia {
  position: absolute;
  top: -5px;
  right: -5px;
  display: grid;
  place-items: center;
  min-width: 26px;
  height: 22px;
  padding: 0 6px;
  border: 2px solid var(--white);
  border-radius: var(--radius-pill);
  background: var(--dark-navy);
  font-size: var(--text-3xs);
  font-weight: 700;
  letter-spacing: .5px;
  line-height: 1;
  color: var(--white);
}

/* Hover azzurro scuro: resta visibile anche sopra le sezioni con fondo nero */
@media (hover: hover) {
  #cb-toggle:hover {
    background: var(--primary-blue-dark);
    color: var(--white);
  }
}

#cb-toggle[aria-expanded="true"] {
  visibility: hidden;
}

/* ---------- Pannello ---------- */
/* Pannello di larghezza fissa (380px): scala compatta e fissa, non fluida come il resto del sito.
   Il campo resta a 16px per evitare lo zoom automatico di iOS. */
#cb-box {
  --cb-titolo: 1.0625rem;
  --cb-testo: .9375rem;
  --cb-chip: .875rem;
  --cb-campo: 1rem;
  --cb-piccolo: .8125rem;
  --cb-micro: .75rem;
  font-size: var(--cb-testo);
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 1002;
  display: flex;
  flex-direction: column;
  width: 380px;
  height: min(600px, calc(100dvh - 48px));
  overflow: hidden;
  border-radius: var(--radius-md);
  background: var(--white);
  box-shadow: 0 20px 60px rgba(0, 0, 0, .22);
  animation: cb-entra .25s ease;
}

#cb-box[hidden] {
  display: none;
}

#cb-box:focus {
  outline: none;
}

@keyframes cb-entra {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
}

#cb-head {
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .85rem .6rem .85rem 1rem;
  background: var(--header-dark);
  color: var(--white);
}

.cb-avatar {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: var(--radius-full);
  background: var(--primary-blue);
  font-weight: 700;
  color: var(--dark-navy);
}

.cb-head-testo {
  flex: 1;
  min-width: 0;
}

#cb-title {
  font-size: var(--cb-titolo);
  font-weight: 700;
  line-height: 1.2;
}

.cb-head-testo p {
  font-size: var(--cb-piccolo);
  color: rgba(255, 255, 255, .65);
}

.cb-head-btn {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border: none;
  border-radius: var(--radius-full);
  background: none;
  font-size: 1rem;
  color: rgba(255, 255, 255, .75);
  cursor: pointer;
  transition: background-color .2s ease, color .2s ease;
}

#cb-reset {
  font-size: var(--cb-piccolo);
}

.cb-head-btn:hover {
  background: rgba(255, 255, 255, .1);
  color: var(--white);
}

/* ---------- Messaggi ---------- */
#cb-msgs {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: .6rem;
  padding: 1rem;
  overflow-y: auto;
  overscroll-behavior: contain;
  background: #f5f6f7;
  scrollbar-width: thin;
  scrollbar-color: rgba(26, 26, 26, .2) transparent;
}

#cb-msgs :global(.cb-m) {
  max-width: 85%;
  padding: .65rem .9rem;
  border-radius: var(--radius-md);
  font-size: var(--cb-testo);
  line-height: 1.55;
  overflow-wrap: anywhere;
}

#cb-msgs :global(.cb-m.bot) {
  align-self: flex-start;
  border: 1px solid #e6e8ea;
  border-bottom-left-radius: var(--radius-xs);
  background: var(--white);
  color: var(--text-dark);
}

#cb-msgs :global(.cb-m.usr) {
  align-self: flex-end;
  border-bottom-right-radius: var(--radius-xs);
  background: var(--primary-blue);
  color: var(--dark-navy);
}

#cb-msgs :global(.cb-txt) {
  display: block;
}

#cb-msgs :global(.cb-time) {
  display: block;
  margin-top: .25rem;
  font-size: var(--cb-micro);
  text-align: right;
  /* Più tenue del messaggio ma con contrasto AA su entrambi i fumetti */
  opacity: .8;
}

#cb-msgs :global(a.cb-link) {
  font-weight: 600;
  color: var(--primary-blue-dark);
  text-decoration: underline;
  text-underline-offset: 2px;
}

#cb-msgs :global(.cb-m.usr a.cb-link) {
  color: var(--dark-navy);
}

/* Risposta in preparazione: tre puntini */
#cb-msgs :global(.cb-m.load) {
  display: flex;
  gap: 4px;
  padding: .85rem 1rem;
}

#cb-msgs :global(.cb-m.load span) {
  width: 7px;
  height: 7px;
  border-radius: var(--radius-full);
  background: #9aa0a6;
  animation: cb-punto 1.2s infinite ease-in-out;
}

#cb-msgs :global(.cb-m.load span:nth-child(2)) {
  animation-delay: .15s;
}

#cb-msgs :global(.cb-m.load span:nth-child(3)) {
  animation-delay: .3s;
}

@keyframes cb-punto {
  0%, 60%, 100% {
    opacity: .35;
    transform: none;
  }
  30% {
    opacity: 1;
    transform: translateY(-3px);
  }
}

/* ---------- Domande suggerite ---------- */
.cb-suggerimenti {
  display: flex;
  flex-wrap: wrap;
  gap: .4rem;
  padding: 0 1rem .75rem;
  background: #f5f6f7;
}

.cb-suggerimenti[hidden] {
  display: none;
}

.cb-chip {
  min-height: 36px;
  padding: .35rem .85rem;
  border: 1px solid var(--primary-blue);
  border-radius: var(--radius-pill);
  background: var(--white);
  font: inherit;
  font-size: var(--cb-chip);
  color: var(--dark-navy);
  cursor: pointer;
  transition: background-color .2s ease;
}

.cb-chip:hover {
  background: rgba(135, 206, 235, .2);
}

/* ---------- Scrittura ---------- */
#cb-inp {
  display: flex;
  gap: .5rem;
  padding: .75rem .75rem .5rem;
  border-top: 1px solid #e6e8ea;
  background: var(--white);
}

#cb-txt {
  flex: 1;
  min-width: 0;
  min-height: 46px;
  padding: .6rem 1rem;
  border: 1px solid #7b858c;
  border-radius: var(--radius-pill);
  background: var(--white);
  font: inherit;
  font-size: var(--cb-campo);
  color: var(--text-dark);
}

#cb-txt:focus {
  outline: none;
  border-color: var(--primary-blue-dark);
  box-shadow: 0 0 0 2px var(--primary-blue-dark);
}

#cb-send {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 46px;
  height: 46px;
  border: none;
  border-radius: var(--radius-full);
  background: var(--primary-blue);
  color: var(--dark-navy);
  cursor: pointer;
  transition: background-color .2s ease, color .2s ease, opacity .2s ease;
}

#cb-send:hover:not(:disabled) {
  background: var(--dark-navy);
  color: var(--white);
}

#cb-send:disabled {
  opacity: .5;
  cursor: default;
}

.cb-nota {
  padding: 0 1rem .75rem;
  background: var(--white);
  font-size: var(--cb-micro);
  line-height: 1.4;
  color: var(--text-light);
}

.cb-nota a {
  color: inherit;
  font-weight: 600;
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  #cb-box,
  #cb-msgs :global(.cb-m.load span) {
    animation: none;
  }
}

/* ---------- Tablet ---------- */
@media (max-width: 900px) {
  #cb-toggle {
    right: 20px;
    bottom: 20px;
  }
}

/* ---------- Mobile: chat a schermo intero ---------- */
@media (max-width: 600px) {
  #cb-toggle {
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    width: 54px;
    height: 54px;
  }

  #cb-box {
    top: 0;
    right: 0;
    bottom: auto;
    left: 0;
    width: 100%;
    height: 100dvh;
    border-radius: 0;
  }

  #cb-head {
    padding-top: calc(.75rem + env(safe-area-inset-top));
  }

  .cb-nota {
    padding-bottom: calc(.75rem + env(safe-area-inset-bottom));
  }

  :global(html.cb-aperto) {
    overflow: hidden;
  }
}
</style>
