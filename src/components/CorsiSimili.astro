---
/**
 * «Corsi simili»: gli altri corsi della stessa categoria (scuola.ts → categorieCorsi), escluso
 * quello della pagina. Stesso schema di «La danza oltre i corsi» in homepage: celle uguali con
 * filetti tra una cella e l'altra, centrate; 3-4 per riga su desktop, 2 su tablet, elenco compatto su mobile.
 */
import { getCollection } from 'astro:content';
import { categorieCorsi } from '../data/scuola';
import '../styles/components/corsi-simili.css';

interface Props {
  /** id del corso corrente (es. "hip-hop"), da escludere */
  corso: string;
}

const { corso } = Astro.props;
const categoria = categorieCorsi.find((c) => c.corsi.some((k) => k.url === `/${corso}`));
const pagine = new Map((await getCollection('corsi')).map((c) => [`/${c.id}`, c.data]));
// Nel nome basta la disciplina: l'età sta nella riga sotto
const nomeBreve = (nome: string) => nome.replace(/\s*\(.*\)$/, '');
const altri = (categoria?.corsi ?? [])
  .filter((k) => k.url !== `/${corso}`)
  .map((k) => ({
    nome: nomeBreve(k.nome),
    href: k.url,
    eta: (pagine.get(k.url)?.badge ?? '').replace(' - ', ' · '),
    frequenza: pagine.get(k.url)?.frequenza ?? '',
  }));
---

{categoria && altri.length > 0 && (
  <section class="simili-section decoro-onde decoro-onde--sinistra" aria-labelledby="simili-titolo">
    <div class="intro-editoriale">
      <p class="eyebrow">{categoria.nome}</p>
      <h2 class="titolo-sezione" id="simili-titolo">Corsi <em>simili</em></h2>
      <p>Gli altri corsi del percorso: <strong>scegli quello più adatto</strong> a te, per età e livello.</p>
    </div>

    <div class="simili-wrapper">
      <ul class="simili-lista">
        {altri.map((c) => (
          <li>
            <a href={c.href} class="simili-voce">
              <i class={`fas ${categoria.icona} simili-icona`} aria-hidden="true"></i>
              <div class="simili-testo">
                <h3 class="simili-nome">{c.nome}</h3>
                <p class="simili-eta">{c.eta}</p>
                <p class="simili-desc testo-piccolo">{c.frequenza}</p>
              </div>
              <p class="link-cta simili-cta">Scopri il corso <i class="fas fa-arrow-right" aria-hidden="true"></i></p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}


