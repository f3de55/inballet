---
/**
 * «Corsi simili»: gli altri corsi della stessa categoria (scuola.ts → categorieCorsi), escluso
 * quello della pagina. Stesso schema di «La danza oltre i corsi» in homepage: celle uguali con
 * filetti tra una cella e l'altra, centrate; 3-4 per riga su desktop, 2 su tablet, elenco compatto su mobile.
 */
import { getCollection } from 'astro:content';
import { categorieCorsi } from '../data/scuola';

interface Props {
  /** id del corso corrente (es. "hip-hop"), da escludere */
  corso: string;
}

const { corso } = Astro.props;
const categoria = categorieCorsi.find((c) => c.corsi.some((k) => k.url === `/${corso}`));
const pagine = new Map((await getCollection('corsi')).map((c) => [`/${c.id}`, c.data]));
// Nel nome basta la disciplina: l'età sta nella riga sotto
const nomeBreve = (nome: string) => nome.replace(/\s*\(.*\)$/, '');
const altri = (categoria?.corsi ?? [])
  .filter((k) => k.url !== `/${corso}`)
  .map((k) => ({
    nome: nomeBreve(k.nome),
    href: k.url,
    eta: (pagine.get(k.url)?.badge ?? '').replace(' - ', ' · '),
    frequenza: pagine.get(k.url)?.frequenza ?? '',
  }));
---

{categoria && altri.length > 0 && (
  <section class="simili-section" aria-labelledby="simili-titolo">
    <div class="intro-editoriale">
      <span class="eyebrow">{categoria.nome}</span>
      <h2 class="titolo-sezione" id="simili-titolo">Corsi <em>simili</em></h2>
      <p>Gli altri corsi del percorso: <strong>scegli quello più adatto</strong> a te, per età e livello.</p>
    </div>

    <div class="simili-wrapper">
      <ul class="simili-lista" style={`--n:${altri.length}`}>
        {altri.map((c) => (
          <li>
            <a href={c.href} class="simili-voce">
              <i class={`fas ${categoria.icona} simili-icona`} aria-hidden="true"></i>
              <span class="simili-testo">
                <h3 class="simili-nome">{c.nome}</h3>
                <span class="simili-eta">{c.eta}</span>
                <span class="simili-desc">{c.frequenza}</span>
              </span>
              <i class="fas fa-arrow-right simili-freccia" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .simili-section {
    padding: calc(var(--section-y) * .85) 0;
    background: var(--white);
  }

  @media (min-width: 769px) {
    .simili-section {
      padding: var(--section-y) 0;
    }
  }

  .simili-wrapper {
    max-width: 1200px;
    margin: 3rem auto 0;
    padding: 0 2rem;
  }

  /* Il gap da 1px sul fondo chiaro disegna i filetti tra le celle (come nei loghi dei sostenitori) */
  .simili-lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    background: rgba(26, 26, 26, .15);
    border-block: 1px solid rgba(26, 26, 26, .15);
  }

  .simili-lista li {
    display: flex;
    background: var(--white);
  }

  .simili-voce {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1.25rem;
    text-align: center;
    color: inherit;
    text-decoration: none;
    transition: background-color .3s ease;
  }

  .simili-icona {
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--primary-blue-dark);
  }

  .simili-testo {
    display: block;
    margin-top: .9rem;
  }

  .simili-nome {
    display: block;
    color: var(--dark-navy);
  }

  .simili-eta {
    display: block;
    margin-top: .4rem;
    font-size: var(--text-md);
    line-height: 1.45;
    color: var(--text-dark);
  }

  .simili-desc {
    display: block;
    margin-top: .1rem;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--text-light);
  }

  .simili-freccia {
    display: none;
  }

  .simili-voce:focus-visible {
    outline: 2px solid var(--primary-blue-dark);
    outline-offset: -4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .simili-voce:hover {
      background: var(--bg-soft);
    }
  }

  /* Tablet: due colonne; con un numero dispari l'ultima cella occupa tutta la riga */
  @media (max-width: 900px) {
    .simili-wrapper {
      margin-top: 2.5rem;
    }

    .simili-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .simili-lista li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .simili-voce {
      padding: 1.75rem 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .simili-wrapper {
      padding: 0 1.5rem;
    }
  }

  /* Mobile: elenco compatto, una voce per riga (icona, nome ed età, freccia) */
  @media (max-width: 600px) {
    .simili-wrapper {
      margin-top: 2rem;
    }

    .simili-lista {
      grid-template-columns: minmax(0, 1fr);
    }

    .simili-voce {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      column-gap: 1rem;
      align-items: center;
      padding: .85rem 0;
      text-align: left;
    }

    .simili-icona {
      font-size: var(--text-xl);
    }

    .simili-testo {
      margin: 0;
    }

    .simili-eta {
      margin-top: .1rem;
    }

    .simili-desc {
      display: none;
    }

    .simili-freccia {
      display: block;
      font-size: var(--text-sm);
      color: var(--primary-blue-dark);
    }
  }
</style>
