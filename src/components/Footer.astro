---
import { categorieCorsi, scuola } from '../data/scuola';
import { menu, type Voce } from '../data/navigazione';
import Img from './Img.astro';
import '../styles/components/footer.css';

const anno = new Date().getFullYear();

const colonne: { titolo: string; href?: string; voci: Voce[] }[] = [
  {
    titolo: 'Corsi',
    href: '/corsi',
    voci: categorieCorsi.map((c) => ({ nome: c.nome, href: `/corsi#${c.id}` })),
  },
  ...menu
    .filter((m) => m.id !== 'corsi')
    .map((m) => ({ titolo: m.label, href: undefined, voci: m.sezioni.flatMap((s) => s.voci) })),
];
---

<div class="footer-main">
  <div class="footer-brand">
    <a href="/" class="footer-logo" aria-label="InBallet - Torna alla homepage">
      <Img src="logo.png" alt="InBallet" width="376" height="133" widths={[120, 240, 376]} sizes="120px" loading="lazy" decoding="async" />
    </a>
    <p class="footer-ente titoletto">Ente Formativo<br>CSEN · CONI</p>
    <div class="footer-social">
      <a href={scuola.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
      <a href={scuola.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook" aria-hidden="true"></i></a>
    </div>
  </div>

  <nav class="footer-nav" aria-label="Mappa del sito">
    {colonne.map((c) => (
      <details class="footer-col" open>
        <summary><h2 class="footer-titolo titoletto">{c.href ? <a href={c.href}>{c.titolo}</a> : c.titolo}</h2></summary>
        <ul>
          {c.voci.map((v) => <li><a href={v.href}>{v.breve ?? v.nome}</a></li>)}
        </ul>
      </details>
    ))}
    <details class="footer-col footer-contatti" open>
      <summary><h2 class="footer-titolo titoletto">Contatti</h2></summary>
      <ul>
        <li class="footer-dato"><i class="fas fa-phone" aria-hidden="true"></i><a href={scuola.telefonoHref}>{scuola.telefono}</a></li>
        <li class="footer-dato"><i class="fas fa-envelope" aria-hidden="true"></i><a href={`mailto:${scuola.email}`}>{scuola.email}</a></li>
      </ul>
      <a href="/contatti" class="footer-link">Altre informazioni <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
    </details>
  </nav>

</div>

<div class="footer-bottom">
  <p>&copy; <span id="footerYear">{anno}</span> {scuola.ragioneSociale} · C.F. {scuola.codiceFiscale}</p>
  <p class="footer-credits"><a href="mailto:fedecpz03@gmail.com">Crediti</a></p>
</div>

<script>
  import '../scripts/footer';
</script>
