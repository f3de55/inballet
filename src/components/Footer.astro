---
/**
 * Footer: colonne generate dalla navigazione (src/data/navigazione.ts) e dai
 * dati ufficiali della scuola, così restano sempre allineate a navbar e contatti.
 */
import { categorieCorsi, FONDAZIONE, scuola, sedi } from '../data/scuola';
import { menu, type Voce } from '../data/navigazione';
import Img from './Img.astro';

const anno = new Date().getFullYear();

// Corsi: i cinque percorsi della pagina /corsi; le altre colonne dalle voci del menu
const colonne = [
  {
    titolo: 'Corsi',
    voci: [{ nome: 'Tutti i corsi', href: '/corsi' }, ...categorieCorsi.map((c) => ({ nome: c.nome, href: `/corsi#${c.id}` }))] as Voce[],
  },
  ...menu
    .filter((m) => m.id !== 'corsi')
    .map((m) => ({ titolo: m.label, voci: m.sezioni.flatMap((s) => s.voci) })),
];
---

<div class="footer-main">
  <div class="footer-brand">
    <a href="/" class="footer-logo" aria-label="InBallet - Torna alla homepage">
      <Img src="logo.png" alt="InBallet" width="376" height="133" widths={[120, 240, 376]} sizes="120px" loading="lazy" decoding="async" />
    </a>
    <p>Scuola di danza a Lainate e Rho dal {FONDAZIONE}, per bambini dai 3 anni, ragazzi e adulti.</p>
    <p class="footer-ente">Ente Formativo<br>CSEN · CONI</p>
    <div class="footer-social">
      <a href={scuola.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
      <a href={scuola.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook" aria-hidden="true"></i></a>
    </div>
  </div>

  <nav class="footer-nav" aria-label="Mappa del sito">
    {/* Colonne sempre aperte; su mobile footer.ts le chiude e diventano a fisarmonica */}
    {colonne.map((c) => (
      <details class="footer-col" open>
        <summary><h2 class="footer-titolo">{c.titolo}</h2></summary>
        <ul>
          {c.voci.map((v) => <li><a href={v.href}>{v.breve ?? v.nome}</a></li>)}
        </ul>
      </details>
    ))}
  </nav>

  <div class="footer-contatti">
    <h2 class="footer-titolo">Contatti</h2>
    <ul>
      <li><a href={scuola.telefonoHref}>{scuola.telefono}</a></li>
      <li><a href={`mailto:${scuola.email}`}>{scuola.email}</a></li>
    </ul>
    <ul class="footer-sedi">
      {sedi.map((s) => (
        <li>
          <span>{s.citta}</span>
          <a href={s.maps} target="_blank" rel="noopener">{s.via}</a>
        </li>
      ))}
    </ul>
    <a href="/contatti" class="footer-link">Orari e contatti</a>
  </div>
</div>

<div class="footer-bottom">
  <p>&copy; <span id="footerYear">{anno}</span> {scuola.ragioneSociale} · C.F. {scuola.codiceFiscale}</p>
</div>

<script>
  import '../scripts/footer';
</script>

<style>
  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 4.4fr) minmax(0, 1fr);
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---------- Marchio ---------- */
  .footer-brand :global(img) {
    width: 120px;
    height: auto;
    margin-bottom: 1.25rem;
  }

  .footer-brand p {
    font-size: var(--text-nav);
    line-height: 1.6;
    color: var(--footer-testo);
    max-width: 16rem;
  }

  .footer-brand .footer-ente {
    margin-top: .9rem;
    font-size: var(--text-3xs);
    font-weight: 600;
    letter-spacing: 1px;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--footer-testo);
  }

  .footer-social {
    display: flex;
    gap: .6rem;
    margin-top: 1.5rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: var(--radius-full);
    color: var(--white);
    text-decoration: none;
    transition: border-color .3s ease, color .3s ease;
  }

  .footer-social a:hover {
    border-color: var(--white);
  }

  /* ---------- Colonne ---------- */
  .footer-nav {
    display: grid;
    /* Colonne larghe quanto le loro voci: meno link spezzati a capo */
    grid-template-columns: repeat(4, auto);
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-col summary {
    display: block;
    list-style: none;
    cursor: default;
  }

  .footer-col summary::-webkit-details-marker {
    display: none;
  }

  .footer-titolo {
    font-size: var(--text-3xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 1.1rem;
  }

  .footer-main ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .6rem;
  }

  .footer-main ul a,
  .footer-link {
    font-size: var(--text-nav);
    line-height: 1.4;
    color: var(--footer-testo);
    text-decoration: none;
    transition: color .3s ease;
  }

  .footer-main ul a:hover,
  .footer-link:hover {
    color: var(--white);
  }

  .footer-main ul a.attiva {
    color: var(--white);
    font-weight: 700;
  }

  .footer-main a:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 2px;
  }

  /* ---------- Contatti ---------- */
  .footer-sedi {
    margin-top: 1.25rem;
  }

  .footer-sedi li {
    display: flex;
    flex-direction: column;
    gap: .15rem;
  }

  .footer-sedi span {
    font-size: var(--text-3xs);
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--footer-testo);
  }

  /* Indirizzi cliccabili alti almeno 24px */
  .footer-sedi a {
    display: inline-block;
    padding: .2rem 0;
  }

  .footer-link {
    display: inline-block;
    min-height: 24px;
    padding: .2rem 0;
    margin-top: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, .35);
  }

  /* ---------- Barra finale ---------- */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem var(--footer-y);
    font-size: var(--text-3xs);
    color: rgba(255, 255, 255, .55);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1240px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer-nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 1024px) {
    .footer-main {
      padding-bottom: 2rem;
    }
  }

  /* Mobile: contatti subito dopo il marchio, mappa del sito a fisarmonica */
  @media (max-width: 700px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 0 1.5rem 2rem;
    }

    .footer-contatti {
      order: 1;
    }

    .footer-nav {
      order: 2;
      grid-row: auto;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      border-top: 1px solid rgba(255, 255, 255, .12);
    }

    .footer-col {
      border-bottom: 1px solid rgba(255, 255, 255, .12);
    }

    .footer-col summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 52px;
      cursor: pointer;
    }

    /* "+" disegnato con due barre: centrato al pixel anche quando ruota in × */
    .footer-col summary::after {
      content: '';
      flex-shrink: 0;
      width: 14px;
      height: 14px;
      color: var(--white);
      background:
        linear-gradient(currentColor, currentColor) center / 14px 2px no-repeat,
        linear-gradient(currentColor, currentColor) center / 2px 14px no-repeat;
      transition: transform .3s ease, color .3s ease;
    }

    .footer-col[open] summary::after {
      transform: rotate(45deg);
    }

    .footer-col .footer-titolo {
      margin: 0;
    }

    .footer-col ul {
      padding: .25rem 0 1.25rem;
    }

    .footer-bottom {
      padding: 0 1.5rem var(--footer-y);
    }
  }
</style>
