---
/**
 * Footer: colonne generate dalla navigazione (src/data/navigazione.ts) e dai
 * dati ufficiali della scuola, così restano sempre allineate a navbar e contatti.
 */
import { categorieCorsi, FONDAZIONE, scuola, sedi } from '../data/scuola';
import { menu, type Voce } from '../data/navigazione';
import Img from './Img.astro';
import '../styles/components/footer.css';

const anno = new Date().getFullYear();

// Corsi: i cinque percorsi della pagina /corsi; le altre colonne dalle voci del menu
const colonne = [
  {
    titolo: 'Corsi',
    voci: [{ nome: 'Tutti i corsi', href: '/corsi' }, ...categorieCorsi.map((c) => ({ nome: c.nome, href: `/corsi#${c.id}` }))] as Voce[],
  },
  ...menu
    .filter((m) => m.id !== 'corsi')
    .map((m) => ({ titolo: m.label, voci: m.sezioni.flatMap((s) => s.voci) })),
];
---

<div class="footer-main">
  <div class="footer-brand">
    <a href="/" class="footer-logo" aria-label="InBallet - Torna alla homepage">
      <Img src="logo.png" alt="InBallet" width="376" height="133" widths={[120, 240, 376]} sizes="120px" loading="lazy" decoding="async" />
    </a>
    <p>Scuola di danza a Lainate e Rho dal {FONDAZIONE}, per bambini dai 3 anni, ragazzi e adulti.</p>
    <p class="footer-ente titoletto">Ente Formativo<br>CSEN · CONI</p>
    <div class="footer-social">
      <a href={scuola.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
      <a href={scuola.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook" aria-hidden="true"></i></a>
    </div>
  </div>

  <nav class="footer-nav" aria-label="Mappa del sito">
    {/* Colonne sempre aperte; su mobile footer.ts le chiude e diventano a fisarmonica */}
    {colonne.map((c) => (
      <details class="footer-col" open>
        <summary><h2 class="footer-titolo titoletto">{c.titolo}</h2></summary>
        <ul>
          {c.voci.map((v) => <li><a href={v.href}>{v.breve ?? v.nome}</a></li>)}
        </ul>
      </details>
    ))}
    {/* Contatti: una colonna come le altre (aperta su desktop e tablet, a fisarmonica chiusa su mobile) */}
    <details class="footer-col footer-contatti" open>
      <summary><h2 class="footer-titolo titoletto">Contatti</h2></summary>
      <ul>
        <li><a href={scuola.telefonoHref}>{scuola.telefono}</a></li>
        <li><a href={`mailto:${scuola.email}`}>{scuola.email}</a></li>
      </ul>
      <ul class="footer-sedi">
        {sedi.map((s) => (
          <li>
            <p>{s.citta}</p>
            <a href={s.maps} target="_blank" rel="noopener">{s.via}</a>
          </li>
        ))}
      </ul>
      <a href="/contatti" class="footer-link">Orari e contatti <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
    </details>
  </nav>

</div>

<div class="footer-bottom">
  <p>&copy; <span id="footerYear">{anno}</span> {scuola.ragioneSociale} · C.F. {scuola.codiceFiscale}</p>
</div>

<script>
  import '../scripts/footer';
</script>
