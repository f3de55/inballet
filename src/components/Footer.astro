---
/**
 * Footer: colonne generate dalla navigazione (src/data/navigazione.ts) e dai
 * dati ufficiali della scuola, così restano sempre allineate a navbar e contatti.
 */
import { categorieCorsi, FONDAZIONE, scuola, sedi } from '../data/scuola';
import { menu, type Voce } from '../data/navigazione';
import Img from './Img.astro';
import Chatbot from './Chatbot.astro';

const anno = new Date().getFullYear();

// Corsi: i cinque percorsi della pagina /corsi; le altre colonne dalle voci del menu
const colonne = [
  {
    titolo: 'Corsi',
    voci: [{ nome: 'Tutti i corsi', href: '/corsi' }, ...categorieCorsi.map((c) => ({ nome: c.nome, href: `/corsi#${c.id}` }))] as Voce[],
  },
  ...menu
    .filter((m) => m.id !== 'corsi')
    .map((m) => ({ titolo: m.label, voci: m.sezioni.flatMap((s) => s.voci) })),
];
---

<div class="footer-main">
  <div class="footer-brand">
    <a href="/" class="footer-logo" aria-label="InBallet - Torna alla homepage">
      <Img src="logo.png" alt="InBallet" widths={[120, 240, 452]} sizes="120px" loading="lazy" decoding="async" />
    </a>
    <p>Scuola di danza a Lainate e Rho dal {FONDAZIONE}, per bambini dai 3 anni, ragazzi e adulti.</p>
    <p class="footer-ente">Ente Formativo CSEN · CONI</p>
    <div class="footer-social">
      <a href={scuola.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
      <a href={scuola.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook" aria-hidden="true"></i></a>
    </div>
  </div>

  <nav class="footer-nav" aria-label="Mappa del sito">
    {colonne.map((c) => (
      <div class="footer-col">
        <h2 class="footer-titolo">{c.titolo}</h2>
        <ul>
          {c.voci.map((v) => <li><a href={v.href}>{v.breve ?? v.nome}</a></li>)}
        </ul>
      </div>
    ))}
  </nav>

  <div class="footer-contatti">
    <h2 class="footer-titolo">Contatti</h2>
    <ul>
      <li><a href={scuola.telefonoHref}>{scuola.telefono}</a></li>
      <li><a href={`mailto:${scuola.email}`}>{scuola.email}</a></li>
    </ul>
    <ul class="footer-sedi">
      {sedi.map((s) => (
        <li>
          <span>{s.citta}</span>
          <a href={s.maps} target="_blank" rel="noopener">{s.via}</a>
        </li>
      ))}
    </ul>
    <a href="/contatti" class="footer-link">Orari e contatti</a>
  </div>
</div>

<div class="footer-bottom">
  <p>&copy; <span id="footerYear">{anno}</span> {scuola.ragioneSociale} · C.F. {scuola.codiceFiscale}</p>
</div>

<Chatbot />

<script>
  import '../scripts/footer';
</script>

<style>
  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 4.4fr) minmax(0, 1fr);
    gap: 3.5rem;
    max-width: 1340px;
    margin: 0 auto;
    padding: 2.5rem 2rem 3.5rem;
  }

  /* ---------- Marchio ---------- */
  .footer-brand :global(img) {
    width: 120px;
    height: auto;
    margin-bottom: 1.25rem;
  }

  .footer-brand p {
    font-size: .9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, .65);
    max-width: 16rem;
  }

  .footer-brand .footer-ente {
    margin-top: .9rem;
    font-size: .8125rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--primary-blue);
  }

  .footer-social {
    display: flex;
    gap: .6rem;
    margin-top: 1.5rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 50%;
    color: var(--white);
    text-decoration: none;
    transition: border-color .3s ease, color .3s ease;
  }

  .footer-social a:hover {
    border-color: var(--primary-blue);
    color: var(--primary-blue);
  }

  /* ---------- Colonne ---------- */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .footer-titolo {
    font-size: .8125rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--primary-blue);
    margin-bottom: 1.1rem;
  }

  .footer-main ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .6rem;
  }

  .footer-main ul a,
  .footer-link {
    font-size: .9375rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, .72);
    text-decoration: none;
    transition: color .3s ease;
  }

  .footer-main ul a:hover,
  .footer-link:hover {
    color: var(--white);
  }

  .footer-main a:focus-visible {
    outline: 2px solid var(--primary-blue);
    outline-offset: 2px;
  }

  /* ---------- Contatti ---------- */
  .footer-contatti ul:first-of-type a {
    color: var(--white);
  }

  .footer-sedi {
    margin-top: 1.25rem;
  }

  .footer-sedi li {
    display: flex;
    flex-direction: column;
    gap: .15rem;
  }

  .footer-sedi span {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .45);
  }

  .footer-link {
    display: inline-block;
    margin-top: 1.25rem;
    padding-bottom: .2rem;
    border-bottom: 1px solid var(--primary-blue);
    color: var(--white);
  }

  /* ---------- Barra finale ---------- */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .5rem 2rem;
    max-width: 1340px;
    margin: 0 auto;
    padding: 1.5rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, .1);
    font-size: .8125rem;
    color: rgba(255, 255, 255, .5);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1240px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer-nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 700px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 2rem 1.5rem 2.5rem;
    }

    .footer-nav {
      grid-row: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }

    .footer-bottom {
      padding: 1.25rem 1.5rem 5rem;
    }
  }
</style>
