---
import Img from './Img.astro';
import { webp } from '../lib/images';
import '../styles/components/galleria.css';

interface Props {
  eyebrow?: string;
  titolo?: string;
  testo?: string;
}

const {
  eyebrow = 'I nostri momenti',
  titolo = 'Emozioni <em>in movimento</em>',
  testo = 'Lezioni in sala, <strong>spettacoli in teatro</strong> e dietro le quinte.',
} = Astro.props;

const foto = [
  ['spettacolo-corpo-di-ballo-blu', 'Corpo di ballo in bianco sul palco illuminato di blu'],
  ['sala-punte-piccola-allieva', 'Una piccola allieva guarda le scarpette da punta di una ballerina in sala'],
  ['spettacolo-contemporaneo-magenta', 'Coreografia contemporanea di gruppo su fondale magenta'],
  ['quinte-trucco', 'Due allieve si truccano dietro le quinte prima di entrare in scena'],
  ['spettacolo-classico-rosso', 'Tre ballerine in blu si tengono per mano sul fondale rosso'],
  ['sala-gruppo-bianco-nero', 'Gruppo di danzatori in posa in sala, in bianco e nero'],
  ['spettacolo-assolo-occhio-di-bue', "Assolo di danza contemporanea nella luce dell'occhio di bue"],
  ['spettacolo-bambine-stupore', 'Piccole allieve in abito lilla sul palco, con le mani sul viso per lo stupore'],
  ['spettacolo-hip-hop', 'Crew hip hop sul palco con le luci blu'],
  ['sala-sbarra-punte', 'Allieve sulle punte alla sbarra, in bianco e nero'],
  ['spettacolo-tutu-salto', 'Ballerina in tutù lilla in salto sul palco buio'],
  ['sala-lezione-classica', "L'insegnante guida la lezione di danza classica con le allieve in body lilla"],
  ['spettacolo-fili-rossi', 'Coreografia di gruppo intrecciata a fili rossi sul palco'],
  ['quinte-sipario', 'Sguardo curioso da sotto il sipario rosso prima dello spettacolo'],
  ['spettacolo-sculture-argento', 'Danzatori sul palco blu con sculture argentate'],
  ['sala-hip-hop-bambini', 'Gruppo hip hop di bambini in posa in sala'],
  ['spettacolo-abiti-blu', 'Danzatrici in abito blu attraversano il palco'],
  ['quinte-camerino', 'Ballerine si preparano davanti allo specchio del camerino'],
  ['spettacolo-saluto-finale', 'Tutta la scuola sul palco per il saluto finale'],
  ['esterni-rocce', 'Gruppo di danzatrici in posa tra le rocce'],
];
const gallery = await Promise.all(
  foto.map(async ([nome, alt]) => {
    const file = `galleria/${nome}.jpg`;
    return { file, alt, full: await webp(file, 1920) };
  }),
);
---

<section class="gallery-section" data-chatbot-escludi>
    <div class="container">
        <div class="gallery-header">
            <p class="gallery-tagline eyebrow">{eyebrow}</p>
            <h2 class="gallery-title titolo-sezione" set:html={titolo} />
            <p class="gallery-description intro-sezione" set:html={testo} />
        </div>
    </div>

    <div class="carosello-wrap carosello-wrap--soft">
    <div class="carosello gallery-infinite" data-giro="135">
        <div class="carosello-track gallery-track" id="galleryTrack">
            {[0, 1].map((set) =>
                gallery.map((img, i) => (
                    <div class="gallery-item" aria-hidden={set === 1 ? 'true' : undefined}>
                        <button type="button" class="gallery-apri" data-index={i} data-full={img.full} data-alt={img.alt} aria-label={`Ingrandisci: ${img.alt}`} tabindex={set === 1 ? -1 : undefined}>
                            <Img src={img.file} alt={set === 0 ? img.alt : ''} width="510" height="340" loading="lazy" decoding="async" draggable="false" rapporto={2 / 3} widths={[420, 640, 1020]} sizes="(max-width: 480px) 450px, (max-width: 768px) 510px, (max-width: 1024px) 450px, 510px" />
                            <span class="gallery-zoom-icon" aria-hidden="true"><i class="fas fa-expand"></i></span>
                        </button>
                    </div>
                ))
            )}
        </div>
    </div>
    </div>
</section>

<dialog tabindex="-1" class="galleria-dialog" id="lightbox" aria-label="Galleria fotografica">
    <button type="button" class="btn-icon btn-icon--chiudi galleria-chiudi" id="lightbox-close" aria-label="Chiudi galleria">
        <i class="fas fa-times" aria-hidden="true"></i>
    </button>
    <figure class="galleria-figura">
        <img class="galleria-foto" id="lightbox-image" src="data:," alt="">
        <figcaption class="galleria-didascalia">
            <small id="lightbox-caption"></small>
            <p class="galleria-contatore titoletto" id="lightbox-counter" aria-live="polite"></p>
        </figcaption>
    </figure>
    <button type="button" class="btn-icon btn-icon--scuro galleria-nav galleria-prev" id="lightbox-prev" aria-label="Foto precedente">
        <i class="fas fa-chevron-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="btn-icon btn-icon--scuro galleria-nav galleria-next" id="lightbox-next" aria-label="Foto successiva">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
    </button>
</dialog>

<script>
    import '../scripts/carosello';
    import '../scripts/galleria';
</script>
