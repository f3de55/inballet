---
/**
 * Galleria fotografica a scorrimento continuo con lightbox (homepage, contatti).
 * Scorrimento, touch e lightbox in src/scripts/galleria.ts.
 */
import Img from './Img.astro';
import { webp } from '../lib/images';
import '../styles/components/galleria.css';

interface Props {
  eyebrow?: string;
  /** Titolo (HTML, con <em> per l'accento). */
  titolo?: string;
  testo?: string;
}

const {
  eyebrow = 'I nostri momenti',
  titolo = 'Emozioni <em>in movimento</em>',
  testo = 'Lezioni in sala, <strong>spettacoli in teatro</strong> e dietro le quinte.',
} = Astro.props;

// Galleria: miniature responsive + versione grande per il lightbox
const alts = [
  'Allieve si preparano dietro le quinte prima dello spettacolo',
  'Corpo di ballo sul palco illuminato di blu',
  'Coreografia di danza contemporanea con costumi bianchi',
  "Lezione di danza contemporanea in sala con l'insegnante",
  'Allieve durante il riscaldamento a terra in sala',
  'Spettacolo di fine anno con tutto il corpo di ballo',
  'Gruppo di allievi InBallet in sala prove',
  "Abbraccio tra insegnante e allieva al termine della lezione",
  'Allieve in allungamento sul parquet della sala',
  'Coreografia sul palco con luci blu ed elementi scenici',
];
const gallery = await Promise.all(
  alts.map(async (alt, i) => {
    const file = `gallery-${i + 1}.jpg`;
    return { file, alt, full: await webp(file, 1280) };
  }),
);
---

<section class="gallery-section">
    <div class="container">
        <div class="gallery-header">
            <p class="gallery-tagline eyebrow">{eyebrow}</p>
            <h2 class="gallery-title titolo-sezione" set:html={titolo} />
            <p class="gallery-description intro-sezione" set:html={testo} />
        </div>
    </div>

    <!-- Due serie identiche: la seconda serve solo alla continuità dello scorrimento
         ed è nascosta a tastiera e screen reader -->
    <div class="carosello-wrap carosello-wrap--soft">
    <div class="carosello gallery-infinite" data-giro="80">
        <div class="carosello-track gallery-track" id="galleryTrack">
            {[0, 1].map((set) =>
                gallery.map((img, i) => (
                    <div class="gallery-item" aria-hidden={set === 1 ? 'true' : undefined}>
                        <button type="button" class="gallery-apri" data-index={i} data-full={img.full} data-alt={img.alt} aria-label={`Ingrandisci: ${img.alt}`} tabindex={set === 1 ? -1 : undefined}>
                            {/* Anteprime già ritagliate in verticale (5:7). sizes = larghezza della foto a schermo:
                                sui riquadri più stretti la decide l'altezza (altezza × 5/7).
                                alt solo sulla prima serie (ricerca immagini); il nome del pulsante resta l'aria-label */}
                            <Img src={img.file} alt={set === 0 ? img.alt : ''} width="300" height="420" loading="eager" decoding="async" draggable="false" rapporto={1.4} widths={[300, 450, 600]} sizes="(max-width: 480px) 215px, (max-width: 768px) 245px, (max-width: 1024px) 275px, 300px" />
                            <span class="gallery-zoom-icon" aria-hidden="true"><i class="fas fa-expand"></i></span>
                        </button>
                    </div>
                ))
            )}
        </div>
    </div>
    </div>
</section>

<!-- Lightbox galleria: dialog nativo (focus intrappolato, Esc, sfondo inerte) -->
<dialog class="galleria-dialog" id="lightbox" aria-label="Galleria fotografica">
    <button type="button" class="btn-icon btn-icon--scuro galleria-chiudi" id="lightbox-close" aria-label="Chiudi galleria">
        <i class="fas fa-times" aria-hidden="true"></i>
    </button>
    <figure class="galleria-figura">
        <img class="galleria-foto" id="lightbox-image" src="data:," alt="">
        <figcaption class="galleria-didascalia">
            <p id="lightbox-caption"></p>
            <p class="galleria-contatore titoletto" id="lightbox-counter" aria-live="polite"></p>
        </figcaption>
    </figure>
    <button type="button" class="btn-icon btn-icon--scuro galleria-nav galleria-prev" id="lightbox-prev" aria-label="Foto precedente">
        <i class="fas fa-chevron-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="btn-icon btn-icon--scuro galleria-nav galleria-next" id="lightbox-next" aria-label="Foto successiva">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
    </button>
</dialog>

<script>
    import '../scripts/carosello';
    import '../scripts/galleria';
</script>
