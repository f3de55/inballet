---
import type { SezioneInsegnanti } from '../lib/insegnanti';
import { grassettoDaTesto } from '../lib/text';
import '../styles/components/insegnanti-section.css';

interface Props {
  dati: SezioneInsegnanti;
}

const { sezione, insegnanti } = Astro.props.dati;
const iniziali = (nome: string) => nome.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase();
const ripetizioni = Math.max(1, Math.ceil(10 / Math.max(1, insegnanti.length)));
const meta = Array.from({ length: ripetizioni }, () => insegnanti).flat();
---

{insegnanti.length > 0 && (
  <section id="insegnanti" class="insegnanti-section decoro-onde" aria-labelledby="insegnanti-titolo">
    <div class="container">
      <div class="insegnanti-header">
        {sezione.eyebrow && <p class="eyebrow insegnanti-eyebrow">{sezione.eyebrow}</p>}
        <h2 class="titolo-sezione insegnanti-titolo" id="insegnanti-titolo">{sezione.titolo}{sezione.accento && <> <em>{sezione.accento}</em></>}</h2>
        {sezione.intro && <p class="intro-sezione insegnanti-intro" set:html={grassettoDaTesto(sezione.intro)} />}
      </div>
    </div>

    <div class="carosello-wrap">
    <div class="carosello insegnanti-fila" data-giro="35">
      <ul class="carosello-track insegnanti-track">
        {[0, 1].map((m) =>
          meta.map((p, i) => {
            const copia = m === 1 || i >= insegnanti.length;
            return (
              <li class="insegnante" data-apri-insegnante={p.id} aria-hidden={copia ? 'true' : undefined}>
                {p.foto
                  ? <img class="insegnante-foto" src={p.foto} alt="" width="800" height="1000" loading={i < 8 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                  : <div class="insegnante-foto insegnante-iniziali" aria-hidden="true">{iniziali(p.nome)}</div>}
                <div class="insegnante-velo">
                  <h3 class="insegnante-nome">{p.nome}</h3>
                  {p.ruolo && <p class="insegnante-ruolo titoletto">{p.ruolo}</p>}
                  <button type="button" class="link-cta insegnante-cta" data-apri-insegnante={p.id} aria-haspopup="dialog" aria-label={`Scopri di più su ${p.nome}`} tabindex={copia ? -1 : undefined}>
                    Scopri di più
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                  </button>
                </div>
              </li>
            );
          })
        )}
      </ul>
    </div>
    </div>
  </section>
)}

<script>
  import '../scripts/carosello';
</script>
