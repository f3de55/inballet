---
/**
 * Sezione «Insegnanti» di Chi siamo, gestita dalla dashboard (sezione Insegnanti).
 * Stesso schema della galleria «Le nostre sale»: intestazione centrata e fila di card
 * a scorrimento continuo (scorrimento vero, anche a mano con il mouse; pausa al passaggio; si
 * trascina con il mouse o col dito e scorre da sola, src/scripts/carosello.ts). Ogni card: foto, e su
 * un velo scuro nome, disciplina e «Scopri di più», che apre la scheda completa
 * (InsegnantiDialoghi.astro). Senza insegnanti la sezione non compare.
 */
import type { SezioneInsegnanti } from '../lib/insegnanti';
import { grassettoDaTesto } from '../lib/text';

interface Props {
  dati: SezioneInsegnanti;
}

const { sezione, insegnanti } = Astro.props.dati;
const iniziali = (nome: string) => nome.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase();
// Ogni metà della fila deve essere più larga dello schermo: con pochi insegnanti l'elenco si ripete
const ripetizioni = Math.max(1, Math.ceil(10 / Math.max(1, insegnanti.length)));
const meta = Array.from({ length: ripetizioni }, () => insegnanti).flat();
---

{insegnanti.length > 0 && (
  <section id="insegnanti" class="insegnanti-section" aria-labelledby="insegnanti-titolo">
    <div class="container">
      <div class="insegnanti-header">
        {sezione.eyebrow && <p class="eyebrow insegnanti-eyebrow">{sezione.eyebrow}</p>}
        <h2 class="titolo-sezione insegnanti-titolo" id="insegnanti-titolo">{sezione.titolo}{sezione.accento && <> <em>{sezione.accento}</em></>}</h2>
        {sezione.intro && <p class="intro-sezione insegnanti-intro" set:html={grassettoDaTesto(sezione.intro)} />}
      </div>
    </div>

    <!-- Due metà identiche: la seconda serve solo alla continuità dello scorrimento ed è
         nascosta a tastiera e screen reader (come le ripetizioni nella prima metà) -->
    <div class="carosello-wrap" style="--fade-bg: var(--white)">
    <div class="carosello insegnanti-fila" data-giro="70">
      <ul class="carosello-track insegnanti-track">
        {[0, 1].map((m) =>
          meta.map((p, i) => {
            const copia = m === 1 || i >= insegnanti.length;
            return (
              <li class="insegnante" data-apri-insegnante={p.id} aria-hidden={copia ? 'true' : undefined}>
                {p.foto
                  ? <img class="insegnante-foto" src={p.foto} alt="" width="800" height="1000" loading={i < 8 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                  : <span class="insegnante-foto insegnante-iniziali" aria-hidden="true">{iniziali(p.nome)}</span>}
                <div class="insegnante-velo">
                  <h3 class="insegnante-nome">{p.nome}</h3>
                  {p.ruolo && <p class="insegnante-ruolo">{p.ruolo}</p>}
                  <button type="button" class="link-cta insegnante-cta" data-apri-insegnante={p.id} aria-haspopup="dialog" aria-label={`Scopri di più su ${p.nome}`} tabindex={copia ? -1 : undefined}>
                    Scopri di più
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                  </button>
                </div>
              </li>
            );
          })
        )}
      </ul>
    </div>
    </div>
  </section>
)}

<script>
  import '../scripts/carosello';
</script>

<style>
  .insegnanti-section {
    padding: var(--section-y) 0;
    background: var(--white);
    overflow: hidden;
  }

  .insegnanti-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .insegnanti-eyebrow,
  .insegnanti-titolo {
    margin-bottom: 1.5rem;
  }

  .insegnanti-intro {
    max-width: 700px;
    margin: 0 auto;
  }

  @media (max-width: 600px) {
    .insegnanti-header {
      margin-bottom: 2rem;
      text-align: left;
    }

    .insegnanti-intro {
      margin: 0;
    }
  }

  /* ---------- Fila a scorrimento (come la galleria; logica in src/scripts/carosello.ts) ---------- */
  .insegnanti-fila {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .insegnanti-fila::-webkit-scrollbar {
    display: none;
  }

  .insegnanti-fila.trascinando {
    cursor: grabbing;
  }

  .insegnanti-track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .insegnante {
    position: relative;
    flex: 0 0 auto;
    cursor: pointer;
    width: 300px;
    height: 420px;
    margin-right: 8px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-soft);
  }

  .insegnante-foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .insegnante-iniziali {
    display: grid;
    place-items: center;
    font-size: var(--text-5xl);
    font-weight: 300;
    color: var(--primary-blue-dark);
  }

  /* Velo scuro in basso: nome, disciplina e pulsante leggibili su qualsiasi foto */
  .insegnante-velo {
    position: absolute;
    inset: auto 0 0;
    padding: 7rem 1.5rem 1.5rem;
    background: linear-gradient(to top, rgba(10, 10, 10, .92) 0%, rgba(10, 10, 10, .78) 45%, rgba(10, 10, 10, 0) 100%);
  }

  .insegnante-ruolo {
    margin: .35rem 0 0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--primary-blue);
  }

  .insegnante-nome {
    margin: 0;
    color: var(--white);
  }

  /* Pulsante sotto il nome; anche il resto della card apre la scheda (data-apri-insegnante sul <li>) */
  .insegnante-cta {
    position: static;
    margin-top: 1rem;
    padding: 0 0 .4rem;
    border: none;
    border-bottom: 2px solid var(--primary-blue);
    background: none;
    font-family: inherit;
    color: var(--white);
    cursor: pointer;
  }

  .insegnante-cta i {
    color: var(--white);
  }

  .insegnante-cta:hover {
    color: var(--white);
    border-color: var(--white);
  }

  .insegnante-cta:focus-visible {
    outline: none;
  }

  .insegnante:has(.insegnante-cta:focus-visible) {
    outline: 3px solid var(--primary-blue);
    outline-offset: -3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .insegnante:hover .insegnante-foto {
      transform: scale(1.04);
    }
  }

  /* Movimento ridotto: solo a mano, senza copie */
  @media (prefers-reduced-motion: reduce) {
    .insegnanti-fila {
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1.5rem;
    }

    .insegnanti-track {
      padding: 0 1.5rem;
    }

    .insegnante {
      scroll-snap-align: start;
    }

    .insegnante[aria-hidden="true"] {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .insegnante {
      width: 280px;
      height: 380px;
    }
  }

  @media (max-width: 768px) {
    .insegnante {
      width: min(62vw, 260px);
      height: 340px;
    }

    .insegnante-velo {
      padding: 6rem 1.25rem 1.25rem;
    }
  }
</style>
