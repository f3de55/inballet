---
/**
 * Sezione «Insegnanti» di Chi siamo, gestita dalla dashboard (sezione Insegnanti).
 * Stesso schema di «Le nostre sale»: intestazione centrata e card con foto grande;
 * sulla foto nome e disciplina su un velo scuro, sotto il pulsante che apre la scheda
 * completa (InsegnantiDialoghi.astro). Senza insegnanti non compare.
 * Desktop 3 per riga, tablet 2, mobile 1.
 */
import type { SezioneInsegnanti } from '../lib/insegnanti';
import { grassettoDaTesto } from '../lib/text';

interface Props {
  dati: SezioneInsegnanti;
}

const { sezione, insegnanti } = Astro.props.dati;
const iniziali = (nome: string) => nome.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase();
---

{insegnanti.length > 0 && (
  <section id="insegnanti" class="insegnanti-section" aria-labelledby="insegnanti-titolo">
    <div class="intro-editoriale">
      {sezione.eyebrow && <span class="eyebrow">{sezione.eyebrow}</span>}
      <h2 class="titolo-sezione" id="insegnanti-titolo">{sezione.titolo}{sezione.accento && <> <em>{sezione.accento}</em></>}</h2>
      {sezione.intro && <p class="intro-sezione" set:html={grassettoDaTesto(sezione.intro)} />}
    </div>
    <div class="container">
      <ul class="insegnanti-lista">
        {insegnanti.map((p) => (
          <li class="insegnante">
            <button type="button" class="insegnante-card" data-apri-insegnante={p.id} tabindex="-1" aria-hidden="true">
              {p.foto
                ? <img class="insegnante-foto" src={p.foto} alt="" width="800" height="1000" loading="lazy" decoding="async" />
                : <span class="insegnante-foto insegnante-iniziali">{iniziali(p.nome)}</span>}
              <span class="insegnante-velo">
                {p.ruolo && <span class="insegnante-ruolo">{p.ruolo}</span>}
                <span class="insegnante-nome">{p.nome}</span>
              </span>
            </button>
            <button type="button" class="link-cta insegnante-cta" data-apri-insegnante={p.id} aria-haspopup="dialog" aria-label={`Scopri di più su ${p.nome}`}>
              Scopri di più
              <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .insegnanti-section {
    padding: var(--section-y) 0;
    background: var(--white);
  }

  /* Come le sale: griglia sotto l'intestazione */
  .insegnanti-lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 2.5rem;
    margin: 3.5rem 0 0;
    padding: 0;
  }

  .insegnante {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .insegnante-card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: none;
    border-radius: var(--radius-img);
    background: var(--bg-soft);
    font-family: inherit;
    cursor: pointer;
  }

  .insegnante-foto {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform .6s ease;
  }

  .insegnante-iniziali {
    display: grid;
    place-items: center;
    font-size: var(--text-5xl);
    font-weight: 300;
    color: var(--primary-blue-dark);
  }

  /* Velo scuro in basso: nome e disciplina leggibili su qualsiasi foto */
  .insegnante-velo {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding: 4rem 1.5rem 1.4rem;
    background: linear-gradient(to top, rgba(10, 10, 10, .82) 0%, rgba(10, 10, 10, .55) 55%, rgba(10, 10, 10, 0) 100%);
    text-align: left;
  }

  .insegnante-ruolo {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--primary-blue);
  }

  .insegnante-nome {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
    color: var(--white);
  }

  .insegnante-cta {
    margin-top: 1.25rem;
    padding-top: 0;
    border-top: none;
    border-left: none;
    border-right: none;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .insegnante-card:hover .insegnante-foto {
      transform: scale(1.04);
    }
  }

  @media (max-width: 900px) {
    .insegnanti-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
      margin-top: 2.5rem;
    }
  }

  /* Un insegnante sotto l'altro */
  @media (max-width: 640px) {
    .insegnanti-lista {
      grid-template-columns: minmax(0, 1fr);
    }

    .insegnante-velo {
      padding: 3.5rem 1.25rem 1.25rem;
    }
  }
</style>
