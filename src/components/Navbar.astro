---
import Img from './Img.astro';
import { menu, type Menu } from '../data/navigazione';

// Pagina corrente (senza .html e slash finale) per evidenziare voce e sottovoce
const corrente = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const attiva = (href: string) => href === corrente;
const menuAttivo = (m: Menu) => (m.href && attiva(m.href)) || m.sezioni.some((s) => s.voci.some((v) => attiva(v.href)));
---

<nav class="nav-container" aria-label="Navigazione principale">
    <div class="logo-section">
        <a href="/" aria-label="InBallet - Torna alla homepage">
            <Img src="logo.png" alt="InBallet Logo" widths={[130, 260, 452]} sizes="130px" fetchpriority="high" />
        </a>
    </div>

    <ul class="nav-menu">
        {menu.map((m) => {
            const LinkTag = m.href ? 'a' : 'button';
            return (
                <li class:list={['nav-item', { 'nav-item--compatto': m.compatto }]} data-menu={m.id}>
                    <LinkTag
                        href={m.href}
                        class:list={['nav-link', { attiva: menuAttivo(m) }]}
                        aria-current={m.href && attiva(m.href) ? 'page' : undefined}
                        aria-expanded="false"
                        aria-haspopup="true"
                    >{m.label}</LinkTag>
                    <div class:list={['mega-menu', { 'mega-menu--compatto': m.compatto }]} id={`mega-menu-${m.id}`} role="region" aria-label={`Menu ${m.label}`}>
                        <div class="mega-menu-content" style={`--voci: ${Math.max(...m.sezioni.map((s) => s.voci.length))}`}>
                            {m.sezioni.map((s) => (
                                <div class="mega-menu-section">
                                    <h4>{s.titolo}</h4>
                                    <ul>
                                        {s.voci.map((v) => (
                                            <li><a href={v.href} class:list={{ attiva: attiva(v.href) }} aria-current={attiva(v.href) ? 'page' : undefined}>{v.nome}</a></li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>
                </li>
            );
        })}
    </ul>

    <a href="/contatti" class:list={['cta-btn', { attiva: attiva('/contatti') }]} aria-current={attiva('/contatti') ? 'page' : undefined}>Contattaci</a>
    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Apri menu di navigazione" aria-expanded="false" aria-controls="mobileMenu">
        <i class="fas fa-bars"></i>
    </button>
</nav>

<!-- Mobile Menu -->
<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Chiudi menu">
        <i class="fas fa-times"></i>
    </button>

    {menu.map((m) => (
        <div class="mobile-nav-item">
            <button class:list={['mobile-nav-toggle', { attiva: menuAttivo(m) }]} data-target={`${m.id}-submenu`} aria-expanded="false" aria-controls={`${m.id}-submenu`}>
                <span>{m.label}</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="mobile-submenu" id={`${m.id}-submenu`}>
                {m.href && <a href={m.href} class:list={['mobile-tutti', { attiva: attiva(m.href) }]} aria-current={attiva(m.href) ? 'page' : undefined}>Tutti i corsi</a>}
                {m.sezioni.map((s) => (
                    <>
                        <h4>{s.titolo}</h4>
                        {s.voci.map((v) => (
                            <a href={v.href} class:list={{ attiva: attiva(v.href) }} aria-current={attiva(v.href) ? 'page' : undefined}>{v.nome}</a>
                        ))}
                    </>
                ))}
            </div>
        </div>
    ))}

    <div class="mobile-cta">
        <a href="/contatti" class="cta-btn">Contattaci</a>
    </div>
</div>

<style>
.nav-link:focus-visible {
  outline: 3px solid var(--primary-blue);
  outline-offset: 2px;
  background: rgba(135,206,235,.15);
}

.mega-menu-section :global(a:focus-visible) {
  outline: 2px solid var(--primary-blue);
  outline-offset: 0;
  background: rgba(135,206,235,.1);
}

.nav-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80px;
  min-height: 80px;
}

.logo-section {
  display: flex;
  align-items: center;
}

.logo-section :global(img) {
  height: 65px;
  width: auto;
  filter: brightness(1.1);
  transition: filter var(--transition-base),transform var(--transition-base);
}

.nav-menu {
  display: flex;
  list-style: none;
  gap: 0;
}

.nav-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  color: var(--white);
  font-weight: 600;
  padding: 1rem 2rem;
  transition: color var(--transition-base),background var(--transition-base);
  cursor: pointer;
  text-transform: uppercase;
  font-size: var(--text-sm);
  line-height: normal;
  letter-spacing: .5px;
  border-radius: var(--radius-sm);
  margin: 0 .2rem;
  border: none;
  background: transparent;
}

.nav-link:hover,
.nav-item:hover .nav-link {
  color: var(--white);
  background: rgba(255,255,255,.1);
}

.nav-item[data-menu] .nav-link::after {
  content: "▼";
  margin-left: .5rem;
  font-size: var(--text-xs);
  transition: transform var(--transition-base);
  color: #fff;
}

.nav-link.attiva,
.nav-item:hover .nav-link.attiva {
  color: var(--primary-blue);
}

.nav-link.attiva::after {
  color: var(--primary-blue);
}

.mega-menu-section a.attiva,
.mega-menu-section a.attiva::before {
  color: var(--primary-blue);
}

.cta-btn.attiva {
  background: var(--white);
  color: var(--dark-navy);
}

.nav-item[data-menu]:hover .nav-link::after {
  transform: rotate(180deg);
}

.cta-btn {
  background: var(--primary-blue);
  color: var(--black);
  padding: 1rem 2.5rem;
  border: none;
  border-radius: var(--radius-xl);
  text-decoration: none;
  font-weight: 600;
  transition: background var(--transition-base),color var(--transition-base);
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: .5px;
  font-size: var(--text-sm);
  box-shadow: var(--shadow-blue);
}

.cta-btn:hover {
  background: rgba(255,255,255,0.95);
  color: var(--dark-navy);
}

.nav-menu {
  position: relative;
}

/* Corsi: pannello largo centrato, stessa posizione verticale delle tendine compatte */
.nav-item:not(.nav-item--compatto) {
  position: static;
}

.mega-menu {
  position: absolute;
  top: calc(100% + 16px);
  left: 50%;
  transform: translateX(-50%);
  width: min(1240px, calc(100vw - 3rem));
  border: 1px solid rgba(255,255,255,.08);
  border-top: none;
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  height: auto;
  max-height: calc(100vh - 80px);
  background: var(--header-dark);
  box-shadow: 0 10px 20px rgba(0,0,0,.3);
  padding: 0;
  /* Chiusa: invisibile e leggermente più in basso; aperta: dissolvenza verso l'alto */
  visibility: hidden;
  opacity: 0;
  translate: 0 8px;
  transition: opacity .2s ease, translate .2s ease, visibility 0s linear .2s;
  overflow: visible;
  z-index: 999;
}

/* Ponte invisibile: il passaggio dalla voce al pannello non lo chiude */
.mega-menu::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  height: 16px;
}

.mega-menu.active {
  visibility: visible;
  opacity: 1;
  translate: 0 0;
  transition-delay: 0s;
}

@media (prefers-reduced-motion: reduce) {
  .mega-menu {
    transition: none;
  }
}

.mega-menu-content {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  padding: 1.5rem 1rem;
}

/* Menu a una sola colonna (La Scuola, Progetti, Formazione): tendina compatta
   sotto la voce, uguale per tutti; il mega menu a tutta larghezza resta per Corsi */
.mega-menu--compatto {
  position: absolute;
  top: calc(100% + 16px);
  left: 50%;
  width: 340px;
  max-height: none;
  overflow: visible;
  border: 1px solid rgba(255,255,255,.08);
  border-top: none;
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);
}

.mega-menu--compatto .mega-menu-content {
  display: block;
  max-width: none;
  padding: 1.5rem 1.75rem 1.25rem;
}

.mega-menu--compatto .mega-menu-section {
  padding: 0;
  border: none;
}

.mega-menu-section {
  padding: 1rem 1.25rem;
  border-right: 1px solid rgba(135,206,235,.2);
  height: auto;
}

.mega-menu-section:last-child {
  border-right: none;
}

.mega-menu-section :global(h4) {
  align-self: end;
  color: var(--primary-blue);
  margin-bottom: .8rem;
  font-size: var(--text-sm);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding-bottom: .4rem;
  border-bottom: 2px solid rgba(135,206,235,.3);
}

.mega-menu-section :global(ul) {
  list-style: none;
}

.mega-menu-section :global(li) {
  margin-bottom: .5rem;
}

/* Mega menu Corsi: le colonne condividono le righe (subgrid), così titoli,
   filetti e voci restano allineati anche quando un testo va a capo */
.mega-menu:not(.mega-menu--compatto) .mega-menu-content {
  grid-template-rows: auto repeat(var(--voci), auto);
}

.mega-menu:not(.mega-menu--compatto) .mega-menu-section {
  display: grid;
  grid-row: 1 / -1;
  grid-template-rows: subgrid;
}

.mega-menu:not(.mega-menu--compatto) .mega-menu-section :global(ul) {
  display: grid;
  grid-row: 2 / -1;
  grid-template-rows: subgrid;
}

.mega-menu-section :global(a) {
  color: #ccc;
  text-decoration: none;
  transition: color var(--transition-base);
  padding: .5rem 0;
  display: flex;
  align-items: center;
  font-weight: 500;
  font-size: var(--text-sm);
  position: relative;
  padding-left: 1.2rem;
  line-height: 1.3;
}

.mega-menu-section :global(a::before) {
  content: "•";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  color: var(--primary-blue);
  font-weight: 700;
  font-size: var(--text-sm);
  line-height: 1;
}

.mega-menu-section :global(a:hover) {
  color: var(--white);
}

.mobile-menu-btn {
  display: none;
  background: 0 0;
  border: none;
  font-size: var(--text-2xl);
  cursor: pointer;
  color: var(--white);
  z-index: 1001;
  transition: all .3s ease;
}

.mobile-menu-btn.active {
  color: var(--primary-blue);
}

.mobile-menu {
  position: fixed;
  top: 0;
  right: -100%;
  width: 85%;
  max-width: 400px;
  height: 100vh;
  background: var(--header-dark);
  box-shadow: -10px 0 50px rgba(0,0,0,.3);
  z-index: 1000;
  transition: all .4s cubic-bezier(.4,0,.2,1);
  overflow-y: auto;
  overflow-x: hidden;
  padding-top: 80px;
  padding-bottom: 40px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: var(--primary-blue) var(--header-dark);
}

.mobile-menu.active {
  right: 0;
}

.mobile-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(0,0,0,.6);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: all .4s ease;
}

.mobile-overlay.active {
  opacity: 1;
  visibility: visible;
}

.mobile-menu-close {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  background: 0 0;
  border: none;
  color: var(--primary-blue);
  font-size: var(--text-2xl);
  cursor: pointer;
  transition: all .3s ease;
}

#mobileMenu .mobile-menu-close,
div.mobile-menu-close {
  color: #fff;
}

.mobile-menu-close:hover {
  opacity: .7;
}

.mobile-nav-item {
  border-bottom: 1px solid rgba(255,255,255,.1);
}

.mobile-nav-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem;
  cursor: pointer;
  transition: all .3s ease;
  font-weight: 600;
  font-size: var(--text-sm);
  text-transform: uppercase;
  letter-spacing: .5px;
  color: var(--white);
  width: 100%;
  border: none;
  background: transparent;
  text-align: left;
}

.mobile-nav-toggle.active {
  background: rgba(255,255,255,.05);
}

.mobile-nav-toggle :global(i) {
  transition: transform .3s ease;
  color: var(--primary-blue);
  font-size: var(--text-sm);
}

#mobileMenu .mobile-nav-toggle :global(i),
div.mobile-menu .mobile-nav-toggle :global(i) {
  color: #fff;
}

.mobile-submenu {
  background: rgba(255,255,255,.05);
  max-height: 0;
  overflow: hidden;
  transition: max-height .3s ease;
}

.mobile-submenu.active {
  max-height: 5000px;
  overflow: visible;
}

#mobileMenu .mobile-submenu :global(h4),
div.mobile-menu .mobile-submenu :global(h4) {
  padding: .5rem 2rem .4rem;
  margin: 1.2rem 0 .4rem;
  font-weight: 500;
  color: rgba(255,255,255,.7);
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 2px;
  border: none;
  border-bottom: 1px solid rgba(255,255,255,.2);
  background: 0 0;
  display: block;
  width: 100%;
  box-sizing: border-box;
  opacity: .7;
  text-align: left;
}

#mobileMenu .mobile-submenu :global(h4:first-child) {
  margin-top: .3rem;
}

.mobile-submenu :global(a) {
  display: block;
  padding: .6rem 1.2rem .6rem 1.8rem;
  color: #ccc;
  text-decoration: none;
  transition: color .3s ease;
  font-weight: 500;
  font-size: var(--text-sm);
  border-bottom: 1px solid rgba(255,255,255,.05);
  line-height: 1.3;
}

.mobile-submenu .mobile-tutti {
  color: var(--primary-blue);
  font-weight: 600;
}

.mobile-nav-toggle.attiva span {
  color: var(--primary-blue);
}

.mobile-submenu a.attiva {
  color: var(--primary-blue);
  font-weight: 700;
}

.mobile-submenu :global(a:last-child) {
  border-bottom: none;
}

#mobileMenu .mobile-submenu :global(a::before),
div.mobile-submenu :global(a::before) {
  color: #fff;
}

.mobile-cta {
  padding: 1.5rem 1.2rem;
  text-align: left;
  float: left;
  width: 100%;
}

.mobile-cta .cta-btn {
  width: 100%;
  text-align: center;
  float: left;
  padding: .85rem 1.5rem;
  font-size: var(--text-xs);
}

.mobile-menu::-webkit-scrollbar {
  width: 6px;
}

.mobile-menu::-webkit-scrollbar-track {
  background: var(--header-dark);
}

.mobile-menu::-webkit-scrollbar-thumb {
  background: var(--primary-blue);
  border-radius: 3px;
}

.mobile-menu::-webkit-scrollbar-thumb:hover {
  background: var(--primary-blue-dark);
}

@media (max-width:1200px) {
  .nav-menu,
  .nav-container > .cta-btn {
    display: none;
  }

  .mobile-menu-btn {
    display: block;
  }
}

/* Con il menu mobile aperto il pulsante hamburger lascia il posto alla X */
:global(html.menu-aperto) .mobile-menu-btn {
  visibility: hidden;
}

@media (max-width:768px) {
  .nav-container {
    padding: 0 1.5rem;
  }
}

@media (max-width:480px) {
  .mega-menu {
    width: 100vw;
    left: 0;
  }

  .mega-menu-content {
    padding: 1rem 1.5rem;
    max-width: none;
    grid-template-columns: 1fr;
  }


  .mega-menu-section {
    border-right: none;
    border-bottom: 1px solid var(--primary-blue);
    height: auto;
    padding: .8rem 1.2rem;
  }

  .mega-menu-section:last-child {
    border-bottom: none;
  }

  .mega-menu-section :global(h4) {
    margin-bottom: .6rem;
    padding-bottom: .3rem;
  }

  .mega-menu-section :global(li) {
    margin-bottom: .4rem;
  }

  .mega-menu-section :global(a) {
    padding: .4rem 0;
    font-size: var(--text-xs);
  }
}
</style>
