---
import Img from './Img.astro';
import { menu, type Menu } from '../data/navigazione';

// Pagina corrente (senza .html e slash finale) per evidenziare voce e sottovoce
const corrente = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const attiva = (href: string) => href === corrente;
const menuAttivo = (m: Menu) => (m.href && attiva(m.href)) || m.sezioni.some((s) => s.voci.some((v) => attiva(v.href)));
---

<nav class="nav-container" aria-label="Navigazione principale">
    <div class="logo-section">
        <a href="/" aria-label="InBallet - Torna alla homepage">
            <Img src="logo.png" alt="InBallet" width="376" height="133" widths={[116, 150, 232, 300, 376]} sizes="(max-width: 1200px) 116px, 150px" fetchpriority="high" />
        </a>
    </div>

    <ul class="nav-menu">
        {menu.map((m) => {
            const LinkTag = m.href ? 'a' : 'button';
            return (
                <li class:list={['nav-item', { 'nav-item--compatto': m.compatto }]} data-menu={m.id}>
                    <LinkTag
                        href={m.href}
                        class:list={['nav-link', { attiva: menuAttivo(m) }]}
                        aria-current={m.href && attiva(m.href) ? 'page' : undefined}
                        aria-expanded="false"
                        aria-haspopup="true"
                    >{m.label}</LinkTag>
                    <div class:list={['mega-menu', { 'mega-menu--compatto': m.compatto }]} id={`mega-menu-${m.id}`} role="region" aria-label={`Menu ${m.label}`}>
                        <div class="mega-menu-content">
                            {m.sezioni.map((s) => (
                                <div class="mega-menu-section">
                                    <p class="mega-titolo titoletto">{s.titolo}</p>
                                    <ul>
                                        {s.voci.map((v) => (
                                            <li><a href={v.href} class:list={{ attiva: attiva(v.href) }} aria-current={attiva(v.href) ? 'page' : undefined}>{v.nome}</a></li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>
                </li>
            );
        })}
    </ul>

    <a href="/contatti" class="btn-primary" aria-current={attiva('/contatti') ? 'page' : undefined}>Contattaci</a>
    <button class="btn-icon btn-icon--nudo mobile-menu-btn" id="mobileMenuBtn" aria-label="Apri menu di navigazione" aria-expanded="false" aria-controls="mobileMenu">
        <i class="fas fa-bars" aria-hidden="true"></i>
    </button>
</nav>

<!-- Mobile Menu -->
<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-menu sezione-scura" id="mobileMenu" aria-hidden="true">
    <div class="mobile-menu-top">
        <span class="eyebrow">Menu</span>
        <button class="btn-icon btn-icon--nudo mobile-menu-close" id="mobileMenuClose" aria-label="Chiudi menu">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
    </div>

    {menu.map((m) => (
        <div class="mobile-nav-item">
            <button class:list={['mobile-nav-toggle', { attiva: menuAttivo(m) }]} data-target={`${m.id}-submenu`} aria-expanded="false" aria-controls={`${m.id}-submenu`}>
                <span>{m.label}</span>
                <span class="mobile-nav-freccia" aria-hidden="true">▼</span>
            </button>
            <div class="mobile-submenu" id={`${m.id}-submenu`}>
                <div class="mobile-submenu-inner">
                    {m.sezioni.map((s) => (
                        <div class="mobile-gruppo">
                            {s.titolo !== m.label && <span class="mobile-gruppo-titolo titoletto">{s.titolo}</span>}
                            <ul>
                                {s.voci.map((v) => (
                                    <li><a href={v.href} class:list={{ attiva: attiva(v.href) }} aria-current={attiva(v.href) ? 'page' : undefined}>{v.nome}</a></li>
                                ))}
                            </ul>
                        </div>
                    ))}
                    {m.href && <a href={m.href} class="link-cta mobile-tutti" aria-current={attiva(m.href) ? 'page' : undefined}>Tutti i corsi <i class="fas fa-arrow-right" aria-hidden="true"></i></a>}
                </div>
            </div>
        </div>
    ))}

    <a href="/contatti" class="btn-primary mobile-cta" aria-current={attiva('/contatti') ? 'page' : undefined}>Contattaci <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
</div>

<style>
.nav-link:focus-visible {
  outline: 3px solid var(--primary-blue);
  outline-offset: 2px;
  background: rgb(var(--blu-rgb) / .15);
}

.mega-menu-section :global(a:focus-visible) {
  outline: 2px solid var(--primary-blue);
  outline-offset: 0;
  background: rgb(var(--blu-rgb) / .1);
}

.nav-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: var(--nav-h);
  min-height: var(--nav-h);
  transition: height .3s ease, min-height .3s ease;
}

.logo-section {
  display: flex;
  align-items: center;
}

.logo-section :global(img) {
  display: block;
  width: 150px;
  height: auto;
  filter: brightness(1.1);
  transition: width .3s ease, filter var(--transition-base);
}

:global(.main-header.is-scrolled) .logo-section :global(img) {
  width: 120px;
}

.nav-menu {
  display: flex;
  list-style: none;
  gap: 0;
}

.nav-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  color: var(--white);
  font-weight: 600;
  padding: 1rem 2rem;
  transition: color var(--transition-base),font-size .3s ease;
  cursor: pointer;
  text-transform: uppercase;
  font-size: var(--text-xs);
  line-height: normal;
  letter-spacing: 1.2px;
  border-radius: var(--radius-sm);
  margin: 0 .2rem;
  border: none;
  background: transparent;
}

.nav-link:hover,
.nav-item:hover .nav-link {
  color: var(--white);
}

/* Voce sotto il mouse (o con il sottomenu aperto): pillola compatta azzurro scuro dietro
   il testo, più piccola dell'area cliccabile (bianco su #3B72A0: contrasto 5.1:1) */
.nav-link {
  position: relative;
  isolation: isolate;
}

.nav-link::before {
  content: '';
  position: absolute;
  inset: .55rem 1.1rem;
  z-index: -1;
  border-radius: var(--radius-pill);
  background: var(--primary-blue-dark);
  opacity: 0;
  transition: opacity .2s ease;
}

.nav-item:hover .nav-link::before,
.nav-link:focus-visible::before,
.nav-item:has(.mega-menu.active) .nav-link::before {
  opacity: 1;
}

/* Sulla pillola anche la voce della sezione attiva torna bianca, per restare leggibile */
.nav-item:hover .nav-link.attiva,
.nav-item[data-menu]:hover .nav-link.attiva::after,
.nav-item:has(.mega-menu.active) .nav-link.attiva,
.nav-item[data-menu]:has(.mega-menu.active) .nav-link.attiva::after {
  color: var(--white);
}

@media (prefers-reduced-motion: reduce) {
  .nav-link::before {
    transition: none;
  }
}


.nav-item[data-menu] .nav-link::after {
  content: "▼";
  margin-left: .5rem;
  font-size: var(--icona-mini);
  transition: transform var(--transition-base);
  color: var(--white);
}

.nav-link.attiva {
  color: var(--primary-blue);
}

.nav-item[data-menu] .nav-link.attiva::after {
  color: var(--primary-blue);
}

.mega-menu-section a.attiva {
  color: var(--white);
}

.nav-item[data-menu]:hover .nav-link::after {
  transform: rotate(180deg);
}

.nav-menu {
  position: relative;
}

/* Dopo lo scroll la navbar si restringe e il pulsante Contattaci si fa molto più piccolo */
.nav-container > .btn-primary {
  transition: background-color .3s ease, color .3s ease, border-color .3s ease, padding .3s ease;
}

:global(.main-header.is-scrolled) .nav-container > .btn-primary {
  padding: .45rem .85rem;
}

/* Corsi: pannello largo centrato, stessa posizione verticale delle tendine compatte */
.nav-item:not(.nav-item--compatto) {
  position: static;
}

.mega-menu {
  position: absolute;
  top: calc(100% + 16px);
  left: 50%;
  transform: translateX(-50%);
  width: min(1240px, calc(100vw - 3rem));
  /* Bordo e alone azzurri: il pannello scuro non si confonde con le sezioni scure sotto */
  border: 1px solid rgb(var(--blu-rgb) / .35);
  border-radius: var(--radius-md);
  height: auto;
  max-height: calc(100vh - var(--nav-h));
  background: var(--header-dark);
  box-shadow: 0 0 0 1px rgb(var(--blu-rgb) / .08), 0 14px 36px rgb(var(--blu-rgb) / .22);
  padding: 0;
  /* Chiusa: invisibile e leggermente più in basso; aperta: dissolvenza verso l'alto */
  visibility: hidden;
  opacity: 0;
  translate: 0 8px;
  transition: opacity .2s ease, translate .2s ease, visibility 0s linear .2s;
  overflow: visible;
  z-index: 999;
}

/* Ponte invisibile: il passaggio dalla voce al pannello non lo chiude */
.mega-menu::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  height: 16px;
}

.mega-menu.active {
  visibility: visible;
  opacity: 1;
  translate: 0 0;
  transition-delay: 0s;
}

@media (prefers-reduced-motion: reduce) {
  .mega-menu,
  .nav-container,
  .logo-section :global(img) {
    transition: none;
  }
}

.mega-menu-content {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  padding: 1.5rem 1rem;
}

/* Menu a una sola colonna (La Scuola, Progetti, Formazione): tendina compatta
   sotto la voce, uguale per tutti; il mega menu a tutta larghezza resta per Corsi */
.mega-menu--compatto {
  position: absolute;
  top: calc(100% + 16px);
  left: 50%;
  width: 340px;
  max-height: none;
  overflow: visible;
  border: 1px solid rgb(var(--bianco-rgb) / .08);
  border-radius: var(--radius-md);
}

.mega-menu--compatto .mega-menu-content {
  display: block;
  max-width: none;
  padding: 1.5rem 1.75rem 1.25rem;
}

.mega-menu--compatto .mega-menu-section {
  padding: 0;
  border: none;
}

.mega-menu-section {
  padding: 1rem 1.25rem;
  border-right: 1px solid rgb(var(--blu-rgb) / .2);
  height: auto;
}

.mega-menu-section:last-child {
  border-right: none;
}

.mega-menu-section .mega-titolo {
  align-self: end;
  color: var(--primary-blue);
  margin-bottom: .8rem;
  padding-bottom: .4rem;
  border-bottom: 2px solid rgb(var(--blu-rgb) / .3);
}

.mega-menu-section :global(ul) {
  list-style: none;
}

.mega-menu-section :global(li) {
  margin-bottom: .5rem;
}

/* Mega menu Corsi: le colonne condividono solo la riga dei titoli (subgrid), così
   i filetti restano allineati; le voci scorrono in ogni colonna con passo regolare */
.mega-menu:not(.mega-menu--compatto) .mega-menu-content {
  grid-template-rows: auto auto;
}

.mega-menu:not(.mega-menu--compatto) .mega-menu-section {
  display: grid;
  grid-row: 1 / -1;
  grid-template-rows: subgrid;
}

.mega-menu-section :global(a) {
  color: var(--grigio-300);
  text-decoration: none;
  transition: color var(--transition-base);
  padding: .5rem 0 .5rem 1.2rem;
  display: block;
  font-weight: 500;
  font-size: var(--text-xs);
  /* Altezza di riga a pixel interi: le voci cadono tutte sulla stessa frazione di pixel, così testo e
     pallino hanno lo stesso allineamento in ogni voce */
  line-height: 1.3;
  line-height: round(up, 1.3em, 1px);
}

/* Pallino di 5px, dello stesso colore della voce (segue hover e voce attiva). È sulla stessa riga del
   testo (inline), quindi segue la linea di base delle lettere: sta sempre a metà dell'altezza delle
   minuscole, identico in ogni voce, e sulla prima riga se la voce va a capo */
.mega-menu-section :global(a::before) {
  content: '';
  display: inline-block;
  width: 5px;
  height: 5px;
  margin: 0 calc(1.2rem - 5px) 0 -1.2rem;
  border-radius: var(--radius-full);
  background: currentColor;
  vertical-align: calc(.25em - 2.15px);
}

.mega-menu-section :global(a:hover) {
  color: var(--white);
}

/* Area di tocco 44px, icona a filo destro come la X del menu */
.mobile-menu-btn {
  display: none;
  margin-right: -2px;
  place-items: center end;
  /* Nessuno z-index: resta sotto il pannello del menu, che lo copre mentre entra ed esce.
     Transizione solo sul colore: con "all" anche la scomparsa veniva ritardata */
  transition: color .3s ease;
}

/* Menu mobile/tablet: pannello scuro editoriale da destra, sotto l'eventuale banner */
.mobile-menu {
  position: fixed;
  top: var(--banner-height, 0px);
  right: 0;
  width: min(480px, 100%);
  height: calc(100dvh - var(--banner-height, 0px));
  display: flex;
  flex-direction: column;
  padding: 0 2rem 2.5rem;
  background: var(--dark-navy);
  box-shadow: -20px 0 60px rgb(var(--nero-rgb) / .35);
  z-index: 1000;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  scrollbar-color: var(--linea-su-scuro) transparent;
  transform: translateX(100%);
  visibility: hidden;
  transition: transform .4s cubic-bezier(.4,0,.2,1), visibility 0s linear .4s;
}

.mobile-menu.active {
  transform: none;
  visibility: visible;
  transition-delay: 0s;
}

.mobile-overlay {
  position: fixed;
  top: var(--banner-height, 0px);
  left: 0;
  width: 100%;
  height: calc(100dvh - var(--banner-height, 0px));
  background: rgb(var(--nero-rgb) / .6);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: opacity .4s ease, visibility 0s linear .4s;
}

.mobile-overlay.active {
  opacity: 1;
  visibility: visible;
  transition-delay: 0s;
}

.mobile-menu-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--nav-h);
  margin-bottom: 1rem;
  border-bottom: 1px solid var(--velo-chiaro);
}

.mobile-menu-top .eyebrow {
  margin: 0;
}

/* Icona a filo destro, in colonna con le frecce delle voci; area di tocco 44px */
.mobile-menu-close {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.mobile-nav-item {
  border-bottom: 1px solid var(--velo-chiaro);
}

.mobile-nav-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 1.15rem 0;
  border: none;
  background: transparent;
  color: var(--white);
  font-family: inherit;
  font-size: var(--text-base);
  font-weight: 600;
  letter-spacing: -0.01em;
  text-align: left;
  cursor: pointer;
  transition: color .3s ease;
}

/* Azzurro solo sulla voce padre della pagina corrente: né hover né voce aperta */
.mobile-nav-toggle.attiva {
  color: var(--primary-blue);
}

/* Stessa freccia della navbar desktop: triangolo bianco, azzurro solo sulla sezione attiva */
.mobile-nav-freccia {
  font-size: var(--icona-mini);
  color: var(--white);
  transition: transform .3s ease, color .3s ease;
}

.mobile-nav-toggle.attiva .mobile-nav-freccia {
  color: var(--primary-blue);
}

/* Voce aperta: la freccia si gira, i colori non cambiano */
.mobile-nav-toggle.active .mobile-nav-freccia {
  transform: rotate(180deg);
}

.mobile-submenu {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows .35s ease;
}

.mobile-submenu.active {
  grid-template-rows: 1fr;
}

.mobile-submenu-inner {
  min-height: 0;
  overflow: hidden;
}

.mobile-gruppo {
  padding-bottom: 1rem;
}

.mobile-gruppo + .mobile-gruppo {
  padding-top: .75rem;
}

/* Intestazione del gruppo, non cliccabile: il filetto sotto la separa dalle voci (che sono link) */
.mobile-gruppo-titolo {
  display: block;
  margin-bottom: .5rem;
  padding-bottom: .5rem;
  border-bottom: 1px solid rgb(var(--blu-rgb) / .35);
  color: var(--primary-blue);
}

.mobile-gruppo ul {
  list-style: none;
}

.mobile-gruppo a {
  display: block;
  padding: .45rem 0;
  color: var(--testo-su-scuro-debole);
  font-size: var(--text-sm);
  line-height: 1.35;
  text-decoration: none;
  transition: color .3s ease;
}

.mobile-gruppo a:hover {
  color: var(--white);
}

.mobile-gruppo a.attiva {
  color: var(--white);
  font-weight: 700;
}

.mobile-tutti {
  margin: .25rem 0 1.5rem;
  color: var(--white);
  font-size: var(--text-xs);
}

.mobile-tutti:hover {
  color: var(--white);
  border-color: var(--primary-blue);
}

.mobile-tutti :global(i),
.mobile-tutti:hover :global(i) {
  color: var(--white);
}

/* Centrato, larghezza del contenuto (non tutto il pannello) */
.mobile-cta {
  align-self: center;
  margin-top: 2rem;
  padding-inline: 3rem;
  flex-shrink: 0;
}

@media (prefers-reduced-motion: reduce) {
  .mobile-menu,
  .mobile-overlay,
  .mobile-submenu {
    transition: none;
  }
}

@media (max-width: 480px) {
  .mobile-menu {
    padding: 0 1.5rem 2rem;
  }
}

@media (max-width:1200px) {
  .nav-menu,
  .nav-container > .btn-primary {
    display: none;
  }

  .mobile-menu-btn {
    display: grid;
  }

  .logo-section :global(img) {
    width: 116px;
  }

  :global(.main-header.is-scrolled) .logo-section :global(img) {
    width: 100px;
  }
}

/* Con il menu mobile aperto il pulsante hamburger lascia il posto alla X */
:global(html.menu-aperto) .mobile-menu-btn {
  visibility: hidden;
}

@media (max-width:768px) {
  .nav-container {
    padding: 0 1.5rem;
  }
}

@media (max-width:480px) {
  .mega-menu {
    width: 100vw;
    left: 0;
  }

  .mega-menu-content {
    padding: 1rem 1.5rem;
    max-width: none;
    grid-template-columns: 1fr;
  }


  .mega-menu-section {
    border-right: none;
    border-bottom: 1px solid var(--primary-blue);
    height: auto;
    padding: .8rem 1.2rem;
  }

  .mega-menu-section:last-child {
    border-bottom: none;
  }

  .mega-menu-section .mega-titolo {
    margin-bottom: .6rem;
    padding-bottom: .3rem;
  }

  .mega-menu-section :global(li) {
    margin-bottom: .4rem;
  }

  .mega-menu-section :global(a) {
    padding: .4rem 0;
  }

}
</style>
