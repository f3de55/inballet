---
import Img from './Img.astro';
import TemaInterruttore from './TemaInterruttore.astro';
import { menu, percorsoPagina, type Menu } from '../data/navigazione';
import '../styles/components/navbar.css';

const corrente = percorsoPagina(Astro.url);
const attiva = (href: string) => href === corrente;
const menuAttivo = (m: Menu) => (m.href && attiva(m.href)) || m.sezioni.some((s) => s.voci.some((v) => attiva(v.href)));
---

<nav class="nav-container" aria-label="Navigazione principale">
    <div class="logo-section">
        <a href="/" aria-label="InBallet - Torna alla homepage">
            <Img src="logo.png" alt="InBallet" width="376" height="133" widths={[116, 150, 232, 300, 376]} sizes="(max-width: 1200px) 116px, 150px" fetchpriority="high" />
        </a>
    </div>

    <ul class="nav-menu">
        {menu.map((m) => {
            const LinkTag = m.href ? 'a' : 'button';
            return (
                <li class:list={['nav-item', { 'nav-item--compatto': m.compatto }]} data-menu={m.id}>
                    <LinkTag
                        href={m.href}
                        class:list={['nav-link', { attiva: menuAttivo(m) }]}
                        aria-current={m.href && attiva(m.href) ? 'page' : undefined}
                        aria-expanded="false"
                        aria-haspopup="true"
                    >{m.label}<i class="fas fa-chevron-down nav-chevron" aria-hidden="true"></i></LinkTag>
                    <div class:list={['mega-menu', { 'mega-menu--compatto': m.compatto }]} id={`mega-menu-${m.id}`} role="region" aria-label={`Menu ${m.label}`}>
                        <div class="mega-menu-content">
                            {m.sezioni.map((s) => (
                                <div class="mega-menu-section">
                                    {m.id === 'corsi' && <p class="mega-titolo titoletto">{s.href ? <a href={s.href}>{s.titolo}</a> : s.titolo}</p>}
                                    <ul>
                                        {s.voci.map((v) => (
                                            <li><a href={v.href} class:list={{ attiva: attiva(v.href) }} aria-current={attiva(v.href) ? 'page' : undefined}>{v.nome}</a></li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>
                </li>
            );
        })}
    </ul>

    <div class="nav-azioni">
        <a href="/contatti" class="btn-primary" aria-current={attiva('/contatti') ? 'page' : undefined}><i class="far fa-comments" aria-hidden="true"></i> Contattaci</a>
        <TemaInterruttore class="btn-icon btn-icon--nudo nav-tema" etichettaNascosta />
        <button type="button" class="btn-icon btn-icon--nudo mobile-menu-btn" id="mobileMenuBtn" aria-label="Apri menu di navigazione" aria-expanded="false" aria-controls="mobileMenu">
            <i class="fas fa-bars" aria-hidden="true"></i>
        </button>
    </div>
</nav>

<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-menu sezione-scura" id="mobileMenu" aria-hidden="true">
    <div class="mobile-menu-top">
        <div class="mobile-menu-titolo">
            <p class="eyebrow">Menu</p>
            <TemaInterruttore class="btn-icon btn-icon--nudo mobile-menu-tema" etichettaNascosta />
        </div>
        <button type="button" class="btn-icon btn-icon--nudo mobile-menu-close" id="mobileMenuClose" aria-label="Chiudi menu">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
    </div>

    {menu.map((m) => (
        <div class="mobile-nav-item">
            <button type="button" class:list={['mobile-nav-toggle', { attiva: menuAttivo(m) }]} data-target={`${m.id}-submenu`} aria-expanded="false" aria-controls={`${m.id}-submenu`}>
                <span>{m.label}</span>
                <i class="fas fa-chevron-down mobile-nav-freccia" aria-hidden="true"></i>
            </button>
            <div class="mobile-submenu" id={`${m.id}-submenu`}>
                <div class="mobile-submenu-inner">
                    {m.sezioni.map((s) => (
                        <div class="mobile-gruppo">
                            {m.id === 'corsi' && s.titolo !== m.label && <p class="mobile-gruppo-titolo titoletto">{s.href ? <a href={s.href}>{s.titolo}</a> : s.titolo}</p>}
                            <ul>
                                {s.voci.map((v) => (
                                    <li><a href={v.href} class:list={{ attiva: attiva(v.href) }} aria-current={attiva(v.href) ? 'page' : undefined}>{v.nome}</a></li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    ))}

    <a href="/contatti" class="btn-primary mobile-cta" aria-current={attiva('/contatti') ? 'page' : undefined}><i class="far fa-comments" aria-hidden="true"></i> Contattaci</a>
    <div class="mobile-menu-decoro" aria-hidden="true">
        <Img
            class="mobile-menu-scarpe"
            src="decorazioni/menu-scarpette-v2.png"
            widths={[240, 480, 640]}
            sizes="(max-width: 480px) 68vw, 256px"
            width="1254"
            height="1254"
            alt=""
            loading="lazy"
            decoding="async"
        />
    </div>
</div>
