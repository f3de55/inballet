---
import Img from './Img.astro';
import { sedi } from '../data/scuola';
import '../styles/components/sedi-mappa.css';

// Screenshot 1111 × 852, Mercator a zoom 14; origine mondo 2202115, 1499493.
// Registrazione verificata sui tasselli Google e sullo screenshot precedente.
// Civici ArcGIS StreetAddressExt (interpolati): i punti indicano gli indirizzi.
const posizioni = [
  { id: 'lainate', x: 237.624, y: 39.247, foto: 'foto/sede-lainate.jpg', alt: "L'edificio della sede di Lainate con l'insegna InBallet", fuoco: { desktop: '35% 50%' } },
  { id: 'rho', x: 468.092, y: 684.604, foto: 'foto/sede-rho.jpg', alt: "L'ingresso della sede di Rho", fuoco: { desktop: '50% 50%' } },
];
const luoghi = posizioni.map((p, i) => ({ ...p, sede: sedi.find((s) => s.id === p.id)!, numero: `0${i + 1}` }));
---

<div class="sedi-composizione">
    <figure class="sedi-mappa" aria-label="Le sedi InBallet di Lainate e Rho sulla mappa">
        <div class="sedi-mappa-tavola" data-sedi-mappa>
            <div class="sedi-mappa-viewport">
                <div class="sedi-mappa-cartografia">
                    <Img class="sedi-mappa-base" src="sedi/mappa-lainate-rho-v3.png" alt="Mappa dettagliata tra Via Puccini a Lainate e Via Tevere a Rho" width="1111" height="852" widths={[640, 900, 1111]} sizes="(max-width: 768px) 700px, (max-width: 1200px) 77vw, 877px" loading="lazy" />
                    {luoghi.map(({ sede, numero, x, y }) => (
                        <a class="sedi-mappa-punto" data-sede={sede.id} href={sede.maps} target="_blank" rel="noopener noreferrer" style={`--punto-x:${x / 1111 * 100}%;--punto-y:${y / 852 * 100}%;`} aria-label={`${sede.citta}, ${sede.via}: apri la mappa (nuova scheda)`}>
                            <span>{numero}</span>
                        </a>
                    ))}
                </div>
            </div>
            <div class="sedi-mappa-velo" aria-hidden="true"></div>
            <svg class="sedi-mappa-linee" fill="none" aria-hidden="true">
                {luoghi.map(({ id }) => (
                    <g data-collegamento={id}>
                        <path class="sedi-mappa-linea-fondo" />
                        <path class="sedi-mappa-linea" />
                    </g>
                ))}
            </svg>

            {luoghi.map(({ sede, id, foto, alt, fuoco, numero }) => (
                <a class={`sedi-mappa-foto sedi-mappa-foto--${id}`} data-sede={id} href={sede.maps} target="_blank" rel="noopener noreferrer" aria-label={`Apri su Google Maps la sede di ${sede.citta}, ${sede.via} (nuova scheda)`}>
                    <Img src={foto} alt={alt} fuoco={fuoco} width="640" height="360" widths={[400, 640, 900]} sizes="(max-width: 768px) calc(100vw - 64px), (max-width: 1200px) 27vw, 307px" loading="lazy" rapporto={9 / 16} />
                    <div class="sedi-mappa-didascalia">
                        <span class="sedi-mappa-numero" aria-hidden="true">{numero}</span>
                        <div class="sedi-mappa-dettaglio">
                            <p class="valore">{sede.citta}</p>
                            <span class="sedi-mappa-azione testo-piccolo">Vedi di più <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </figure>
</div>

<script>
    import '../scripts/sedi-mappa';
</script>
