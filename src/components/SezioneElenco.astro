---
/** Introduzione seguita da contenuti aperti, condivisa fra formazione, progetti e servizi. */
import '../styles/components/intro-split.css';
import '../styles/components/righe.css';

interface Props {
  titoloId: string;
  class?: string;
}

const { titoloId, class: className } = Astro.props;
---

<section class:list={['split-section', className]} aria-labelledby={titoloId}>
  <div class="container split-layout">
    <header class="split-header">
      <slot name="introduzione" />
    </header>
    <slot />
  </div>
</section>
