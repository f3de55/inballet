---
import Img from './Img.astro';

interface Props {
  /** Link alla pagina Sostieni (falso sulla pagina stessa). */
  link?: boolean;
}

const { link = true } = Astro.props;

const sponsors = [
  { file: 'panta-rei.png', alt: 'Panta Rei' },
  { file: 'clifford-chance.png', alt: 'Clifford Chance' },
  { file: 'banca-generali.png', alt: 'Banca Generali Private' },
  { file: 'terna.png', alt: 'Terna Rete Italia' },
  { file: 'mastrorlando.png', alt: 'Mastrorlando' },
  { file: 'santoro.png', alt: 'Santoro' },
  { file: 'tacchini.png', alt: 'Tacchini Denis' },
  { file: 'bottega-sport.png', alt: 'La Bottega dello Sport' },
];
---

<section class="sostenitori-section" aria-labelledby="sostenitori-titolo">
    <div class="intro-editoriale sostenitori-intro">
        <span class="eyebrow">Grazie a chi ci sostiene</span>
        <h2 class="titolo-sezione" id="sostenitori-titolo">I nostri <em>sostenitori</em></h2>
        <p class="intro-sezione">Il nostro lavoro è reso possibile anche grazie a chi crede nell'arte come strumento educativo.</p>
        {link && (
            <a href="/sostenitori" class="link-cta">
                Sostieni i nostri progetti
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
        )}
    </div>

    <!-- Loghi in griglia separata da filetti: i loghi hanno fondo bianco, la sezione resta bianca -->
    <div class="container">
        <ul class="sostenitori-loghi">
            {sponsors.map((s) => (
                <li>
                    <Img src={`sponsors/${s.file}`} alt={s.alt} widths={[388]} sizes="(max-width: 600px) 45vw, 280px" loading="lazy" decoding="async" />
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
.sostenitori-section {
  padding: var(--section-y) 0;
  background: var(--white);
  border-top: 1px solid rgba(26, 26, 26, 0.08);
}

.sostenitori-intro .link-cta {
  margin-top: .5rem;
}

/* Il gap da 1px sul fondo grigio disegna i filetti solo tra un logo e l'altro */
.sostenitori-loghi {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  grid-auto-rows: 9.5rem;
  gap: 1px;
  max-width: 1200px;
  margin: 3.5rem auto 0;
  background: rgba(26, 26, 26, 0.1);
}

/* Flex (non grid): così il max-height del logo si riferisce all'altezza fissa della cella */
.sostenitori-loghi li {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 0;
  padding: .75rem 1.5rem;
  background: var(--white);
}

.sostenitori-loghi :global(img) {
  display: block;
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
}

@media (max-width: 900px) {
  .sostenitori-loghi {
    margin-top: 2.5rem;
  }

  .sostenitori-loghi li {
    padding: .75rem;
  }
}

@media (max-width: 600px) {
  .sostenitori-loghi {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 6.5rem;
  }

  .sostenitori-loghi li {
    padding: .5rem .75rem;
  }
}
</style>
