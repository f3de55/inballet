---
import Img from './Img.astro';
import '../styles/components/sostenitori-section.css';

interface Props {
  /** Link alla pagina Sostieni (falso sulla pagina stessa). */
  link?: boolean;
}

const { link = true } = Astro.props;

const sponsors = [
  { file: 'panta-rei.png', alt: 'Panta Rei', href: 'https://pantareirehab.it/' },
  { file: 'clifford-chance.png', alt: 'Clifford Chance', href: 'https://www.cliffordchance.com/' },
  { file: 'banca-generali.png', alt: 'Banca Generali Private', href: 'https://www.bancageneraliprivate.it/' },
  { file: 'terna.png', alt: 'Terna Rete Italia', href: 'https://www.terna.it/it' },
  { file: 'mastrorlando.png', alt: 'Mastrorlando', href: 'https://www.mastrorlando.it/' },
  { file: 'santoro.png', alt: 'Santoro', href: 'https://www.studiodentisticosantoro.com/' },
  { file: 'tacchini.png', alt: 'Tacchini Denis', href: 'https://www.aziendaagricolatacchini.it/' },
  { file: 'bottega-sport.png', alt: 'La Bottega dello Sport', href: 'https://labottegadellosport.it/' },
];
---

<section class="sostenitori-section" aria-labelledby="sostenitori-titolo">
    <div class="intro-editoriale sostenitori-intro">
        <p class="eyebrow">Grazie a chi ci sostiene</p>
        <h2 class="titolo-sezione" id="sostenitori-titolo">I nostri <em>sostenitori</em></h2>
        <p class="intro-sezione">Aziende e realtà del territorio che credono nella danza come <strong>strumento educativo</strong> e sostengono i nostri <strong>progetti sociali</strong>, a partire da NoiConVoi.</p>
        {link && (
            <a href="/sostenitori" class="link-cta" aria-label="Sostieni i nostri progetti sociali">
                Sostienici
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
        )}
    </div>

    <!-- Loghi in griglia separata da filetti: i loghi hanno fondo bianco, la sezione resta bianca -->
    <div class="container">
        <ul class="sostenitori-loghi">
            {sponsors.map((s) => (
                <li>
                    <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Visita il sito di ${s.alt} (si apre in una nuova scheda)`}>
                        <Img src={`sponsors/${s.file}`} alt={s.alt} widths={[388]} sizes="(max-width: 600px) 45vw, 280px" loading="lazy" decoding="async" />
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
