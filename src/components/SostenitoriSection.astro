---
import Img from './Img.astro';
import '../styles/components/sostenitori-section.css';

interface Props {
  link?: boolean;
}

const { link = true } = Astro.props;

const sponsors = [
  { file: 'panta-rei', alt: 'Panta Rei', href: 'https://pantareirehab.it/' },
  { file: 'clifford-chance', alt: 'Clifford Chance', href: 'https://www.cliffordchance.com/' },
  { file: 'banca-generali', alt: 'Banca Generali Private', href: 'https://www.bancageneraliprivate.it/' },
  { file: 'terna', alt: 'Terna Rete Italia', href: 'https://www.terna.it/it' },
  { file: 'mastrorlando', alt: 'Mastrorlando', href: 'https://www.mastrorlando.it/' },
  { file: 'santoro', alt: 'Santoro', href: 'https://www.studiodentisticosantoro.com/' },
  { file: 'tacchini', alt: 'Tacchini Denis', href: 'https://www.aziendaagricolatacchini.it/' },
  { file: 'bottega-sport', alt: 'La Bottega dello Sport', href: 'https://labottegadellosport.it/' },
];
---

<section class="sostenitori-section decoro-onde" aria-labelledby="sostenitori-titolo">
    <div class="intro-editoriale sostenitori-intro">
        <p class="eyebrow">Grazie a chi ci sostiene</p>
        <h2 class="titolo-sezione" id="sostenitori-titolo">I nostri <em>sostenitori</em></h2>
        <p class="intro-sezione">Aziende e realtà che credono nella danza come <strong>strumento educativo</strong> e sostengono i nostri <strong>progetti sociali</strong>, a partire da NoiConVoi.</p>
        {link && (
            <a href="/sostenitori" class="btn-primary">
                <i class="far fa-hand-holding-heart" aria-hidden="true"></i>
                Sostienici
            </a>
        )}
    </div>

    <div class="container">
        <ul class="sostenitori-loghi">
            {sponsors.map((s) => (
                <li>
                    <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Visita il sito di ${s.alt} (si apre in una nuova scheda)`}>
                        <Img class="sostenitori-logo" src={`sponsors/${s.file}.png`} alt={s.alt} widths={[388]} sizes="(max-width: 600px) 45vw, 280px" loading="lazy" decoding="async" />
                        <Img class="sostenitori-logo-notte" src={`sponsors/${s.file}-scuro.png`} alt={s.alt} widths={[388]} sizes="(max-width: 600px) 45vw, 280px" loading="lazy" decoding="async" />
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
