---
/**
 * Statistiche del chatbot: messaggi, persone, spesa, grafici per giorno/ora e
 * domande più frequenti nel periodo selezionato; stato della catena di
 * fornitori con la verifica di qualità e le ultime conversazioni.
 */
import { CHATBOT_BUDGET_GIORNO } from 'astro:env/server';
import type { LogEntry } from '../../lib/chatbot';
import { GIORNI_CONSERVAZIONE, ultimeConversazioni } from '../../lib/chatbot/conversazioni';
import { statoCatena } from '../../lib/chatbot/fornitori';
import { paths, readJson } from '../../lib/storage';
import { mbSlice } from '../../lib/text';
import { romeDate } from '../../lib/time';
import { VERIFICHE } from '../../data/chatbot';
import DemoModal from './DemoModal.astro';

const params = Astro.url.searchParams;
const giorniFa = (n: number) => romeDate(Date.now() - n * 86400000);
const filterFrom = params.get('from') ?? giorniFa(30);
const filterTo = params.get('to') ?? romeDate();
const tuttiLog = await readJson<LogEntry[]>(paths.analytics, []);
const logs = tuttiLog.filter((l) => l.date >= filterFrom && l.date <= filterTo);
const demoNelPeriodo = logs.filter((l) => l.demo).length;

const totalMessages = logs.length;
const uniqueUsers = new Set(logs.map((l) => l.ip_hash)).size;
const cacheHitRate = totalMessages ? Math.round((logs.filter((l) => l.cached).length / totalMessages) * 100) : 0;

const perGiorno = new Map<string, number>();
const perOra = Array<number>(24).fill(0);
const domande = new Map<string, number>();
for (const log of logs) {
  perGiorno.set(log.date, (perGiorno.get(log.date) ?? 0) + 1);
  perOra[log.hour ?? 0]++;
  if (log.message && log.type !== 'blocked') {
    const q = mbSlice(log.message.trim(), 80).toLowerCase();
    domande.set(q, (domande.get(q) ?? 0) + 1);
  }
}
const giorni = [...perGiorno.keys()].sort();
const topQuestions = [...domande].sort((a, b) => b[1] - a[1]).slice(0, 10);
const charts = {
  daily: { labels: giorni.map((d) => d.slice(8, 10) + '/' + d.slice(5, 7)), data: giorni.map((d) => perGiorno.get(d)!) },
  hourly: { labels: perOra.map((_, h) => String(h)), data: perOra },
};
const fmt = new Intl.NumberFormat('it-IT');

const oggi = romeDate();
const periodi = [7, 30, 90].map((n) => ({ n, from: giorniFa(n), attivo: filterTo === oggi && filterFrom === giorniFa(n) }));
const dataIt = (d: string) => d.split('-').reverse().join('/');

// Spesa e affidabilità
const dalModello = logs.filter((l) => l.type === 'success');
const somma = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
const spesa = somma(logs.map((l) => l.costo ?? 0));
const spesaOggi = somma(tuttiLog.filter((l) => l.date === oggi && !l.demo).map((l) => l.costo ?? 0));
const costoMedio = dalModello.length ? spesa / dalModello.length : 0;
const tempi = dalModello.flatMap((l) => (l.ms ? [l.ms] : []));
const tempoMedio = tempi.length ? somma(tempi) / tempi.length / 1000 : 0;
const daRiserva = dalModello.filter((l) => (l.fallback ?? 0) > 0).length;
const senzaModello = logs.filter((l) => l.type === 'offline' || l.type === 'error').length;
const perModello = new Map<string, number>();
for (const l of dalModello) if (l.modello) perModello.set(`${l.fornitore}:${l.modello}`, (perModello.get(`${l.fornitore}:${l.modello}`) ?? 0) + 1);

const dollari = (n: number) => `${n < 0.01 && n > 0 ? n.toFixed(4) : n.toFixed(2)} $`.replace('.', ',');
const orario = (ms: number) => new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', hour: '2-digit', minute: '2-digit' }).format(ms);
const quando = (iso: string) => `${dataIt(iso.slice(0, 10))} ${iso.slice(11, 16)}`;

const catena = statoCatena();
const conversazioni = await ultimeConversazioni(20);
const etichettaTipo: Record<string, string> = { cached: 'dalla cache', offline: 'dalle FAQ, senza AI' };
---

<div class="pagina-head">
    <div>
        <h1>Chatbot</h1>
        <p class="pagina-sotto">Dal {dataIt(filterFrom)} al {dataIt(filterTo)}{demoNelPeriodo > 0 && ` · ${fmt.format(demoNelPeriodo)} messaggi demo inclusi`}</p>
    </div>
    <div class="pagina-azioni">
        <button type="button" class="btn btn-secondary" data-apri-demo><i class="fas fa-flask" aria-hidden="true"></i> Dati demo</button>
    </div>
</div>

<div class="periodo">
    <div class="filtri" role="group" aria-label="Periodo">
        {periodi.map((p) => (
            <a href={`?s=bot&from=${p.from}&to=${oggi}`} class:list={['filtro', { attivo: p.attivo }]} aria-current={p.attivo ? 'true' : undefined}>{p.n} giorni</a>
        ))}
    </div>
    <form class="periodo-date" method="GET">
        <input type="hidden" name="s" value="bot">
        <label>Dal <input type="date" name="from" value={filterFrom}></label>
        <label>al <input type="date" name="to" value={filterTo}></label>
        <button type="submit" class="btn btn-secondary">Mostra</button>
    </form>
</div>

{totalMessages === 0 ? (
    <div class="vuoto"><p>Nessun messaggio in questo periodo.</p></div>
) : (
    <>
        <dl class="numeri">
            <div class="numero">
                <dt>Messaggi</dt>
                <dd>{fmt.format(totalMessages)}</dd>
            </div>
            <div class="numero">
                <dt>Persone</dt>
                <dd>{fmt.format(uniqueUsers)}</dd>
                <dd class="numero-nota">conteggio anonimo</dd>
            </div>
            <div class="numero">
                <dt>Risposte immediate</dt>
                <dd>{cacheHitRate}%</dd>
                <dd class="numero-nota">domande già ricevute, risposta dalla cache</dd>
            </div>
        </dl>

        <dl class="numeri">
            <div class="numero">
                <dt>Spesa stimata</dt>
                <dd>{dollari(spesa)}</dd>
                <dd class="numero-nota">{dollari(costoMedio)} a risposta · oggi {dollari(spesaOggi)}{CHATBOT_BUDGET_GIORNO > 0 && ` su ${dollari(CHATBOT_BUDGET_GIORNO)}`}</dd>
            </div>
            <div class="numero">
                <dt>Tempo di risposta</dt>
                <dd>{tempoMedio.toFixed(1).replace('.', ',')} s</dd>
                <dd class="numero-nota">media delle risposte del modello</dd>
            </div>
            <div class="numero">
                <dt>Riserve usate</dt>
                <dd>{fmt.format(daRiserva + senzaModello)}</dd>
                <dd class="numero-nota">{fmt.format(daRiserva)} da un fornitore di riserva, {fmt.format(senzaModello)} dalle FAQ senza AI</dd>
            </div>
        </dl>

        <div class="pannelli" data-charts={JSON.stringify(charts)}>
            <section class="pannello">
                <h2>Messaggi per giorno</h2>
                <div class="grafico"><canvas id="chartDaily" aria-label="Messaggi per giorno" role="img"></canvas></div>
            </section>
            <section class="pannello">
                <h2>Messaggi per ora del giorno</h2>
                <div class="grafico"><canvas id="chartHourly" aria-label="Messaggi per ora del giorno" role="img"></canvas></div>
            </section>
        </div>

        <section class="pannello">
            <h2>Domande più frequenti</h2>
            {topQuestions.length === 0 ? (
                <p class="nota">Nessuna domanda nel periodo.</p>
            ) : (
                <ol class="domande">
                    {topQuestions.map(([q, c]) => (
                        <li><span class="domanda">{q}</span><span class="domanda-n">{c}</span></li>
                    ))}
                </ol>
            )}
        </section>
    </>
)}

<section class="pannello bot-sezione" aria-labelledby="catenaTitolo">
    <h2 id="catenaTitolo">Fornitori AI</h2>
    <p class="nota bot-intro">In ordine di priorità: se il primo non risponde si passa al successivo; se nessuno risponde, Étoile risponde con le FAQ. Si configurano in <code>CHATBOT_MODELLI</code> nel file <code>.env</code>.</p>
    {catena.length === 0 ? (
        <p class="nota">Nessun fornitore configurato: il chatbot risponde solo con le FAQ.</p>
    ) : (
        <ol class="catena" data-verifiche={JSON.stringify(VERIFICHE.map((v) => v.domanda))}>
            {catena.map((a, i) => (
                <li class="anello">
                    <div class="anello-riga">
                        <span class="anello-n">{i + 1}</span>
                        <div class="anello-nome">
                            <strong>{a.nome}</strong>
                            <span class="nota">{a.modello}{perModello.get(`${a.fornitore}:${a.modello}`) && ` · ${fmt.format(perModello.get(`${a.fornitore}:${a.modello}`)!)} risposte nel periodo`}</span>
                        </div>
                        {!a.attivo ? (
                            <span class="stato stato--spento">Manca la chiave API</span>
                        ) : a.sospesoFino ? (
                            <span class="stato stato--sospeso" title={a.ultimoErrore}>Sospeso fino alle {orario(a.sospesoFino)}</span>
                        ) : (
                            <span class="stato stato--ok">Attivo{a.essenziale && ' (conoscenza ridotta)'}</span>
                        )}
                        {a.attivo && (
                            <button type="button" class="btn btn-secondary anello-verifica" data-fornitore={a.fornitore} data-modello={a.modello}>Verifica</button>
                        )}
                    </div>
                    {a.ultimoErrore && a.quando && <p class="anello-errore">Ultimo errore alle {orario(a.quando)}: {a.ultimoErrore}</p>}
                    <div class="verifica" hidden aria-live="polite"></div>
                </li>
            ))}
        </ol>
    )}
</section>

<section class="pannello bot-sezione" aria-labelledby="convTitolo">
    <h2 id="convTitolo">Ultime conversazioni</h2>
    <p class="nota bot-intro">Conservate {GIORNI_CONSERVAZIONE} giorni, poi cancellate automaticamente. Le persone sono anonime.</p>
    {conversazioni.length === 0 ? (
        <p class="nota">Nessuna conversazione salvata.</p>
    ) : (
        <ul class="conversazioni">
            {conversazioni.map((c) => (
                <li>
                    <details class="conv">
                        <summary>
                            <span class="conv-quando">{quando(c.aggiornata)}</span>
                            <span class="conv-prima">{c.scambi[0].domanda}</span>
                            <span class="conv-n">{c.scambi.length} {c.scambi.length === 1 ? 'domanda' : 'domande'}</span>
                        </summary>
                        <ol class="conv-scambi">
                            {c.scambi.map((s) => (
                                <li>
                                    <p class="conv-domanda">{s.domanda}</p>
                                    <p class="conv-risposta">{s.risposta}</p>
                                    <p class="nota">{s.ora.slice(11, 16)} · {s.modello ?? etichettaTipo[s.tipo] ?? s.tipo}</p>
                                </li>
                            ))}
                        </ol>
                    </details>
                </li>
            ))}
        </ul>
    )}
</section>

<DemoModal tipo="chatbot" presenti={tuttiLog.filter((l) => l.demo).length} liberi={10000 - tuttiLog.length} />

<script>
    import { BarController, BarElement, CategoryScale, Chart, Filler, LinearScale, LineController, LineElement, PointElement } from 'chart.js';

    Chart.register(LineController, BarController, LineElement, BarElement, PointElement, CategoryScale, LinearScale, Filler);
    Chart.defaults.color = '#6a6f75';
    Chart.defaults.borderColor = '#e3e6e9';
    Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;

    type Serie = { labels: string[]; data: number[] };
    const container = document.querySelector<HTMLElement>('[data-charts]');
    if (container) {
        const { daily, hourly } = JSON.parse(container.dataset.charts!) as { daily: Serie; hourly: Serie };
        const options = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#eef0f2' } },
                x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkipPadding: 12 } },
            },
        };

        new Chart(document.querySelector<HTMLCanvasElement>('#chartDaily')!, {
            type: 'line',
            data: { labels: daily.labels, datasets: [{ label: 'Messaggi', data: daily.data, borderColor: '#4682B4', backgroundColor: 'rgba(135,206,235,.25)', fill: true, cubicInterpolationMode: 'monotone', pointRadius: 2 }] },
            options,
        });
        new Chart(document.querySelector<HTMLCanvasElement>('#chartHourly')!, {
            type: 'bar',
            data: { labels: hourly.labels, datasets: [{ label: 'Messaggi', data: hourly.data, backgroundColor: '#87CEEB', borderRadius: 3 }] },
            options,
        });
    }
</script>
