---
/**
 * Gestione eventi: elenco per mese (in programma dal più vicino, passati dal
 * più recente), filtri, ricerca e modali di modifica evento / gestione tipi.
 * Logica client in src/scripts/dashboard/eventi.ts.
 */
import { ETICHETTE_STATO, leggiEventi, leggiTipi, passato, urlEvento, type Evento } from '../../lib/eventi';
import { romeDate } from '../../lib/time';
import { sedi } from '../../data/scuola';
import EventoModal from './EventoModal.astro';
import TipiModal from './TipiModal.astro';
import DemoModal from './DemoModal.astro';

const MESI = ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre'];
const GIORNI = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];

const tipiEvento = await leggiTipi();
const tutti = await leggiEventi();
const adesso = Date.now();
const oggi = romeDate(adesso);
const domani = romeDate(adesso + 86400000);

const ordina = (a: Evento, b: Evento) => (a.data + a.ora).localeCompare(b.data + b.ora);
// Stessa regola del sito: un evento è passato quando è finito
const futuri = tutti.filter((e) => !passato(e, adesso)).sort(ordina);
const passati = tutti.filter((e) => passato(e, adesso)).sort((a, b) => ordina(b, a));
const bozze = tutti.filter((e) => e.stato === 'bozza').length;

/** Eventi raggruppati per mese, nell'ordine ricevuto. */
function perMese(lista: Evento[]) {
  const gruppi = new Map<string, Evento[]>();
  for (const e of lista) gruppi.set(e.data.slice(0, 7), [...(gruppi.get(e.data.slice(0, 7)) ?? []), e]);
  return [...gruppi].map(([k, ev]) => {
    const [y, m] = k.split('-').map(Number);
    return { titolo: `${MESI[m - 1]} ${y}`, eventi: ev };
  });
}

const giorno = (data: string) => {
  const [y, m, d] = data.split('-').map(Number);
  return { numero: d, settimana: GIORNI[new Date(Date.UTC(y, m - 1, d)).getUTCDay()] };
};

/** Valori già usati, dal più frequente: suggerimenti nei campi del modulo. */
function usati(campo: 'luogo' | 'destinatari' | 'costo') {
  const conta = new Map<string, number>();
  for (const e of tutti) {
    const v = e[campo].trim();
    if (v) conta.set(v, (conta.get(v) ?? 0) + 1);
  }
  return [...conta].sort((a, b) => b[1] - a[1]).map(([v]) => v);
}
const sediRapide = sedi.map((s) => ({ nome: s.citta, luogo: `Sede di ${s.citta}, ${s.via.replace(',', '')}` }));

const gruppi = [
  { id: 'futuri', titolo: 'In programma', mesi: perMese(futuri), n: futuri.length, passato: false },
  { id: 'passati', titolo: 'Passati', mesi: perMese(passati), n: passati.length, passato: true },
];
---

<div class="pagina-head">
    <div>
        <h1>Eventi</h1>
        <p class="pagina-sotto">
            {tutti.length
                ? `${futuri.length} in programma · ${passati.length} passati${bozze ? ` · ${bozze} ${bozze === 1 ? 'bozza' : 'bozze'}` : ''}`
                : 'Ancora nessun evento'}
        </p>
    </div>
    <div class="pagina-azioni">
        <button type="button" class="btn btn-secondary" data-apri-demo><i class="fas fa-flask" aria-hidden="true"></i> Dati demo</button>
        <a href="/spettacoli-eventi" target="_blank" rel="noopener" class="btn btn-secondary">Vedi il calendario</a>
        <button type="button" class="btn btn-primary" data-nuovo-evento><i class="fas fa-plus" aria-hidden="true"></i> Nuovo evento</button>
    </div>
</div>

{tutti.length > 0 ? (
    <>
        <div class="barra">
            <div class="filtri" role="group" aria-label="Mostra">
                <button type="button" class="filtro attivo" data-filtro="futuri" aria-pressed="true">In programma</button>
                <button type="button" class="filtro" data-filtro="passati" aria-pressed="false">Passati</button>
                <button type="button" class="filtro" data-filtro="tutti" aria-pressed="false">Tutti</button>
            </div>
            <label class="cerca">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" id="searchEventi" placeholder="Cerca un evento" aria-label="Cerca un evento" autocomplete="off">
            </label>
        </div>

        {gruppi.map((g) => (
            <section class="ev-gruppo" data-gruppo={g.id} hidden={g.id !== 'futuri'} aria-label={g.titolo}>
                <h2 class="ev-gruppo-titolo">{g.titolo} <span>{g.n}</span></h2>
                {g.n === 0 && <p class="ev-vuoto">Nessun evento {g.passato ? 'passato' : 'in programma'}.</p>}
                {g.mesi.map((mese) => (
                    <div class="ev-mese">
                        <h3>{mese.titolo}</h3>
                        <ul class="ev-lista">
                            {mese.eventi.map((ev) => {
                                const g2 = giorno(ev.data);
                                const titolo = ev.titolo;
                                const luogo = ev.luogo;
                                const vicino = g.passato ? '' : ev.data === oggi || ev.data < oggi ? (ev.dataFine ? 'In corso' : 'Oggi') : ev.data === domani ? 'Domani' : '';
                                const fino = ev.dataFine ? `fino al ${giorno(ev.dataFine).numero}/${ev.dataFine.slice(5, 7)}` : '';
                                const ore = ev.ora ? `${ev.ora}${ev.oraFine ? `–${ev.oraFine}` : ''}` : '';
                                return (
                                    <li class:list={['ev', { passato: g.passato }]} data-id={ev.id} data-modifica={JSON.stringify(ev)}
                                        data-cerca={[titolo, luogo, ev.tipo, mese.titolo, ev.stato !== 'pubblicato' ? ETICHETTE_STATO[ev.stato] : ''].join(' ').toLowerCase()}>
                                        <button type="button" class="ev-apri" data-azione="modifica">
                                            <span class="ev-data">
                                                <span class="ev-giorno">{g2.numero}</span>
                                                <span class="ev-sett">{g2.settimana}</span>
                                            </span>
                                            <span class="ev-testo">
                                                <span class="ev-titolo">
                                                    {vicino && <span class="ev-vicino">{vicino}</span>}
                                                    {ev.demo && <span class="ev-demo">Demo</span>}
                                                    {titolo}
                                                </span>
                                                <span class="ev-meta">{[ev.ora, ev.tipo, luogo].filter(Boolean).join(' · ')}{!ev.immagine && !g.passato && <span class="ev-avviso"> · senza locandina</span>}</span>
                                            </span>
                                        </button>
                                        <div class="ev-azioni">
                                            <button type="button" data-azione="modifica" aria-label={`Modifica ${titolo}`} title="Modifica"><i class="fas fa-pen" aria-hidden="true"></i></button>
                                            <button type="button" class="elimina" data-azione="elimina" aria-label={`Elimina ${titolo}`} title="Elimina"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
                                        </div>
                                    </li>
                                );
                            })}
                        </ul>
                    </div>
                ))}
            </section>
        ))}

        <p class="ev-vuoto" id="nessunRisultato" hidden>Nessun evento trovato.</p>
    </>
) : (
    <div class="vuoto">
        <p>Qui compariranno gli eventi del calendario del sito.</p>
        <button type="button" class="btn btn-primary" data-nuovo-evento><i class="fas fa-plus" aria-hidden="true"></i> Aggiungi il primo evento</button>
    </div>
)}

<EventoModal tipi={tipiEvento} sedi={sediRapide} luoghi={usati('luogo')} destinatari={usati('destinatari')} costi={usati('costo')} />
<TipiModal />
<DemoModal tipo="eventi" presenti={tutti.filter((e) => e.demo).length} />

<script type="application/json" id="tipiEventoData" set:html={JSON.stringify(tipiEvento).replace(/</g, '\\u003c')} />

<script>
    import '../../scripts/dashboard/eventi';
</script>
