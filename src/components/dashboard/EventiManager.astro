---
/**
 * Gestione eventi: statistiche, filtri, ricerca, tabella e modali di
 * modifica evento / gestione tipi. Logica client in src/scripts/dashboard/.
 */
import { eventoPerModifica, leggiEventi, leggiTipi } from '../../lib/eventi';
import { decodeHtml } from '../../lib/text';
import { eventoTimestamp } from '../../lib/time';
import EventoModal from './EventoModal.astro';
import TipiModal from './TipiModal.astro';

const tipiEvento = await leggiTipi();
const adesso = Date.now();
const eventi = (await leggiEventi())
  .sort((a, b) => b.data.localeCompare(a.data))
  .map((ev) => ({ ev, isPassato: eventoTimestamp(ev) < adesso }));
const futuri = eventi.filter((e) => !e.isPassato).length;
const passati = eventi.length - futuri;
const dataIt = (d: string) => d.split('-').reverse().join('/');
---

<div class="header">
    <h2><i class="fas fa-calendar-alt"></i> Gestione Eventi</h2>
</div>

<div style="display:flex;gap:.8rem;margin-bottom:1.5rem">
    <button type="button" class="btn btn-primary" data-nuovo-evento><i class="fas fa-plus"></i> Nuovo Evento</button>
    <a href="/spettacoli-eventi" target="_blank" class="btn btn-secondary" style="text-decoration:none"><i class="fas fa-external-link-alt"></i> Vedi Calendario</a>
</div>

{eventi.length > 0 && (
    <div class="stats">
        <div class="stat">
            <div class="stat-icon blue"><i class="fas fa-calendar"></i></div>
            <div class="stat-value">{eventi.length}</div>
            <div class="stat-label">Eventi Totali</div>
        </div>
        {futuri > 0 && (
            <div class="stat">
                <div class="stat-icon green"><i class="fas fa-clock"></i></div>
                <div class="stat-value">{futuri}</div>
                <div class="stat-label">In Programma</div>
            </div>
        )}
        {passati > 0 && (
            <div class="stat">
                <div class="stat-icon yellow"><i class="fas fa-history"></i></div>
                <div class="stat-value">{passati}</div>
                <div class="stat-label">Passati</div>
            </div>
        )}
    </div>
)}

{eventi.length > 0 ? (
    <>
        <div class="tabs" role="tablist">
            <button type="button" class="tab active" data-filtro="tutti">Tutti</button>
            {futuri > 0 && <button type="button" class="tab" data-filtro="futuri">In Programma</button>}
            {passati > 0 && <button type="button" class="tab" data-filtro="passati">Passati</button>}
        </div>

        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-list"></i> Lista Eventi</h3>
                <input type="text" id="searchEventi" placeholder="Cerca..." aria-label="Cerca eventi" style="padding:.5rem 1rem;border-radius:8px;border:1px solid #333;background:var(--bg);color:var(--text);font-size:.85rem">
            </div>
            <div class="card-body" style="padding:0">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr><th>Evento</th><th style="width:100px">Azioni</th><th>Data</th><th>Tipo</th><th>Luogo</th></tr>
                        </thead>
                        <tbody id="eventiBody">
                            {eventi.map(({ ev, isPassato }) => (
                                <tr class:list={['evento-row', isPassato ? 'passato' : 'futuro']} data-id={ev.id}>
                                    <td>
                                        <strong>{decodeHtml(ev.titolo)}</strong>
                                        {ev.ora && <><br><small style="color:var(--text-muted)"><i class="fas fa-clock"></i> {ev.ora}</small></>}
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <button type="button" class="edit" title="Modifica" data-modifica={JSON.stringify(eventoPerModifica(ev))}><i class="fas fa-edit"></i></button>
                                            <button type="button" class="delete" title="Elimina" data-elimina={ev.id} data-titolo={decodeHtml(ev.titolo)}><i class="fas fa-trash"></i></button>
                                        </div>
                                    </td>
                                    <td style="color:var(--primary)">{dataIt(ev.data)}{isPassato && <> <span class="badge badge-gray">Passato</span></>}</td>
                                    <td>{ev.tipo ? <span class="badge badge-blue">{ev.tipo}</span> : '-'}</td>
                                    <td style="color:var(--text-muted)">{ev.luogo ? decodeHtml(ev.luogo) : '-'}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </>
) : (
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <i class="fas fa-calendar-plus"></i>
                <p>Nessun evento presente</p>
                <p style="font-size:.85rem;margin-top:.5rem">Clicca "Nuovo Evento" per aggiungere il primo evento.</p>
            </div>
        </div>
    </div>
)}

<EventoModal tipi={tipiEvento} />
<TipiModal />

<script type="application/json" id="tipiEventoData" set:html={JSON.stringify(tipiEvento).replace(/</g, '\\u003c')} />

<script>
    import '../../scripts/dashboard/eventi';
</script>
