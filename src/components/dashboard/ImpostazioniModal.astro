---
import type { Impostazioni } from '../../lib/impostazioni';
import { revisioneCollegata } from '../../lib/revisione';

interface Props {
  impostazioni: Impostazioni;
}

const { impostazioni } = Astro.props;
const collegata = revisioneCollegata();
---

<div class="modal modal--impostazioni" id="modalImpostazioni" role="dialog" aria-modal="true" aria-labelledby="impostazioniTitolo">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="impostazioniTitolo">Impostazioni</h2>
            <button type="button" class="modal-close" data-chiudi-impostazioni aria-label="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
        </div>
        <form id="formImpostazioni" novalidate>
            <div class="modal-body">
                <section class="imp-riga" aria-labelledby="impEliminaTitolo">
                    <div class="imp-testo">
                        <h3 id="impEliminaTitolo">Elimina tutto</h3>
                        <small class="nota">Cancella eventi, locandine e dati del chatbot, <strong>anche quelli veri</strong>. Non si può annullare.</small>
                    </div>
                    <button type="button" class="btn btn-danger" data-apri-elimina><i class="fas fa-trash-alt" aria-hidden="true"></i> Elimina tutto…</button>
                </section>

                <section class="imp-riga" aria-labelledby="impRevisioneTitolo">
                    <div class="imp-testo">
                        <h3 id="impRevisioneTitolo">Modalità revisione</h3>
                        <small class="nota">Mentre sei collegato, ogni pagina del sito mostra <strong>Proponi un testo</strong>: testi, immagini e video finiscono in una tabella di Google Fogli, pagina per pagina, non sul sito.</small>
                    </div>
                    <label class="interruttore">
                        <input type="checkbox" role="switch" name="revisione" id="impRevisione" checked={impostazioni.revisione} aria-controls="impCampiRevisione">
                        <span>Abilita</span>
                    </label>

                    <div id="impCampiRevisione" class="imp-campi" hidden={!impostazioni.revisione}>
                        <div class="campo">
                            <label for="impFoglio">Indirizzo di Google Fogli</label>
                            <input type="url" id="impFoglio" name="foglio" value={impostazioni.foglio} placeholder="https://docs.google.com/spreadsheets/d/…" autocomplete="off" spellcheck="false">
                            <small class="nota">Se manca, la scheda «Revisione» viene creata al salvataggio.</small>
                        </div>
                        <div class="campo">
                            <label for="impCartella">Cartella di Google Drive</label>
                            <input type="url" id="impCartella" name="cartella" value={impostazioni.cartella} placeholder="https://drive.google.com/drive/folders/…" autocomplete="off" spellcheck="false">
                            <small class="nota">Per immagini e video, con una sottocartella per pagina.</small>
                        </div>
                        {!collegata && (
                            <p class="imp-avviso">
                                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                                <span>Collegamento a Google da configurare sul server: <code>GOOGLE_REVISIONE_URL</code> e <code>GOOGLE_REVISIONE_CHIAVE</code>.</span>
                            </p>
                        )}
                    </div>
                </section>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-chiudi-impostazioni>Annulla</button>
                <button type="submit" class="btn btn-primary" id="impSalva">Salva</button>
            </div>
        </form>
    </div>
</div>

<script>
    import '../../scripts/dashboard/impostazioni';
</script>
