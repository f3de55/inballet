---
/** Modale gestione tipi evento (aggiunta e rimozione). */
---

<div class="modal modal--piccola" id="modalTipi" role="dialog" aria-modal="true" aria-labelledby="modalTipiTitle">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="modalTipiTitle">Tipi di evento</h2>
            <button type="button" class="modal-close" data-chiudi-tipi aria-label="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="modal-body">
            <ul class="tipi-list" id="tipiList"></ul>
            <form class="campo tipo-nuovo" id="formTipo">
                <label for="nuovoTipo">Aggiungi un tipo</label>
                <div class="tipo-nuovo-riga">
                    <input type="text" id="nuovoTipo" placeholder="Es. Masterclass" maxlength="30" autocomplete="off">
                    <button type="submit" class="btn btn-primary">Aggiungi</button>
                </div>
            </form>
        </div>
    </div>
</div>
