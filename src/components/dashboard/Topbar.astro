---
import { actions } from 'astro:actions';
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';

interface Props {
  sezione: 'eventi' | 'documenti' | 'insegnanti' | 'bot';
}

const { sezione } = Astro.props;
const voci = [
  { id: 'eventi', label: 'Eventi' },
  { id: 'bot', label: 'Chatbot' },
  { id: 'documenti', label: 'Documenti' },
  { id: 'insegnanti', label: 'Insegnanti' },
] as const;
---

<header class="topbar">
    <div class="topbar-inner">
        <a href="/dashboard" class="topbar-logo" aria-label="Dashboard InBallet">
            <Image src={logo} alt="" width={240} format="webp" loading="eager" />
        </a>
        <nav class="topbar-nav" aria-label="Sezioni">
            {voci.map((v) => (
                <a href={`?s=${v.id}`} class:list={{ attiva: sezione === v.id }} aria-current={sezione === v.id ? 'page' : undefined}>{v.label}</a>
            ))}
        </nav>
        <div class="topbar-azioni">
            <button type="button" data-apri-impostazioni><i class="fas fa-gear" aria-hidden="true"></i><span>Impostazioni</span></button>
            <a href="/" target="_blank" rel="noopener"><i class="fas fa-external-link-alt" aria-hidden="true"></i><span>Vedi il sito</span><span class="sr-only"> (si apre in una nuova scheda)</span></a>
            <form method="POST" action={actions.auth.logout}>
                <button type="submit"><i class="fas fa-sign-out-alt" aria-hidden="true"></i><span>Esci</span></button>
            </form>
        </div>
    </div>
</header>
