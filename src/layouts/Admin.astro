---
/**
 * Layout dell'area riservata (login e dashboard): tema chiaro come il sito,
 * barra scura in alto, nessuna indicizzazione, nessuna cache.
 */
import '../styles/icons.css';
import { Font } from 'astro:assets';

interface Props {
  title: string;
}

const { title } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<!doctype html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#2a2a2a">
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <Font cssVariable="--font-rubik" />
</head>
<body>
    <slot />
</body>
</html>

<style is:global>
    :root{
        --primary:#87CEEB;--primary-dark:#4682B4;
        --bar:#2a2a2a;--bg:#f4f5f6;--surface:#fff;--soft:#eef7fa;
        --line:#e3e6e9;--line-strong:#cfd4d9;
        --text:#1a1a1a;--text-muted:#6a6f75;
        --success:#2e7d4f;--warning:#a86400;--danger:#c0392b;
        --radius:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:var(--font-rubik),'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
</style>
