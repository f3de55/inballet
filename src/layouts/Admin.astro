---
import '../styles/icons.css';
import { Font } from 'astro:assets';
import '../styles/base/variables.css';
import '../styles/base/accessibilita.css';
import '../styles/admin/variables.css';
import '../styles/admin/base.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Content-Security-Policy', "frame-ancestors 'none'");
Astro.response.headers.set('Referrer-Policy', 'same-origin');
---

<!doctype html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#2a2a2a">
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <Font cssVariable="--font-rubik" />
</head>
<body>
    <slot />
</body>
</html>
