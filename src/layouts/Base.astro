---
/**
 * Layout comune a tutte le pagine pubbliche: <head> (meta, font, CSS),
 * skip link, banner evento (Server Island), header/navbar, <main> e footer.
 */
import '../styles/icons.css';
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import { getAsset } from '../lib/images';
import Banner from '../components/Banner.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Immagine Open Graph / social (default: foto 1200x630 generata) */
  ogImage?: string;
  /** id dello skip link (la homepage usa "skip-link") */
  skipLinkId?: string;
  /** tabindex="-1" su <main> (tutte le pagine tranne il calendario eventi) */
  mainFocusable?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  skipLinkId,
  mainFocusable = true,
} = Astro.props;

// URL canonico pulito (come nella sitemap): /chi-siamo, / per la home
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site).href;
// Immagine social predefinita 1200x630 (le pagine possono passarne una propria)
const image = ogImage ?? new URL((await getImage({ src: getAsset('gallery-3.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href;
---

<!doctype html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="author" content="InBallet ASD">
    <meta name="theme-color" content="#87CEEB">
    <link rel="canonical" href={canonical}>

    <!-- Open Graph / social -->
    <meta property="og:type" content="website">
    <meta property="og:locale" content="it_IT">
    <meta property="og:site_name" content="InBallet">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={ogTitle ?? title}>
    <meta property="og:description" content={ogDescription ?? description}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle ?? title}>
    <meta name="twitter:description" content={ogDescription ?? description}>
    <meta name="twitter:image" content={image}>

    <title>{title}</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <Font cssVariable="--font-rubik" preload={[{ style: 'normal', subset: 'latin' }]} />
    <style is:inline>body{min-height:100vh}.main-header{min-height:var(--nav-h,80px)}</style>
    <slot name="head" />
</head>
<body>
    <a href="#main-content" class="skip-link" id={skipLinkId}>Salta al contenuto principale</a>

    <!-- Banner Evento Prossimo -->
    <Banner server:defer />

    <header class="main-header" role="banner">
        <Navbar />
    </header>

    <main id="main-content" role="main" tabindex={mainFocusable ? '-1' : undefined}>
        <slot />
    </main>

    <slot name="after-main" />

    <footer class="footer" role="contentinfo">
        <Footer />
    </footer>

    <!-- Fuori dal footer: il suo z-index terrebbe la chat sotto la barra del sito -->
    <Chatbot />

    <script>
        import '../scripts/navbar';
    </script>
    <slot name="scripts" />
</body>
</html>

<style>
.main-header {
  position: fixed;
  top: 0;
  width: 100%;
  background: var(--header-dark);
  z-index: 1000;
  transition: background var(--transition-base);
  box-shadow: 0 2px 20px rgba(0,0,0,.3);
  min-height: var(--nav-h);
}

.main-header.is-scrolled {
  background: rgba(42, 42, 42, 0.98);
  box-shadow: 0 4px 20px rgba(0,0,0,.4);
}

.footer {
  background: var(--dark-navy);
  color: #fff;
  /* Stessa scala della navbar: voci e testi a 14-15px */
  font-size: var(--text-nav);
  position: relative;
  z-index: 10;
  padding: 3rem 0 0;
}

@media (max-width: 1024px) {
  .footer {
    padding-top: 2rem;
  }
}

/* Mobile: illustrazione decorativa (757x2076, sfondo ~#0e0e0e) a tutta larghezza e con le
   sue proporzioni, ancorata in basso: non si stira né si ripete, qualunque sia l'altezza
   del footer (cambia con le fisarmoniche). Lo sfondo del footer è lo stesso nero
   dell'immagine e il bordo superiore sfuma, così non si vedono giunzioni. */
@media (max-width: 768px) {
  .footer {
    background: #0e0e0e;
    overflow: clip;
  }

  .footer::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: -1;
    width: 100%;
    aspect-ratio: 757 / 2076;
    background: url('/assets/images/footer-mobile.webp') center bottom / 100% 100% no-repeat;
    filter: brightness(.75);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 12%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 12%);
    pointer-events: none;
  }
}
</style>
