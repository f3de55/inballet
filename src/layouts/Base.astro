---
import '../styles/icons.css';
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import { getAsset } from '../lib/images';
import Banner from '../components/Banner.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  tipo?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  skipLinkId?: string;
  indicizza?: boolean;
  mainFocusable?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogImageAlt = 'Allievi di InBallet in sala durante una lezione di danza',
  tipo = 'WebPage',
  skipLinkId,
  indicizza = true,
  mainFocusable = true,
} = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site).href;
const image = ogImage ?? new URL((await getImage({ src: getAsset('gallery-3.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href;
const sito = new URL('/', Astro.site).href;
const pagina = {
  '@context': 'https://schema.org',
  '@type': tipo,
  '@id': `${canonical}#pagina`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'it-IT',
  isPartOf: { '@id': `${sito}#sito` },
  about: { '@id': `${sito}#scuola` },
  primaryImageOfPage: { '@type': 'ImageObject', url: image, caption: ogImageAlt },
  ...(path !== '/' && { breadcrumb: { '@id': `${canonical}#percorso` } }),
};
---

<!doctype html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="author" content="InBallet ASD">
    <meta name="robots" content={indicizza ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' : 'noindex, follow'}>
    <meta name="theme-color" content="#87CEEB">
    <link rel="canonical" href={canonical}>

    <meta property="og:type" content="website">
    <meta property="og:locale" content="it_IT">
    <meta property="og:site_name" content="InBallet">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={ogTitle ?? title}>
    <meta property="og:description" content={ogDescription ?? description}>
    <meta property="og:image" content={image}>
    <meta property="og:image:alt" content={ogImageAlt}>
    {!ogImage && <meta property="og:image:width" content="1200">}
    {!ogImage && <meta property="og:image:height" content="630">}
    <meta name="twitter:card" content="summary_large_image">

    <title>{title}</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <Font cssVariable="--font-rubik" preload={[{ style: 'normal', subset: 'latin' }]} />
    
    <script type="application/ld+json" set:html={JSON.stringify(pagina)} />
    <slot name="head" />
</head>
<body>
    <a href="#main-content" class="skip-link" id={skipLinkId}>Salta al contenuto principale</a>

    <Banner server:defer />

    <header class="main-header">
        <Navbar />
    </header>

    <main id="main-content" tabindex={mainFocusable ? '-1' : undefined}>
        <slot />
    </main>

    <slot name="after-main" />

    <footer class="footer">
        <Footer />
    </footer>

    <Chatbot />

    <script>
        import '../scripts/navbar';
    </script>
    <slot name="scripts" />
</body>
</html>
