---
/**
 * Pagine corso (22): stesso template, dati nella collection `corsi`
 * (src/content.config.ts → src/data/corsi.json). L'HTML è generato al build.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { webp } from '../lib/images';

export const getStaticPaths = (async () => {
  const corsi = await getCollection('corsi');
  return corsi.map((corso) => ({ params: { corso: corso.id }, props: { data: corso.data } }));
}) satisfies GetStaticPaths;

interface Props {
  data: CollectionEntry<'corsi'>['data'];
}

const { data } = Astro.props;
const heroBg = await webp(data.heroImage, 1920);
const contattoBg = await webp('bg-progetti-territorio.jpg', 1920);
---

<Base
    title={data.title}
    description={data.description}
    ogTitle={data.ogTitle}
    ogDescription={data.ogDescription}
>
    <link slot="head" rel="preload" as="image" href={heroBg} fetchpriority="high">

    <!-- Hero Corso -->
    <section class="corso-hero">
        <div class="corso-hero-image" id="corsoHeroImage" style={`background-image: url('${heroBg}');`}></div>
        <div class="corso-hero-overlay"></div>

        <div class="corso-hero-glass">
            <span class="corso-hero-badge" id="corsoBadge">{data.badge}</span>
            <h1 class="corso-hero-title" id="corsoTitolo">{data.titolo}</h1>
            <p class="corso-hero-tagline" id="corsoTagline">{data.tagline}</p>

            <a href="#corso-intro" class="corso-scroll-arrow" aria-label="Scorri in basso">
                <i class="fas fa-chevron-down"></i>
            </a>
        </div>
    </section>

    <!-- Intro -->
    <section id="corso-intro" class="corso-intro-section">
        <div class="container">
            <div class="corso-story-layout">
                <div class="corso-story-content">
                    <div class="corso-section-header">
                        <p class="corso-section-tagline eyebrow" id="corsoIntroTagline">Il percorso</p>
                        <h2 class="corso-section-title titolo-sezione" id="corsoIntroTitolo">Di cosa si tratta</h2>
                    </div>

                    <div class="corso-story-text" id="corsoIntroText" set:html={data.intro} />

                    <div class="corso-intro-meta">
                        <div class="corso-meta-card">
                            <div class="corso-meta-icon">
                                <i class="fas fa-child"></i>
                            </div>
                            <div class="corso-meta-info">
                                <span class="corso-meta-label">Età</span>
                                <strong id="corsoEta">{data.eta}</strong>
                            </div>
                        </div>
                        <div class="corso-meta-card">
                            <div class="corso-meta-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div class="corso-meta-info">
                                <span class="corso-meta-label">Frequenza</span>
                                <strong id="corsoFrequenza">{data.frequenza}</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="corso-story-image">
                    <Img id="corsoIntroImg" src={data.introImage} alt={data.titolo} loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" />
                </div>
            </div>
        </div>
    </section>

    <!-- Il Metodo -->
    <section class="corso-metodo-section sezione-scura">
        <div class="corso-metodo-wrapper">
            <div class="corso-metodo-header">
                <span class="corso-metodo-label eyebrow">Come lavoriamo</span>
                <h2 id="corsoMetodoTitolo" class="titolo-sezione">{data.metodoTitolo}</h2>
            </div>
            <div class="corso-metodo-list" id="corsoMetodoContent">
                {data.metodo.map((item) => (
                    <div class="corso-metodo-item">
                        <h3 set:html={item.titolo} />
                        <p set:html={item.testo} />
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Cosa Imparera -->
    <section class="corso-impara-section">
        <div class="corso-impara-wrapper">
            <div class="corso-impara-header">
                <span class="corso-impara-label eyebrow">Gli obiettivi</span>
                <h2 id="corsoImparaTitolo" class="titolo-sezione">{data.imparaTitolo}</h2>
                <p class="corso-impara-subtitle intro-sezione">Le competenze che svilupperà durante il percorso</p>
            </div>
            <ul class="corso-impara-list" id="corsoImparaGrid">
                {data.impara.map((item) => <li set:html={item} />)}
            </ul>
        </div>
    </section>

    <!-- CTA -->
    <section class="corso-contatto-section sezione-scura">
        <div class="corso-contatto-bg" style={`background-image: url('${contattoBg}')`}></div>
        <div class="corso-contatto-overlay"></div>
        <div class="corso-contatto-wrapper">
            <div class="corso-contatto-content">
                <h2 class="titolo-sezione">Prenota una lezione di prova gratuita</h2>
                <p class="intro-sezione">Vieni a conoscerci: la prima lezione è sempre senza impegno.</p>
                <a href="/contatti" class="corso-btn-cta btn-primary">
                    Contattaci per prenotare
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</Base>

<style>
.corso-hero {
  height: 65vh;
  min-height: 450px;
  max-height: 580px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 80px;
}

.corso-hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  z-index: 1;
}

.corso-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(26,26,26,0.55) 0%, rgba(42,42,42,0.45) 50%, rgba(26,26,26,0.55) 100%);
  z-index: 2;
}

.corso-hero-glass {
  position: relative;
  z-index: 3;
  text-align: center;
  max-width: 620px;
  margin: 0 2rem;
  padding: 2.5rem 3rem;
  background: rgba(135, 206, 235, 0.22);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 20px;
  border: 1px solid rgba(135, 206, 235, 0.25);
  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
  animation: fadeInUp 0.8s ease-out;
}

.corso-hero-badge {
  display: inline-block;
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--white);
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 1rem;
  text-shadow: 0 2px 8px rgba(0,0,0,0.5);
}

.corso-hero-title {
  font-size: var(--text-6xl);
  font-weight: 700;
  color: var(--white);
  margin: 0 0 1rem;
  line-height: var(--leading-tight);
  letter-spacing: -0.02em;
  text-shadow: 0 4px 12px rgba(0,0,0,0.3);
}

.corso-hero-tagline {
  font-size: var(--text-xl);
  color: rgba(255,255,255,0.9);
  margin: 0 0 1.5rem;
  line-height: 1.5;
  font-weight: 300;
}

.corso-scroll-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  color: var(--white);
  text-decoration: none;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  transition: all 0.3s;
}

.corso-scroll-arrow :global(i) {
  font-size: 1.1rem;
  animation: arrowBounce 2s ease-in-out infinite;
}

.corso-scroll-arrow:hover {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(1.1);
}

.corso-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
  position: relative;
}

.corso-story-layout {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 4rem;
  align-items: center;
  max-width: 1100px;
  margin: 0 auto;
}

.corso-story-content {
  padding: 0;
}

.corso-section-header {
  margin-bottom: 1.5rem;
}

.corso-section-tagline {
  margin-bottom: 0.5rem;
}

.corso-section-title {
  margin: 0;
}

.corso-story-text {
  max-width: 550px;
}

.corso-story-text :global(p) {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-dark);
  margin-bottom: 1.2rem;
}

.corso-story-text :global(p:last-child) {
  margin-bottom: 0;
}

.corso-story-text :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

.corso-intro-meta {
  display: flex;
  gap: 1.2rem;
  margin-top: 2rem;
}

.corso-meta-card {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  padding: 1.2rem 1.8rem;
  background: rgba(135, 206, 235, 0.12);
  border-radius: var(--radius-card);
  border: 1px solid var(--border-card);
  flex: 1;
  min-width: 180px;
}

.corso-meta-icon {
  width: 52px;
  height: 52px;
  background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-light) 100%);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(135, 206, 235, 0.3);
}

.corso-meta-icon :global(i) {
  font-size: 1.4rem;
  color: var(--dark-navy);
}

.corso-meta-info {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.corso-meta-info .corso-meta-label {
  font-size: var(--text-sm);
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 500;
}

.corso-meta-info :global(strong) {
  font-size: var(--text-lg);
  color: var(--dark-navy);
  font-weight: 700;
  line-height: 1.3;
}

.corso-story-image {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.corso-story-image :global(img) {
  width: 100%;
  max-width: 400px;
  height: 450px;
  object-fit: cover;
  border-radius: var(--radius-img);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
}

.corso-metodo-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
  position: relative;
}

.corso-metodo-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-blue) 0%, var(--primary-blue-light) 50%, var(--primary-blue) 100%);
}

.corso-metodo-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.corso-metodo-header {
  margin-bottom: 3.5rem;
  text-align: center;
}

.corso-metodo-label {
  margin-bottom: 0.5rem;
}

.corso-metodo-header :global(h2) {
  margin: 0;
}

.corso-metodo-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.corso-metodo-item {
  background: rgba(255, 255, 255, 0.03);
  border-radius: var(--radius-card);
  padding: 2rem;
  border: 1px solid var(--border-card);
  position: relative;
}

.corso-metodo-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--primary-blue);
  border-radius: 16px 16px 0 0;
}

.corso-metodo-item :global(h3) {
  font-size: var(--text-2xl);
  color: var(--white);
  margin: 0 0 1rem;
  font-weight: 700;
}

.corso-metodo-item :global(p) {
  font-size: var(--text-base);
  color: rgba(255, 255, 255, 0.75);
  margin: 0;
  line-height: 1.75;
}

.corso-impara-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
}

.corso-impara-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corso-impara-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
}

.corso-impara-header {
  margin-bottom: 2.5rem;
  text-align: center;
}

.corso-impara-label {
  margin-bottom: 0.8rem;
  display: block;
}

.corso-impara-header :global(h2) {
  margin: 0 0 1rem 0;
}

.corso-impara-subtitle {
  margin: 0;
}

.corso-impara-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem 4rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.corso-impara-list :global(li) {
  position: relative;
  padding-left: 2.5rem;
  font-size: var(--text-xl);
  color: var(--text-dark);
  line-height: 1.5;
  font-weight: 500;
}

.corso-impara-list :global(li::before) {
  content: '\f00c';
  font-family: 'Font Awesome 6 Free';
  font-weight: 900;
  position: absolute;
  left: 0;
  top: 0.25rem;
  color: var(--primary-blue-dark);
  font-size: 1.3rem;
}

@media (max-width: 1024px) {
  .corso-metodo-list {
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .corso-metodo-item {
    padding: 1.5rem;
  }
}

@media (max-width: 900px) {
  .corso-story-layout {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .corso-story-content {
    text-align: center;
    order: -1;
  }

  .corso-story-text {
    max-width: 100%;
  }

  .corso-story-image {
    justify-content: center;
  }

  .corso-story-image :global(img) {
    max-width: 100%;
    height: 350px;
    width: 100%;
    object-fit: cover;
  }

  .corso-impara-list {
    gap: 1.2rem 3rem;
  }

  .corso-metodo-list {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .corso-metodo-item {
    padding: 2rem;
  }

  .corso-intro-meta {
    flex-direction: column;
    gap: 1rem;
  }

  .corso-meta-card {
    width: 100%;
  }
}

@media (max-width: 768px) {
  .corso-hero {
    height: 60vh;
    min-height: 400px;
  }

  .corso-hero-glass {
    padding: 2rem;
    margin: 0 1.5rem;
    max-width: 500px;
  }

  .corso-hero-badge {
    font-size: var(--text-base);
    letter-spacing: 1.5px;
  }

  .corso-hero-title {
    font-size: var(--text-5xl);
  }

  .corso-hero-tagline {
    font-size: var(--text-lg);
  }

  .corso-intro-section,
  .corso-metodo-section,
  .corso-impara-section {
    padding: 4rem 0;
  }

  .corso-metodo-wrapper,
  .corso-impara-wrapper {
    padding: 0 1.5rem;
  }


  .corso-metodo-item :global(h3) {
    font-size: var(--text-xl);
  }

  .corso-impara-list {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .corso-impara-list :global(li) {
    font-size: var(--text-lg);
    padding-left: 2.2rem;
  }

  .corso-story-image :global(img) {
    height: 300px;
  }
}

@media (max-width: 480px) {
  .corso-hero {
    height: 55vh;
    min-height: 380px;
  }

  .corso-hero-glass {
    padding: 1.5rem;
    margin: 0 1rem;
    border-radius: 16px;
  }

  .corso-hero-badge {
    font-size: var(--text-sm);
    letter-spacing: 1px;
    margin-bottom: 0.8rem;
  }

  .corso-hero-title {
    font-size: var(--text-3xl);
    margin-bottom: 0.8rem;
  }

  .corso-hero-tagline {
    font-size: var(--text-base);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .corso-scroll-arrow {
    width: 38px;
    height: 38px;
  }

  .corso-intro-section,
  .corso-metodo-section,
  .corso-impara-section {
    padding: 3rem 0;
  }

  .corso-metodo-wrapper,
  .corso-impara-wrapper {
    padding: 0 1rem;
  }


  .corso-metodo-item :global(h3) {
    font-size: var(--text-lg);
    margin-bottom: 0.8rem;
  }

  .corso-section-tagline,
  .corso-metodo-label,
  .corso-impara-label {
    margin-bottom: 0.5rem;
  }

  .corso-meta-card {
    padding: 1rem 1.2rem;
    gap: 1rem;
  }

  .corso-meta-icon {
    width: 44px;
    height: 44px;
  }

  .corso-meta-icon :global(i) {
    font-size: 1.2rem;
  }

  .corso-meta-info .corso-meta-label {
    font-size: var(--text-xs);
  }

  .corso-meta-info :global(strong) {
    font-size: var(--text-base);
  }

  .corso-metodo-header {
    margin-bottom: 2rem;
  }

  .corso-metodo-item {
    padding: 1.5rem;
  }

  .corso-metodo-item :global(p) {
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .corso-impara-header {
    margin-bottom: 2rem;
  }

  .corso-impara-list :global(li) {
    font-size: var(--text-base);
    padding-left: 2rem;
    line-height: 1.5;
  }

  .corso-impara-list :global(li::before) {
    font-size: 1rem;
    top: 0.15rem;
  }

  .corso-story-image :global(img) {
    height: 260px;
    border-radius: var(--radius-img);
  }

  .corso-story-text :global(p) {
    font-size: var(--text-sm);
    line-height: 1.7;
  }
}
</style>
