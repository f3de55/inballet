---
/**
 * Pagine corso (22): stesso template, dati nella collection `corsi`
 * (src/content.config.ts → src/data/corsi.json). L'HTML è generato al build.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { webp } from '../lib/images';

export const getStaticPaths = (async () => {
  const corsi = await getCollection('corsi');
  return corsi.map((corso) => ({ params: { corso: corso.id }, props: { data: corso.data } }));
}) satisfies GetStaticPaths;

interface Props {
  data: CollectionEntry<'corsi'>['data'];
}

const { data } = Astro.props;
const heroBg = await webp(data.heroImage, 2560);
const contattoBg = await webp('bg-progetti-territorio.jpg', 1920);

/** Titolo con l'ultima parola in corsivo azzurro (stile dei titoli di sezione). */
const accento = (titolo: string) => titolo.replace(/^(.*\s)(\S+)$/, '$1<em>$2</em>');
---

<Base
    title={data.title}
    description={data.description}
    ogTitle={data.ogTitle}
    ogDescription={data.ogDescription}
>
    <link slot="head" rel="preload" as="image" href={heroBg} fetchpriority="high">

    <!-- Hero Corso -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={`background-image: url('${heroBg}');${data.heroPosizione ? ` background-position: ${data.heroPosizione};` : ''}`}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">{data.titolo}</h1>
            <p class="chisiamo-hero-tagline">{data.tagline}</p>
        </div>
    </section>

    <!-- Intro -->
    <section id="corso-intro" class="corso-intro-section">
        <div class="container">
            <div class="corso-story-layout">
                <div class="corso-story-content">
                    <div class="corso-section-header">
                        <p class="corso-section-tagline eyebrow" id="corsoIntroTagline">Il percorso</p>
                        <h2 class="corso-section-title titolo-sezione" id="corsoIntroTitolo">Di cosa <em>si tratta</em></h2>
                    </div>

                    <div class="corso-story-text" id="corsoIntroText" set:html={data.intro} />

                    <div class="corso-intro-meta">
                        <div class="corso-meta-card">
                            <div class="corso-meta-icon">
                                <i class="fas fa-child"></i>
                            </div>
                            <div class="corso-meta-info">
                                <span class="corso-meta-label">Età</span>
                                <strong id="corsoEta">{data.eta}</strong>
                            </div>
                        </div>
                        <div class="corso-meta-card">
                            <div class="corso-meta-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div class="corso-meta-info">
                                <span class="corso-meta-label">Frequenza</span>
                                <strong id="corsoFrequenza">{data.frequenza}</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="corso-story-image foto-cornice">
                    <Img id="corsoIntroImg" src={data.introImage} alt={data.titolo} loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" />
                </div>
            </div>
        </div>
    </section>

    <!-- Il Metodo -->
    <section class="corso-metodo-section sezione-scura">
        <div class="corso-metodo-wrapper">
            <div class="corso-metodo-header">
                <span class="corso-metodo-label eyebrow">Come lavoriamo</span>
                <h2 id="corsoMetodoTitolo" class="titolo-sezione" set:html={accento(data.metodoTitolo)} />
            </div>
            <div class="corso-metodo-list" id="corsoMetodoContent">
                {data.metodo.map((item) => (
                    <div class="corso-metodo-item voce">
                        <h3 class="voce-titolo" set:html={item.titolo} />
                        <p class="voce-testo" set:html={item.testo} />
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Cosa Imparera -->
    <section class="corso-impara-section">
        <div class="corso-impara-wrapper">
            <div class="corso-impara-header">
                <span class="corso-impara-label eyebrow">Gli obiettivi</span>
                <h2 id="corsoImparaTitolo" class="titolo-sezione" set:html={accento(data.imparaTitolo)} />
                <p class="corso-impara-subtitle intro-sezione">Le competenze che svilupperà durante il percorso</p>
            </div>
            <ul class="corso-impara-list" id="corsoImparaGrid">
                {data.impara.map((item) => <li set:html={item} />)}
            </ul>
        </div>
    </section>

    <!-- CTA -->
    <section class="corso-contatto-section sezione-scura">
        <div class="corso-contatto-bg" style={`background-image: url('${contattoBg}')`}></div>
        <div class="corso-contatto-overlay"></div>
        <div class="corso-contatto-wrapper">
            <div class="corso-contatto-content">
                <h2 class="titolo-sezione">Hai domande <em>su questo corso?</em></h2>
                <p class="intro-sezione">Scrivici o chiamaci: ti aiutiamo a scegliere il percorso giusto.</p>
                <a href="/contatti" class="corso-btn-cta btn-primary">
                    Contattaci
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</Base>

<style>
.corso-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
  position: relative;
}

.corso-story-layout {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 4rem;
  align-items: center;
  max-width: 1100px;
  margin: 0 auto;
}

.corso-story-content {
  padding: 0;
}

.corso-section-header {
  margin-bottom: 1.5rem;
}

.corso-section-tagline {
  margin-bottom: 0.5rem;
}

.corso-section-title {
  margin: 0;
}

.corso-story-text {
  max-width: 550px;
}

.corso-story-text :global(p) {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-dark);
  margin-bottom: 1.2rem;
}

.corso-story-text :global(p:last-child) {
  margin-bottom: 0;
}

.corso-story-text :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

.corso-intro-meta {
  display: flex;
  gap: 1.2rem;
  margin-top: 2rem;
}

.corso-meta-card {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  padding: 1.1rem 0 0;
  border-top: 1px solid rgba(26, 26, 26, 0.12);
  flex: 1;
  min-width: 180px;
}

.corso-meta-icon {
  width: 1.75rem;
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  padding-top: .15rem;
  color: var(--primary-blue-dark);
  font-size: 1.25rem;
  flex-shrink: 0;
}

.corso-meta-icon :global(i) {
  color: inherit;
}

.corso-meta-info {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.corso-meta-info .corso-meta-label {
  font-size: var(--text-sm);
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 500;
}

.corso-meta-info :global(strong) {
  font-size: var(--text-lg);
  color: var(--dark-navy);
  font-weight: 700;
  line-height: 1.3;
}

.corso-story-image {
  width: 100%;
  max-width: 400px;
  justify-self: center;
}

.corso-story-image :global(img) {
  width: 100%;
  height: 450px;
  object-fit: cover;
}

.corso-metodo-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
  position: relative;
}

.corso-metodo-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-blue) 0%, var(--primary-blue-light) 50%, var(--primary-blue) 100%);
}

.corso-metodo-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.corso-metodo-header {
  margin-bottom: 3.5rem;
  text-align: center;
}

.corso-metodo-label {
  margin-bottom: 0.5rem;
}

.corso-metodo-header :global(h2) {
  margin: 0;
}

.corso-metodo-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem 3rem;
}

.corso-impara-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
}

.corso-impara-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corso-impara-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
}

.corso-impara-header {
  margin-bottom: 2.5rem;
  text-align: center;
}

.corso-impara-label {
  margin-bottom: 0.8rem;
  display: block;
}

.corso-impara-header :global(h2) {
  margin: 0 0 1rem 0;
}

.corso-impara-subtitle {
  margin: 0;
}

.corso-impara-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem 4rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.corso-impara-list :global(li) {
  position: relative;
  padding-left: 2.5rem;
  font-size: var(--text-xl);
  color: var(--text-dark);
  line-height: 1.5;
  font-weight: 500;
}

.corso-impara-list :global(li::before) {
  content: '\f00c';
  font-family: 'Font Awesome 6 Free';
  font-weight: 900;
  position: absolute;
  left: 0;
  top: 0.25rem;
  color: var(--primary-blue-dark);
  font-size: 1.3rem;
}

@media (max-width: 1024px) {
  .corso-metodo-list {
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

}

@media (max-width: 900px) {
  .corso-story-layout {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .corso-story-content {
    text-align: center;
    order: -1;
  }

  .corso-story-text {
    max-width: 100%;
  }

  .corso-story-image {
    max-width: none;
  }

  .corso-story-image :global(img) {
    max-width: 100%;
    height: 350px;
    width: 100%;
    object-fit: cover;
  }

  .corso-impara-list {
    gap: 1.2rem 3rem;
  }

  .corso-metodo-list {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .corso-intro-meta {
    flex-direction: column;
    gap: 1rem;
  }

  .corso-meta-card {
    width: 100%;
  }
}

@media (max-width: 768px) {

  .corso-intro-section,
  .corso-metodo-section,
  .corso-impara-section {
    padding: 4rem 0;
  }

  .corso-metodo-wrapper,
  .corso-impara-wrapper {
    padding: 0 1.5rem;
  }

  .corso-impara-list {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .corso-impara-list :global(li) {
    font-size: var(--text-lg);
    padding-left: 2.2rem;
  }

  .corso-story-image :global(img) {
    height: 300px;
  }
}

@media (max-width: 480px) {

  .corso-intro-section,
  .corso-metodo-section,
  .corso-impara-section {
    padding: 3rem 0;
  }

  .corso-metodo-wrapper,
  .corso-impara-wrapper {
    padding: 0 1rem;
  }

  .corso-section-tagline,
  .corso-metodo-label,
  .corso-impara-label {
    margin-bottom: 0.5rem;
  }

  .corso-meta-card {
    padding: 1rem 0 0;
    gap: 1rem;
  }

  .corso-meta-icon :global(i) {
    font-size: 1.2rem;
  }

  .corso-meta-info .corso-meta-label {
    font-size: var(--text-xs);
  }

  .corso-meta-info :global(strong) {
    font-size: var(--text-base);
  }

  .corso-metodo-header {
    margin-bottom: 2rem;
  }

  .corso-impara-header {
    margin-bottom: 2rem;
  }

  .corso-impara-list :global(li) {
    font-size: var(--text-base);
    padding-left: 2rem;
    line-height: 1.5;
  }

  .corso-impara-list :global(li::before) {
    font-size: 1rem;
    top: 0.15rem;
  }

  .corso-story-image :global(img) {
    height: 260px;
    border-radius: var(--radius-img);
  }

  .corso-story-text :global(p) {
    font-size: var(--text-sm);
    line-height: 1.7;
  }
}
</style>
