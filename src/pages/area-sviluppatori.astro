---
import '../styles/admin/dashboard.css';
import '../styles/admin/sviluppatori.css';
import { actions } from 'astro:actions';
import Admin from '../layouts/Admin.astro';
import Conferma from '../components/dashboard/Conferma.astro';
import { isSviluppatore } from '../lib/auth';
import { modalita } from '../lib/sviluppatori/deposito';

export const prerender = false;

if (!(await isSviluppatore(Astro.session))) return Astro.redirect('/login?da=/area-sviluppatori');

const dispositivi = [
  { id: 'schermo', nome: 'Schermo intero', larghezza: 0, icona: 'fa-desktop' },
  { id: 'desktop', nome: 'Desktop', larghezza: 1440, icona: 'fa-desktop' },
  { id: 'portatile', nome: 'Portatile', larghezza: 1280, icona: 'fa-laptop' },
  { id: 'tablet', nome: 'Tablet', larghezza: 768, icona: 'fa-tablet' },
  { id: 'telefono', nome: 'Telefono', larghezza: 390, icona: 'fa-phone' },
];
const strumenti = [
  { id: 'design', nome: 'Design', icona: 'fa-layer-group', finestra: 'finDesign' },
  { id: 'contenuti', nome: 'Contenuti', icona: 'fa-image', finestra: 'finContenuti' },
  { id: 'codice', nome: 'Codice', icona: 'fa-code', finestra: 'finCodice' },
];
const configurata = modalita() !== 'assente';
---

<Admin title="Area sviluppatori - InBallet">
    <main class="sv-main" id="sv">
        <h1 class="sr-only">Area sviluppatori</h1>

        {!configurata && (
            <div class="vuoto sv-configura">
                <p>L'area non è ancora collegata al codice del sito.</p>
                <p>Su Railway aggiungi la variabile <code>GITHUB_TOKEN</code> (token GitHub con permesso «Contents: read and write» sul repository) e riavvia il servizio.</p>
                <div class="sv-configura-azioni">
                    <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
                    <button type="submit" form="svEsci" class="btn btn-secondary"><i class="fas fa-sign-out-alt" aria-hidden="true"></i> Esci</button>
                </div>
            </div>
        )}

        {configurata && (
            <>
                <div class="sv-scena" id="svScena" data-dispositivo="schermo">
                    <div class="sv-cornice" id="svCornice">
                        <iframe id="svAnteprima" title="Anteprima del sito"></iframe>
                        <div class="sv-evidenza sv-evidenza--sopra" id="svSopra" hidden></div>
                        <div class="sv-evidenza sv-evidenza--scelto" id="svScelto" hidden><span id="svSceltoNome"></span></div>
                    </div>
                </div>

                <dialog class="sv-finestra sv-finestra--lato" id="finIspettore" data-lato="destra" tabindex="-1" aria-labelledby="svIspettoreTitolo">
                    <header class="sv-finestra-testa" data-trascina>
                        <h2 id="svIspettoreTitolo">Elemento</h2>
                        <div class="sv-finestra-comandi">
                            <button type="button" class="sv-comando" data-riduci aria-expanded="true" aria-label="Riduci la finestra" title="Riduci"><i class="fas fa-minus" aria-hidden="true"></i></button>
                            <button type="button" class="sv-comando" data-chiudi aria-label="Chiudi e deseleziona" title="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
                        </div>
                    </header>
                    <div class="sv-finestra-corpo sv-scorre" id="svIspettore"></div>
                </dialog>

                <dialog class="sv-finestra sv-finestra--lato" id="finDesign" data-lato="sinistra" tabindex="-1" aria-labelledby="svDesignTitolo">
                    <header class="sv-finestra-testa" data-trascina>
                        <h2 id="svDesignTitolo">Design</h2>
                        <div class="sv-linguette" role="tablist" aria-label="Design">
                            <button type="button" role="tab" id="scheda-tema" aria-controls="vista-tema" aria-selected="true" data-strumento="tema">Tema</button>
                            <button type="button" role="tab" id="scheda-animazioni" aria-controls="vista-animazioni" aria-selected="false" tabindex="-1" data-strumento="animazioni">Animazioni</button>
                        </div>
                        <div class="sv-finestra-comandi">
                            <button type="button" class="sv-comando" data-riduci aria-expanded="true" aria-label="Riduci la finestra" title="Riduci"><i class="fas fa-minus" aria-hidden="true"></i></button>
                            <button type="button" class="sv-comando" data-chiudi aria-label="Chiudi Design" title="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
                        </div>
                    </header>
                    <div class="sv-finestra-corpo">
                        <div role="tabpanel" id="vista-tema" aria-labelledby="scheda-tema" class="sv-scorre">
                            <div class="sv-filtro">
                                <label for="svCercaToken" class="sr-only">Cerca nel tema</label>
                                <input type="search" id="svCercaToken" placeholder="Cerca colore, misura, font…" autocomplete="off">
                            </div>
                            <div id="svTema"></div>
                        </div>
                        <div role="tabpanel" id="vista-animazioni" aria-labelledby="scheda-animazioni" class="sv-scorre" hidden>
                            <div class="sv-filtro">
                                <label for="svCercaAnimazioni" class="sr-only">Cerca animazioni</label>
                                <input type="search" id="svCercaAnimazioni" placeholder="Cerca animazione, transizione o selettore…" autocomplete="off">
                            </div>
                            <div id="svAnimazioni"></div>
                        </div>
                    </div>
                </dialog>

                <dialog class="sv-finestra sv-finestra--grande" id="finContenuti" tabindex="-1" aria-labelledby="svContenutiTitolo">
                    <header class="sv-finestra-testa" data-trascina>
                        <h2 id="svContenutiTitolo">Contenuti</h2>
                        <div class="sv-linguette" role="tablist" aria-label="Contenuti">
                            <button type="button" role="tab" id="scheda-seo" aria-controls="vista-seo" aria-selected="true" data-strumento="seo">SEO</button>
                            <button type="button" role="tab" id="scheda-immagini" aria-controls="vista-immagini" aria-selected="false" tabindex="-1" data-strumento="immagini">Immagini</button>
                        </div>
                        <div class="sv-finestra-comandi">
                            <button type="button" class="sv-comando" data-chiudi aria-label="Chiudi Contenuti" title="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
                        </div>
                    </header>
                    <div class="sv-finestra-corpo">
                        <div role="tabpanel" id="vista-seo" aria-labelledby="scheda-seo" class="sv-scorre sv-largo">
                            <div class="sv-riga-comandi">
                                <button type="button" class="btn btn-primary" id="svSeoControlla"><i class="fas fa-magnifying-glass" aria-hidden="true"></i> Controlla tutte le pagine</button>
                                <small class="sv-spiega">Titolo ≤ 60 caratteri, descrizione ≤ 160, un solo h1, alt dell'immagine social.</small>
                            </div>
                            <div class="sv-collegamenti" id="svSeoFile"></div>
                            <div id="svSeo"></div>
                        </div>
                        <div role="tabpanel" id="vista-immagini" aria-labelledby="scheda-immagini" class="sv-scorre sv-largo" hidden>
                            <div class="sv-riga-comandi">
                                <div class="sv-filtro sv-filtro--riga">
                                    <label for="svCercaImmagini" class="sr-only">Cerca immagini</label>
                                    <input type="search" id="svCercaImmagini" placeholder="Cerca per nome o cartella…" autocomplete="off">
                                </div>
                                <label class="btn btn-primary sv-carica">
                                    <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i> Aggiungi immagini
                                    <input type="file" id="svNuoveImmagini" accept="image/*" multiple class="sr-only">
                                </label>
                            </div>
                            <div class="sv-immagini" id="svImmagini"></div>
                        </div>
                    </div>
                </dialog>

                <dialog class="sv-finestra sv-finestra--grande" id="finCodice" tabindex="-1" aria-labelledby="svCodiceTitolo">
                    <header class="sv-finestra-testa" data-trascina>
                        <h2 id="svCodiceTitolo">Codice</h2>
                        <code class="sv-finestra-file" id="svFileNome"></code>
                        <div class="sv-finestra-comandi">
                            <button type="button" class="sv-comando" data-chiudi aria-label="Chiudi Codice" title="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
                        </div>
                    </header>
                    <div class="sv-finestra-corpo sv-file">
                        <div class="sv-file-lato">
                            <div class="sv-filtro">
                                <label for="svFiltroFile" class="sr-only">Filtra i file</label>
                                <input type="search" id="svFiltroFile" placeholder="Filtra i file…" autocomplete="off">
                            </div>
                            <div class="sv-filtro">
                                <label for="svCercaCodice" class="sr-only">Cerca nel codice</label>
                                <input type="search" id="svCercaCodice" placeholder="Cerca nel codice (Invio)…" autocomplete="off">
                            </div>
                            <div class="sv-file-comandi">
                                <button type="button" class="btn btn-secondary" id="svNuovoFile"><i class="fas fa-plus" aria-hidden="true"></i> Nuovo</button>
                                <label class="btn btn-secondary sv-carica">
                                    <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i> Carica
                                    <input type="file" id="svCaricaFile" class="sr-only">
                                </label>
                            </div>
                            <div class="sv-albero" id="svAlbero"></div>
                        </div>
                        <div class="sv-file-corpo">
                            <div class="sv-file-azioni" id="svFileAzioni" hidden>
                                <button type="button" class="btn btn-primary" id="svFileSalva" disabled><i class="fas fa-check" aria-hidden="true"></i> Salva</button>
                                <button type="button" class="btn btn-secondary" id="svFileRinomina">Rinomina</button>
                                <a class="btn btn-secondary" id="svFileScarica" href="/area-sviluppatori" download><i class="fas fa-download" aria-hidden="true"></i> Scarica</a>
                                <button type="button" class="btn btn-secondary btn-icona" id="svFileElimina" aria-label="Elimina il file" title="Elimina il file"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
                            </div>
                            <div class="sv-editor" id="svEditor"><p class="sv-spiega sv-editor-vuoto">Scegli un file a sinistra.</p></div>
                        </div>
                    </div>
                </dialog>

                <dialog class="sv-finestra sv-finestra--grande" id="finPubblica" tabindex="-1" aria-labelledby="svPubblicaTitolo">
                    <header class="sv-finestra-testa" data-trascina>
                        <h2 id="svPubblicaTitolo">Pubblica</h2>
                        <div class="sv-finestra-comandi">
                            <button type="button" class="sv-comando" data-chiudi aria-label="Chiudi Pubblica" title="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
                        </div>
                    </header>
                    <div class="sv-finestra-corpo sv-pubblica">
                        <div class="sv-scorre">
                            <h3 class="sv-titolo">Modifiche da pubblicare</h3>
                            <small class="sv-spiega" id="svModo"></small>
                            <ul class="sv-modifiche" id="svModifiche"></ul>
                            <form class="sv-invia" id="svInvia">
                                <div class="campo">
                                    <label for="svMessaggio">Cosa hai cambiato</label>
                                    <input id="svMessaggio" maxlength="300" placeholder="Es. Nuovo colore dei pulsanti" autocomplete="off">
                                </div>
                                <button type="submit" class="btn btn-primary" id="svPubblica"><i class="fas fa-paper-plane" aria-hidden="true"></i> Pubblica sul sito</button>
                            </form>
                            <p class="sv-online" id="svOnline" role="status" aria-live="polite"></p>
                            <h3 class="sv-titolo">Ultime pubblicazioni</h3>
                            <ul class="sv-storia" id="svStoria"></ul>
                        </div>
                        <div class="sv-differenza">
                            <h3 class="sv-titolo" id="svDiffNome">Differenze</h3>
                            <pre id="svDiff" tabindex="0"><code>Scegli un file per vedere cosa cambia.</code></pre>
                        </div>
                    </div>
                </dialog>

                <div class="sv-menu" id="svVistaMenu" popover aria-label="Vista">
                    <small class="sv-menu-titolo" id="svLarghezzeTitolo">Larghezza</small>
                    <div class="sv-menu-gruppo" role="group" aria-labelledby="svLarghezzeTitolo">
                        {dispositivi.map((d, i) => (
                            <button type="button" class="sv-menu-voce" data-dispositivo={d.id} data-nome={d.nome} data-larghezza={d.larghezza} data-icona={d.icona} aria-pressed={i === 0 ? 'true' : 'false'}>
                                <i class={`fas ${d.icona}`} aria-hidden="true"></i>
                                {d.nome}
                                <small>{d.larghezza ? `${d.larghezza} px` : 'finestra'}</small>
                            </button>
                        ))}
                    </div>
                    <small class="sv-menu-titolo" id="svTemiTitolo">Tema dell'anteprima</small>
                    <div class="sv-menu-gruppo" role="group" aria-labelledby="svTemiTitolo">
                        <button type="button" class="sv-menu-voce" data-tema-anteprima="chiaro" aria-pressed="true"><i class="fas fa-sun" aria-hidden="true"></i> Chiaro</button>
                        <button type="button" class="sv-menu-voce" data-tema-anteprima="scuro" aria-pressed="false"><i class="fas fa-moon" aria-hidden="true"></i> Scuro</button>
                    </div>
                    <div class="sv-menu-gruppo sv-menu-gruppo--fine">
                        <button type="button" class="sv-menu-voce" id="svRicarica"><i class="fas fa-arrows-rotate" aria-hidden="true"></i> Ricarica l'anteprima</button>
                    </div>
                </div>
            </>
        )}
    </main>

    {configurata && (
        <nav class="sv-dock" id="svDock" aria-label="Strumenti sviluppatori">
            <button type="button" class="sv-dock-voce sv-dock-pagina" id="svPagina" aria-haspopup="dialog" title="Cerca una pagina">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <span class="sr-only">Cerca una pagina. Pagina attuale: </span>
                <code id="svPercorso">/</code>
            </button>
            <button type="button" class="sv-dock-voce" id="svVista" popovertarget="svVistaMenu" aria-label="Vista: larghezza e tema dell'anteprima" title="Larghezza e tema">
                <i class="fas fa-desktop" id="svVistaIcona" aria-hidden="true"></i>
                <small id="svVistaLarghezza"></small>
                <i class="fas fa-sun" id="svVistaTema" aria-hidden="true"></i>
            </button>
            <div class="sv-dock-segmento" role="group" aria-label="Modalità">
                <button type="button" class="sv-dock-voce" data-modo="modifica" aria-pressed="true" title="Clicca un elemento per modificarlo"><i class="fas fa-pen" aria-hidden="true"></i><span class="sv-dock-testo">Modifica</span></button>
                <button type="button" class="sv-dock-voce" data-modo="naviga" aria-pressed="false" title="Usa il sito e i suoi link"><i class="fas fa-route" aria-hidden="true"></i><span class="sv-dock-testo">Naviga</span></button>
            </div>
            <span class="sv-dock-separatore" aria-hidden="true"></span>
            {strumenti.map((s) => (
                <button type="button" class="sv-dock-voce" data-apri={s.id} aria-controls={s.finestra} aria-expanded="false">
                    <i class={`fas ${s.icona}`} aria-hidden="true"></i><span class="sv-dock-testo">{s.nome}</span>
                </button>
            ))}
            <span class="sv-dock-separatore" aria-hidden="true"></span>
            <button type="button" class="sv-dock-voce sv-dock-pubblica" data-apri="pubblica" aria-controls="finPubblica" aria-expanded="false">
                <i class="fas fa-paper-plane" aria-hidden="true"></i><span class="sv-dock-testo">Pubblica</span>
                <span class="sv-conteggio" id="svConteggio" hidden></span>
            </button>
            <button type="button" class="sv-dock-voce" popovertarget="svAltroMenu" aria-label="Altro" title="Dashboard, sito, esci"><i class="fas fa-ellipsis" aria-hidden="true"></i></button>
        </nav>

        <div class="sv-menu" id="svAltroMenu" popover aria-label="Altro">
            <div class="sv-menu-gruppo">
                <a href="/dashboard" class="sv-menu-voce"><i class="fas fa-gear" aria-hidden="true"></i> Dashboard</a>
                <a href="/" class="sv-menu-voce" target="_blank" rel="noopener"><i class="fas fa-external-link-alt" aria-hidden="true"></i> Il sito<span class="sr-only"> (si apre in una nuova scheda)</span></a>
            </div>
            <div class="sv-menu-gruppo sv-menu-gruppo--fine">
                <button type="submit" form="svEsci" class="sv-menu-voce"><i class="fas fa-sign-out-alt" aria-hidden="true"></i> Esci</button>
            </div>
        </div>

        <dialog class="sv-palette" id="svPalette" aria-label="Cerca una pagina">
            <div class="sv-palette-campo">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="svPaletteCampo" role="combobox" aria-expanded="true" aria-controls="svPaletteRisultati" aria-autocomplete="list" aria-label="Cerca una pagina" placeholder="Cerca una pagina… oppure /indirizzo" autocomplete="off" spellcheck="false">
            </div>
            <ul class="sv-palette-risultati" id="svPaletteRisultati" role="listbox" aria-label="Risultati"></ul>
        </dialog>
    )}

    <form id="svEsci" method="POST" action={actions.auth.logout} hidden></form>

    <dialog class="conferma sv-chiedi" id="svChiedi" aria-labelledby="svChiediTitolo">
        <form method="dialog">
            <h2 id="svChiediTitolo"></h2>
            <div class="campo">
                <label for="svChiediCampo" id="svChiediEtichetta"></label>
                <input id="svChiediCampo" autocomplete="off" spellcheck="false">
            </div>
            <div class="conferma-azioni">
                <button type="submit" value="no" class="btn btn-secondary" formnovalidate>Annulla</button>
                <button type="submit" value="si" class="btn btn-primary">Conferma</button>
            </div>
        </form>
    </dialog>
    <Conferma />
</Admin>

{configurata && (
    <script>
        import '../scripts/sviluppatori/index';
    </script>
)}
