---
import { ANNI_ATTIVITA, categorieCorsi, FONDAZIONE, sedi } from '../data/scuola';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondo } from '../lib/images';

const bg = {
  hero: await sfondo('gallery-7.jpg', { desktop: '50% 40%', tablet: '50% 55%' }),
  cta: await sfondo('bg-progetti-territorio.jpg', { desktop: '50% 35%' }),
};


/** Insegnanti (sezione team, mostrata solo se l'elenco non è vuoto): solo persone e bio reali. */
const team: { nome: string; ruolo: string; bio: string; foto: string }[] = [];

const [lainate, rho] = sedi;

// Sedi: foto e frase per ciascuna (indirizzo e link alla mappa da src/data/scuola.ts)
const sediFoto = [
  { sede: lainate, foto: 'gallery-4.jpg', alt: 'Lezione in una sala della sede di Lainate', testo: 'La sede principale: corsi per tutte le età, dai primi passi ai livelli avanzati.' },
  { sede: rho, foto: 'gallery-9.jpg', alt: 'Allieve in sala nella sede di Rho', testo: 'Lo stesso metodo della sede centrale, vicino alle famiglie di Rho e dintorni.' },
];
const totaleCorsi = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);
---

<Base
    title="Chi siamo: scuola di danza multidisciplinare | InBallet"
    description={`Scuola di danza multidisciplinare a Lainate e Rho fondata nel ${FONDAZIONE} da Ilenia Nobile: corsi dai 3 anni, inclusione e formazione insegnanti CSEN e CONI.`}
    ogTitle="Chi siamo | InBallet"
    ogDescription={`La storia e la visione di InBallet, scuola di danza a Lainate e Rho dal ${FONDAZIONE}: un luogo di vita aperto a tutte le età.`}
>

        <!-- Hero Chi Siamo -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">La nostra storia</h1>
                <p class="chisiamo-hero-tagline">Dal {FONDAZIONE} a Lainate e Rho: una scuola di danza multidisciplinare, inclusiva e aperta a tutte le età.</p>
            </div>
        </section>

        <!-- Fondatrice Section -->
        <section id="fondatrice" class="fondatrice-section">
            <div class="container">
                <div class="fondatrice-layout">
                    <div class="fondatrice-visual">
                        <div class="fondatrice-image-wrapper foto-cornice foto-cornice--sinistra">
                            <Img src="ilenia.jpg" alt="Ilenia Nobile, Fondatrice e Direttrice Artistica di InBallet" loading="lazy" />
                        </div>
                    </div>
                    <div class="fondatrice-content">
                        <span class="fondatrice-label eyebrow">Fondatrice & Direttrice Artistica</span>
                        <h2 class="fondatrice-name titolo-sezione">Ilenia <em>Nobile</em></h2>
                        <div class="fondatrice-bio">
                            <p>Ilenia Nobile ha fondato I.N. Ballet nel {FONDAZIONE} e ne è la Direttrice Artistica: una scuola di danza multidisciplinare, oggi con due sedi a Lainate e Rho, in cui la danza è accessibile a tutti.</p>
                            <p>Nel 2013 ha dato vita al progetto NoiConVoi, convinta che ognuno, secondo le proprie possibilità, possa portare il suo contributo artistico.</p>
                        </div>
                        <blockquote class="fondatrice-citazione">
                            <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                            <cite>Ilenia Nobile</cite>
                        </blockquote>
                    </div>
                </div>
            </div>
        </section>

        <!-- La scuola: intestazione editoriale con la visione -->
        <section class="scuola-section" aria-labelledby="scuola-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">La scuola</span>
                <h2 class="titolo-sezione" id="scuola-titolo">Un luogo <em>di vita</em></h2>
                <p>Dalla tecnica classica alle danze urbane: ogni giorno bambini dai 3 anni, ragazzi e adulti frequentano le sale, in classi divise per livello fino ai corsi avanzati.</p>
                <p>Ai professionisti la scuola propone <a href="/formazioni-personalizzate">corsi di formazione</a> per educatori, terapeuti e pedagogisti ed è un punto di riferimento per la <a href="/formazione-insegnanti">formazione nazionale dei maestri di danza</a>.</p>
                <p>Dal 2013 il <a href="/progetto-noiconvoi">progetto NoiConVoi</a> accoglie in sala ragazzi con disabilità, con supporto psicomotorio e un team di volontari.</p>
                <div class="scuola-highlight">
                    <p>Una comunità educante, in dialogo con le famiglie, che vede nella danza uno strumento di espressione, comunicazione e conoscenza.</p>
                </div>
            </div>
        </section>

        <!-- Timeline della storia -->
        <section class="storia-section">
            <div class="container">
                <div class="storia-header">
                    <span class="storia-label eyebrow">Il nostro percorso</span>
                    <h2 class="storia-title titolo-sezione">Dal {FONDAZIONE} <em>a oggi</em></h2>
                </div>
                <ol class="timeline">
                    <li class="voce">
                        <span class="voce-anno">{FONDAZIONE}</span>
                        <h3 class="voce-titolo">La fondazione</h3>
                        <p class="voce-testo">Ilenia Nobile fonda a Lainate I.N. Ballet, scuola di danza multidisciplinare.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2013</span>
                        <h3 class="voce-titolo">Nasce NoiConVoi</h3>
                        <p class="voce-testo">Il progetto di volontariato che accoglie in sala ragazzi con disabilità, con supporto psicomotorio.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2023</span>
                        <h3 class="voce-titolo">Ente formativo</h3>
                        <p class="voce-testo">Riconoscimento per il titolo di Insegnante di Danza, valido CSEN e CONI a livello nazionale.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2024</span>
                        <h3 class="voce-titolo">Volontariato d'impresa</h3>
                        <p class="voce-testo">Aziende ed enti entrano nei progetti sociali con i loro volontari.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">Oggi</span>
                        <h3 class="voce-titolo">Due sedi, ogni età</h3>
                        <p class="voce-testo">Lainate e Rho, {totaleCorsi} corsi dai 3 anni all'età adulta e uno spettacolo in teatro ogni anno.</p>
                    </li>
                </ol>
            </div>
        </section>

        <!-- InBallet in Numeri: intestazione editoriale, sotto i quattro numeri in fila -->
        <section class="numeri-section sezione-scura" aria-labelledby="numeri-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">In sintesi</span>
                <h2 class="titolo-sezione" id="numeri-titolo">InBallet <em>in numeri</em></h2>
                <p class="intro-sezione">Dai primi passi a 3 anni fino all'età adulta.</p>
            </div>
            <div class="container">
                <dl class="numeri-grid">
                    <div class="numero-item">
                        <dt class="numero-label">Anni di danza</dt>
                        <dd class="numero-value-wrapper"><span class="numero-value" data-target={ANNI_ATTIVITA}>{ANNI_ATTIVITA}</span></dd>
                        <dd class="numero-nota">Dal {FONDAZIONE}</dd>
                    </div>
                    <div class="numero-item">
                        <dt class="numero-label">Corsi</dt>
                        <dd class="numero-value-wrapper"><span class="numero-value" data-target={totaleCorsi}>{totaleCorsi}</span></dd>
                        <dd class="numero-nota">In {categorieCorsi.length} percorsi</dd>
                    </div>
                    <div class="numero-item">
                        <dt class="numero-label">Età per iniziare</dt>
                        <dd class="numero-value-wrapper"><span class="numero-value" data-target="3">3</span></dd>
                        <dd class="numero-nota">Anni compiuti</dd>
                    </div>
                    <div class="numero-item">
                        <dt class="numero-label">Sedi</dt>
                        <dd class="numero-value-wrapper"><span class="numero-value" data-target="2">2</span></dd>
                        <dd class="numero-nota">{lainate.citta} e {rho.citta}</dd>
                    </div>
                </dl>
                <a href="/corsi" class="link-cta numeri-cta">
                    Scopri i corsi
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </section>

        <!-- Team Professionisti -->
        {team.length > 0 && (
        <section class="team-section">
            <div class="container">
                <div class="team-header">
                    <span class="team-label eyebrow">Il nostro team</span>
                    <h2 class="team-title titolo-sezione">I professionisti <em>di InBallet</em></h2>
                    <p class="team-subtitle intro-sezione">Insegnanti qualificati, uniti dalla passione per la danza.</p>
                </div>
                <!-- Desktop: nomi a destra, foto e bio del selezionato a sinistra.
                     Tablet/mobile: fisarmonica, il pannello si apre sotto il nome -->
                <ul class="team-roster" style={`--persone: ${team.length}`}>
                    {team.map((p, i) => (
                        <li class="team-persona">
                            <button type="button" class="team-voce" id={`team-voce-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`team-pannello-${i}`}>
                                <span class="team-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                                <span class="team-voce-testo">
                                    <span class="team-voce-nome">{p.nome}</span>
                                    <span class="team-voce-ruolo">{p.ruolo}</span>
                                </span>
                                <i class="fas fa-plus" aria-hidden="true"></i>
                            </button>
                            <div class="team-pannello" id={`team-pannello-${i}`} role="region" aria-labelledby={`team-voce-${i}`} hidden={i !== 0}>
                                <div class="team-foto">
                                    <Img src={p.foto} alt={p.nome} loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
                                </div>
                                <div class="team-pannello-testo">
                                    <span class="team-role">{p.ruolo}</span>
                                    <h3 class="team-nome">{p.nome}</h3>
                                    <p class="team-bio">{p.bio}</p>
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
        )}

        <!-- Carosello Sede Fullwidth -->
        <!-- Sedi: intestazione editoriale e le due sedi affiancate (foto, città, indirizzo, indicazioni) -->
        <section class="sede-section" aria-labelledby="sedi-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">I nostri spazi</span>
                <h2 class="titolo-sezione" id="sedi-titolo">Le nostre <em>sale</em></h2>
                <p class="intro-sezione">Due sedi a nord-ovest di Milano, a Lainate e a Rho.</p>
            </div>
            <div class="container">
                <div class="sedi">
                    {sediFoto.map(({ sede, foto, alt, testo }) => (
                        <article class="sede">
                            <figure class="sede-foto">
                                <Img src={foto} alt={alt} loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 560px" />
                            </figure>
                            <div class="sede-testo">
                                <p class="sede-tipo">{sede.titolo}</p>
                                <h3 class="sede-nome">{sede.citta}</h3>
                                <p class="sede-descrizione">{testo}</p>
                                <address class="sede-indirizzo">
                                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                    {sede.via} · {sede.cap} {sede.citta} ({sede.provincia})
                                </address>
                                <a href={sede.maps} target="_blank" rel="noopener" class="link-cta sede-cta">
                                    Indicazioni
                                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- CTA Finale - Stesso stile template corsi -->
        <section class="corso-contatto-section sezione-scura">
            <div class="corso-contatto-bg" style={bg.cta.style}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2 class="titolo-sezione">Vuoi conoscerci <em>meglio?</em></h2>
                    <p class="intro-sezione">Scrivici o chiamaci: ti raccontiamo corsi, orari e sedi.</p>
                    <a href="/contatti" class="corso-btn-cta btn-primary">
                        Contattaci <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

    <Fragment slot="scripts">
    <script>
        import '../scripts/chi-siamo';
    </script>
    </Fragment>
</Base>

<style>
.fondatrice-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.fondatrice-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

.fondatrice-visual {
  position: relative;
}

.fondatrice-image-wrapper {
  max-width: 480px;
}

.fondatrice-image-wrapper :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.fondatrice-content {
  padding: 0;
}

.fondatrice-label {
  display: block;
  margin-bottom: 1rem;
}

.fondatrice-name {
  margin: 0 0 0.5rem;
}

.fondatrice-citazione {
  margin: 2rem 0 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.fondatrice-citazione p {
  font-size: var(--text-base);
  font-style: italic;
  line-height: 1.6;
  color: var(--dark-navy);
}

.fondatrice-citazione cite {
  display: block;
  margin-top: .5rem;
  font-size: var(--text-sm);
  font-style: normal;
  font-weight: 600;
  color: var(--text-light);
}

.fondatrice-bio :global(p) {
  font-size: var(--text-base);
  color: var(--text-dark);
  line-height: 1.8;
  margin-bottom: 1.5rem;
}

.fondatrice-bio :global(p:last-child) {
  margin-bottom: 0;
}

.scuola-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.storia-section {
  padding: var(--section-y) 0;
  background: var(--white);
  position: relative;
  overflow: hidden;
}

.storia-header {
  text-align: center;
  margin-bottom: 4rem;
}

.timeline {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem 3.5rem;
}

@media (max-width: 900px) {
  .timeline {
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2rem;
  }
}

@media (max-width: 520px) {
  .timeline {
    gap: 2rem 1.25rem;
  }

  .timeline :global(.voce-anno) {
    font-size: var(--text-2xl);
  }

  .timeline :global(.voce-titolo) {
    font-size: var(--text-base);
  }

  .timeline :global(.voce-testo) {
    font-size: var(--text-sm);
  }
}

.storia-label {
  display: block;
  margin-bottom: 1rem;
}

.storia-title {
  margin: 0;
}

/* ---------- InBallet in numeri ---------- */
.numeri-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
}

/* Centrato sotto i numeri come l'intestazione; a sinistra sotto i 900px */
.numeri-cta {
  display: flex;
  width: fit-content;
  margin: 2.5rem auto 0;
  color: var(--white);
}

.numeri-cta:hover {
  color: var(--primary-blue);
  border-color: var(--primary-blue);
}

/* Quattro numeri in fila (2x2 sotto i 900px): il gap da 1px sul fondo chiaro
   disegna i filetti solo tra le celle */
.numeri-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1px;
  margin: 3.5rem 0 0;
  background: rgba(255, 255, 255, 0.14);
}

.numero-item {
  display: flex;
  flex-direction: column;
  padding: 2.25rem 2.5rem;
  background: var(--dark-navy);
}

.numero-label {
  order: 2;
  margin-top: .9rem;
  font-size: var(--text-base);
  font-weight: 400;
  color: var(--white);
}

.numero-value-wrapper {
  order: 1;
  margin: 0;
  line-height: 1;
}

.numero-value {
  font-size: var(--text-5xl);
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--white);
  font-variant-numeric: tabular-nums;
}

.numero-suffix {
  margin-left: .1em;
  font-size: var(--text-3xl);
  font-weight: 300;
  line-height: 1;
  color: var(--primary-blue);
}

.numero-nota {
  order: 3;
  margin: .3rem 0 0;
  font-size: var(--text-sm);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.6);
}

@media (max-width: 900px) {
  .numeri-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.5rem;
  }

  .numeri-cta {
    margin-left: 0;
  }

  /* Colonna sinistra dei numeri allineata al testo sopra */
  .numero-item:nth-child(odd) {
    padding-left: 0;
  }
}

@media (max-width: 600px) {
  .numero-item {
    padding: 1.5rem 1.25rem;
  }



  .numero-label {
    margin-top: .6rem;
  }

}

.team-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.team-header {
  margin-bottom: 3rem;
  max-width: 44rem;
}

.team-label {
  display: block;
  margin-bottom: 1rem;
}

.team-title {
  margin: 0 0 1rem;
}

.team-subtitle {
  margin: 0;
}

/* Team come "roster": desktop elenco di nomi a destra e pannello del selezionato a
   sinistra (tutti i pannelli occupano la stessa cella, si vede solo l'attivo);
   sotto i 900px fisarmonica con il pannello che si apre sotto il nome */
.team-roster {
  list-style: none;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
  grid-template-rows: repeat(var(--persone), auto) 1fr;
  column-gap: 5rem;
}

.team-persona:first-child .team-voce {
  border-top: 1px solid rgba(26, 26, 26, 0.12);
}

.team-persona {
  display: contents;
}

.team-voce {
  grid-column: 2;
  display: grid;
  grid-template-columns: 2.5rem minmax(0, 1fr) auto;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 1.25rem 0;
  border: none;
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
  background: none;
  font: inherit;
  text-align: left;
  color: var(--dark-navy);
  cursor: pointer;
}

.team-num {
  font-size: var(--text-sm);
  font-weight: 300;
  color: var(--primary-blue-dark);
}

.team-voce-testo {
  display: flex;
  flex-direction: column;
  gap: .2rem;
}

.team-voce-nome {
  font-size: var(--text-xl);
  font-weight: 600;
  line-height: 1.25;
  transition: color .3s ease;
}

.team-voce-ruolo {
  font-size: var(--text-sm);
  color: var(--text-light);
}

/* Desktop: niente icona, il selezionato si riconosce dal colore */
.team-voce i {
  display: none;
  place-items: center;
  width: 1em;
  height: 1em;
  line-height: 1;
  font-size: var(--text-sm);
  color: var(--primary-blue-dark);
  transition: transform .3s ease;
}

.team-voce[aria-expanded="true"] .team-num {
  font-weight: 600;
}

/* Desktop: il nome attivo è evidenziato e la croce diventa una freccia verso il pannello */
.team-voce[aria-expanded="true"] .team-voce-nome {
  color: var(--primary-blue-dark);
}

.team-voce[aria-expanded="true"] i {
  transform: rotate(45deg);
}

@media (hover: hover) and (pointer: fine) {
  .team-voce:hover .team-voce-nome {
    color: var(--primary-blue-dark);
  }
}

.team-pannello {
  grid-column: 1;
  grid-row: 1 / -1;
  align-self: start;
}

.team-pannello[hidden] {
  display: none;
}

.team-foto {
  overflow: hidden;
  border-radius: var(--radius-img);
  margin-bottom: 1.75rem;
}

.team-foto :global(img) {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  animation: team-entra .4s ease;
}

@keyframes team-entra {
  from {
    opacity: 0;
  }
}

.team-role {
  display: block;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
  margin-bottom: .5rem;
}

.team-nome {
  font-size: var(--text-3xl);
  font-weight: 700;
  line-height: 1.2;
  color: var(--dark-navy);
  margin-bottom: .75rem;
}

.team-bio {
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--text-light);
  max-width: 32rem;
}

@media (prefers-reduced-motion: reduce) {
  .team-foto :global(img) {
    animation: none;
  }
}

/* Tablet e mobile: fisarmonica, foto e bio sotto il nome aperto */
@media (max-width: 900px) {
  .team-roster {
    display: block;
  }

  .team-persona {
    display: block;
    border-bottom: 1px solid rgba(26, 26, 26, 0.12);
  }

  .team-voce,
  .team-persona:first-child .team-voce {
    border: none;
  }

  .team-persona:first-child {
    border-top: 1px solid rgba(26, 26, 26, 0.12);
  }

  /* Fisarmonica: + per aprire, x per chiudere */
  .team-voce i {
    display: grid;
  }

  .team-pannello {
    padding: 0 0 1.75rem;
  }

