---
import { ANNI_ATTIVITA, categorieCorsi, FONDAZIONE, sedi } from '../data/scuola';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import InsegnantiSection from '../components/InsegnantiSection.astro';
import InsegnantiDialoghi from '../components/InsegnantiDialoghi.astro';
import SediMappa from '../components/SediMappa.astro';
import { sfondoCta } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import { leggiInsegnanti } from '../lib/insegnanti';
import '../styles/pages/chi-siamo.css';

// Gli insegnanti si gestiscono dalla dashboard: la pagina è generata a ogni richiesta
export const prerender = false;

const bg = {
  hero: await heroPagina('chi-siamo'),
  cta: await sfondoCta('danza'),
};


const insegnanti = await leggiInsegnanti();

const [lainate, rho] = sedi;

const totaleCorsi = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

// InBallet in numeri: valore (animato dal conteggio), etichetta e nota
const numeri = [
  { valore: ANNI_ATTIVITA, etichetta: 'Anni di danza', nota: `Dal ${FONDAZIONE}` },
  { valore: totaleCorsi, etichetta: 'Corsi', nota: `In ${categorieCorsi.length} percorsi` },
  { valore: 3, etichetta: 'Età per iniziare', nota: 'Anni compiuti' },
  { valore: 2, etichetta: 'Sedi', nota: `${lainate.citta} e ${rho.citta}` },
];
---

<Base
    title="Chi siamo: la scuola di danza di Ilenia Nobile | InBallet"
    description={`InBallet è la scuola di danza di Lainate e Rho fondata nel ${FONDAZIONE} da Ilenia Nobile: corsi dai 3 anni, inclusione e formazione insegnanti CSEN e CONI.`}
    ogTitle="Chi siamo | InBallet"
    ogDescription={`Dalle prime lezioni allo skate park alle due sedi di oggi: la storia di InBallet, scuola di danza a Lainate e Rho dal ${FONDAZIONE}.`}
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Chi Siamo -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Chi siamo: la nostra storia</h1>
                <p class="hero-lead">Dal {FONDAZIONE} a Lainate e Rho: una scuola di danza multidisciplinare, un luogo di vita <strong>aperto a tutte le età</strong>.</p>
            </div>
        </section>

        <!-- Fondatrice Section -->
        <section id="fondatrice" class="fondatrice-section decoro-onde">
            <div class="container">
                <div class="fondatrice-layout">
                    <div class="fondatrice-visual">
                        <div class="fondatrice-image-wrapper foto-cornice foto-cornice--sinistra">
                            <Img src="ilenia.jpg" alt="Ilenia Nobile, Fondatrice e Direttrice Artistica di InBallet" loading="lazy" />
                        </div>
                    </div>
                    <div class="fondatrice-content">
                        <p class="fondatrice-label eyebrow">Fondatrice & Direttrice Artistica</p>
                        <h2 class="fondatrice-name titolo-sezione">Ilenia <em>Nobile</em></h2>
                        <div class="fondatrice-bio">
                            <p><a href="https://ilenianobile.it" target="_blank" rel="noopener noreferrer" aria-label="Ilenia Nobile, sito personale (si apre in una nuova scheda)">Ilenia Nobile <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></a> ha fondato I.N. Ballet nel {FONDAZIONE} e ne è la <strong>Direttrice Artistica</strong>. Professoressa di danza, psicomotricista e formatrice, è anche operatrice per l'educazione speciale e insegnante certificata ContaKids World.</p>
                            <p>All'inizio non c'erano né una sede né un nome: le prime lezioni allo skate park, poi l'Auditorium, gli oratori e le palestre comunali. Oggi la scuola ha <strong>due sedi, a Lainate e Rho</strong>.</p>
                            <p>Nel 2013 ha dato vita al <strong>progetto NoiConVoi</strong>, convinta che la danza sia per tutti e che ognuno, secondo le proprie possibilità, possa portare il suo contributo artistico.</p>
                        </div>
                        <blockquote class="fondatrice-citazione">
                            <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                            <cite>Ilenia Nobile</cite>
                        </blockquote>
                    </div>
                </div>
            </div>
        </section>

        <!-- Timeline della storia -->
        <section class="storia-section" aria-labelledby="storia-titolo">
            <div class="container">
                <div class="storia-header">
                    <p class="storia-label eyebrow">Il nostro percorso</p>
                    <h2 class="storia-title titolo-sezione" id="storia-titolo">Dal {FONDAZIONE} <em>a oggi</em></h2>
                </div>
                <ol class="timeline">
                    <li class="voce">
                        <p class="voce-anno numero-medio">{FONDAZIONE}</p>
                        <h3 class="voce-titolo titolo-card">La fondazione</h3>
                        <p class="voce-testo testo-piccolo">Ilenia Nobile fonda a Lainate <strong>I.N. Ballet</strong>, scuola di danza multidisciplinare.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">2013</p>
                        <h3 class="voce-titolo titolo-card">Nasce NoiConVoi</h3>
                        <p class="voce-testo testo-piccolo">Il progetto di volontariato che accoglie in sala <strong>ragazzi con disabilità</strong>, con supporto psicomotorio.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">2023</p>
                        <h3 class="voce-titolo titolo-card">Ente formativo</h3>
                        <p class="voce-testo testo-piccolo">Riconoscimento per il titolo di <strong>Insegnante di Danza</strong>, valido CSEN e CONI a livello nazionale.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">2024</p>
                        <h3 class="voce-titolo titolo-card">Volontariato d'impresa</h3>
                        <p class="voce-testo testo-piccolo">Aziende ed enti entrano nei progetti sociali con i loro <strong>volontari</strong>.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">2024</p>
                        <h3 class="voce-titolo titolo-card">Da Lainate a New York</h3>
                        <p class="voce-testo testo-piccolo">Una <strong>borsa di studio</strong> porta due allieve a lezione in cinque scuole di New York, tra cui Alvin Ailey e Martha Graham.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">Oggi</p>
                        <h3 class="voce-titolo titolo-card">Due sedi, ogni età</h3>
                        <p class="voce-testo testo-piccolo">Lainate e Rho, <strong>{totaleCorsi} corsi</strong> dai 3 anni all'età adulta e uno spettacolo in teatro ogni anno.</p>
                    </li>
                </ol>
            </div>
        </section>

        <!-- InBallet in Numeri: intestazione, pulsante e quattro numeri in fila separati da filetti verticali -->
        <section class="numeri-section sezione-scura" aria-labelledby="numeri-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">In sintesi</p>
                <h2 class="titolo-sezione" id="numeri-titolo">InBallet <em>in numeri</em></h2>
                <p class="intro-sezione">Dai <strong>primi passi a 3 anni</strong> fino all'età adulta.</p>
            </div>
            <div class="container">
                <div class="numeri-cta">
                    <a href="/corsi" class="btn-secondary">
                        Scopri i corsi
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
                <dl class="numeri-lista">
                    {numeri.map((n) => (
                        <div class="numero">
                            <dt class="numero-etichetta titoletto">{n.etichetta}</dt>
                            <dd class="numero-valore numero-grande"><span class="numero-value" data-target={n.valore}>{n.valore}</span></dd>
                            <dd class="numero-nota testo-piccolo">{n.nota}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        <!-- Insegnanti (gestiti dalla dashboard; la sezione compare solo se ce ne sono) -->
        <InsegnantiSection dati={insegnanti} />

        <!-- Foto delle sedi collegate agli indirizzi sulla cartografia originale. -->
        <section class="sede-section" id="dove-trovarci" aria-labelledby="sedi-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">Le nostre sedi</p>
                <h2 class="titolo-sezione" id="sedi-titolo">Dove <em>trovarci</em></h2>
                <p class="intro-sezione">Due sedi, <strong>Lainate e Rho</strong>: scegli quella più comoda e vieni a conoscerci.</p>
            </div>
            <div class="container">
                <SediMappa />
            </div>
        </section>

        <!-- CTA Finale - Stesso stile template corsi -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Vuoi conoscerci <em>meglio?</em></h2>
                <p class="intro-sezione"><strong>Scrivici o chiamaci</strong>: ti raccontiamo corsi, orari e sedi, e facciamo insieme il primo passo.</p>
                <div class="cta-pulsanti">
                    <a href="/contatti" class="btn-primary">
                        Contattaci <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

    <Fragment slot="after-main">
        <InsegnantiDialoghi dati={insegnanti} />
    </Fragment>

    <Fragment slot="scripts">
    <script>
        import '../scripts/chi-siamo';
    </script>
    </Fragment>
</Base>

<script>
  import '../scripts/timeline';
</script>
