---
import { ANNI_ATTIVITA, FONDAZIONE, sedi } from '../data/scuola';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { webp } from '../lib/images';

const bg: Record<string, string> = {
  'gallery-7.jpg': await webp('gallery-7.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};


/** Insegnanti (mostrati nella sezione team). */
const team = [
  { nome: 'Ilenia Nobile', ruolo: 'Direttrice Artistica', bio: 'Fondatrice di InBallet. Danza classica e contemporanea.', foto: 'ballerina.jpg' },
  { nome: 'Marco Bianchi', ruolo: 'Coreografo Hip Hop', bio: '15 anni nelle street dance. Giudice in competizioni nazionali.', foto: 'gallery-2.jpg' },
  { nome: 'Sofia Russo', ruolo: 'Insegnante Danza Classica', bio: 'Diplomata Accademia Nazionale. Propedeutica e tecnica classica.', foto: 'hero-bg.jpg' },
  { nome: 'Giulia Ferrara', ruolo: 'Insegnante Modern Jazz', bio: 'Ballerina professionista. Produzioni teatrali e TV.', foto: 'gallery-3.jpg' },
  { nome: 'Luca Martini', ruolo: 'Insegnante Breaking', bio: 'B-boy dal 2008. Vincitore di battle nazionali.', foto: 'gallery-10.jpg' },
  { nome: 'Elena Costa', ruolo: 'Insegnante Pilates & Yoga', bio: 'Certificata internazionalmente. Benessere per danzatori.', foto: 'gallery-6.jpg' },
];

const [lainate, rho] = sedi;
---

<Base
    title="Chi Siamo - InBallet"
    description={`Scopri la storia di InBallet, la scuola di danza fondata da Ilenia Nobile. Dal ${FONDAZIONE} formiamo ballerini a Lainate e Rho con passione e professionalità.`}
    ogTitle="Chi Siamo - InBallet"
    ogDescription={`La storia, la visione e il team di InBallet. Dal ${FONDAZIONE} formiamo ballerini con passione.`}
>

        <!-- Hero Chi Siamo -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-7.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">La nostra storia</h1>
                <p class="chisiamo-hero-tagline">Dal {FONDAZIONE} formiamo ballerini con passione e dedizione.</p>
            </div>
        </section>

        <!-- Fondatrice Section -->
        <section id="fondatrice" class="fondatrice-section">
            <div class="container">
                <div class="fondatrice-layout">
                    <div class="fondatrice-visual">
                        <div class="fondatrice-image-wrapper foto-cornice foto-cornice--sinistra">
                            <Img src="ilenia.jpg" alt="Ilenia Nobile, Fondatrice e Direttrice Artistica di InBallet" loading="lazy" />
                        </div>
                    </div>
                    <div class="fondatrice-content">
                        <span class="fondatrice-label eyebrow">Fondatrice & Direttrice Artistica</span>
                        <h2 class="fondatrice-name titolo-sezione">Ilenia <em>Nobile</em></h2>
                        <div class="fondatrice-bio">
                            <p>Dallo skate park di Lainate alle due sedi di Lainate e Rho: Ilenia Nobile ha trasformato la sua passione in una scuola dove la danza è accessibile a tutti.</p>
                            <p>La sua filosofia: il movimento come strumento di crescita personale completa.</p>
                        </div>
                        <blockquote class="fondatrice-citazione">
                            <p>La danza è un linguaggio universale che connette corpo, mente e anima.</p>
                            <cite>Ilenia Nobile</cite>
                        </blockquote>
                    </div>
                </div>
            </div>
        </section>

        <!-- Timeline della storia -->
        <section class="storia-section">
            <div class="container">
                <div class="storia-header">
                    <span class="storia-label eyebrow">Il Nostro Percorso</span>
                    <h2 class="storia-title titolo-sezione">Dal {FONDAZIONE} <em>a oggi</em></h2>
                </div>
                <ol class="timeline">
                    <li class="voce">
                        <span class="voce-anno">{FONDAZIONE}</span>
                        <h3 class="voce-titolo">Il Primo Passo</h3>
                        <p class="voce-testo">Ilenia fonda InBallet nello skate park di Lainate.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2010</span>
                        <h3 class="voce-titolo">Crescita</h3>
                        <p class="voce-testo">Dalla strada alla prima sede stabile.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2015</span>
                        <h3 class="voce-titolo">Espansione</h3>
                        <p class="voce-testo">Apertura della seconda sede a Rho.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2020</span>
                        <h3 class="voce-titolo">Innovazione</h3>
                        <p class="voce-testo">Didattica online durante la pandemia.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2023</span>
                        <h3 class="voce-titolo">Riconoscimento</h3>
                        <p class="voce-testo">Ente Formativo CSEN e CONI. Qualità certificata.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2025</span>
                        <h3 class="voce-titolo">Oggi</h3>
                        <p class="voce-testo">Oltre 500 allievi, due sedi a Lainate e Rho e un team di insegnanti.</p>
                    </li>
                </ol>
            </div>
        </section>

        <!-- InBallet in Numeri -->
        <section class="numeri-section sezione-scura">
            <div class="container">
                <div class="numeri-header">
                    <span class="numeri-label eyebrow">In sintesi</span>
                    <h2 class="numeri-title titolo-sezione">InBallet <em>in numeri</em></h2>
                </div>
                <div class="numeri-grid">
                    <div class="numero-item">
                        <div class="numero-value-wrapper">
                            <span class="numero-value" data-target={ANNI_ATTIVITA}>0</span>
                        </div>
                        <span class="numero-label">Anni di esperienza</span>
                    </div>
                    <div class="numero-item">
                        <div class="numero-value-wrapper">
                            <span class="numero-value" data-target="500">0</span><span class="numero-suffix">+</span>
                        </div>
                        <span class="numero-label">Allievi formati</span>
                    </div>
                    <div class="numero-item">
                        <div class="numero-value-wrapper">
                            <span class="numero-value" data-target="2">0</span>
                        </div>
                        <span class="numero-label">Sedi a Lainate e Rho</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Team Professionisti -->
        <section class="team-section">
            <div class="container">
                <div class="team-header">
                    <span class="team-label eyebrow">Il Nostro Team</span>
                    <h2 class="team-title titolo-sezione">I professionisti <em>di InBallet</em></h2>
                    <p class="team-subtitle intro-sezione">Insegnanti qualificati, uniti dalla passione per la danza.</p>
                </div>
                <ul class="team-grid">
                    {team.map((p) => (
                        <li class="team-card">
                            <div class="team-card-image">
                                <Img src={p.foto} alt={p.nome} loading="lazy" decoding="async" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 33vw" />
                            </div>
                            <span class="team-role">{p.ruolo}</span>
                            <h3 class="team-nome">{p.nome}</h3>
                            <p class="team-bio">{p.bio}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Carosello Sede Fullwidth -->
        <section class="sede-section">
            <div class="sede-header">
                <div class="container">
                    <span class="sede-label eyebrow">I Nostri Spazi</span>
                    <h2 class="sede-title titolo-sezione">Le nostre <em>sale</em></h2>
                    <p class="sede-subtitle intro-sezione">Gli spazi di Lainate e Rho in cui facciamo lezione ogni settimana.</p>
                </div>
            </div>
            <div class="container">
                <div class="sedi">
                    <article class="sede">
                        <figure class="sede-foto foto-cornice foto-cornice--sinistra">
                            <Img src="gallery-4.jpg" alt="Lezione in una sala della sede di Lainate" loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
                        </figure>
                        <div class="sede-testo">
                            <p class="sede-luogo">{lainate.citta} · {lainate.via}</p>
                            <h3 class="sede-nome">Sede centrale</h3>
                            <p class="sede-descrizione">500mq di spazi dedicati alla danza nel cuore di Lainate: tre sale con pavimentazione tecnica, specchi, sbarre e climatizzazione.</p>
                            <ul class="sede-spazi">
                                <li><strong>Sale danza</strong><span>Ambienti luminosi, con impianto audio e illuminazione regolabile.</span></li>
                                <li><strong>Spazio famiglie</strong><span>Un'area di accoglienza dove i genitori possono attendere in tranquillità.</span></li>
                                <li><strong>Spogliatoi</strong><span>Spazi separati con armadietti e docce, puliti ogni giorno.</span></li>
                            </ul>
                        </div>
                    </article>

                    <article class="sede">
                        <figure class="sede-foto foto-cornice">
                            <Img src="gallery-9.jpg" alt="Allieve in sala nella sede di Rho" loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
                        </figure>
                        <div class="sede-testo">
                            <p class="sede-luogo">{rho.citta} · {rho.via}</p>
                            <h3 class="sede-nome">Sede di Rho</h3>
                            <p class="sede-descrizione">La metodologia InBallet ancora più vicina alle famiglie: due sale danza con gli stessi standard della sede centrale, facili da raggiungere e con parcheggio.</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <!-- CTA Finale - Stesso stile template corsi -->
        <section class="corso-contatto-section sezione-scura">
            <div class="corso-contatto-bg" style={`background: url('${bg['bg-progetti-territorio.jpg']}') center/cover no-repeat`}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2 class="titolo-sezione">Vuoi conoscerci <em>meglio?</em></h2>
                    <p class="intro-sezione">Scrivici o chiamaci: ti raccontiamo corsi, orari e sedi.</p>
                    <a href="/contatti" class="corso-btn-cta btn-primary">
                        Contattaci <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>

    <Fragment slot="scripts">
    <script>
        import '../scripts/chi-siamo';
    </script>
    </Fragment>
</Base>

<style>
.fondatrice-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.fondatrice-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
  max-width: 1100px;
  margin: 0 auto;
}

.fondatrice-visual {
  position: relative;
}

.fondatrice-image-wrapper {
  max-width: 480px;
}

.fondatrice-image-wrapper :global(img) {
  width: 100%;
  height: 550px;
  object-fit: cover;
}

.fondatrice-content {
  padding: 0;
}

.fondatrice-label {
  display: block;
  margin-bottom: 1rem;
}

.fondatrice-name {
  margin: 0 0 0.5rem;
}

.fondatrice-citazione {
  margin: 2rem 0 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.fondatrice-citazione p {
  font-size: var(--text-lg);
  font-style: italic;
  line-height: 1.6;
  color: var(--dark-navy);
}

.fondatrice-citazione cite {
  display: block;
  margin-top: .5rem;
  font-size: var(--text-sm);
  font-style: normal;
  font-weight: 600;
  color: var(--text-light);
}

.fondatrice-bio :global(p) {
  font-size: var(--text-base);
  color: var(--text-dark);
  line-height: 1.8;
  margin-bottom: 1.5rem;
}

.fondatrice-bio :global(p:last-child) {
  margin-bottom: 0;
}

.storia-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
  overflow: hidden;
}

.storia-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.storia-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.storia-header {
  text-align: center;
  margin-bottom: 4rem;
}

.timeline {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem 3.5rem;
  max-width: 1100px;
  margin: 0 auto;
}

@media (max-width: 900px) {
  .timeline {
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2rem;
  }
}

@media (max-width: 520px) {
  .timeline {
    grid-template-columns: 1fr;
  }
}

.storia-label {
  display: block;
  margin-bottom: 1rem;
}

.storia-title {
  margin: 0;
}

.numeri-section {
  padding: var(--section-y) 0;
  background: linear-gradient(135deg, var(--dark-navy) 0%, #1a1a2e 100%);
  position: relative;
  overflow: hidden;
}

.numeri-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--primary-blue), transparent);
}

.numeri-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--primary-blue), transparent);
}

.numeri-header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.numeri-label {
  display: block;
  margin-bottom: 1rem;
}

.numeri-title {
  margin: 0;
}

.numeri-grid {
  display: flex;
  justify-content: center;
  align-items: stretch;
  gap: 0;
  max-width: 1000px;
  margin: 0 auto;
}

.numero-item {
  text-align: center;
  padding: 2rem 3.5rem;
  position: relative;
  flex: 1;
}

.numero-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1px;
  height: 50%;
  background: rgba(135, 206, 235, 0.3);
}

.numero-value-wrapper {
  display: block;
  margin-bottom: 0.8rem;
}

.numero-value {
  font-family: var(--font-rubik);
  font-size: var(--text-6xl);
  font-weight: 300;
  color: var(--white);
  line-height: 1;
}

.numero-suffix {
  font-family: var(--font-rubik);
  font-size: var(--text-3xl);
  font-weight: 700;
  color: var(--primary-blue);
  vertical-align: top;
}

.numero-label {
  display: block;
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.4;
}

.team-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.team-header {
  text-align: center;
  margin-bottom: 4rem;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}

.team-label {
  display: block;
  margin-bottom: 1rem;
}

.team-title {
  margin: 0 0 1rem;
}

.team-subtitle {
  margin: 0;
}

/* Team: tre colonne ariose, foto verticale, ruolo sopra il nome */
.team-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4rem 3rem;
  max-width: 1100px;
  margin: 0 auto;
}

.team-card-image {
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: var(--radius-img);
  margin-bottom: 1.5rem;
}

.team-card-image :global(img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .6s ease;
}

.team-card:hover .team-card-image :global(img) {
  transform: scale(1.04);
}

.team-role {
  display: block;
  font-size: .8125rem;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
  margin-bottom: .5rem;
}

.team-nome {
  font-size: var(--text-2xl);
  font-weight: 700;
  line-height: 1.2;
  color: var(--dark-navy);
  margin-bottom: .6rem;
}

.team-bio {
  font-size: 1rem;
  line-height: 1.65;
  color: var(--text-light);
  max-width: 22rem;
}

@media (max-width: 900px) {
  .team-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 2rem;
  }
}

@media (max-width: 560px) {
  .team-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .team-card-image {
    aspect-ratio: 4 / 3;
  }
}

.sede-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
}

.sede-section::before,
.sede-section::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.sede-section::before {
  top: 0;
}

.sede-section::after {
  bottom: 0;
}

.sede-header {
  text-align: center;
  margin-bottom: 3rem;
}

.sede-label {
  display: block;
  margin-bottom: 1rem;
}

.sede-title {
  margin: 0 0 1rem;
}

.sede-subtitle {
  margin: 0;
}

/* Sedi: foto e testo alternati, come le righe della pagina Corsi */
.sedi {
  max-width: 1100px;
  margin: 0 auto;
}

.sede {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(0, 1fr);
  gap: 4.5rem;
  align-items: center;
  padding: 3.5rem 0;
}

.sede + .sede {
  border-top: 1px solid rgba(26, 26, 26, 0.1);
}

.sede:nth-child(even) .sede-foto {
  order: 2;
}

.sede-foto {
  margin: 0 1.5rem 1.5rem;
}

.sede-foto :global(img) {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.sede-luogo {
  font-size: .8125rem;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
  margin-bottom: .6rem;
}

.sede-nome {
  font-size: var(--text-3xl);
  font-weight: 700;
  line-height: 1.2;
  color: var(--dark-navy);
  margin-bottom: .9rem;
}

.sede-descrizione {
  font-size: 1.0625rem;
  line-height: 1.75;
  color: var(--text-light);
}

.sede-spazi {
  list-style: none;
  margin-top: 1.75rem;
}

.sede-spazi li {
  display: grid;
  grid-template-columns: 9rem 1fr;
  gap: 1rem;
  padding: .9rem 0;
  border-top: 1px solid rgba(26, 26, 26, 0.1);
}

.sede-spazi li:last-child {
  border-bottom: 1px solid rgba(26, 26, 26, 0.1);
}

.sede-spazi strong {
  font-weight: 600;
  color: var(--dark-navy);
}

.sede-spazi span {
  font-size: .9375rem;
  line-height: 1.6;
  color: var(--text-light);
}

@media (max-width: 900px) {
  .sede {
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding: 3rem 0;
  }

  .sede:nth-child(even) .sede-foto {
    order: 0;
  }

  .sede-foto {
    margin: 0 1rem 1rem;
  }
}

@media (max-width: 560px) {
  .sede-spazi li {
    grid-template-columns: 1fr;
    gap: .2rem;
  }
}

@media (max-width: 1024px) {
  .numero-item {
    padding: 1.5rem 2rem;
  }
}

@media (max-width: 900px) {
  .fondatrice-layout {
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  .fondatrice-visual {
    order: -1;
    display: flex;
    justify-content: center;
  }

  .fondatrice-image-wrapper {
    max-width: 400px;
  }

  .fondatrice-image-wrapper :global(img) {
    height: 480px;
  }

  .fondatrice-content {
    text-align: center;
  }

  .numero-item {
    padding: 1.5rem 2rem;
  }

}

@media (max-width: 768px) {

  .fondatrice-section,
  .storia-section,
  .numeri-section,
  .team-section,
  .sede-section {
    padding: 4rem 0;
  }

  .numero-value {
    font-size: var(--text-4xl);
  }

}

@media (max-width: 480px) {

  .fondatrice-section,
  .storia-section,
  .numeri-section,
  .team-section,
  .sede-section {
    padding: 3rem 0;
  }

  .fondatrice-image-wrapper {
    max-width: none;
  }

  .fondatrice-image-wrapper :global(img) {
    max-width: 100%;
    height: 350px;
    border-radius: var(--radius-img);
  }

  .numeri-grid {
    flex-direction: column;
    gap: 0;
  }

  .numero-item {
    padding: 2rem;
    flex: none;
    width: 100%;
  }

  .numero-item:not(:last-child)::after {
    right: auto;
    left: 50%;
    transform: translateX(-50%);
    top: auto;
    bottom: 0;
    width: 80%;
    height: 1px;
    background: rgba(135, 206, 235, 0.4);
  }

  .numero-value {
    font-size: var(--text-4xl);
  }

  .numero-suffix {
    font-size: var(--text-2xl);
  }

  .numero-label {
    font-size: var(--text-base);
  }

}
</style>
