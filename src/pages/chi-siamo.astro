---
import { ANNI_ATTIVITA, categorieCorsi, FONDAZIONE, sedi } from '../data/scuola';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import InsegnantiSection from '../components/InsegnantiSection.astro';
import InsegnantiDialoghi from '../components/InsegnantiDialoghi.astro';
import { sfondoCta, type Fuoco } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import { leggiInsegnanti } from '../lib/insegnanti';
import '../styles/pages/chi-siamo.css';

// Gli insegnanti si gestiscono dalla dashboard: la pagina è generata a ogni richiesta
export const prerender = false;

const bg = {
  hero: await heroPagina('chi-siamo'),
  cta: await sfondoCta('bg-progetti-territorio.jpg', { desktop: '50% 35%' }),
};


const insegnanti = await leggiInsegnanti();

const [lainate, rho] = sedi;

// Sedi: foto dell'ingresso; indirizzi e mappe dai dati ufficiali della scuola.
const sediFoto: { sede: typeof lainate; foto: string; alt: string; fuoco?: Fuoco }[] = [
  { sede: lainate, foto: 'foto/sede-lainate.jpg', alt: "L'edificio della sede di Lainate al tramonto, con l'insegna IN.Ballet sulla facciata", fuoco: { desktop: '35% 50%', mobile: '38% 50%' } },
  { sede: rho, foto: 'foto/sede-rho.jpg', alt: "L'ingresso della sede di Rho al tramonto" },
];
const totaleCorsi = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

// InBallet in numeri: valore (animato dal conteggio), etichetta e nota
const numeri = [
  { valore: ANNI_ATTIVITA, etichetta: 'Anni di danza', nota: `Dal ${FONDAZIONE}` },
  { valore: totaleCorsi, etichetta: 'Corsi', nota: `In ${categorieCorsi.length} percorsi` },
  { valore: 3, etichetta: 'Età per iniziare', nota: 'Anni compiuti' },
  { valore: 2, etichetta: 'Sedi', nota: `${lainate.citta} e ${rho.citta}` },
];
---

<Base
    title="Chi siamo: scuola di danza multidisciplinare | InBallet"
    description={`Scuola di danza multidisciplinare a Lainate e Rho fondata nel ${FONDAZIONE} da Ilenia Nobile: corsi dai 3 anni, inclusione e formazione insegnanti CSEN e CONI.`}
    ogTitle="Chi siamo | InBallet"
    ogDescription={`La storia e la visione di InBallet, scuola di danza a Lainate e Rho dal ${FONDAZIONE}: una scuola aperta a tutte le età.`}
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Chi Siamo -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">La nostra storia</h1>
                <p class="hero-lead">Dal {FONDAZIONE} a Lainate e Rho: una scuola di danza multidisciplinare, <strong>inclusiva e aperta a tutte le età</strong>.</p>
            </div>
        </section>

        <!-- Fondatrice Section -->
        <section id="fondatrice" class="fondatrice-section decoro-onde">
            <div class="container">
                <div class="fondatrice-layout">
                    <div class="fondatrice-visual">
                        <div class="fondatrice-image-wrapper foto-cornice foto-cornice--sinistra">
                            <Img src="ilenia.jpg" alt="Ilenia Nobile, Fondatrice e Direttrice Artistica di InBallet" loading="lazy" />
                        </div>
                    </div>
                    <div class="fondatrice-content">
                        <p class="fondatrice-label eyebrow">Fondatrice & Direttrice Artistica</p>
                        <h2 class="fondatrice-name titolo-sezione">Ilenia <em>Nobile</em></h2>
                        <div class="fondatrice-bio">
                            <p><strong>Ilenia Nobile</strong> ha fondato I.N. Ballet nel {FONDAZIONE} e ne è la <strong>Direttrice Artistica</strong>: una scuola di danza multidisciplinare, oggi con <strong>due sedi a Lainate e Rho</strong>, in cui la danza è accessibile a tutti.</p>
                            <p>Nel 2013 ha dato vita al <strong>progetto NoiConVoi</strong>, convinta che ognuno, secondo le proprie possibilità, possa portare il suo contributo artistico.</p>
                        </div>
                        <blockquote class="fondatrice-citazione">
                            <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                            <cite>Ilenia Nobile</cite>
                        </blockquote>
                    </div>
                </div>
            </div>
        </section>

        <!-- Timeline della storia -->
        <section class="storia-section decoro-onde decoro-onde--sinistra">
            <div class="container">
                <div class="storia-header">
                    <p class="storia-label eyebrow">Il nostro percorso</p>
                    <h2 class="storia-title titolo-sezione">Dal {FONDAZIONE} <em>a oggi</em></h2>
                </div>
                <ol class="timeline">
                    <li class="voce">
                        <p class="voce-anno numero-medio">{FONDAZIONE}</p>
                        <h3 class="voce-titolo">La fondazione</h3>
                        <p class="voce-testo">Ilenia Nobile fonda a Lainate <strong>I.N. Ballet</strong>, scuola di danza multidisciplinare.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">2013</p>
                        <h3 class="voce-titolo">Nasce NoiConVoi</h3>
                        <p class="voce-testo">Il progetto di volontariato che accoglie in sala <strong>ragazzi con disabilità</strong>, con supporto psicomotorio.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">2023</p>
                        <h3 class="voce-titolo">Ente formativo</h3>
                        <p class="voce-testo">Riconoscimento per il titolo di <strong>Insegnante di Danza</strong>, valido CSEN e CONI a livello nazionale.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">2024</p>
                        <h3 class="voce-titolo">Volontariato d'impresa</h3>
                        <p class="voce-testo">Aziende ed enti entrano nei progetti sociali con i loro <strong>volontari</strong>.</p>
                    </li>
                    <li class="voce">
                        <p class="voce-anno numero-medio">Oggi</p>
                        <h3 class="voce-titolo">Due sedi, ogni età</h3>
                        <p class="voce-testo">Lainate e Rho, <strong>{totaleCorsi} corsi</strong> dai 3 anni all'età adulta e uno spettacolo in teatro ogni anno.</p>
                    </li>
                </ol>
            </div>
        </section>

        <!-- InBallet in Numeri: intestazione, pulsante e quattro numeri in fila separati da filetti verticali -->
        <section class="numeri-section sezione-scura" aria-labelledby="numeri-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">In sintesi</p>
                <h2 class="titolo-sezione" id="numeri-titolo">InBallet <em>in numeri</em></h2>
                <p class="intro-sezione">Dai <strong>primi passi a 3 anni</strong> fino all'età adulta.</p>
            </div>
            <div class="container">
                <div class="numeri-cta">
                    <a href="/corsi" class="btn-secondary">
                        Scopri i corsi
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
                <dl class="numeri-lista">
                    {numeri.map((n) => (
                        <div class="numero">
                            <dt class="numero-etichetta titoletto">{n.etichetta}</dt>
                            <dd class="numero-valore numero-grande"><span class="numero-value" data-target={n.valore}>{n.valore}</span></dd>
                            <dd class="numero-nota testo-piccolo">{n.nota}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        <!-- Insegnanti (gestiti dalla dashboard; la sezione compare solo se ce ne sono) -->
        <InsegnantiSection dati={insegnanti} />

        <!-- Sedi: due righe con ingresso, indirizzo e accesso diretto alla mappa. -->
        <section class="sede-section" aria-labelledby="sedi-titolo">
            <div class="intro-editoriale">
                <h2 class="titolo-sezione" id="sedi-titolo">Dove <em>trovarci</em></h2>
            </div>
            <div class="container">
                <ul class="sedi">
                    {sediFoto.map(({ sede, foto, alt, fuoco }) => (
                        <li class="sede">
                            <Img class="sede-foto" src={foto} alt={alt} fuoco={fuoco} loading="lazy" decoding="async" widths={[240, 480]} sizes="(max-width: 600px) 96px, 208px" />
                            <div class="sede-testo">
                                <h3 class="sede-nome">{sede.citta}</h3>
                                <p>{sede.via}</p>
                                <p class="testo-piccolo">{sede.cap} {sede.citta} ({sede.provincia})</p>
                            </div>
                            <a href={sede.maps} target="_blank" rel="noopener noreferrer" class="link-cta sede-cta" aria-label={`Apri la mappa della sede di ${sede.citta}, ${sede.via} (si apre in una nuova scheda)`}>
                                Apri la mappa
                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA Finale - Stesso stile template corsi -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Vuoi conoscerci <em>meglio?</em></h2>
                <p class="intro-sezione"><strong>Scrivici o chiamaci</strong>: ti raccontiamo corsi, orari e sedi.</p>
                <div class="cta-pulsanti">
                    <a href="/contatti" class="btn-primary">
                        Contattaci <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

    <Fragment slot="after-main">
        <InsegnantiDialoghi dati={insegnanti} />
    </Fragment>

    <Fragment slot="scripts">
    <script>
        import '../scripts/chi-siamo';
    </script>
    </Fragment>
</Base>

<script>
  // Timeline a serpentina: un unico tracciato che unisce i nodi, riga dopo riga (sempre letti da sinistra a
  // destra). Alla fine di ogni riga la linea gira a destra con due curve identiche, scende, torna indietro
  // tra le righe e curva (stesso raggio) dentro il nodo della prima tappa della riga sotto.
  // Sul telefono resta la linea verticale.
  const timeline = document.querySelector<HTMLElement>('.timeline');
  if (timeline) {
    const NS = 'http://www.w3.org/2000/svg';
    const RAGGIO = 28; // stesso raggio per tutte e quattro le curve: a destra escono e rientrano, a sinistra entrano nel nodo
    const telefono = window.matchMedia('(max-width: 600px)');

    const disegna = () => {
      timeline.querySelector('.timeline-linea')?.remove();
      timeline.classList.remove('con-linea');
      if (telefono.matches) return;

      const nodo = parseFloat(getComputedStyle(timeline).getPropertyValue('--nodo')) || 20;
      const voci = [...timeline.children] as HTMLElement[];
      const righe: HTMLElement[][] = [];
      voci.forEach((v) => {
        const r = righe[righe.length - 1];
        if (r && Math.abs(r[0].offsetTop - v.offsetTop) < 2) r.push(v);
        else righe.push([v]);
      });
      const centro = (v: HTMLElement) => ({ x: v.offsetLeft + nodo / 2, y: v.offsetTop + nodo / 2 });

      let d = '';
      righe.forEach((riga, i) => {
        const primo = centro(riga[0]);
        const ultimo = centro(riga[riga.length - 1]);
        d += i === 0 ? `M ${primo.x} ${primo.y}` : '';
        d += ` L ${ultimo.x} ${ultimo.y}`;
        const prossima = righe[i + 1];
        if (!prossima) return;
        const fondo = Math.max(...riga.map((v) => v.offsetTop + v.offsetHeight));
        const yg = (fondo + prossima[0].offsetTop) / 2;
        const xr = riga[riga.length - 1].offsetLeft + riga[riga.length - 1].offsetWidth;
        const nodoSotto = centro(prossima[0]);
        // Raggio uguale per tutte le curve, ridotto se a destra non c'è abbastanza margine nello schermo
        const margine = document.documentElement.clientWidth - timeline.getBoundingClientRect().right - 4;
        const r = Math.min(RAGGIO, nodoSotto.y - yg, Math.max(12, margine));
        // Giro a destra (due quarti di cerchio e un tratto dritto), ritorno, curva a sinistra dentro il nodo
        d += ` L ${xr} ${ultimo.y} A ${r} ${r} 0 0 1 ${xr + r} ${ultimo.y + r}`;
        d += ` L ${xr + r} ${yg - r} A ${r} ${r} 0 0 1 ${xr} ${yg}`;
        d += ` L ${nodoSotto.x + r} ${yg} A ${r} ${r} 0 0 0 ${nodoSotto.x} ${yg + r} L ${nodoSotto.x} ${nodoSotto.y}`;
      });

      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'timeline-linea');
      svg.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', d);
      svg.append(path);
      timeline.prepend(svg);
      timeline.classList.add('con-linea');
    };

    disegna();
    new ResizeObserver(disegna).observe(timeline);
    document.fonts?.ready.then(disegna);
    telefono.addEventListener('change', disegna);
  }
</script>
