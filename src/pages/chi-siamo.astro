---
import { ANNI_ATTIVITA, categorieCorsi, FONDAZIONE, sedi } from '../data/scuola';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondo } from '../lib/images';

const bg = {
  hero: await sfondo('gallery-7.jpg', { desktop: '50% 40%', tablet: '50% 55%' }),
  cta: await sfondo('bg-progetti-territorio.jpg', { desktop: '50% 35%' }),
};


/** Insegnanti (mostrati nella sezione team). */
const team = [
  { nome: 'Ilenia Nobile', ruolo: 'Direttrice Artistica', bio: 'Fondatrice di InBallet. Danza classica e contemporanea.', foto: 'ballerina.jpg' },
  { nome: 'Marco Bianchi', ruolo: 'Coreografo Hip Hop', bio: '15 anni nelle street dance. Giudice in competizioni nazionali.', foto: 'gallery-2.jpg' },
  { nome: 'Sofia Russo', ruolo: 'Insegnante Danza Classica', bio: 'Diplomata Accademia Nazionale. Propedeutica e tecnica classica.', foto: 'hero-bg.jpg' },
  { nome: 'Giulia Ferrara', ruolo: 'Insegnante Modern Jazz', bio: 'Ballerina professionista. Produzioni teatrali e TV.', foto: 'gallery-3.jpg' },
  { nome: 'Luca Martini', ruolo: 'Insegnante Breaking', bio: 'B-boy dal 2008. Vincitore di battle nazionali.', foto: 'gallery-10.jpg' },
  { nome: 'Elena Costa', ruolo: 'Insegnante Pilates & Yoga', bio: 'Certificata internazionalmente. Benessere per danzatori.', foto: 'gallery-6.jpg' },
];

const [lainate, rho] = sedi;
const totaleCorsi = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);
---

<Base
    title="Chi siamo: scuola di danza multidisciplinare | InBallet"
    description={`I.N. Ballet è la scuola di danza multidisciplinare di Lainate e Rho fondata nel ${FONDAZIONE} da Ilenia Nobile: corsi dai 3 anni in su, inclusione e formazione CSEN-CONI.`}
    ogTitle="Chi siamo | InBallet"
    ogDescription={`La storia, la visione e le persone di InBallet, scuola di danza a Lainate e Rho dal ${FONDAZIONE}.`}
>

        <!-- Hero Chi Siamo -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">La nostra storia</h1>
                <p class="chisiamo-hero-tagline">Dal {FONDAZIONE} a Lainate e Rho: una scuola di danza multidisciplinare, inclusiva e aperta a tutte le età.</p>
            </div>
        </section>

        <!-- Fondatrice Section -->
        <section id="fondatrice" class="fondatrice-section">
            <div class="container">
                <div class="fondatrice-layout">
                    <div class="fondatrice-visual">
                        <div class="fondatrice-image-wrapper foto-cornice foto-cornice--sinistra">
                            <Img src="ilenia.jpg" alt="Ilenia Nobile, Fondatrice e Direttrice Artistica di InBallet" loading="lazy" />
                        </div>
                    </div>
                    <div class="fondatrice-content">
                        <span class="fondatrice-label eyebrow">Fondatrice & Direttrice Artistica</span>
                        <h2 class="fondatrice-name titolo-sezione">Ilenia <em>Nobile</em></h2>
                        <div class="fondatrice-bio">
                            <p>Dallo skate park di Lainate alle due sedi di Lainate e Rho: Ilenia Nobile ha trasformato la sua passione in una scuola dove la danza è accessibile a tutti.</p>
                            <p>Direttrice Artistica della scuola, nel 2013 ha dato vita al progetto NoiConVoi, convinta che la danza sia per tutti: ognuno, secondo le proprie possibilità, può portare il suo contributo artistico.</p>
                        </div>
                        <blockquote class="fondatrice-citazione">
                            <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                            <cite>Ilenia Nobile</cite>
                        </blockquote>
                    </div>
                </div>
            </div>
        </section>

        <!-- La scuola: intestazione editoriale con la visione -->
        <section class="scuola-section" aria-labelledby="scuola-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">La scuola</span>
                <h2 class="titolo-sezione" id="scuola-titolo">Un luogo <em>di vita</em></h2>
                <p>I.N. Ballet è una scuola di danza multidisciplinare: un luogo di vita dedicato alla conoscenza e all'esplorazione dei diversi stili di danza, nelle loro sfumature tecniche e artistiche.</p>
                <p>È un ambiente che si lascia modificare ogni giorno, attraverso un agire e un pensiero quotidiano legati a ciò che emerge da bambini, ragazzi e adulti che lo vivono. Uno spazio di continua ricerca corporea, dove la danza, con i suoi infiniti linguaggi, incontra emozioni sottili e intime e forme espressive diverse: uno spazio di incontro fatto di stupore, relazioni e curiosità, in continua comunicazione con le famiglie.</p>
                <p>La scuola accoglie bambini dai 3 anni e allievi di tutte le età, con gruppi di diversi livelli fino ai corsi avanzati e per adulti. Propone a professionisti dell'ambito educativo e terapeutico e a pedagogisti <a href="/formazioni-personalizzate">corsi di formazione</a> che intrecciano linguaggi espressivi, corporeità, motricità ed esplorazione del sé, ed è un punto di riferimento sul territorio per la <a href="/formazione-insegnanti">formazione nazionale dei maestri di danza</a>.</p>
                <p>L'inclusione è centrale per tutte le fasce d'età: dal 2013 il <a href="/progetto-noiconvoi">progetto NoiConVoi</a> accoglie ragazzi con disabilità in esperienze di danza con supporto psicomotorio, insieme a un team di volontari e alla coordinatrice del progetto.</p>
                <div class="scuola-highlight">
                    <p>I progetti evolvono ogni giorno e fanno della scuola una comunità educante ed educativa, che riconosce nell'arte della danza un potente strumento di espressione, comunicazione e conoscenza.</p>
                </div>
            </div>
        </section>

        <!-- Timeline della storia -->
        <section class="storia-section">
            <div class="container">
                <div class="storia-header">
                    <span class="storia-label eyebrow">Il nostro percorso</span>
                    <h2 class="storia-title titolo-sezione">Dal {FONDAZIONE} <em>a oggi</em></h2>
                </div>
                <ol class="timeline">
                    <li class="voce">
                        <span class="voce-anno">{FONDAZIONE}</span>
                        <h3 class="voce-titolo">La fondazione</h3>
                        <p class="voce-testo">Ilenia Nobile fonda I.N. Ballet a Lainate, partendo dallo skate park.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2013</span>
                        <h3 class="voce-titolo">Nasce NoiConVoi</h3>
                        <p class="voce-testo">Il progetto di volontariato che accoglie in sala ragazzi con disabilità, con supporto psicomotorio.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2023</span>
                        <h3 class="voce-titolo">Ente formativo</h3>
                        <p class="voce-testo">Riconoscimento per il titolo di Insegnante di Danza, valido CSEN e CONI a livello nazionale.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2024</span>
                        <h3 class="voce-titolo">Volontariato d'impresa</h3>
                        <p class="voce-testo">Aziende ed enti entrano nei progetti sociali con i loro volontari.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">Oggi</span>
                        <h3 class="voce-titolo">Due sedi, ogni età</h3>
                        <p class="voce-testo">Lainate e Rho, {totaleCorsi} corsi dai 3 anni agli adulti over 40 e uno spettacolo in teatro ogni anno.</p>
                    </li>
                </ol>
            </div>
        </section>

        <!-- InBallet in Numeri: intro a sinistra, griglia 2x2 di numeri a destra -->
        <section class="numeri-section sezione-scura" aria-labelledby="numeri-titolo">
            <div class="container numeri-layout">
                <div class="numeri-intro">
                    <span class="eyebrow">In sintesi</span>
                    <h2 class="titolo-sezione" id="numeri-titolo">InBallet <em>in numeri</em></h2>
                    <p class="intro-sezione">Dal {FONDAZIONE} a oggi: discipline, percorsi e sedi pensati per accompagnare ogni allievo, dai primi passi a 3 anni fino all'età adulta.</p>
                    <a href="/corsi" class="link-cta numeri-cta">
                        Scopri i corsi
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
                <dl class="numeri-grid">
                    <div class="numero-item">
                        <dt class="numero-label">Anni di danza</dt>
                        <dd class="numero-value-wrapper"><span class="numero-value" data-target={ANNI_ATTIVITA}>{ANNI_ATTIVITA}</span></dd>
                        <dd class="numero-nota">Dal {FONDAZIONE} a Lainate e Rho</dd>
                    </div>
                    <div class="numero-item">
                        <dt class="numero-label">Corsi</dt>
                        <dd class="numero-value-wrapper"><span class="numero-value" data-target={totaleCorsi}>{totaleCorsi}</span></dd>
                        <dd class="numero-nota">In {categorieCorsi.length} percorsi, dai 3 anni agli adulti</dd>
                    </div>
                    <div class="numero-item">
                        <dt class="numero-label">Età per iniziare</dt>
                        <dd class="numero-value-wrapper"><span class="numero-value" data-target="3">3</span></dd>
                        <dd class="numero-nota">Anni compiuti, con Avviamento alla Danza</dd>
                    </div>
                    <div class="numero-item">
                        <dt class="numero-label">Sedi</dt>
                        <dd class="numero-value-wrapper"><span class="numero-value" data-target="2">2</span></dd>
                        <dd class="numero-nota">{lainate.citta} e {rho.citta}</dd>
                    </div>
                </dl>
            </div>
        </section>

        <!-- Team Professionisti -->
        <section class="team-section">
            <div class="container">
                <div class="team-header">
                    <span class="team-label eyebrow">Il nostro team</span>
                    <h2 class="team-title titolo-sezione">I professionisti <em>di InBallet</em></h2>
                    <p class="team-subtitle intro-sezione">Insegnanti qualificati, uniti dalla passione per la danza.</p>
                </div>
                <!-- Desktop: nomi a destra, foto e bio del selezionato a sinistra.
                     Tablet/mobile: fisarmonica, il pannello si apre sotto il nome -->
                <ul class="team-roster" style={`--persone: ${team.length}`}>
                    {team.map((p, i) => (
                        <li class="team-persona">
                            <button type="button" class="team-voce" id={`team-voce-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`team-pannello-${i}`}>
                                <span class="team-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                                <span class="team-voce-testo">
                                    <span class="team-voce-nome">{p.nome}</span>
                                    <span class="team-voce-ruolo">{p.ruolo}</span>
                                </span>
                                <i class="fas fa-plus" aria-hidden="true"></i>
                            </button>
                            <div class="team-pannello" id={`team-pannello-${i}`} role="region" aria-labelledby={`team-voce-${i}`} hidden={i !== 0}>
                                <div class="team-foto">
                                    <Img src={p.foto} alt={p.nome} loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
                                </div>
                                <div class="team-pannello-testo">
                                    <span class="team-role">{p.ruolo}</span>
                                    <h3 class="team-nome">{p.nome}</h3>
                                    <p class="team-bio">{p.bio}</p>
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Carosello Sede Fullwidth -->
        <section class="sede-section">
            <div class="sede-header">
                <div class="container">
                    <span class="sede-label eyebrow">I nostri spazi</span>
                    <h2 class="sede-title titolo-sezione">Le nostre <em>sale</em></h2>
                    <p class="sede-subtitle intro-sezione">Gli spazi di Lainate e Rho in cui facciamo lezione ogni settimana.</p>
                </div>
            </div>
            <div class="container">
                <div class="sedi">
                    <article class="sede">
                        <figure class="sede-foto foto-cornice foto-cornice--sinistra">
                            <Img src="gallery-4.jpg" alt="Lezione in una sala della sede di Lainate" loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
                        </figure>
                        <div class="sede-testo">
                            <p class="sede-luogo">{lainate.citta} · {lainate.via}</p>
                            <h3 class="sede-nome">Sede centrale</h3>
                            <p class="sede-descrizione">500mq di spazi dedicati alla danza nel cuore di Lainate: tre sale con pavimentazione tecnica, specchi, sbarre e climatizzazione.</p>
                            <ul class="sede-spazi">
                                <li><strong>Sale danza</strong><span>Ambienti luminosi, con impianto audio e illuminazione regolabile.</span></li>
                                <li><strong>Spazio famiglie</strong><span>Un'area di accoglienza dove i genitori possono attendere in tranquillità.</span></li>
                                <li><strong>Spogliatoi</strong><span>Spazi separati con armadietti e docce, puliti ogni giorno.</span></li>
                            </ul>
                        </div>
                    </article>

                    <article class="sede">
                        <figure class="sede-foto foto-cornice">
                            <Img src="gallery-9.jpg" alt="Allieve in sala nella sede di Rho" loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
                        </figure>
                        <div class="sede-testo">
                            <p class="sede-luogo">{rho.citta} · {rho.via}</p>
                            <h3 class="sede-nome">Sede di Rho</h3>
                            <p class="sede-descrizione">La metodologia InBallet ancora più vicina alle famiglie: due sale danza con gli stessi standard della sede centrale, facili da raggiungere e con parcheggio.</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <!-- CTA Finale - Stesso stile template corsi -->
        <section class="corso-contatto-section sezione-scura">
            <div class="corso-contatto-bg" style={bg.cta.style}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2 class="titolo-sezione">Vuoi conoscerci <em>meglio?</em></h2>
                    <p class="intro-sezione">Scrivici o chiamaci: ti raccontiamo corsi, orari e sedi.</p>
                    <a href="/contatti" class="corso-btn-cta btn-primary">
                        Contattaci <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>

    <Fragment slot="scripts">
    <script>
        import '../scripts/chi-siamo';
    </script>
    </Fragment>
</Base>

<style>
.fondatrice-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.fondatrice-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

.fondatrice-visual {
  position: relative;
}

.fondatrice-image-wrapper {
  max-width: 480px;
}

.fondatrice-image-wrapper :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.fondatrice-content {
  padding: 0;
}

.fondatrice-label {
  display: block;
  margin-bottom: 1rem;
}

.fondatrice-name {
  margin: 0 0 0.5rem;
}

.fondatrice-citazione {
  margin: 2rem 0 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.fondatrice-citazione p {
  font-size: var(--text-lg);
  font-style: italic;
  line-height: 1.6;
  color: var(--dark-navy);
}

.fondatrice-citazione cite {
  display: block;
  margin-top: .5rem;
  font-size: var(--text-sm);
  font-style: normal;
  font-weight: 600;
  color: var(--text-light);
}

.fondatrice-bio :global(p) {
  font-size: 1.125rem;
  color: var(--text-dark);
  line-height: 1.8;
  margin-bottom: 1.5rem;
}

.fondatrice-bio :global(p:last-child) {
  margin-bottom: 0;
}

.scuola-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.storia-section {
  padding: var(--section-y) 0;
  background: var(--white);
  position: relative;
  overflow: hidden;
}

.storia-header {
  text-align: center;
  margin-bottom: 4rem;
}

.timeline {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem 3.5rem;
}

@media (max-width: 900px) {
  .timeline {
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2rem;
  }
}

@media (max-width: 520px) {
  .timeline {
    gap: 2rem 1.25rem;
  }

  .timeline :global(.voce-anno) {
    font-size: var(--text-2xl);
  }

  .timeline :global(.voce-titolo) {
    font-size: 1.0625rem;
  }

  .timeline :global(.voce-testo) {
    font-size: .9375rem;
  }
}

.storia-label {
  display: block;
  margin-bottom: 1rem;
}

.storia-title {
  margin: 0;
}

/* ---------- InBallet in numeri ---------- */
.numeri-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
}

.numeri-layout {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: center;
}

.numeri-intro .titolo-sezione {
  margin-bottom: 1.5rem;
}

.numeri-cta {
  margin-top: 2rem;
  color: var(--white);
}

.numeri-cta:hover {
  color: var(--primary-blue);
  border-color: var(--primary-blue);
}

/* Griglia 2x2: il gap da 1px sul fondo chiaro disegna i filetti solo tra le celle */
.numeri-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  margin: 0;
  background: rgba(255, 255, 255, 0.14);
}

.numero-item {
  display: flex;
  flex-direction: column;
  padding: 2.25rem 2.5rem;
  background: var(--dark-navy);
}

.numero-label {
  order: 2;
  margin-top: .9rem;
  font-size: 1.0625rem;
  font-weight: 600;
  color: var(--white);
}

.numero-value-wrapper {
  order: 1;
  margin: 0;
  line-height: 1;
}

.numero-value {
  font-size: clamp(2.25rem, 1.75rem + 1.5vw, 3rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--white);
  font-variant-numeric: tabular-nums;
}

.numero-suffix {
  margin-left: .1em;
  font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
  font-weight: 700;
  line-height: 1;
  color: var(--primary-blue);
}

.numero-nota {
  order: 3;
  margin: .3rem 0 0;
  font-size: .9375rem;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.6);
}

@media (max-width: 900px) {
  .numeri-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  /* Colonna sinistra dei numeri allineata al testo sopra */
  .numero-item:nth-child(odd) {
    padding-left: 0;
  }
}

@media (max-width: 600px) {
  .numero-item {
    padding: 1.5rem 1.25rem;
  }

  .numero-value {
    font-size: 2.25rem;
  }

  .numero-suffix {
    font-size: 1.75rem;
  }

  .numero-label {
    margin-top: .6rem;
    font-size: 1rem;
  }

  .numero-nota {
    font-size: .8125rem;
  }
}

.team-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.team-header {
  margin-bottom: 3rem;
  max-width: 44rem;
}

.team-label {
  display: block;
  margin-bottom: 1rem;
}

.team-title {
  margin: 0 0 1rem;
}

.team-subtitle {
  margin: 0;
}

/* Team come "roster": desktop elenco di nomi a destra e pannello del selezionato a
   sinistra (tutti i pannelli occupano la stessa cella, si vede solo l'attivo);
   sotto i 900px fisarmonica con il pannello che si apre sotto il nome */
.team-roster {
  list-style: none;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
  grid-template-rows: repeat(var(--persone), auto) 1fr;
  column-gap: 5rem;
}

.team-persona:first-child .team-voce {
  border-top: 1px solid rgba(26, 26, 26, 0.12);
}

.team-persona {
  display: contents;
}

.team-voce {
  grid-column: 2;
  display: grid;
  grid-template-columns: 2.5rem minmax(0, 1fr) auto;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 1.25rem 0;
  border: none;
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
  background: none;
  font: inherit;
  text-align: left;
  color: var(--dark-navy);
  cursor: pointer;
}

.team-num {
  font-size: .9375rem;
  font-weight: 300;
  color: var(--primary-blue-dark);
}

.team-voce-testo {
  display: flex;
  flex-direction: column;
  gap: .2rem;
}

.team-voce-nome {
  font-size: var(--text-xl);
  font-weight: 600;
  line-height: 1.25;
  transition: color .3s ease;
}

.team-voce-ruolo {
  font-size: .875rem;
  color: var(--text-light);
}

/* Desktop: niente icona, il selezionato si riconosce dal colore */
.team-voce i {
  display: none;
  font-size: .875rem;
  color: var(--primary-blue-dark);
  transition: transform .3s ease;
}

.team-voce[aria-expanded="true"] .team-num {
  font-weight: 600;
}

/* Desktop: il nome attivo è evidenziato e la croce diventa una freccia verso il pannello */
.team-voce[aria-expanded="true"] .team-voce-nome {
  color: var(--primary-blue-dark);
}

.team-voce[aria-expanded="true"] i {
  transform: rotate(45deg);
}

@media (hover: hover) and (pointer: fine) {
