---
import { ANNI_ATTIVITA, categorieCorsi, FONDAZIONE, sedi } from '../data/scuola';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import InsegnantiSection from '../components/InsegnantiSection.astro';
import InsegnantiDialoghi from '../components/InsegnantiDialoghi.astro';
import { sfondo, sfondoCta, type Fuoco } from '../lib/images';
import { leggiInsegnanti } from '../lib/insegnanti';

// Gli insegnanti si gestiscono dalla dashboard: la pagina è generata a ogni richiesta
export const prerender = false;

const bg = {
  hero: await sfondo('gallery-7.jpg', { desktop: '50% 40%', tablet: '50% 55%' }),
  cta: await sfondoCta('bg-progetti-territorio.jpg', { desktop: '50% 35%' }),
};


const insegnanti = await leggiInsegnanti();

const [lainate, rho] = sedi;

// Sedi: foto e frase per ciascuna (indirizzo e link alla mappa da src/data/scuola.ts)
const sediFoto: { sede: typeof lainate; foto: string; alt: string; fuoco?: Fuoco; testo: string }[] = [
  { sede: lainate, foto: 'foto/sede-lainate.jpg', alt: "L'edificio della sede di Lainate al tramonto, con l'insegna IN.Ballet sulla facciata", fuoco: { desktop: '35% 50%', mobile: '38% 50%' }, testo: 'La sede principale: corsi per tutte le età, dai primi passi ai livelli avanzati.' },
  { sede: rho, foto: 'foto/sede-rho.jpg', alt: "L'ingresso della sede di Rho al tramonto", testo: 'Lo stesso metodo della sede centrale, vicino alle famiglie di Rho e dintorni.' },
];
const totaleCorsi = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

// InBallet in numeri: valore (animato dal conteggio), etichetta e nota
const numeri = [
  { valore: ANNI_ATTIVITA, etichetta: 'Anni di danza', nota: `Dal ${FONDAZIONE}` },
  { valore: totaleCorsi, etichetta: 'Corsi', nota: `In ${categorieCorsi.length} percorsi` },
  { valore: 3, etichetta: 'Età per iniziare', nota: 'Anni compiuti' },
  { valore: 2, etichetta: 'Sedi', nota: `${lainate.citta} e ${rho.citta}` },
];
---

<Base
    title="Chi siamo: scuola di danza multidisciplinare | InBallet"
    description={`Scuola di danza multidisciplinare a Lainate e Rho fondata nel ${FONDAZIONE} da Ilenia Nobile: corsi dai 3 anni, inclusione e formazione insegnanti CSEN e CONI.`}
    ogTitle="Chi siamo | InBallet"
    ogDescription={`La storia e la visione di InBallet, scuola di danza a Lainate e Rho dal ${FONDAZIONE}: una scuola aperta a tutte le età.`}
>

        <!-- Hero Chi Siamo -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">La nostra storia</h1>
                <p class="chisiamo-hero-tagline">Dal {FONDAZIONE} a Lainate e Rho: una scuola di danza multidisciplinare, <strong>inclusiva e aperta a tutte le età</strong>.</p>
            </div>
        </section>

        <!-- Fondatrice Section -->
        <section id="fondatrice" class="fondatrice-section decoro-onde">
            <div class="container">
                <div class="fondatrice-layout">
                    <div class="fondatrice-visual">
                        <div class="fondatrice-image-wrapper foto-cornice foto-cornice--sinistra">
                            <Img src="ilenia.jpg" alt="Ilenia Nobile, Fondatrice e Direttrice Artistica di InBallet" loading="lazy" />
                        </div>
                    </div>
                    <div class="fondatrice-content">
                        <span class="fondatrice-label eyebrow">Fondatrice & Direttrice Artistica</span>
                        <h2 class="fondatrice-name titolo-sezione">Ilenia <em>Nobile</em></h2>
                        <div class="fondatrice-bio">
                            <p><strong>Ilenia Nobile</strong> ha fondato I.N. Ballet nel {FONDAZIONE} e ne è la <strong>Direttrice Artistica</strong>: una scuola di danza multidisciplinare, oggi con <strong>due sedi a Lainate e Rho</strong>, in cui la danza è accessibile a tutti.</p>
                            <p>Nel 2013 ha dato vita al <strong>progetto NoiConVoi</strong>, convinta che ognuno, secondo le proprie possibilità, possa portare il suo contributo artistico.</p>
                        </div>
                        <blockquote class="fondatrice-citazione">
                            <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                            <cite>Ilenia Nobile</cite>
                        </blockquote>
                    </div>
                </div>
            </div>
        </section>

        <!-- Timeline della storia -->
        <section class="storia-section decoro-onde decoro-onde--sinistra">
            <div class="container">
                <div class="storia-header">
                    <span class="storia-label eyebrow">Il nostro percorso</span>
                    <h2 class="storia-title titolo-sezione">Dal {FONDAZIONE} <em>a oggi</em></h2>
                </div>
                <ol class="timeline">
                    <li class="voce">
                        <span class="voce-anno">{FONDAZIONE}</span>
                        <h3 class="voce-titolo">La fondazione</h3>
                        <p class="voce-testo">Ilenia Nobile fonda a Lainate <strong>I.N. Ballet</strong>, scuola di danza multidisciplinare.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2013</span>
                        <h3 class="voce-titolo">Nasce NoiConVoi</h3>
                        <p class="voce-testo">Il progetto di volontariato che accoglie in sala <strong>ragazzi con disabilità</strong>, con supporto psicomotorio.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2023</span>
                        <h3 class="voce-titolo">Ente formativo</h3>
                        <p class="voce-testo">Riconoscimento per il titolo di <strong>Insegnante di Danza</strong>, valido CSEN e CONI a livello nazionale.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">2024</span>
                        <h3 class="voce-titolo">Volontariato d'impresa</h3>
                        <p class="voce-testo">Aziende ed enti entrano nei progetti sociali con i loro <strong>volontari</strong>.</p>
                    </li>
                    <li class="voce">
                        <span class="voce-anno">Oggi</span>
                        <h3 class="voce-titolo">Due sedi, ogni età</h3>
                        <p class="voce-testo">Lainate e Rho, <strong>{totaleCorsi} corsi</strong> dai 3 anni all'età adulta e uno spettacolo in teatro ogni anno.</p>
                    </li>
                </ol>
            </div>
        </section>

        <!-- InBallet in Numeri: intestazione e quattro numeri in fila separati da filetti verticali -->
        <section class="numeri-section sezione-scura" aria-labelledby="numeri-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">In sintesi</span>
                <h2 class="titolo-sezione" id="numeri-titolo">InBallet <em>in numeri</em></h2>
                <p class="intro-sezione">Dai <strong>primi passi a 3 anni</strong> fino all'età adulta.</p>
            </div>
            <div class="container">
                <dl class="numeri-lista">
                    {numeri.map((n) => (
                        <div class="numero">
                            <dt class="numero-etichetta">{n.etichetta}</dt>
                            <dd class="numero-valore"><span class="numero-value" data-target={n.valore}>{n.valore}</span></dd>
                            <dd class="numero-nota">{n.nota}</dd>
                        </div>
                    ))}
                </dl>
                <div class="numeri-cta">
                    <a href="/corsi" class="btn-secondary">
                        <span>Scopri i corsi</span>
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- Insegnanti (gestiti dalla dashboard; la sezione compare solo se ce ne sono) -->
        <InsegnantiSection dati={insegnanti} />

        <!-- Carosello Sede Fullwidth -->
        <!-- Sedi: intestazione editoriale e le due sedi affiancate (foto grande; sotto tipo,
             città, descrizione e indicazioni) -->
        <section class="sede-section decoro-onde" aria-labelledby="sedi-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">I nostri spazi</span>
                <h2 class="titolo-sezione" id="sedi-titolo">Le nostre <em>sale</em></h2>
                <p class="intro-sezione"><strong>Due sedi</strong> a nord-ovest di Milano, a Lainate e a Rho.</p>
            </div>
            <div class="container">
                <ul class="sedi">
                    {sediFoto.map(({ sede, foto, alt, fuoco, testo }) => (
                        <li class="sede">
                            <Img class="sede-foto" src={foto} alt={alt} fuoco={fuoco} loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, 560px" />
                            <div class="sede-testo">
                                <p class="sede-tipo">{sede.titolo}</p>
                                <h3 class="sede-nome">{sede.citta}</h3>
                                <p class="sede-descrizione">{testo}</p>
                                <a href={sede.maps} target="_blank" rel="noopener" class="link-cta sede-cta" aria-label={`Indicazioni per la sede di ${sede.citta}, ${sede.via}`}>
                                    Indicazioni
                                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA Finale - Stesso stile template corsi -->
        <section class="corso-contatto-section sezione-scura">
            <div class="corso-contatto-bg" style={bg.cta.style}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2 class="titolo-sezione">Vuoi conoscerci <em>meglio?</em></h2>
                    <p class="intro-sezione"><strong>Scrivici o chiamaci</strong>: ti raccontiamo corsi, orari e sedi.</p>
                    <a href="/contatti" class="corso-btn-cta btn-primary">
                        Contattaci <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

    <Fragment slot="after-main">
        <InsegnantiDialoghi dati={insegnanti} />
    </Fragment>

    <Fragment slot="scripts">
    <script>
        import '../scripts/chi-siamo';
    </script>
    </Fragment>
</Base>

<style>
.fondatrice-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.fondatrice-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

.fondatrice-visual {
  position: relative;
}

.fondatrice-image-wrapper {
  max-width: 480px;
}

.fondatrice-image-wrapper :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.fondatrice-content {
  padding: 0;
}

.fondatrice-label {
  display: block;
  margin-bottom: 1rem;
}

.fondatrice-name {
  margin: 0 0 0.5rem;
}

.fondatrice-bio :global(p) {
  font-size: var(--text-base);
  color: var(--text-dark);
  line-height: 1.8;
  margin-bottom: 1.5rem;
}

.fondatrice-bio :global(p:last-child) {
  margin-bottom: 0;
}

.storia-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
  overflow: hidden;
}

.storia-header {
  text-align: center;
  margin-bottom: 4rem;
}

.timeline {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem 3.5rem;
}

@media (max-width: 900px) {
  .timeline {
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2rem;
  }
}

/* Mobile: una voce per riga, con la scala tipografica normale */
@media (max-width: 640px) {
  .timeline {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
  }
}

.storia-label {
  display: block;
  margin-bottom: 1rem;
}

.storia-title {
  margin: 0;
}

/* ---------- InBallet in numeri ---------- */
/* Fondo scuro; numeri bianchi in fila, divisi da filetti verticali */
.numeri-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
}

.numeri-lista {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: 3.5rem 0 0;
  text-align: center;
}

.numero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: .5rem 1.5rem;
}

.numero + .numero {
  border-left: 1px solid rgba(255, 255, 255, .2);
}

.numero-valore {
  order: 1;
  margin: 0;
  font-size: var(--text-5xl);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--white);
  font-variant-numeric: tabular-nums;
}

.numero-etichetta {
  order: 2;
  margin-top: 1rem;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue);
}

.numero-nota {
  order: 3;
  margin: .35rem 0 0;
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, .7);
}

.numeri-cta {
  margin-top: 3.5rem;
  text-align: center;
}

/* Tablet e mobile: 2x2 a celle uguali, con filetti solo tra una cella e l'altra (come i loghi dei sostenitori):
   il gap da 1px sul fondo chiaro disegna le linee, le celle hanno il fondo scuro */
@media (max-width: 900px) {
  .numeri-lista {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2.5rem;
    background: rgba(255, 255, 255, .2);
  }

  .numero,
  .numero + .numero {
    justify-content: center;
    padding: 2rem 1rem;
    border-left: none;
    background: var(--dark-navy);
  }

  .numeri-cta {
    margin-top: 2.5rem;
    text-align: left;
  }
}

@media (max-width: 640px) {
  .numero,
  .numero + .numero {
    padding: 1.5rem .75rem;
  }

  .numero-valore {
    font-size: var(--text-4xl);
  }

  .numero-etichetta {
    margin-top: .75rem;
    letter-spacing: 1.5px;
    text-align: center;
  }

  .numero-nota {
    text-align: center;
  }
}

.sede-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
}

/* Le due sedi affiancate sulla stessa riga: foto grande sopra, testo compatto sotto */
.sedi {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 3rem 2.5rem;
  margin: 3.5rem 0 0;
  padding: 0;
}

.sede :global(.sede-foto) {
  display: block;
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  border-radius: var(--radius-img);
}

.sede-testo {
  margin-top: 1.5rem;
}

.sede-tipo {
  margin-bottom: .4rem;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
}

.sede-nome {
  margin-bottom: .6rem;
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--dark-navy);
}

.sede-descrizione {
  max-width: 30rem;
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--text-light);
}

.sede-cta {
  margin-top: 1.5rem;
}

@media (max-width: 900px) {
  .sedi {
    gap: 2.5rem 1.5rem;
    margin-top: 2.5rem;
  }
}

/* Una sede sotto l'altra */
@media (max-width: 640px) {
  .sedi {
    grid-template-columns: minmax(0, 1fr);
  }

  .sede-testo {
    margin-top: 1.25rem;
  }
}

@media (max-width: 900px) {
  .fondatrice-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .fondatrice-content {
    display: contents;
  }

  .fondatrice-label {
    order: 1;
  }

  .fondatrice-name {
    order: 2;
    margin-bottom: 1.75rem;
  }

  /* La cornice "--sinistra" sporge a destra e in basso: spazio dentro i margini */
  .fondatrice-visual {
    order: 3;
    margin: 0 1.5rem 3.75rem 0;
  }

  .fondatrice-image-wrapper {
    max-width: none;
  }

  .fondatrice-image-wrapper :global(img) {
    aspect-ratio: 3 / 2;
    object-position: center 25%;
  }

  .fondatrice-bio {
    order: 4;
  }

  .fondatrice-citazione {
    order: 5;
  }

  /* Intestazioni a sinistra, allineate ai contenuti sotto */
  .storia-header {
    text-align: left;
    margin-bottom: 2.5rem;
  }

}

@media (max-width: 768px) {

  .fondatrice-section,
.storia-section,
.sede-section {
    padding: 3.5rem 0;
  }

}

@media (max-width: 480px) {

  .fondatrice-section,
.storia-section,
.sede-section {
    padding: 2.75rem 0;
  }

  .fondatrice-visual {
    margin: 0 0 3rem .75rem;
  }

  .fondatrice-image-wrapper :global(img) {
    aspect-ratio: 4 / 3;
  }


}
</style>
