---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { webp } from '../lib/images';
import { scuola } from '../data/scuola';

const bg: Record<string, string> = {
  'gallery-9.jpg': await webp('gallery-9.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};

const valori = [
  { nome: 'Accoglienza', testo: 'Ogni bambino viene accolto per quello che è, con le sue unicità e il suo potenziale da esprimere attraverso il movimento.' },
  { nome: 'Integrazione', testo: 'Lavoriamo per creare gruppi classe dove le differenze diventano ricchezza e occasione di crescita per tutti.' },
  { nome: 'Professionalità', testo: 'Insegnanti formati e competenti, capaci di adattare le metodologie alle esigenze specifiche di ogni allievo.' },
];

const classi = [
  { nome: 'Danza Classica', href: '/danza-classica' },
  { nome: 'Danza Moderna', href: '/modern' },
  { nome: 'Danza Contemporanea', href: '/danza-contemporanea' },
  { nome: 'Movimento Creativo', href: '/movimento-creativo' },
  { nome: 'Hip Hop', href: '/hip-hop' },
  { nome: 'Propedeutica alla Danza', href: '/avviamento-danza' },
];
---

<Base
    title="Classi Multidisciplinari Integrate - InBallet"
    description="Classi Multidisciplinari Integrate InBallet - Percorsi di danza inclusivi per accogliere ogni bambino con professionalità e attenzione personalizzata."
    ogTitle="Classi Multidisciplinari Integrate - InBallet"
    ogDescription="Percorsi di danza inclusivi dove ogni bambino trova il suo spazio per crescere ed esprimersi."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-9.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Classi Multidisciplinari Integrate</h1>
                <p class="chisiamo-hero-tagline">Percorsi dove ogni bambino trova il suo spazio per crescere, esprimersi e danzare.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="integrate-intro-section">
            <div class="container integrate-intro-layout">
                <div class="integrate-intro-content">
                    <span class="integrate-intro-label eyebrow">Il nostro approccio</span>
                    <h2 class="integrate-intro-title titolo-sezione">Un ambiente dove tutti <em>sono benvenuti</em></h2>
                    <div class="integrate-intro-testo">
                        <p>Quasi tutte le classi che proponiamo hanno la predisposizione tecnica e professionale per poter accogliere casi speciali, entro i livelli di competenza del nostro istituto.</p>
                        <p>Crediamo che la danza sia un linguaggio universale capace di abbattere barriere e creare connessioni. Per questo abbiamo sviluppato un approccio inclusivo che valorizza le unicità di ogni allievo.</p>
                    </div>
                    <div class="integrate-intro-highlight">
                        <p>Il nostro team di insegnanti è formato per accogliere e supportare bambini con bisogni speciali, in un ambiente sicuro dove ognuno può esprimersi liberamente attraverso il movimento.</p>
                    </div>
                </div>
                <div class="integrate-intro-visual foto-cornice">
                    <Img src="gallery-4.jpg" alt="Un'insegnante guida un'allieva durante la lezione" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Valori: intestazione editoriale e tre voci -->
        <section class="integrate-valori-section" aria-labelledby="valori-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">I nostri valori</span>
                <h2 class="titolo-sezione" id="valori-titolo">I principi <em>che ci guidano</em></h2>
                <p>Tre principi che orientano il lavoro in sala, dalla prima lezione all'inserimento nel gruppo classe.</p>
            </div>
            <div class="container">
                <ul class="valori-lista">
                    {valori.map((v) => (
                        <li class="voce">
                            <h3 class="voce-titolo">{v.nome}</h3>
                            <p class="voce-testo">{v.testo}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Classi: intestazione a sinistra, elenco delle discipline (con link al corso) a destra -->
        <section class="integrate-classi-section" aria-labelledby="classi-titolo">
            <div class="container integrate-classi-layout">
                <div class="integrate-classi-header">
                    <span class="eyebrow">Le nostre discipline</span>
                    <h2 class="titolo-sezione" id="classi-titolo">Classi disponibili <em>per l'inserimento</em></h2>
                    <p class="intro-sezione">Molte delle nostre discipline sono predisposte per accogliere allievi con bisogni speciali. Apri un corso per conoscerne livelli e orari.</p>
                </div>
                <ul class="classi-lista">
                    {classi.map((c) => (
                        <li>
                            <a class="classe" href={c.href}>
                                <span class="classe-nome">{c.nome}</span>
                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA -->
        <section class="integrate-cta-section sezione-scura">
            <div class="integrate-cta-bg" style={`background-image: url('${bg['bg-progetti-territorio.jpg']}')`}></div>
            <div class="integrate-cta-overlay"></div>
            <div class="integrate-cta-wrapper">
                <h2 class="titolo-sezione">Parliamo <em>del tuo bambino</em></h2>
                <p class="intro-sezione">Contattaci per un colloquio conoscitivo: insieme troveremo il percorso più adatto.</p>
                <div class="integrate-cta-buttons">
                    <a href={`mailto:${scuola.email}?subject=Classi%20Integrate%20-%20Richiesta%20Informazioni`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Richiedi informazioni
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
/* ---------- Intro ---------- */
.integrate-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.integrate-intro-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 5rem;
  align-items: center;
}

.integrate-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.integrate-intro-title {
  margin-bottom: 1.75rem;
}

.integrate-intro-testo p {
  margin-bottom: 1.25rem;
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--text-dark);
}

.integrate-intro-testo p:last-child {
  margin-bottom: 0;
}

/* La cornice sporge a sinistra e in basso: spazio dentro la colonna */
.integrate-intro-visual {
  max-width: 520px;
  margin: 0 0 1.5rem 1.5rem;
  justify-self: end;
}

.integrate-intro-visual :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

/* ---------- Valori ---------- */
.integrate-valori-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.valori-lista {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 3rem;
  margin: 3.5rem 0 0;
  padding: 0;
}

.valori-lista .voce-testo {
  font-size: 1.0625rem;
}

/* ---------- Classi ---------- */
.integrate-classi-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.integrate-classi-layout {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: start;
}

.integrate-classi-header .titolo-sezione {
  margin-bottom: 1.25rem;
}

.classi-lista {
  list-style: none;
  margin: 0;
  padding: 0;
}

.classi-lista li {
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.classi-lista li:last-child {
  border-bottom: none;
}

.classe {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  padding: 1.35rem 0;
  color: var(--dark-navy);
  text-decoration: none;
}

.classi-lista li:first-child .classe {
  padding-top: .5rem;
}

.classe-nome {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-snug);
  transition: color .3s ease;
}

.classe i {
  font-size: .9375rem;
  color: var(--primary-blue-dark);
  transition: transform .3s ease;
}

@media (hover: hover) and (pointer: fine) {
  .classe:hover .classe-nome {
    color: var(--primary-blue-dark);
  }

  .classe:hover i {
    transform: translateX(6px);
  }
}

/* ---------- CTA ---------- */
.integrate-cta-section {
  position: relative;
  padding: var(--section-y) 0;
  overflow: hidden;
}

.integrate-cta-bg,
.integrate-cta-overlay {
  position: absolute;
  inset: 0;
}

.integrate-cta-bg {
  background: center / cover no-repeat;
}

.integrate-cta-overlay {
  background: linear-gradient(135deg, rgba(26, 26, 26, .9) 0%, rgba(42, 42, 42, .85) 100%);
}

.integrate-cta-wrapper {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.integrate-cta-wrapper .titolo-sezione {
  margin-bottom: 1.25rem;
}

.integrate-cta-wrapper .intro-sezione {
  margin-bottom: 2.5rem;
}

.integrate-cta-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

/* ---------- Tablet ---------- */
@media (max-width: 900px) {
  /* Intro: etichetta e titolo, foto, testo, citazione */
  .integrate-intro-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .integrate-intro-content {
    display: contents;
  }

  .integrate-intro-label {
    order: 1;
  }

  .integrate-intro-title {
    order: 2;
  }

  .integrate-intro-visual {
    order: 3;
    max-width: none;
    margin: 0 0 2.75rem 1.5rem;
  }

  .integrate-intro-visual :global(img) {
    aspect-ratio: 3 / 2;
  }

  .integrate-intro-testo {
    order: 4;
  }

  .integrate-intro-highlight {
    order: 5;
  }

  /* Valori: una colonna */
  .valori-lista {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  /* Classi: intestazione sopra l'elenco */
  .integrate-classi-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .integrate-intro-visual {
    margin: 0 0 2rem .75rem;
  }

  .integrate-intro-visual :global(img) {
    aspect-ratio: 4 / 3;
  }

  .integrate-intro-testo p,
  .valori-lista .voce-testo {
    font-size: 1rem;
  }

  .classe {
    padding: 1.15rem 0;
  }

  .classe-nome {
    font-size: 1.125rem;
  }

  .integrate-cta-wrapper {
    padding: 0 1.5rem;
  }

  .integrate-cta-buttons {
    flex-direction: column;
    align-items: stretch;
  }
}
</style>
