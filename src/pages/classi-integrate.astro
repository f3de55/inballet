---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { webp } from '../lib/images';

const bg: Record<string, string> = {
  'gallery-9.jpg': await webp('gallery-9.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};
---

<Base
    title="Classi Multidisciplinari Integrate - InBallet"
    description="Classi Multidisciplinari Integrate InBallet - Percorsi di danza inclusivi per accogliere ogni bambino con professionalità e attenzione personalizzata."
    ogTitle="Classi Multidisciplinari Integrate - InBallet"
    ogDescription="Percorsi di danza inclusivi dove ogni bambino trova il suo spazio per crescere ed esprimersi."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-9.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Classi Multidisciplinari Integrate</h1>
                <p class="chisiamo-hero-tagline">Percorsi dove ogni bambino trova il suo spazio per crescere, esprimersi e danzare.</p>
            </div>
        </section>

        <!-- Intro Section -->
        <section id="intro" class="integrate-intro-section">
            <div class="integrate-intro-wrapper intro-editoriale">
                <span class="integrate-intro-label eyebrow">Il Nostro Approccio</span>
                <h2 class="integrate-intro-title titolo-sezione">Un ambiente dove tutti <em>sono benvenuti</em></h2>
                <p class="integrate-intro-text">
                    Quasi tutte le classi che proponiamo hanno la predisposizione tecnica e professionale per poter accogliere casi speciali, entro i livelli di competenza del nostro istituto.
                </p>
                <p class="integrate-intro-text">
                    Crediamo che la danza sia un linguaggio universale capace di abbattere barriere e creare connessioni. Per questo abbiamo sviluppato un approccio inclusivo che valorizza le unicità di ogni allievo.
                </p>
                <div class="integrate-intro-highlight">
                    <p>Il nostro team di insegnanti è formato per accogliere e supportare bambini con bisogni speciali, creando un ambiente sicuro dove ognuno può esprimersi liberamente attraverso il movimento.</p>
                </div>
            </div>
        </section>

        <!-- Valori Section - CARD -->
        <section class="integrate-valori-section">
            <div class="integrate-valori-wrapper">
                <div class="integrate-valori-header">
                    <span class="integrate-valori-label eyebrow">I Nostri Valori</span>
                    <h2 class="integrate-valori-title titolo-sezione">I principi <em>che ci guidano</em></h2>
                </div>
                <div class="integrate-valori-grid">
                    <div class="integrate-valore-card voce">
                        <div class="integrate-valore-icon voce-icona">
                            <i class="fas fa-hand-holding-heart"></i>
                        </div>
                        <h3 class="integrate-valore-name voce-titolo">Accoglienza</h3>
                        <p class="integrate-valore-desc voce-testo">Ogni bambino viene accolto per quello che è, con le sue unicità e il suo potenziale da esprimere attraverso il movimento.</p>
                    </div>
                    <div class="integrate-valore-card voce">
                        <div class="integrate-valore-icon voce-icona">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3 class="integrate-valore-name voce-titolo">Integrazione</h3>
                        <p class="integrate-valore-desc voce-testo">Lavoriamo per creare gruppi classe dove le differenze diventano ricchezza e occasione di crescita per tutti.</p>
                    </div>
                    <div class="integrate-valore-card voce">
                        <div class="integrate-valore-icon voce-icona">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <h3 class="integrate-valore-name voce-titolo">Professionalità</h3>
                        <p class="integrate-valore-desc voce-testo">Insegnanti formati e competenti, capaci di adattare le metodologie alle esigenze specifiche di ogni allievo.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Classi Section -->
        <section class="integrate-classi-section sezione-scura">
            <div class="integrate-classi-wrapper">
                <div class="integrate-classi-header">
                    <span class="integrate-classi-label eyebrow">Le Nostre Discipline</span>
                    <h2 class="integrate-classi-title titolo-sezione">Classi disponibili <em>per l'inserimento</em></h2>
                    <p class="integrate-classi-subtitle intro-sezione">Molte delle nostre discipline sono predisposte per accogliere allievi con bisogni speciali.</p>
                </div>
                <div class="integrate-classi-list">
                    <div class="integrate-classe-item">
                        <i class="fas fa-check"></i>
                        <span>Danza Classica</span>
                    </div>
                    <div class="integrate-classe-item">
                        <i class="fas fa-check"></i>
                        <span>Danza Moderna</span>
                    </div>
                    <div class="integrate-classe-item">
                        <i class="fas fa-check"></i>
                        <span>Danza Contemporanea</span>
                    </div>
                    <div class="integrate-classe-item">
                        <i class="fas fa-check"></i>
                        <span>Movimento Creativo</span>
                    </div>
                    <div class="integrate-classe-item">
                        <i class="fas fa-check"></i>
                        <span>Hip Hop</span>
                    </div>
                    <div class="integrate-classe-item">
                        <i class="fas fa-check"></i>
                        <span>Propedeutica alla Danza</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="corso-contatto-section sezione-scura">
            <div class="corso-contatto-bg" style={`background: url('${bg['bg-progetti-territorio.jpg']}') center/cover no-repeat`}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2 class="titolo-sezione">Parliamo <em>del tuo bambino</em></h2>
                    <p class="intro-sezione">Contattaci per un colloquio conoscitivo. Insieme troveremo il percorso più adatto.</p>
                    <a href="mailto:info@inballet.it?subject=Classi%20Integrate%20-%20Richiesta%20Informazioni" class="corso-btn-cta btn-primary">
                        Richiedi Informazioni <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
.integrate-intro-section {
  padding: var(--section-y) 0;
  background: #fff;
}

.integrate-intro-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
}

.integrate-intro-label {
  display: block;
  margin-bottom: 1rem;
  text-align: center;
}

.integrate-intro-title {
  margin-bottom: 2rem;
  text-align: center;
}

.integrate-intro-text {
  font-size: var(--text-lg);
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 1.5rem;
  text-align: center;
}

.integrate-intro-text :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

.integrate-intro-highlight {
  background: rgba(135,206,235,.1);
  border-left: 4px solid var(--primary-blue);
  padding: 1.5rem 2rem;
  border-radius: 0 12px 12px 0;
  margin-top: 2.5rem;
  max-width: 750px;
  margin-left: auto;
  margin-right: auto;
}

.integrate-intro-highlight :global(p) {
  font-size: var(--text-base);
  color: var(--dark-navy);
  font-weight: 500;
  margin: 0;
  line-height: 1.7;
}

.integrate-valori-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.integrate-valori-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2rem;
}

.integrate-valori-header {
  text-align: center;
  margin-bottom: 4rem;
}

.integrate-valori-label {
  display: block;
  margin-bottom: 1rem;
}

.integrate-valori-title {
  margin-bottom: 1rem;
}

.integrate-valori-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 2.5rem;
}

.integrate-classi-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
  position: relative;
  overflow: hidden;
}

.integrate-classi-section::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle,rgba(135,206,235,.06) 0,transparent 70%);
  border-radius: 50%;
}

.integrate-classi-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 2;
}

.integrate-classi-header {
  text-align: center;
  margin-bottom: 3rem;
}

.integrate-classi-label {
  display: block;
  margin-bottom: 1rem;
}

.integrate-classi-title {
  margin-bottom: 1rem;
}

.integrate-classi-subtitle {
  max-width: 600px;
  margin: 0 auto;
}

.integrate-classi-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2rem 3rem;
  margin-top: 2.5rem;
}

.integrate-classe-item {
  display: flex;
  align-items: center;
  gap: .8rem;
}

.integrate-classe-item :global(i) {
  color: var(--primary-blue);
  font-size: 1rem;
}

.integrate-classe-item :global(span) {
  font-size: var(--text-base);
  color: #fff;
  font-weight: 500;
}

@media(max-width:992px) {
  .integrate-valori-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

@media(max-width:600px) {
  .integrate-classi-list {
    grid-template-columns: 1fr;
  }
}
</style>
