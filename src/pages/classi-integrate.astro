---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondoCta } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import { scuola } from '../data/scuola';
import '../styles/components/intro-split.css';
import '../styles/components/righe.css';
import '../styles/pages/classi-integrate.css';

const bg = {
  hero: await heroPagina('classi-integrate'),
  cta: await sfondoCta('foto/bambini-mani.jpg'),
};

const passi = [
  { nome: 'Consulto con la Direzione', icona: 'fa-phone', testo: 'Un primo contatto con la Direzione per <strong>raccontare il bambino o il ragazzo</strong> e le sue esigenze.' },
  { nome: 'Colloquio conoscitivo', icona: 'fa-comments', testo: 'Un incontro per conoscere la famiglia e <strong>capire insieme il percorso più adatto</strong>.' },
  { nome: 'Accoglienza nel gruppo', icona: 'fa-users', testo: "L'inserimento nel <strong>gruppo classe più adeguato</strong>, tra i corsi predisposti ad accogliere casi speciali." },
];

const classi = [
  { nome: 'Avviamento alla Danza', href: '/avviamento-danza' },
  { nome: 'Educazione alla Danza', href: '/educazione-danza' },
  { nome: 'Danza Classica', href: '/danza-classica' },
  { nome: 'Modern', href: '/modern' },
  { nome: 'Danza Contemporanea', href: '/danza-contemporanea' },
  { nome: 'Hip-Hop', href: '/hip-hop' },
];
---

<Base
    title="Classi integrate: danza inclusiva a Lainate e Rho | InBallet"
    description="Classi di danza integrate a Lainate e Rho (MI) per bambini e ragazzi con bisogni speciali: colloquio con la famiglia e inserimento nel gruppo più adatto."
    ogTitle="Classi Multidisciplinari Integrate | InBallet"
    ogDescription="Quasi tutti i corsi InBallet possono accogliere bambini e ragazzi con bisogni speciali, dopo un colloquio con la famiglia."
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Section -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Classi Multidisciplinari Integrate</h1>
                <p class="hero-lead">Quasi tutti i nostri corsi possono accogliere bambini e ragazzi con <strong>bisogni speciali</strong>.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="intro-split">
            <div class="container intro-split-layout">
                <div class="intro-split-content">
                    <p class="intro-split-label eyebrow">Il nostro approccio</p>
                    <h2 class="intro-split-title titolo-sezione">Un ambiente dove tutti <em>sono benvenuti</em></h2>
                    <div class="intro-split-testo">
                        <p>Quasi tutte le classi di InBallet hanno la <strong>predisposizione tecnica e professionale</strong> per accogliere bambini e ragazzi con bisogni speciali, entro il nostro livello di preparazione.</p>
                        <p>Si parte sempre da un <strong>consulto con la Direzione</strong> e da un <strong>colloquio con la famiglia</strong>, per scegliere insieme il gruppo classe più adeguato.</p>
                    </div>
                    <div class="intro-split-highlight">
                        <p>La danza è capace di creare racconti in tutti i corpi e in tutte le menti: per questo l'<strong>inclusione</strong> è centrale in ogni fascia d'età.</p>
                    </div>
                </div>
                <div class="intro-split-visual foto-cornice">
                    <Img src="gallery-4.jpg" alt="Un'insegnante guida un'allieva durante la lezione" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Valori: intestazione editoriale e tre voci -->
        <section class="integrate-valori-section" aria-labelledby="valori-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">Come funziona</p>
                <h2 class="titolo-sezione" id="valori-titolo">Dal primo contatto <em>alla classe</em></h2>
                <p>Tre passaggi per costruire un'<strong>accoglienza su misura</strong>, insieme alla famiglia.</p>
            </div>
            <div class="container">
                <ol class="valori-lista">
                    {passi.map((v) => (
                        <li class="voce">
                            <i class={`fas ${v.icona} voce-icona`} aria-hidden="true"></i>
                            <h3 class="voce-titolo">{v.nome}</h3>
                            <p class="voce-testo" set:html={v.testo} />
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- Classi: intestazione a sinistra, elenco delle discipline (con link al corso) a destra -->
        <section class="split-section decoro-onde decoro-onde--sinistra" aria-labelledby="classi-titolo">
            <div class="container split-layout">
                <div class="split-header">
                    <p class="eyebrow">Le nostre discipline</p>
                    <h2 class="titolo-sezione" id="classi-titolo">Classi disponibili <em>per l'inserimento</em></h2>
                    <p class="intro-sezione">Alcuni dei corsi predisposti per l'inserimento: apri un corso per conoscerne <strong>età e livelli</strong>. Per i ragazzi con disabilità c'è anche il <a href="/progetto-noiconvoi">progetto NoiConVoi</a>, il <strong>lunedì sera</strong>.</p>
                </div>
                <ul class="righe">
                    {classi.map((c) => (
                        <li>
                            <a class="riga" href={c.href}>
                                <p class="riga-nome">{c.nome}</p>
                                <i class="riga-freccia fas fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Parliamo <em>del tuo bambino</em></h2>
                <p class="intro-sezione">Contatta la Direzione per fissare un <strong>colloquio conoscitivo</strong>: insieme troveremo il gruppo classe più adatto.</p>
                <div class="cta-pulsanti">
                    <a href={`mailto:${scuola.email}?subject=Classi%20Integrate%20-%20Richiesta%20Informazioni`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Richiedi informazioni
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>
