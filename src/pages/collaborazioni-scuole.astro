---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondo } from '../lib/images';
import { scuola } from '../data/scuola';

const bg = {
  hero: await sfondo('bg-progetti-territorio.jpg', { desktop: '50% 35%', tablet: '50% 50%' }),
  cta: await sfondo('gallery-4.jpg', { desktop: '50% 20%' }),
};

const fasce = [
  { eta: '0-6', nome: "Nidi e scuole dell'infanzia" },
  { eta: '6-11', nome: 'Scuole primarie' },
  { eta: '11-14', nome: 'Secondarie di primo grado' },
  { eta: '14-19', nome: 'Secondarie di secondo grado' },
];

const progetti = [
  { nome: 'Progetti su misura', testo: 'Costruiti con la scuola, sulle sue richieste educative e didattiche.' },
  { nome: 'Co-progettazione con i docenti', testo: "Con il team degli insegnanti o l'équipe, dall'idea alla realizzazione." },
  { nome: 'Supporto psicomotorio', testo: "Sempre presente, a sostegno dell'integrazione sociale dei bambini." },
  { nome: 'Inclusione', testo: "L'esperienza delle nostre classi integrate e di NoiConVoi, dal 2013." },
  { nome: 'Momenti ed eventi a scuola', testo: 'Eventi personalizzati, curati nella parte artistica e organizzativa.' },
  { nome: 'Formazione per i docenti', testo: 'Corsi su linguaggi espressivi, corporeità e motricità.' },
]
---

<Base
    title="Progetti di danza nelle scuole del territorio | InBallet"
    description="Progetti di danza su misura con supporto psicomotorio per nidi, scuole dell'infanzia, primarie e secondarie, a Lainate, Rho e in provincia di Milano."
    ogTitle="Collaborazioni con le scuole | InBallet"
    ogDescription="Da molti anni portiamo la danza nelle scuole del territorio, con progetti educativi costruiti insieme ai docenti."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Collaborazioni con le scuole</h1>
                <p class="chisiamo-hero-tagline">Progetti educativi di danza e movimento, dal nido alle secondarie di secondo grado.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="collab-intro-section">
            <div class="container collab-intro-layout">
                <div class="collab-intro-content">
                    <span class="collab-intro-label eyebrow">Danza a scuola</span>
                    <h2 class="collab-intro-title titolo-sezione">Da molti anni accanto <em>alle scuole del territorio</em></h2>
                    <div class="collab-intro-testo">
                        <p>Da molti anni la Direzione di I.N. Ballet collabora con le scuole del territorio: nidi e scuole dell'infanzia, scuole primarie, scuole secondarie di primo e di secondo grado.</p>
                        <p>Realizziamo progetti utili e personalizzati in base alle richieste educative e didattiche di ogni scuola, in collaborazione con il team degli insegnanti o con l'équipe di lavoro.</p>
                    </div>
                    <div class="collab-intro-highlight">
                        <p>In ogni progetto è sempre previsto il supporto psicomotorio ai bambini, a sostegno dell'integrazione sociale: la danza diventa fonte educativa per bambini, ragazzi e adulti.</p>
                    </div>
                </div>
                <div class="collab-intro-visual foto-cornice">
                    <Img src="gallery-7.jpg" alt="Lo staff di InBallet in sala" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Fasce d'età: intestazione editoriale e quattro numeri -->
        <section class="collab-fasce-section" aria-labelledby="fasce-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">A chi ci rivolgiamo</span>
                <h2 class="titolo-sezione" id="fasce-titolo">Progetti per ogni <em>fascia d'età</em></h2>
                <p>Collaboriamo con tutte le tipologie di istituti scolastici, adattando i nostri programmi alle specifiche esigenze.</p>
            </div>
            <div class="container">
                <ul class="fasce-lista">
                    {fasce.map((f) => (
                        <li class="fascia">
                            <span class="fascia-eta">{f.eta}<span class="fascia-anni"> anni</span></span>
                            <span class="fascia-nome">{f.nome}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Progetti: intestazione a sinistra (fissa su desktop), elenco numerato a destra -->
        <section class="collab-progetti-section" aria-labelledby="progetti-titolo">
            <div class="container collab-progetti-layout">
                <div class="collab-progetti-header">
                    <span class="eyebrow">I nostri progetti</span>
                    <h2 class="titolo-sezione" id="progetti-titolo">Cosa possiamo offrire <em>alla tua scuola</em></h2>
                    <p class="intro-sezione">Programmi flessibili, costruiti sulle richieste educative e didattiche di ogni scuola.</p>
                </div>
                <ol class="progetti-lista">
                    {progetti.map((p, i) => (
                        <li class="progetto">
                            <span class="progetto-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                            <div>
                                <h3 class="progetto-nome">{p.nome}</h3>
                                <p class="progetto-testo">{p.testo}</p>
                            </div>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- CTA -->
        <section class="collab-cta-section sezione-scura">
            <div class="collab-cta-bg" style={bg.cta.style}></div>
            <div class="collab-cta-overlay"></div>
            <div class="collab-cta-wrapper">
                <h2 class="titolo-sezione">Portiamo la danza <em>nella tua scuola</em></h2>
                <p class="intro-sezione">Contattaci per un incontro conoscitivo senza impegno: ti presentiamo le nostre proposte e costruiamo insieme un progetto su misura per la tua scuola.</p>
                <div class="collab-cta-buttons">
                    <a href={`mailto:${scuola.email}?subject=Collaborazione%20Scuola`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Richiedi informazioni
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
/* ---------- Intro ---------- */
.collab-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.collab-intro-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 5rem;
  align-items: center;
}

.collab-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.collab-intro-title {
  margin-bottom: 1.75rem;
}

.collab-intro-testo p {
  margin-bottom: 1.25rem;
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-dark);
}

.collab-intro-testo p:last-child {
  margin-bottom: 0;
}

/* La cornice sporge a sinistra e in basso: spazio dentro la colonna */
.collab-intro-visual {
  max-width: 520px;
  margin: 0 0 1.5rem 1.5rem;
  justify-self: end;
}

.collab-intro-visual :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

/* ---------- Fasce d'età ---------- */
.collab-fasce-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

/* Il gap da 1px sul fondo scuro disegna i filetti solo tra le celle */
/* Quattro card bianche separate sul fondo azzurrino della sezione */
.fasce-lista {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1.5rem;
  margin: 3.5rem 0 0;
  padding: 0;
}

.fascia {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  align-items: center;
  justify-content: center;
  padding: 2rem 1.75rem;
  text-align: center;
  background: var(--white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.fascia-eta {
  font-size: var(--text-5xl);
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--primary-blue-dark);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.fascia-anni {
  margin-left: .1em;
  font-size: var(--text-base);
  font-weight: 400;
  letter-spacing: 0;
  color: var(--primary-blue-dark);
}

.fascia-nome {
  font-size: var(--text-base);
  font-weight: 400;
  color: var(--text-dark);
}

/* ---------- Progetti ---------- */
.collab-progetti-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.collab-progetti-layout {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: start;
}

.collab-progetti-header {
  position: sticky;
  top: calc(var(--header-h) + var(--banner-height, 0px) + 2rem);
}

.collab-progetti-header .titolo-sezione {
  margin-bottom: 1.25rem;
}

.progetti-lista {
  list-style: none;
  margin: 0;
  padding: 0;
}

.progetto {
  display: grid;
  grid-template-columns: 3rem minmax(0, 1fr);
  gap: 1rem;
  padding: 1.75rem 0;
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.progetto:first-child {
  padding-top: 0;
}

.progetto:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.progetto-num {
  padding-top: .3rem;
  font-size: var(--text-xl);
  font-weight: 300;
  color: var(--primary-blue-dark);
  font-variant-numeric: tabular-nums;
}

.progetto-nome {
  margin-bottom: .5rem;
  font-size: var(--text-xl);
  font-weight: 500;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
}

.progetto-testo {
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--text-light);
}

/* ---------- CTA ---------- */
.collab-cta-section {
  position: relative;
  padding: var(--section-y) 0;
  overflow: hidden;
}

.collab-cta-bg,
.collab-cta-overlay {
  position: absolute;
  inset: 0;
}

.collab-cta-bg {
  background: center / cover no-repeat;
}

.collab-cta-overlay {
  background: linear-gradient(135deg, rgba(26, 26, 26, .9) 0%, rgba(42, 42, 42, .85) 100%);
}

.collab-cta-wrapper {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.collab-cta-wrapper .titolo-sezione {
  margin-bottom: 1.25rem;
}

.collab-cta-wrapper .intro-sezione {
  margin-bottom: 2.5rem;
}

.collab-cta-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

/* ---------- Tablet ---------- */
@media (max-width: 1024px) {
  .fascia {
    padding: 1.75rem 1.5rem;
  }
}

@media (max-width: 900px) {
  /* Intro: etichetta e titolo, foto, testo, citazione */
  .collab-intro-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .collab-intro-content {
    display: contents;
  }

  .collab-intro-label {
    order: 1;
  }

  .collab-intro-title {
    order: 2;
  }

  .collab-intro-visual {
    order: 3;
    max-width: none;
    margin: 0 0 2.75rem 1.5rem;
  }

  .collab-intro-visual :global(img) {
    aspect-ratio: 3 / 2;
  }

  .collab-intro-testo {
    order: 4;
  }

  .collab-intro-highlight {
    order: 5;
  }

  /* Fasce: griglia 2x2 */
  .fasce-lista {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  /* Progetti: intestazione sopra l'elenco */
  .collab-progetti-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  .collab-progetti-header {
    position: static;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .collab-intro-visual {
    margin: 0 0 2rem .75rem;
  }

  .collab-intro-visual :global(img) {
    aspect-ratio: 4 / 3;
  }


  .fascia {
    gap: .5rem;
    padding: 1.5rem 1.25rem;
  }




  .progetto {
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: .75rem;
    padding: 1.5rem 0;
  }



  .collab-cta-wrapper {
    padding: 0 1.5rem;
  }

  .collab-cta-buttons {
    flex-direction: column;
    align-items: center;
  }
}
/* Schermi molto stretti (320px): una fascia per riga, senza scorrimento orizzontale */
@media (max-width: 400px) {
  .fasce-lista {
    grid-template-columns: minmax(0, 1fr);
  }
}
</style>
