---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondoCta } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import { scuola } from '../data/scuola';
import '../styles/components/intro-split.css';
import '../styles/components/righe.css';
import '../styles/pages/collaborazioni-scuole.css';

const bg = {
  hero: await heroPagina('collaborazioni-scuole'),
  cta: await sfondoCta('gallery-4.jpg', { desktop: '50% 20%' }),
};

const fasce = [
  { eta: '0-6', icona: 'fa-baby', nome: "Nidi e scuole dell'infanzia" },
  { eta: '6-11', icona: 'fa-child', nome: 'Scuole primarie' },
  { eta: '11-14', icona: 'fa-book-open', nome: 'Secondarie di primo grado' },
  { eta: '14-19', icona: 'fa-graduation-cap', nome: 'Secondarie di secondo grado' },
];

const progetti = [
  { nome: 'Progetti su misura', icona: 'fa-puzzle-piece', testo: '<strong>Costruiti con i docenti</strong>, sulle richieste della scuola.' },
  { nome: 'Supporto psicomotorio', icona: 'fa-hands-holding', testo: "<strong>Sempre presente</strong>, per l'integrazione dei bambini." },
  { nome: 'Eventi a scuola', icona: 'fa-masks-theater', testo: 'Curati nella <strong>parte artistica e organizzativa</strong>.' },
  { nome: 'Formazione per i docenti', icona: 'fa-chalkboard-user', testo: '<strong>Linguaggi espressivi</strong>, corporeità e motricità.' },
];
---

<Base
    title="Progetti di danza nelle scuole del territorio | InBallet"
    description="Progetti di danza su misura con supporto psicomotorio per nidi, scuole dell'infanzia, primarie e secondarie, a Lainate, Rho e in provincia di Milano."
    ogTitle="Collaborazioni con le scuole | InBallet"
    ogDescription="Da molti anni portiamo la danza nelle scuole del territorio, con progetti educativi costruiti insieme ai docenti."
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Section -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Collaborazioni con le scuole</h1>
                <p class="hero-lead">Progetti educativi di danza e movimento, <strong>dal nido alle secondarie di secondo grado</strong>.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="intro-split">
            <div class="container intro-split-layout">
                <div class="intro-split-content">
                    <p class="intro-split-label eyebrow">Danza a scuola</p>
                    <h2 class="intro-split-title titolo-sezione">Da molti anni accanto <em>alle scuole del territorio</em></h2>
                    <div class="intro-split-testo">
                        <p>I.N. Ballet collabora con nidi, scuole dell'infanzia, primarie e secondarie di primo e secondo grado, a <strong>Lainate, Rho e in provincia di Milano</strong>.</p>
                        <p>Ogni progetto nasce dalle <strong>richieste educative e didattiche della scuola</strong> ed è costruito con il team degli insegnanti o con l'équipe di lavoro.</p>
                    </div>
                    <div class="intro-split-highlight">
                        <p>In ogni progetto c'è il <strong>supporto psicomotorio</strong> ai bambini, a sostegno dell'integrazione sociale.</p>
                    </div>
                </div>
                <div class="intro-split-visual foto-cornice">
                    <Img src="gallery-7.jpg" alt="Lo staff di InBallet in sala" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Fasce d'età: intestazione editoriale e quattro numeri -->
        <section class="collab-fasce-section" aria-labelledby="fasce-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">A chi ci rivolgiamo</p>
                <h2 class="titolo-sezione" id="fasce-titolo">Progetti per ogni <em>fascia d'età</em></h2>
                <p>Adattiamo i programmi a <strong>ogni tipo di istituto</strong> e alle sue esigenze.</p>
            </div>
            <div class="container">
                <ul class="fasce-lista">
                    {fasce.map((f) => (
                        <li class="fascia">
                            <i class={`fas ${f.icona} fascia-icona`} aria-hidden="true"></i>
                            <h3 class="fascia-eta">{f.eta} anni</h3>
                            <p class="fascia-nome">{f.nome}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Progetti: intestazione a sinistra (fissa su desktop), elenco numerato a destra -->
        <section class="split-section decoro-onde" aria-labelledby="progetti-titolo">
            <div class="container split-layout">
                <div class="split-header split-header--sticky">
                    <p class="eyebrow">I nostri progetti</p>
                    <h2 class="titolo-sezione" id="progetti-titolo">Cosa possiamo offrire <em>alla tua scuola</em></h2>
                    <p class="intro-sezione"><strong>Programmi flessibili</strong>, costruiti sulle richieste educative e didattiche di ogni scuola.</p>
                </div>
                <ol class="righe">
                    {progetti.map((p) => (
                        <li class="riga">
                            <i class={`riga-icona fas ${p.icona}`} aria-hidden="true"></i>
                            <div class="riga-corpo">
                                <p class="riga-nome">{p.nome}</p>
                                <p set:html={p.testo} />
                            </div>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- CTA -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Portiamo la danza <em>nella tua scuola</em></h2>
                <p class="intro-sezione">Contattaci per un <strong>incontro conoscitivo senza impegno</strong>: costruiamo insieme un progetto su misura per la tua scuola.</p>
                <div class="cta-pulsanti">
                    <a href={`mailto:${scuola.email}?subject=Collaborazione%20Scuola`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Richiedi informazioni
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>
