---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { webp } from '../lib/images';

const bg: Record<string, string> = {
  'gallery-4.jpg': await webp('gallery-4.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};
---

<Base
    title="Collaborazioni con Scuole - InBallet"
    description="Collaborazioni con scuole del territorio - InBallet porta la danza nelle scuole con progetti educativi personalizzati per nidi, infanzia, primarie e secondarie."
    ogTitle="Collaborazioni con Scuole - InBallet"
    ogDescription="Portiamo la danza nelle scuole con progetti educativi personalizzati. Scopri come collaborare con InBallet."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['bg-progetti-territorio.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Collaborazioni con Scuole</h1>
                <p class="chisiamo-hero-tagline">Progetti educativi di danza e movimento per le scuole.</p>
            </div>
        </section>

        <!-- Intro Section -->
        <section id="intro" class="collab-intro-section">
            <div class="container">
                <div class="collab-intro-layout">
                    <div class="collab-intro-content">
                        <span class="collab-intro-label eyebrow">Chi Siamo</span>
                        <h2 class="collab-intro-title titolo-sezione">Da oltre 15 anni partner <em>delle scuole del territorio</em></h2>
                        <p class="collab-intro-text">
                            La Direzione I.N.BALLET collabora con le scuole del territorio offrendo progetti personalizzati che integrano la danza e il movimento nell'attività educativa.
                        </p>
                        <p class="collab-intro-text">
                            I nostri interventi sono progettati per favorire lo sviluppo psicomotorio, la socializzazione e l'integrazione attraverso il linguaggio universale del movimento.
                        </p>
                        <div class="collab-intro-highlight">
                            <p>Ogni progetto è costruito insieme alla scuola, rispettando le esigenze specifiche di ogni fascia d'età e contesto educativo.</p>
                        </div>
                    </div>
                    <div class="collab-intro-visual foto-cornice">
                        <Img src="gallery-7.jpg" alt="Lo staff di InBallet in sala" class="collab-intro-image" />
                    </div>
                </div>
            </div>
        </section>

        <!-- Target Section -->
        <section class="collab-target-section">
            <div class="collab-target-wrapper">
                <div class="collab-target-header">
                    <span class="collab-target-label eyebrow">A Chi Ci Rivolgiamo</span>
                    <h2 class="collab-target-title titolo-sezione">Progetti per ogni <em>fascia d'età</em></h2>
                    <p class="collab-target-subtitle intro-sezione">Collaboriamo con tutte le tipologie di istituti scolastici, adattando i nostri programmi alle specifiche esigenze.</p>
                </div>
                <div class="collab-target-grid">
                    <div class="collab-target-item voce">
                        <div class="collab-target-icon voce-icona">
                            <i class="fas fa-baby"></i>
                        </div>
                        <h3 class="collab-target-name voce-titolo">Asili Nido</h3>
                        <p class="collab-target-age voce-testo">0-3 anni</p>
                    </div>
                    <div class="collab-target-item voce">
                        <div class="collab-target-icon voce-icona">
                            <i class="fas fa-child"></i>
                        </div>
                        <h3 class="collab-target-name voce-titolo">Scuole dell'Infanzia</h3>
                        <p class="collab-target-age voce-testo">3-6 anni</p>
                    </div>
                    <div class="collab-target-item voce">
                        <div class="collab-target-icon voce-icona">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <h3 class="collab-target-name voce-titolo">Scuole Primarie</h3>
                        <p class="collab-target-age voce-testo">6-11 anni</p>
                    </div>
                    <div class="collab-target-item voce">
                        <div class="collab-target-icon voce-icona">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <h3 class="collab-target-name voce-titolo">Scuole Secondarie</h3>
                        <p class="collab-target-age voce-testo">11-14 anni</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Progetti Section -->
        <section class="collab-progetti-section">
            <div class="collab-progetti-wrapper">
                <div class="collab-progetti-header">
                    <span class="collab-progetti-label eyebrow">I Nostri Progetti</span>
                    <h2 class="collab-progetti-title titolo-sezione">Cosa possiamo offrire <em>alla tua scuola</em></h2>
                    <p class="collab-progetti-subtitle intro-sezione">Programmi flessibili e personalizzabili, sviluppati da professionisti con esperienza nel mondo educativo.</p>
                </div>
                <div class="collab-progetti-list">
                    <div class="collab-progetto-item">
                        <div class="collab-progetto-icon">
                            <i class="fas fa-music"></i>
                        </div>
                        <div class="collab-progetto-content">
                            <h3 class="collab-progetto-name">Educazione al Movimento</h3>
                            <p class="collab-progetto-desc">Percorsi di psicomotricità e movimento creativo per sviluppare coordinazione, equilibrio e consapevolezza corporea fin dalla prima infanzia.</p>
                        </div>
                    </div>
                    <div class="collab-progetto-item">
                        <div class="collab-progetto-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="collab-progetto-content">
                            <h3 class="collab-progetto-name">Laboratori Espressivi</h3>
                            <p class="collab-progetto-desc">Attività che uniscono danza, musica e teatro per stimolare la creatività, l'espressione emotiva e le capacità relazionali dei bambini.</p>
                        </div>
                    </div>
                    <div class="collab-progetto-item">
                        <div class="collab-progetto-icon">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div class="collab-progetto-content">
                            <h3 class="collab-progetto-name">Progetti Inclusivi</h3>
                            <p class="collab-progetto-desc">Programmi specifici per l'integrazione e l'inclusione sociale attraverso la danza, favorendo l'accoglienza delle diversità.</p>
                        </div>
                    </div>
                    <div class="collab-progetto-item">
                        <div class="collab-progetto-icon">
                            <i class="fas fa-theater-masks"></i>
                        </div>
                        <div class="collab-progetto-content">
                            <h3 class="collab-progetto-name">Spettacoli di Fine Anno</h3>
                            <p class="collab-progetto-desc">Supporto nella creazione di performance per saggi e eventi scolastici, con coreografie adatte all'età e al livello dei partecipanti.</p>
                        </div>
                    </div>
                    <div class="collab-progetto-item">
                        <div class="collab-progetto-icon">
                            <i class="fas fa-chalkboard-teacher"></i>
                        </div>
                        <div class="collab-progetto-content">
                            <h3 class="collab-progetto-name">Formazione Docenti</h3>
                            <p class="collab-progetto-desc">Workshop e corsi di aggiornamento per insegnanti, per integrare il movimento nelle attività didattiche quotidiane.</p>
                        </div>
                    </div>
                    <div class="collab-progetto-item">
                        <div class="collab-progetto-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div class="collab-progetto-content">
                            <h3 class="collab-progetto-name">Progetti PON/PTOF</h3>
                            <p class="collab-progetto-desc">Collaborazione per progetti finanziati, con documentazione completa e supporto nella pianificazione delle attività.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="collab-cta-section sezione-scura">
            <div class="collab-cta-bg" style={`background-image: url('${bg['gallery-4.jpg']}')`}></div>
            <div class="collab-cta-overlay"></div>
            <div class="collab-cta-wrapper">
                <h2 class="collab-cta-title titolo-sezione">Portiamo la danza <em>nella tua scuola</em></h2>
                <p class="collab-cta-text intro-sezione">Contattaci per un incontro conoscitivo senza impegno. Saremo lieti di presentarti le nostre proposte e costruire insieme un progetto su misura per la tua scuola.</p>
                <div class="collab-cta-buttons">
                    <a href="mailto:info@inballet.it?subject=Collaborazione%20Scuola" class="collab-cta-btn collab-cta-btn-primary btn-primary">
                        <i class="fas fa-envelope"></i> Richiedi Informazioni
                    </a>
                    <a href="tel:+393937802996" class="collab-cta-btn collab-cta-btn-secondary btn-secondary">
                        <i class="fas fa-phone"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
.collab-intro-section {
  padding: var(--section-y) 0;
  background: #fff;
}

.collab-intro-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  max-width: 1100px;
  margin: 0 auto;
}

.collab-intro-content {
  max-width: 540px;
}

.collab-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.collab-intro-title {
  margin-bottom: 1.5rem;
}

.collab-intro-text {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 1.5rem;
}

.collab-intro-text :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

.collab-intro-highlight {
  background: rgba(135,206,235,.1);
  border-left: 4px solid var(--primary-blue);
  padding: 1.5rem;
  border-radius: 0 12px 12px 0;
  margin-top: 2rem;
}

.collab-intro-highlight :global(p) {
  font-size: var(--text-lg);
  color: var(--dark-navy);
  font-weight: 500;
  margin: 0;
  line-height: 1.6;
}

.collab-intro-visual {
  align-self: center;
}

.collab-intro-image {
  width: 100%;
}

.collab-target-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.collab-target-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2rem;
}

.collab-target-header {
  text-align: center;
  margin-bottom: 4rem;
}

.collab-target-label {
  display: block;
  margin-bottom: 1rem;
}

.collab-target-title {
  margin-bottom: 1rem;
}

.collab-target-subtitle {
  max-width: 600px;
  margin: 0 auto;
}

.collab-target-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 2rem;
}

.collab-progetti-section {
  padding: var(--section-y) 0;
  background: #fff;
}

.collab-progetti-wrapper {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 2rem;
}

.collab-progetti-header {
  text-align: center;
  margin-bottom: 4rem;
}

.collab-progetti-label {
  display: block;
  margin-bottom: 1rem;
}

.collab-progetti-title {
  margin-bottom: 1rem;
}

.collab-progetti-subtitle {
  max-width: 650px;
  margin: 0 auto;
}

.collab-progetti-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2.5rem 4rem;
}

.collab-progetto-item {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
}

.collab-progetto-icon {
  width: 1.75rem;
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  padding-top: .15rem;
  color: var(--primary-blue-dark);
  font-size: 1.25rem;
  flex-shrink: 0;
}

.collab-progetto-name {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--dark-navy);
  margin-bottom: .4rem;
}

.collab-progetto-desc {
  font-size: var(--text-sm);
  color: var(--text-light);
  line-height: 1.6;
}

.collab-cta-section {
  padding: var(--section-y) 0;
  position: relative;
  overflow: hidden;
}

.collab-cta-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: center/cover no-repeat;
  z-index: 1;
}

.collab-cta-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg,rgba(26,26,26,.9) 0%,rgba(42,42,42,.85) 100%);
  z-index: 2;
}

.collab-cta-wrapper {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 3;
  text-align: center;
}

.collab-cta-title {
  margin-bottom: 1rem;
}

.collab-cta-text {
  margin-bottom: 2.5rem;
}

.collab-cta-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

@media(max-width:992px) {
  .collab-intro-layout {
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .collab-intro-visual {
    order: -1;
  }

  .collab-target-grid {
    grid-template-columns: repeat(2,1fr);
  }
}

@media(max-width:600px) {
  .collab-target-grid {
    grid-template-columns: 1fr;
  }

}
</style>
