---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Galleria from '../components/Galleria.astro';
import { heroPagina } from '../lib/hero-pagine';
import { categorieCorsi, scuola, sedi, orari } from '../data/scuola';
import '../styles/pages/contatti.css';

const { telefono: TEL, telefonoHref: TEL_HREF, email: EMAIL } = scuola;

const bg = {
  hero: await heroPagina('contatti'),
};

/** Settimana da lunedì con gli orari di scuola.ts (aggiornati poi da Google, se disponibile). */
const ABBR: Record<string, string> = { Monday: 'Lun', Tuesday: 'Mar', Wednesday: 'Mer', Thursday: 'Gio', Friday: 'Ven', Saturday: 'Sab', Sunday: 'Dom' };
// I fondamenti di InBallet, in sintesi dai contenuti del sito (Chi siamo, FAQ, Classi Integrate,
// Sportello Psicologico, Formazione Insegnanti)
const totaleCorsi = categorieCorsi.reduce((n, c) => n + c.corsi.length, 0);
const fondamenti = [
  { icona: 'fa-child', titolo: 'Ogni età', testo: 'Dai 3 anni, senza limiti', href: '/corsi' },
  { icona: 'fa-layer-group', titolo: 'Classi per livello', testo: `${totaleCorsi} corsi divisi per livello`, href: '/corsi' },
  { icona: 'fa-universal-access', titolo: 'Inclusione', testo: 'Classi aperte ai bisogni speciali', href: '/classi-integrate' },
  { icona: 'fa-house-user', titolo: 'Comunità educante', testo: 'In dialogo con le famiglie', href: '/sportello-psicologico' },
  { icona: 'fa-masks-theater', titolo: 'In teatro ogni anno', testo: 'Lo spettacolo degli allievi', href: '/spettacoli-eventi' },
  { icona: 'fa-graduation-cap', titolo: 'Ente formativo', testo: 'Titolo CSEN e CONI', href: '/formazione-insegnanti' },
];

const settimana = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'].map((giorno) => {
  const o = orari.find((x) => x.giorni.some((d) => ABBR[d] === giorno));
  return { giorno, apre: o?.apre, chiude: o?.chiude };
});
---

<Base
    title="Contatti e sedi a Lainate e Rho | InBallet"
    description={`Contatti InBallet: ${TEL}, e-mail e WhatsApp. Sedi in ${sedi[0].via} a Lainate e ${sedi[1].via} a Rho (MI) e orari della segreteria.`}
    ogTitle="Contatti e sedi | InBallet"
    ogDescription="Due sedi a Lainate e Rho: chiamaci o scrivici per scegliere il corso giusto."
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>
    <!-- Hero -->
    <section class="chisiamo-hero hero-banner">
        <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">Contatti e sedi</h1>
            <p class="hero-lead"><strong>Due sedi</strong> a Lainate e Rho, a nord-ovest di Milano: chiamaci, scrivici o passa in segreteria.</p>
        </div>
    </section>

    <!-- Contatti: intro, poi tre blocchi distinti (scrivici, sedi, orari) -->
    <section id="contatti" class="contatti decoro-onde">
        <div class="container">
            <header class="contatti-intro">
                <p class="eyebrow">Scuola di danza a Lainate e Rho</p>
                <h2 class="titolo-sezione">Il primo passo è un <em>passo di danza</em></h2>
                <p class="intro-sezione">
                    Raccontaci chi sei e cosa vorresti imparare: ti aiutiamo a scegliere
                    il corso giusto per <strong>età e livello</strong>, con orari e iscrizione.
                </p>
            </header>

            <div class="info">
                <div class="info-blocco">
                    <h3 class="info-titolo">Recapiti</h3>
                    <div class="info-corpo">
                    <ul class="info-righe">
                        <li class="info-riga">
                            <i class="fas fa-phone info-icona" aria-hidden="true"></i>
                            <a class="info-valore" href={TEL_HREF}>{TEL}</a>
                        </li>
                        <li class="info-riga">
                            <i class="fas fa-envelope info-icona" aria-hidden="true"></i>
                            <a class="info-valore" href={`mailto:${EMAIL}`}>{EMAIL}</a>
                        </li>
                        <li class="info-riga">
                            <i class="fab fa-whatsapp info-icona" aria-hidden="true"></i>
                            <a class="info-valore" href={scuola.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
                        </li>
                        <li class="info-riga">
                            <i class="fab fa-instagram info-icona" aria-hidden="true"></i>
                            <a class="info-valore" href={scuola.social.instagram} target="_blank" rel="noopener">Instagram</a>
                        </li>
                        <li class="info-riga">
                            <i class="fab fa-facebook info-icona" aria-hidden="true"></i>
                            <a class="info-valore" href={scuola.social.facebook} target="_blank" rel="noopener">Facebook</a>
                        </li>
                    </ul>
                    </div>
                </div>

                <div class="info-blocco">
                    <h3 class="info-titolo">Le nostre sedi</h3>
                    <div class="info-corpo">
                    <ul class="info-righe">
                        {sedi.map((sede, i) => (
                            <li class="info-riga sede">
                                <i class="fas fa-location-dot info-icona" aria-hidden="true"></i>
                                <div>
                                    <p class="info-valore">{sede.citta}{i === 0 && <span class="sede-tag">sede centrale</span>}</p>
                                    <address class="sede-indirizzo">{sede.via}<br>{sede.cap} {sede.citta} ({sede.provincia})</address>
                                    <a href={sede.maps} target="_blank" rel="noopener" class="link-cta">
                                        Indicazioni <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </li>
                        ))}
                    </ul>
                    </div>
                </div>

                <div class="info-blocco">
                    <h3 class="info-titolo">Orari segreteria</h3>
                    <div class="info-corpo">
                    <p id="open-status" class="orari-status" aria-live="polite"></p>
                    <ul class="orari-grid" id="orari-grid">
                        {settimana.map((s) => (
                            <li class="orario-item" data-giorno={s.giorno} data-apre={s.apre} data-chiude={s.chiude}>
                                <p class="orario-day">{s.giorno}</p>
                                {s.apre
                                    ? <p class="orario-time">{s.apre}–{s.chiude}</p>
                                    : <p class="orario-time chiuso">Chiuso</p>}
                            </li>
                        ))}
                    </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- I fondamenti di InBallet: titolo centrato, poi sei punti (icona nel cerchio, titolo, una riga).
         Desktop tre colonne con l'icona sopra il testo, tablet due e mobile una con l'icona a sinistra -->
    <section class="fondamenti sezione-scura" aria-labelledby="fondamenti-titolo">
        <div class="container fondamenti-layout">
            <div class="fondamenti-intro">
                <p class="eyebrow">I fondamenti di InBallet</p>
                <h2 class="titolo-sezione" id="fondamenti-titolo">Perché scegliere <em>InBallet</em></h2>
            </div>
            <ul class="fondamenti-lista">
                {fondamenti.map((f) => (
                    <li>
                        <a href={f.href} class="fondamento">
                            <div class="fondamento-icona" aria-hidden="true"><i class={`fas ${f.icona}`}></i></div>
                            <div class="fondamento-testi">
                                <h3 class="fondamento-titolo">{f.titolo}</h3>
                                <p class="fondamento-testo testo-piccolo">{f.testo}</p>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- Galleria: la scuola dal vivo, subito dopo i contatti -->
    <Galleria
        eyebrow="Vieni a trovarci"
        titolo="Le nostre sale, <em>la nostra danza</em>"
        testo="Lezioni, spettacoli e dietro le quinte a Lainate e Rho."
    />

    <Fragment slot="scripts">
        <script>
            import '../scripts/contatti';
        </script>
    </Fragment>
</Base>
