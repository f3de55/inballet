---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Galleria from '../components/Galleria.astro';
import { sfondo } from '../lib/images';
import { scuola, sedi, orari } from '../data/scuola';

const { telefono: TEL, telefonoHref: TEL_HREF, email: EMAIL } = scuola;

const bg = {
  hero: await sfondo('gallery-6.jpg', { desktop: '50% 40%', tablet: '50% 50%' }),
};

/** Settimana da lunedì con gli orari di scuola.ts (aggiornati poi da Google, se disponibile). */
const ABBR: Record<string, string> = { Monday: 'Lun', Tuesday: 'Mar', Wednesday: 'Mer', Thursday: 'Gio', Friday: 'Ven', Saturday: 'Sab', Sunday: 'Dom' };
const settimana = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'].map((giorno) => {
  const o = orari.find((x) => x.giorni.some((d) => ABBR[d] === giorno));
  return { giorno, apre: o?.apre, chiude: o?.chiude };
});
---

<Base
    title="Contatti e sedi a Lainate e Rho | InBallet"
    description={`Contatti InBallet: ${TEL}, e-mail e WhatsApp. Sedi in ${sedi[0].via} a Lainate e ${sedi[1].via} a Rho (MI) e orari della segreteria.`}
    ogTitle="Contatti e sedi | InBallet"
    ogDescription="Due sedi a Lainate e Rho: chiamaci o scrivici per scegliere il corso giusto."
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={bg.hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">Contatti e sedi</h1>
            <p class="chisiamo-hero-tagline"><strong>Due sedi</strong> a Lainate e Rho, a nord-ovest di Milano: chiamaci, scrivici o passa in segreteria.</p>
        </div>
    </section>

    <!-- Contatti: intro, poi tre blocchi distinti (scrivici, sedi, orari) -->
    <section id="contatti" class="contatti decoro-onde">
        <div class="container">
            <header class="contatti-intro">
                <span class="eyebrow">Scuola di danza a Lainate e Rho</span>
                <h2 class="titolo-sezione">Il primo passo è un <em>passo di danza</em></h2>
                <p class="intro-sezione">
                    Raccontaci chi sei e cosa vorresti imparare: ti aiutiamo a scegliere
                    il corso giusto per <strong>età e livello</strong>, con orari e iscrizione.
                </p>
            </header>

            <div class="info">
                <!-- Contatto diretto: la card scura è l'azione principale -->
                <div class="info-blocco info-contatto">
                    <h3 class="info-titolo"><span class="info-titolo-icona" aria-hidden="true"><i class="fas fa-paper-plane"></i></span>Chiamaci o scrivici</h3>
                    <ul class="contatto-azioni">
                        <li>
                            <a href={TEL_HREF} class="contatto-azione">
                                <span class="contatto-icona" aria-hidden="true"><i class="fas fa-phone"></i></span>
                                <span class="contatto-testo">
                                    <span class="contatto-etichetta">Telefono</span>
                                    <span class="contatto-valore">{TEL}</span>
                                </span>
                            </a>
                        </li>
                        <li>
                            <a href={`mailto:${EMAIL}`} class="contatto-azione">
                                <span class="contatto-icona" aria-hidden="true"><i class="fas fa-envelope"></i></span>
                                <span class="contatto-testo">
                                    <span class="contatto-etichetta">E-mail</span>
                                    <span class="contatto-valore">{EMAIL}</span>
                                </span>
                            </a>
                        </li>
                        <li>
                            <a href={scuola.whatsapp} target="_blank" rel="noopener" class="contatto-azione">
                                <span class="contatto-icona" aria-hidden="true"><i class="fab fa-whatsapp"></i></span>
                                <span class="contatto-testo">
                                    <span class="contatto-etichetta">WhatsApp</span>
                                    <span class="contatto-valore">Scrivici ora</span>
                                </span>
                            </a>
                        </li>
                    </ul>
                    <div class="contatto-social">
                        <span class="contatto-social-titolo">Seguici</span>
                        <a href={scuola.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
                        <a href={scuola.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook" aria-hidden="true"></i></a>
                    </div>
                </div>

                <div class="info-blocco info-sedi">
                    <h3 class="info-titolo"><span class="info-titolo-icona" aria-hidden="true"><i class="fas fa-map-marker-alt"></i></span>Le nostre sedi</h3>
                    <ul class="sedi-lista">
                        {sedi.map((sede, i) => (
                            <li class="sede">
                                <span class="sede-citta">{sede.citta}{i === 0 && <span class="sede-tag">Sede centrale</span>}</span>
                                <address class="sede-indirizzo">{sede.via}<br>{sede.cap} {sede.citta} ({sede.provincia})</address>
                                <a href={sede.maps} target="_blank" rel="noopener" class="link-cta">
                                    Indicazioni <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="info-blocco info-orari">
                    <h3 class="info-titolo">
                        <span class="info-titolo-icona" aria-hidden="true"><i class="fas fa-clock"></i></span>
                        <span class="info-titolo-testo">Orari della segreteria</span>
                        <span id="open-status" class="orari-status" aria-live="polite"></span>
                    </h3>
                    <ul class="orari-grid" id="orari-grid">
                        {settimana.map((s) => (
                            <li class="orario-item" data-giorno={s.giorno} data-apre={s.apre} data-chiude={s.chiude}>
                                <span class="orario-day">{s.giorno}</span>
                                {s.apre
                                    ? <span class="orario-time">{s.apre}–{s.chiude}</span>
                                    : <span class="orario-time chiuso">Chiuso</span>}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Galleria: la scuola dal vivo, subito dopo i contatti -->
    <Galleria
        eyebrow="Vieni a trovarci"
        titolo="Le nostre sale, <em>la nostra danza</em>"
        testo="Lezioni, spettacoli e dietro le quinte a Lainate e Rho."
    />

    <Fragment slot="scripts">
        <script>
            import '../scripts/contatti';
        </script>
    </Fragment>
</Base>

<style>
  .contatti {
    padding: var(--section-y) 0;
    background: var(--white);
    /* l'ancora #contatti non deve finire sotto l'header fisso (e il banner) */
  }

  .contatti-intro {
    max-width: 48rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .contatti-intro .eyebrow {
    display: block;
    margin-bottom: 1rem;
  }

  .contatti-intro .titolo-sezione {
    margin-bottom: 1.5rem;
  }

  /* ---------- Tre card con ruoli e colori diversi ----------
     Contatto diretto (scura, a tutta altezza a sinistra), sedi (azzurro chiaro), orari (bianca con filetto) */
  .info {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      "contatto sedi"
      "contatto orari";
    gap: 1.5rem;
  }

  .info-contatto { grid-area: contatto; }
  .info-sedi { grid-area: sedi; }
  .info-orari { grid-area: orari; }

  .info-blocco {
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2.25rem;
    border-radius: var(--radius-card);
  }

  .info-contatto {
    background: var(--dark-navy);
    color: var(--white);
  }

  .info-sedi {
    background: var(--bg-soft);
  }

  .info-orari {
    background: var(--white);
    border: 1px solid rgba(26, 26, 26, .12);
  }

  .info-titolo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem 1rem;
    margin: 0 0 1.5rem;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    color: var(--dark-navy);
  }

  .info-contatto .info-titolo {
    color: var(--white);
  }

  /* Icona nel cerchio davanti al titolo di ogni card */
  .info-titolo-icona {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--white);
    font-size: var(--text-md);
    color: var(--primary-blue-dark);
  }

  .info-contatto .info-titolo-icona {
    background: var(--primary-blue);
    color: var(--dark-navy);
  }

  .info-orari .info-titolo-icona {
    background: var(--bg-soft);
  }

  .info-titolo-testo {
    flex: 1;
  }

  :global(.orari-status) {
    margin-left: auto;
  }

  /* ---------- Contatto diretto ---------- */
  .contatto-azioni {
    list-style: none;
    display: grid;
    flex: 1;
    align-content: space-evenly;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .contatto-azione {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.5rem;
    border-radius: var(--radius-img);
    background: rgba(255, 255, 255, .07);
    color: var(--white);
    text-decoration: none;
    transition: background-color .3s ease;
  }

  .contatto-azione:hover {
    background: rgba(255, 255, 255, .14);
  }

  .contatto-azione:focus-visible,
  .contatto-social a:focus-visible {
    outline: 2px solid var(--primary-blue);
    outline-offset: 3px;
  }

  .contatto-icona {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--primary-blue);
    font-size: var(--text-md);
    color: var(--dark-navy);
  }

  .contatto-testo {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contatto-etichetta {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--primary-blue);
  }

  .contatto-valore {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .contatto-social {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-top: auto;
    padding-top: 1.75rem;
  }

  .contatto-social-titolo {
    margin-right: .25rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .7);
  }

  .contatto-social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, .35);
    border-radius: 50%;
    font-size: var(--text-md);
    color: var(--white);
    text-decoration: none;
    transition: background-color .3s ease, color .3s ease;
  }

  .contatto-social a:hover {
    background: var(--white);
    color: var(--dark-navy);
  }

  /* ---------- Sedi ---------- */
  .sedi-lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .sede {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .sede-citta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
    margin-bottom: .35rem;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--dark-navy);
  }

  .sede-tag {
    padding: .15rem .6rem;
    border-radius: 999px;
    background: var(--white);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: .5px;
    color: var(--primary-blue-dark);
  }

  .sede-indirizzo {
    margin: 0 0 1rem;
    font-size: var(--text-base);
    font-style: normal;
    line-height: 1.55;
    color: var(--text-dark);
  }

  .sede .link-cta {
    margin-top: auto;
  }

  /* ---------- Orari: stato e giorno corrente da src/scripts/contatti.ts ---------- */
  :global(.orari-status) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--dark-navy);
  }

  :global(.orari-status:empty) {
    display: none;
  }

  :global(.orari-status i) {
    font-size: 0.5rem;
  }

  :global(.orari-status.aperto i) {
    color: #22c55e;
  }

  :global(.orari-status.chiuso i) {
    color: #ef4444;
  }

  .orari-grid {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(4, auto);
    column-gap: 2.5rem;
    margin: 0;
    padding: 0;
  }

  :global(.orario-item) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: .55rem .75rem;
    border-radius: .5rem;
    font-size: var(--text-base);
    color: var(--text-dark);
  }

  :global(.orario-day) {
    font-weight: 600;
  }

  :global(.orario-time) {
    font-variant-numeric: tabular-nums;
    color: var(--text-light);
  }

  :global(.orario-time.chiuso) {
    font-style: italic;
  }

  /* Oggi: riga evidenziata */
  :global(.orario-item.oggi) {
    background: var(--bg-soft);
  }

  :global(.orario-item.oggi .orario-day),
  :global(.orario-item.oggi .orario-time) {
    color: var(--primary-blue-dark);
    font-weight: 600;
  }

  /* ---------- Responsive ---------- */
  /* Tablet: contatto a tutta larghezza (tre azioni in fila), sedi e orari affiancati sotto */
  @media (max-width: 1100px) {
    .info {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "contatto contatto"
        "sedi orari";
    }

    .contatto-azioni {
      flex: none;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .contatto-azione {
      flex-direction: column;
      align-items: flex-start;
      gap: .75rem;
    }

    .orari-grid {
      grid-auto-flow: row;
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr);
    }

    .sedi-lista {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .contatti-intro {
      margin: 0 0 2.5rem;
      text-align: left;
    }
  }

  /* Mobile: tutte le card una sotto l'altra */
  @media (max-width: 700px) {
    .info {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "contatto"
        "sedi"
        "orari";
    }

    .info-blocco {
      padding: 1.75rem 1.5rem;
    }

    .info-titolo {
      font-size: var(--text-xl);
    }

    .contatto-azioni {
      grid-template-columns: minmax(0, 1fr);
    }

    .contatto-azione {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }
  }
</style>
