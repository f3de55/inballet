---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { webp } from '../lib/images';
import { scuola, sedi } from '../data/scuola';

const { telefono: TEL, telefonoHref: TEL_HREF, email: EMAIL } = scuola;

const heroBg = await webp('gallery-6.jpg', 1920);
---

<Base
    title="Contatti - InBallet"
    description="Contatta InBallet - Scuola di danza a Lainate e Rho. Telefono, email, sedi e orari di apertura."
    ogTitle="Contatti - InBallet"
    ogDescription="Vieni a trovarci a Lainate o Rho. Contattaci per informazioni sui corsi."
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={`background-image: url('${heroBg}')`}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">Vieni a trovarci</h1>
            <p class="chisiamo-hero-tagline">Due sedi a Lainate e Rho. Siamo pronti ad accoglierti.</p>
        </div>
    </section>

    <section id="contatti" class="contatti">
        <div class="container contatti-layout">
            <div class="contatti-testo">
                <p class="eyebrow">Scuola di danza a Lainate e Rho</p>
                <h2 class="titolo titolo-sezione">Il primo passo<br>è un <em>passo di danza</em></h2>
                <p class="invito intro-sezione">
                    Raccontaci chi sei e cosa vorresti imparare:
                    ti aiutiamo a scegliere il corso giusto per età e livello.
                </p>

                <dl class="info">
                    <div class="info-riga">
                        <dt>Contatti</dt>
                        <dd>
                            <a href={TEL_HREF}>{TEL}</a>
                            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
                        </dd>
                    </div>

                    {sedi.map((sede) => (
                        <div class="info-riga">
                            <dt>{sede.titolo}</dt>
                            <dd><a href={sede.maps} target="_blank" rel="noopener">{sede.indirizzo}</a></dd>
                        </div>
                    ))}

                    <div class="info-riga">
                        <dt>
                            Orari segreteria
                            <span id="open-status" class="orari-status" aria-live="polite"></span>
                        </dt>
                        <dd>
                            <ul class="orari-grid" id="orari-grid">
                                <li class="orario-item">
                                    <span class="orario-day">Caricamento orari…</span>
                                    <span class="orario-time"></span>
                                </li>
                            </ul>
                        </dd>
                    </div>
                </dl>
            </div>

            <figure class="contatti-foto">
                <Img src="gallery-4.jpg" alt="Lezione di danza in sala a InBallet" loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 35vw" />
            </figure>
        </div>
    </section>

    <Fragment slot="scripts">
        <script>
            import '../scripts/contatti';
        </script>
    </Fragment>
</Base>

<style>
  .contatti {
    padding: var(--section-y) 0;
    background: var(--white);
    /* l'ancora #contatti non deve finire sotto l'header fisso (e il banner) */
    scroll-margin-top: calc(var(--header-h) + var(--banner-height, 0px));
  }

  .contatti-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 5.5rem;
    align-items: start;
  }

  /* ---------- Foto ---------- */
  .contatti-foto {
    position: sticky;
    top: calc(var(--header-h) + 30px + var(--banner-height, 0px));
    margin: 0;
    isolation: isolate;
  }

  .contatti-foto::before {
    content: '';
    position: absolute;
    inset: 2.5rem 2.5rem -1.5rem -1.5rem;
    border: 2px solid var(--primary-blue);
    border-radius: 24px;
    z-index: -1;
  }

  .contatti-foto :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
  }

  /* ---------- Testo ---------- */

  .titolo {
    margin-bottom: 1.5rem;
  }

  .invito {
    max-width: 34rem;
  }

  /* ---------- Informazioni ---------- */
  .info {
    margin-top: 3rem;
  }

  .info-riga {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-top: 1px solid rgba(26, 26, 26, 0.1);
  }

  .info-riga:last-child {
    border-bottom: 1px solid rgba(26, 26, 26, 0.1);
  }

  .info-riga dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-light);
    padding-top: 0.3rem;
  }

  .info-riga dd {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .info-riga dd > a {
    align-self: flex-start;
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--dark-navy);
    text-decoration: none;
    background: linear-gradient(var(--primary-blue), var(--primary-blue)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s ease, color 0.3s ease;
  }

  .info-riga dd > a:hover {
    color: var(--primary-blue-dark);
    background-size: 100% 2px;
  }

  /* Orari e stato: generati da src/scripts/contatti.ts */
  :global(.orari-status) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.6rem;
    letter-spacing: 1px;
    color: var(--dark-navy);
  }

  :global(.orari-status:empty) {
    display: none;
  }

  :global(.orari-status i) {
    font-size: 0.5rem;
  }

  :global(.orari-status.aperto i) {
    color: #22c55e;
  }

  :global(.orari-status.chiuso i) {
    color: #ef4444;
  }

  .orari-grid {
    list-style: none;
    max-width: 22rem;
  }

  :global(.orario-item) {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: 0.3rem 0;
    font-size: 1.0625rem;
    color: var(--text-dark);
  }

  :global(.orario-day) {
    font-weight: 600;
  }

  :global(.orario-time) {
    font-variant-numeric: tabular-nums;
    color: var(--text-light);
  }

  :global(.orario-time.chiuso) {
    font-style: italic;
    opacity: 0.7;
  }

  :global(.orario-item.oggi .orario-day),
  :global(.orario-item.oggi .orario-time) {
    color: var(--primary-blue-dark);
    font-weight: 600;
  }


  /* ---------- Responsive ---------- */
  @media (max-width: 1024px) {
    .contatti-layout {
      gap: 4rem;
    }

    .info-riga {
      grid-template-columns: 9rem 1fr;
    }
  }

  @media (max-width: 900px) {

    .contatti-layout {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .contatti-foto {
      position: relative;
      top: auto;
      max-width: 520px;
      width: calc(100% - 1.5rem);
      margin-left: auto;
    }

    .contatti-foto :global(img) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 600px) {

    .info-riga {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.4rem 0;
    }

    .contatti-foto::before {
      inset: 1.5rem 1.5rem -0.75rem -0.75rem;
    }

  }
</style>
