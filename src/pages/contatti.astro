---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Galleria from '../components/Galleria.astro';
import { heroPagina } from '../lib/hero-pagine';
import { scuola, sedi } from '../data/scuola';
import HeroPagina from '../components/HeroPagina.astro';
import OrariSegreteria from '../components/OrariSegreteria.astro';
import '../styles/components/recapiti.css';
import '../styles/pages/contatti.css';

const { telefono: TEL, telefonoHref: TEL_HREF, email: EMAIL } = scuola;

const bg = {
  hero: await heroPagina('contatti'),
};

const fondamenti = [
  { titolo: 'Corsi', testo: 'Per bambini dai 3 anni, ragazzi e adulti.', href: '/corsi', icona: 'fa-shoe-prints' },
  { titolo: 'Inclusione', testo: 'Classi integrate e ascolto per le famiglie.', href: '/classi-integrate', icona: 'fa-users' },
  { titolo: 'Formazione', testo: 'Due anni di formazione per insegnare danza.', href: '/formazione-insegnanti', icona: 'fa-graduation-cap' },
];
---

<Base
    title="Contatti e sedi a Lainate e Rho | InBallet"
    description={`Chiamaci al ${TEL} o scrivici: ti aiutiamo a scegliere il corso. Sedi in ${sedi[0].via} a Lainate e ${sedi[1].via} a Rho (MI).`}
    ogTitle="Contatti e sedi | InBallet"
    ogDescription="Due sedi a Lainate e Rho: chiamaci o scrivici per scegliere il corso giusto."
    tipo="ContactPage"
    preload={bg.hero.preload}
>

    <HeroPagina titolo="Contatti e sedi" stile={bg.hero.style}>
        <p class="hero-lead"><strong>Due sedi</strong> a Lainate e Rho, a nord-ovest di Milano: chiamaci, scrivici o passa in segreteria.</p>
    </HeroPagina>

    <section id="contatti" class="contatti decoro-onde">
        <div class="container">
            <header class="contatti-intro">
                <div>
                <p class="eyebrow">Scuola di danza a Lainate e Rho</p>
                <h2 class="titolo-sezione">Il primo passo è un <em>passo di danza</em></h2>
                </div>
                <p class="intro-sezione">
                    Raccontaci chi sei e cosa ti piacerebbe imparare: ti aiutiamo a scegliere
                    il corso giusto per <strong>età e livello</strong>, con orari e iscrizione.
                </p>
            </header>

            <div class="info">
                <div class="info-blocco">
                    <Img class="info-illustrazione" src="grafica-contatti/recapiti-moderno.webp" alt="" aria-hidden="true" width="176" height="176" loading="lazy" decoding="async" widths={[240, 480, 640]} sizes="(max-width: 600px) 264px, 168px" />
                    <h3 class="info-titolo">Recapiti</h3>
                    <div class="info-corpo">
                    <ul class="info-righe">
                        <li class="info-riga">
                            <a class="recapito" href={TEL_HREF}><span class="recapito-testo">{TEL}</span></a>
                            <a class="info-whatsapp" href={scuola.whatsapp} target="_blank" rel="noopener"><i class="fab fa-whatsapp" aria-hidden="true"></i><span class="info-link-testo">WhatsApp</span><span class="sr-only"> (si apre in una nuova scheda)</span></a>
                        </li>
                        <li class="info-riga">
                            <a class="recapito" href={`mailto:${EMAIL}`}><i class="fas fa-envelope" aria-hidden="true"></i><span class="recapito-testo">{EMAIL}</span></a>
                        </li>
                    </ul>
                    <div class="info-social">
                        <small class="testo-piccolo">Seguici sui social</small>
                        <div class="info-social-link">
                            <a href={scuola.social.instagram} target="_blank" rel="noopener"><i class="fab fa-instagram" aria-hidden="true"></i><span class="info-link-testo">Instagram</span><span class="sr-only"> (si apre in una nuova scheda)</span></a>
                            <a href={scuola.social.facebook} target="_blank" rel="noopener"><i class="fab fa-facebook" aria-hidden="true"></i><span class="info-link-testo">Facebook</span><span class="sr-only"> (si apre in una nuova scheda)</span></a>
                        </div>
                    </div>
                    </div>
                </div>

                <div class="info-blocco">
                    <Img class="info-illustrazione" src="grafica-contatti/sedi.webp" alt="" aria-hidden="true" width="176" height="176" loading="lazy" decoding="async" widths={[240, 480, 640]} sizes="(max-width: 600px) 264px, 168px" />
                    <h3 class="info-titolo">Le nostre sedi</h3>
                    <div class="info-corpo">
                    <ul class="info-righe">
                        {sedi.map((sede) => (
                            <li class="info-riga sede">
                                <i class="fas fa-location-dot info-icona" aria-hidden="true"></i>
                                <div>
                                    <p class="info-valore">{sede.citta}</p>
                                    <address class="sede-indirizzo">
                                        <a class="sede-mappa" href={sede.maps} target="_blank" rel="noopener noreferrer" aria-label={`${sede.via}, ${sede.cap} ${sede.citta} (${sede.provincia}): apri la mappa (si apre in una nuova scheda)`}>
                                            <span class="info-link-testo">{sede.via}, {sede.cap} {sede.citta} ({sede.provincia})</span><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                        </a>
                                    </address>
                                </div>
                            </li>
                        ))}
                    </ul>
                    </div>
                </div>

                <div class="info-blocco">
                    <Img class="info-illustrazione info-illustrazione--digitale" src="grafica-contatti/orari-digitale.webp" alt="" aria-hidden="true" width="176" height="176" loading="lazy" decoding="async" widths={[240, 480, 640]} sizes="(max-width: 600px) 264px, 208px" />
                    <h3 class="info-titolo">Orari segreteria</h3>
                    <div class="info-corpo">
                    <OrariSegreteria server:defer>
                        <p slot="fallback">Caricamento orari…</p>
                    </OrariSegreteria>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="fondamenti" class="fondamenti decoro-onde decoro-onde--sinistra" aria-labelledby="fondamenti-titolo">
        <div class="container fondamenti-layout">
            <header class="fondamenti-intro">
                <h2 class="titolo-sezione" id="fondamenti-titolo">InBallet, <em>in breve</em></h2>
            </header>
            <ul class="fondamenti-lista">
                {fondamenti.map((f) => (
                    <li>
                        <a class="fondamento" href={f.href}>
                            <i class={`fas ${f.icona} fondamento-icona`} aria-hidden="true"></i>
                            <h3 class="fondamento-titolo titolo-card">{f.titolo}</h3>
                            <p class="fondamento-testo">{f.testo}</p>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <Galleria
        eyebrow="Vieni a trovarci"
        titolo="Le nostre sale, <em>la nostra danza</em>"
        testo="Lezioni, spettacoli e dietro le quinte a Lainate e Rho."
    />
</Base>
