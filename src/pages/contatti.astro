---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Galleria from '../components/Galleria.astro';
import { sfondo } from '../lib/images';
import { scuola, sedi, orari } from '../data/scuola';

const { telefono: TEL, telefonoHref: TEL_HREF, email: EMAIL } = scuola;

const bg = {
  hero: await sfondo('gallery-6.jpg', { desktop: '50% 40%', tablet: '50% 50%' }),
};

/** Settimana da lunedì con gli orari di scuola.ts (aggiornati poi da Google, se disponibile). */
const ABBR: Record<string, string> = { Monday: 'Lun', Tuesday: 'Mar', Wednesday: 'Mer', Thursday: 'Gio', Friday: 'Ven', Saturday: 'Sab', Sunday: 'Dom' };
const settimana = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'].map((giorno) => {
  const o = orari.find((x) => x.giorni.some((d) => ABBR[d] === giorno));
  return { giorno, apre: o?.apre, chiude: o?.chiude };
});
---

<Base
    title="Contatti e sedi a Lainate e Rho | InBallet"
    description={`Contatti InBallet: ${TEL}, e-mail e WhatsApp. Sedi in ${sedi[0].via} a Lainate e ${sedi[1].via} a Rho (MI) e orari della segreteria.`}
    ogTitle="Contatti e sedi | InBallet"
    ogDescription="Due sedi a Lainate e Rho: chiamaci o scrivici per scegliere il corso giusto."
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={bg.hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">Contatti e sedi</h1>
            <p class="chisiamo-hero-tagline"><strong>Due sedi</strong> a Lainate e Rho, a nord-ovest di Milano: chiamaci, scrivici o passa in segreteria.</p>
        </div>
    </section>

    <!-- Contatti: intro, poi tre blocchi distinti (scrivici, sedi, orari) -->
    <section id="contatti" class="contatti decoro-onde">
        <div class="container">
            <header class="contatti-intro">
                <span class="eyebrow">Scuola di danza a Lainate e Rho</span>
                <h2 class="titolo-sezione">Il primo passo è un <em>passo di danza</em></h2>
                <p class="intro-sezione">
                    Raccontaci chi sei e cosa vorresti imparare: ti aiutiamo a scegliere
                    il corso giusto per <strong>età e livello</strong>, con orari e iscrizione.
                </p>
            </header>

            <div class="info">
                <div class="info-blocco">
                    <h3 class="info-titolo">Chiamaci o scrivici</h3>
                    <div class="info-telefono"><a href={TEL_HREF}>{TEL}</a></div>
                    <div class="info-email"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></div>
                    <a href={scuola.whatsapp} target="_blank" rel="noopener" class="link-cta">
                        Scrivici su WhatsApp <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <div class="info-social">
                        <a href={scuola.social.instagram} target="_blank" rel="noopener">Instagram</a>
                        <a href={scuola.social.facebook} target="_blank" rel="noopener">Facebook</a>
                    </div>
                </div>

                <div class="info-blocco">
                    <h3 class="info-titolo">Le nostre sedi</h3>
                    <ul class="sedi-lista">
                        {sedi.map((sede, i) => (
                            <li class="sede">
                                <p class="sede-citta">{sede.citta}{i === 0 && <span class="sede-tag">sede centrale</span>}</p>
                                <address class="sede-indirizzo">{sede.via}<br>{sede.cap} {sede.citta} ({sede.provincia})</address>
                                <a href={sede.maps} target="_blank" rel="noopener" class="link-cta">
                                    Indicazioni <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="info-blocco">
                    <h3 class="info-titolo">
                        Orari della segreteria
                        <span id="open-status" class="orari-status" aria-live="polite"></span>
                    </h3>
                    <ul class="orari-grid" id="orari-grid">
                        {settimana.map((s) => (
                            <li class="orario-item" data-giorno={s.giorno} data-apre={s.apre} data-chiude={s.chiude}>
                                <span class="orario-day">{s.giorno}</span>
                                {s.apre
                                    ? <span class="orario-time">{s.apre}–{s.chiude}</span>
                                    : <span class="orario-time chiuso">Chiuso</span>}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Galleria: la scuola dal vivo, subito dopo i contatti -->
    <Galleria
        eyebrow="Vieni a trovarci"
        titolo="Le nostre sale, <em>la nostra danza</em>"
        testo="Lezioni, spettacoli e dietro le quinte a Lainate e Rho."
    />

    <Fragment slot="scripts">
        <script>
            import '../scripts/contatti';
        </script>
    </Fragment>
</Base>

<style>
  .contatti {
    padding: var(--section-y) 0;
    background: var(--white);
    /* l'ancora #contatti non deve finire sotto l'header fisso (e il banner) */
  }

  .contatti-intro {
    max-width: 48rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .contatti-intro .eyebrow {
    display: block;
    margin-bottom: 1rem;
  }

  .contatti-intro .titolo-sezione {
    margin-bottom: 1.5rem;
  }

  /* ---------- Tre colonne editoriali, senza riquadri: gerarchia data dalla tipografia, filetti tra le colonne ---------- */
  .info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(26, 26, 26, .15);
  }

  .info-blocco {
    padding: 2.5rem 2.5rem 0;
  }

  .info-blocco:first-child {
    padding-left: 0;
  }

  .info-blocco:last-child {
    padding-right: 0;
  }

  .info-blocco + .info-blocco {
    border-left: 1px solid rgba(26, 26, 26, .15);
  }

  .info-titolo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .25rem 1rem;
    margin: 0 0 1.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--primary-blue-dark);
  }

  /* Contatti: il telefono è il dato principale */
  .info-telefono,
  .info-email {
    margin: 0;
  }

  .info-telefono a {
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -.01em;
  }

  .info-email {
    margin: .5rem 0 1.75rem;
  }

  .info-email a {
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .info-telefono a,
  .info-email a,
  .info-social a {
    color: var(--dark-navy);
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--primary-blue), var(--primary-blue)) 0 100% / 0 2px no-repeat;
    transition: background-size .3s ease, color .3s ease;
  }

  .info-telefono a:hover,
  .info-email a:hover,
  .info-social a:hover {
    color: var(--primary-blue-dark);
    background-size: 100% 2px;
  }

  .info-social {
    display: flex;
    gap: 1.5rem;
    margin: 1.75rem 0 0;
  }

  .info-social a {
    font-size: var(--text-base);
    font-weight: 500;
  }

  /* Sedi */
  .sedi-lista {
    list-style: none;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .sede-citta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .25rem .75rem;
    margin: 0 0 .5rem;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.2;
    color: var(--dark-navy);
  }

  .sede-tag {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-light);
  }

  .sede-indirizzo {
    margin: 0 0 1rem;
    font-size: var(--text-base);
    font-style: normal;
    line-height: 1.6;
    color: var(--text-dark);
  }

  /* Orari: stato e giorno corrente da src/scripts/contatti.ts */
  :global(.orari-status) {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-size: var(--text-xs);
    letter-spacing: 1px;
    color: var(--dark-navy);
  }

  :global(.orari-status:empty) {
    display: none;
  }

  :global(.orari-status i) {
    font-size: .5rem;
  }

  :global(.orari-status.aperto i) {
    color: #22c55e;
  }

  :global(.orari-status.chiuso i) {
    color: #ef4444;
  }

  .orari-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.orario-item) {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: .4rem 0;
    font-size: var(--text-base);
    color: var(--text-dark);
  }

  :global(.orario-day) {
    font-weight: 600;
  }

  :global(.orario-time) {
    font-variant-numeric: tabular-nums;
    color: var(--text-light);
  }

  :global(.orario-time.chiuso) {
    font-style: italic;
  }

  :global(.orario-item.oggi .orario-day),
  :global(.orario-item.oggi .orario-time) {
    color: var(--primary-blue-dark);
    font-weight: 600;
  }

  /* ---------- Responsive ---------- */
  /* Tablet: contatti a tutta larghezza sopra (telefono e email affiancati), poi sedi e orari */
  @media (max-width: 1000px) {
    .info {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .info-blocco,
    .info-blocco:first-child,
    .info-blocco:nth-child(2),
    .info-blocco:last-child {
      padding: 2.25rem 0 0;
      border-left: none;
    }

    .info-blocco:first-child {
      grid-column: 1 / -1;
      padding-bottom: 2.25rem;
      border-bottom: 1px solid rgba(26, 26, 26, .15);
    }

    .info-blocco:nth-child(3) {
      padding-left: 2.5rem;
      border-left: 1px solid rgba(26, 26, 26, .15);
    }

    .info-blocco:nth-child(2) {
      padding-right: 2.5rem;
    }
  }

  @media (max-width: 900px) {
    .contatti-intro {
      margin: 0 0 2.5rem;
      text-align: left;
    }
  }

  /* Mobile: tre sezioni una sotto l'altra, separate da un filetto */
  @media (max-width: 700px) {
    .info {
      grid-template-columns: minmax(0, 1fr);
    }

    .info-blocco,
    .info-blocco:first-child,
    .info-blocco:nth-child(2),
    .info-blocco:nth-child(3),
    .info-blocco:last-child {
      padding: 2rem 0;
      border-left: none;
      border-bottom: 1px solid rgba(26, 26, 26, .15);
    }

    .info-blocco:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .info-telefono a {
      font-size: var(--text-2xl);
    }
  }
</style>
