---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Galleria from '../components/Galleria.astro';
import { sfondo } from '../lib/images';
import { categorieCorsi, FONDAZIONE, scuola, sedi, orari } from '../data/scuola';

const { telefono: TEL, telefonoHref: TEL_HREF, email: EMAIL } = scuola;

const bg = {
  hero: await sfondo('gallery-6.jpg', { desktop: '50% 40%', tablet: '50% 50%' }),
};

/** Settimana da lunedì con gli orari di scuola.ts (aggiornati poi da Google, se disponibile). */
const ABBR: Record<string, string> = { Monday: 'Lun', Tuesday: 'Mar', Wednesday: 'Mer', Thursday: 'Gio', Friday: 'Ven', Saturday: 'Sab', Sunday: 'Dom' };
// I fondamenti di InBallet: contenuti presi dalle pagine del sito (Chi siamo, FAQ, Classi Integrate,
// Sportello Psicologico, Formazione Insegnanti), non testi nuovi
const totaleCorsi = categorieCorsi.reduce((n, c) => n + c.corsi.length, 0);
const fondamenti = [
  { icona: 'fa-child', titolo: 'Ogni età', testo: "Si comincia <strong>dai 3 anni compiuti</strong> e non c'è un'età per smettere: anche gli adulti trovano corsi <strong>per principianti assoluti</strong>.", href: '/corsi' },
  { icona: 'fa-layer-group', titolo: 'Classi per livello', testo: `Dalla tecnica classica alle danze urbane: <strong>${totaleCorsi} corsi</strong> in <strong>classi divise per livello</strong>, con insegnanti qualificati.`, href: '/corsi' },
  { icona: 'fa-universal-access', titolo: 'Inclusione', testo: 'Quasi tutte le classi accolgono allievi con <strong>bisogni speciali</strong> e dal 2013 il <strong>progetto NoiConVoi</strong> porta la danza ai ragazzi con disabilità.', href: '/classi-integrate' },
  { icona: 'fa-house-user', titolo: 'Comunità educante', testo: 'Una scuola <strong>in dialogo con le famiglie</strong>, con lo <strong>sportello psicologico</strong> su richiesta alla Direzione.', href: '/sportello-psicologico' },
  { icona: 'fa-masks-theater', titolo: 'In teatro ogni anno', testo: "Ogni anno gli allievi portano <strong>in teatro</strong> uno spettacolo nato dal lavoro dell'anno.", href: '/spettacoli-eventi' },
  { icona: 'fa-graduation-cap', titolo: 'Ente formativo', testo: 'Dal 2023 InBallet forma gli <strong>insegnanti di danza</strong> con titolo <strong>CSEN e CONI</strong> a valenza nazionale.', href: '/formazione-insegnanti' },
];

const settimana = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'].map((giorno) => {
  const o = orari.find((x) => x.giorni.some((d) => ABBR[d] === giorno));
  return { giorno, apre: o?.apre, chiude: o?.chiude };
});
---

<Base
    title="Contatti e sedi a Lainate e Rho | InBallet"
    description={`Contatti InBallet: ${TEL}, e-mail e WhatsApp. Sedi in ${sedi[0].via} a Lainate e ${sedi[1].via} a Rho (MI) e orari della segreteria.`}
    ogTitle="Contatti e sedi | InBallet"
    ogDescription="Due sedi a Lainate e Rho: chiamaci o scrivici per scegliere il corso giusto."
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={bg.hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">Contatti e sedi</h1>
            <p class="chisiamo-hero-tagline"><strong>Due sedi</strong> a Lainate e Rho, a nord-ovest di Milano: chiamaci, scrivici o passa in segreteria.</p>
        </div>
    </section>

    <!-- Contatti: intro, poi tre blocchi distinti (scrivici, sedi, orari) -->
    <section id="contatti" class="contatti decoro-onde">
        <div class="container">
            <header class="contatti-intro">
                <span class="eyebrow">Scuola di danza a Lainate e Rho</span>
                <h2 class="titolo-sezione">Il primo passo è un <em>passo di danza</em></h2>
                <p class="intro-sezione">
                    Raccontaci chi sei e cosa vorresti imparare: ti aiutiamo a scegliere
                    il corso giusto per <strong>età e livello</strong>, con orari e iscrizione.
                </p>
            </header>

            <div class="info">
                <div class="info-blocco">
                    <h3 class="info-titolo"><i class="fas fa-paper-plane" aria-hidden="true"></i>Chiamaci o scrivici</h3>
                    <ul class="info-righe">
                        <li class="info-riga">
                            <i class="fas fa-phone info-icona" aria-hidden="true"></i>
                            <a class="info-valore" href={TEL_HREF}>{TEL}</a>
                        </li>
                        <li class="info-riga">
                            <i class="fas fa-envelope info-icona" aria-hidden="true"></i>
                            <a class="info-valore" href={`mailto:${EMAIL}`}>{EMAIL}</a>
                        </li>
                        <li class="info-riga">
                            <i class="fab fa-whatsapp info-icona" aria-hidden="true"></i>
                            <a class="info-valore" href={scuola.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
                        </li>
                    </ul>
                    <div class="info-social">
                        <a href={scuola.social.instagram} target="_blank" rel="noopener"><i class="fab fa-instagram" aria-hidden="true"></i>Instagram</a>
                        <a href={scuola.social.facebook} target="_blank" rel="noopener"><i class="fab fa-facebook" aria-hidden="true"></i>Facebook</a>
                    </div>
                </div>

                <div class="info-blocco">
                    <h3 class="info-titolo"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>Le nostre sedi</h3>
                    <ul class="info-righe">
                        {sedi.map((sede, i) => (
                            <li class="info-riga sede">
                                <i class="fas fa-location-dot info-icona" aria-hidden="true"></i>
                                <div>
                                    <p class="info-valore">{sede.citta}{i === 0 && <span class="sede-tag">sede centrale</span>}</p>
                                    <address class="sede-indirizzo">{sede.via}<br>{sede.cap} {sede.citta} ({sede.provincia})</address>
                                    <a href={sede.maps} target="_blank" rel="noopener" class="link-cta">
                                        Indicazioni <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="info-blocco">
                    <h3 class="info-titolo"><i class="fas fa-clock" aria-hidden="true"></i>Orari segreteria</h3>
                    <p id="open-status" class="orari-status" aria-live="polite"></p>
                    <ul class="orari-grid" id="orari-grid">
                        {settimana.map((s) => (
                            <li class="orario-item" data-giorno={s.giorno} data-apre={s.apre} data-chiude={s.chiude}>
                                <span class="orario-day">{s.giorno}</span>
                                {s.apre
                                    ? <span class="orario-time">{s.apre}–{s.chiude}</span>
                                    : <span class="orario-time chiuso">Chiuso</span>}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- I fondamenti di InBallet: perché sceglierci, con i due contatti più rapidi.
         Desktop: intro e pulsanti a sinistra, sei fondamenti in griglia 2x3 a destra.
         Tablet e mobile: intro, fondamenti, poi i pulsanti (l'azione arriva dopo le ragioni) -->
    <section class="fondamenti sezione-scura" aria-labelledby="fondamenti-titolo">
        <div class="container fondamenti-layout">
            <header class="fondamenti-testa">
                <span class="eyebrow">I fondamenti di InBallet</span>
                <h2 class="titolo-sezione" id="fondamenti-titolo">Perché scegliere <em>InBallet</em></h2>
                <p class="intro-sezione">Dal {FONDAZIONE} a Lainate e Rho: una scuola di danza multidisciplinare, <strong>inclusiva e aperta a tutte le età</strong>.</p>
            </header>

            <ul class="fondamenti-lista">
                {fondamenti.map((f) => (
                    <li>
                        <a href={f.href} class="fondamento">
                            <i class={`fas ${f.icona} fondamento-icona`} aria-hidden="true"></i>
                            <h3 class="fondamento-titolo">{f.titolo}</h3>
                            <p class="fondamento-testo" set:html={f.testo} />
                        </a>
                    </li>
                ))}
            </ul>

            <div class="fondamenti-cta">
                <p class="fondamenti-cta-testo">Hai ancora un dubbio? <strong>Chiamaci o scrivici</strong>: ti aiutiamo a scegliere il corso giusto per età e livello.</p>
                <div class="fondamenti-pulsanti">
                    <a href={TEL_HREF} class="btn-primary">
                        <i class="fas fa-phone" aria-hidden="true"></i>
                        <span>Chiamaci</span>
                    </a>
                    <a href={scuola.whatsapp} target="_blank" rel="noopener" class="btn-secondary">
                        <i class="fab fa-whatsapp" aria-hidden="true"></i>
                        <span>Scrivici su WhatsApp</span>
                    </a>
                </div>
                <p class="fondamenti-email">Oppure scrivi a <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            </div>
        </div>
    </section>

    <!-- Galleria: la scuola dal vivo, subito dopo i contatti -->
    <Galleria
        eyebrow="Vieni a trovarci"
        titolo="Le nostre sale, <em>la nostra danza</em>"
        testo="Lezioni, spettacoli e dietro le quinte a Lainate e Rho."
    />

    <Fragment slot="scripts">
        <script>
            import '../scripts/contatti';
        </script>
    </Fragment>
</Base>

<style>
  .contatti {
    padding: var(--section-y) 0;
    background: var(--white);
    /* l'ancora #contatti non deve finire sotto l'header fisso (e il banner) */
  }

  .contatti-intro {
    max-width: 48rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .contatti-intro .eyebrow {
    display: block;
    margin-bottom: 1rem;
  }

  .contatti-intro .titolo-sezione {
    margin-bottom: 1.5rem;
  }

  /* ---------- Tre celle a filetti (come La danza oltre i corsi): linee sopra, sotto e tra le celle; i dati principali (telefono, e-mail, sedi) hanno lo stesso titoletto grande ---------- */
  .info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid rgba(26, 26, 26, .18);
  }

  .info-blocco {
    padding: 2.5rem 2rem;
  }

  .info-blocco + .info-blocco {
    border-left: 1px solid rgba(26, 26, 26, .18);
  }

  /* Contatti e orari su fondo azzurrino, le sedi al centro restano bianche */
  .info-blocco:first-child,
  .info-blocco:last-child {
    background: var(--bg-soft);
  }

  /* Etichetta del box con icona */
  .info-titolo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .25rem .6rem;
    margin: 0 0 1.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--primary-blue-dark);
  }

  .info-titolo i {
    font-size: var(--text-sm);
  }

  .info-titolo-testo {
    flex: 1;
  }

  .info-righe {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .info-riga {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    column-gap: .75rem;
    align-items: start;
  }

  .info-icona {
    padding-top: .3em;
    font-size: var(--text-md);
    color: var(--primary-blue-dark);
  }

  /* Il glifo di WhatsApp è più piccolo degli altri: lo pareggiamo */
  .info-icona.fa-whatsapp {
    font-size: var(--text-xl);
    padding-top: .1em;
  }

  /* Stesso titoletto per numero, e-mail, WhatsApp e nomi delle sedi */
  .info-valore {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.3;
    color: var(--dark-navy);
    overflow-wrap: anywhere;
  }

  /* La linea in hover segue la sola parola: il link non si allarga alla colonna della griglia */
  a.info-valore,
  .info-social a {
    justify-self: start;
    width: fit-content;
    text-decoration: none;
    background: linear-gradient(var(--primary-blue), var(--primary-blue)) 0 100% / 0 2px no-repeat;
    transition: background-size .3s ease, color .3s ease;
  }

  a.info-valore:hover,
  .info-social a:hover {
    color: var(--primary-blue-dark);
    background-size: 100% 2px;
  }

  .info-social {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.75rem;
    margin-top: 1.75rem;
  }

  .info-social a {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--dark-navy);
  }

  .info-social a i {
    margin-right: .5rem;
    color: var(--primary-blue-dark);
  }

  /* Sedi */
  .sede-tag {
    margin-left: .6rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-light);
  }

  .sede-indirizzo {
    margin: .35rem 0 .75rem;
    font-size: var(--text-base);
    font-style: normal;
    line-height: 1.6;
    color: var(--text-dark);
  }

  /* Orari: stato e giorno corrente da src/scripts/contatti.ts */
  :global(.orari-status) {
    display: flex;
    align-items: center;
    gap: .45rem;
    margin: -.5rem 0 .75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--dark-navy);
  }

  :global(.orari-status:empty) {
    display: none;
  }

  :global(.orari-status i) {
    font-size: .5rem;
  }

  :global(.orari-status.aperto i) {
    color: #22c55e;
  }

  :global(.orari-status.chiuso i) {
    color: #ef4444;
  }

  .orari-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.orario-item) {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: .4rem 0;
    font-size: var(--text-base);
    color: var(--text-dark);
  }

  :global(.orario-day) {
    font-weight: 600;
  }

  :global(.orario-time) {
    font-variant-numeric: tabular-nums;
    color: var(--text-light);
  }

  :global(.orario-time.chiuso) {
    font-style: italic;
  }

  :global(.orario-item.oggi .orario-day),
  :global(.orario-item.oggi .orario-time) {
    color: var(--primary-blue-dark);
    font-weight: 600;
  }

  /* ---------- Responsive ---------- */
  /* Tablet: contatti a tutta larghezza sopra, sedi e orari affiancati sotto */
  @media (max-width: 1000px) {
    .info {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .info-blocco:first-child {
      grid-column: 1 / -1;
    }

    .info-blocco:nth-child(2) {
      border-left: none;
      border-top: 1px solid rgba(26, 26, 26, .18);
    }

    .info-blocco:nth-child(3) {
      border-top: 1px solid rgba(26, 26, 26, .18);
    }

    .info-blocco:first-child .info-righe {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (max-width: 900px) {
    .contatti-intro {
      margin: 0 0 2.5rem;
      text-align: left;
    }
  }

  /* Mobile: le tre celle una sotto l'altra, separate da un filetto */
  @media (max-width: 700px) {
    .info {
      grid-template-columns: minmax(0, 1fr);
    }

    .info-blocco,
    .info-blocco:nth-child(2),
    .info-blocco:nth-child(3) {
      padding: 2rem 1.5rem;
      border-left: none;
    }

    .info-blocco + .info-blocco {
      border-top: 1px solid rgba(26, 26, 26, .18);
    }

    .info-blocco:first-child .info-righe {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- I fondamenti di InBallet ---------- */
  .fondamenti {
    padding: var(--section-y) 0;
    background: var(--dark-navy);
    color: var(--white);
  }

  .fondamenti-layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      "testa lista"
      "cta   lista";
    grid-template-rows: auto 1fr;
    column-gap: 4.5rem;
  }

  .fondamenti-testa {
    grid-area: testa;
  }

  .fondamenti-testa .eyebrow {
    display: block;
    margin-bottom: 1rem;
  }

  .fondamenti-testa .titolo-sezione {
    margin-bottom: 1.25rem;
  }

  .fondamenti-testa .intro-sezione {
    margin: 0;
  }

  .fondamenti-cta {
    grid-area: cta;
    align-self: start;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, .18);
  }

  .fondamenti-cta-testo {
    margin: 0 0 1.5rem;
    font-size: var(--text-base);
    line-height: 1.6;
    color: rgba(255, 255, 255, .85);
  }

  /* Desktop: due pulsanti della stessa larghezza, uno sotto l'altro */
  .fondamenti-pulsanti {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: .75rem;
    max-width: 22rem;
  }

  .fondamenti-email {
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, .7);
  }

  .fondamenti-email a {
    color: var(--white);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--primary-blue);
    text-underline-offset: 3px;
  }

  /* Sei celle uguali: il gap da 1px sul fondo chiaro disegna i filetti tra le celle */
  .fondamenti-lista {
    grid-area: lista;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    background: rgba(255, 255, 255, .16);
    border-block: 1px solid rgba(255, 255, 255, .16);
  }

  .fondamenti-lista li {
    display: flex;
    background: var(--dark-navy);
  }

  .fondamento {
    flex: 1;
    display: block;
    padding: 2rem 1.75rem;
    color: inherit;
    text-decoration: none;
    transition: background-color .3s ease;
  }

  .fondamento-icona {
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--primary-blue);
  }

  .fondamento-titolo {
    margin: 1rem 0 .5rem;
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.25;
    color: var(--white);
  }

  .fondamento-testo {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: rgba(255, 255, 255, .78);
  }

  .fondamento:focus-visible {
    outline: 2px solid var(--primary-blue);
    outline-offset: -4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .fondamento:hover {
      background: rgba(255, 255, 255, .05);
    }
  }

  /* Tablet e mobile: intro, fondamenti, poi i pulsanti */
  @media (max-width: 1024px) {
    .fondamenti-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "testa"
        "lista"
        "cta";
      grid-template-rows: none;
    }

    .fondamenti-testa {
      margin-bottom: 2.5rem;
    }

    .fondamenti-cta {
      margin-top: 2.5rem;
      padding-top: 0;
      border-top: none;
    }

    .fondamenti-pulsanti {
      flex-direction: row;
      flex-wrap: wrap;
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    .fondamenti-lista {
      grid-template-columns: minmax(0, 1fr);
    }

    .fondamento {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      column-gap: 1rem;
      padding: 1.5rem 0;
    }

    .fondamento-icona {
      grid-row: 1 / span 2;
      padding-top: .2rem;
      font-size: var(--text-xl);
      text-align: center;
    }

    .fondamento-titolo {
      margin: 0 0 .35rem;
    }

    .fondamenti-pulsanti {
      flex-direction: column;
    }
  }
</style>
