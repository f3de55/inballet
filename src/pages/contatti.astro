---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Galleria from '../components/Galleria.astro';
import { sfondo } from '../lib/images';
import { scuola, sedi, orari } from '../data/scuola';

const { telefono: TEL, telefonoHref: TEL_HREF, email: EMAIL } = scuola;

const bg = {
  hero: await sfondo('gallery-6.jpg', { desktop: '50% 40%', tablet: '50% 50%' }),
};

/** Settimana da lunedì con gli orari di scuola.ts (aggiornati poi da Google, se disponibile). */
const ABBR: Record<string, string> = { Monday: 'Lun', Tuesday: 'Mar', Wednesday: 'Mer', Thursday: 'Gio', Friday: 'Ven', Saturday: 'Sab', Sunday: 'Dom' };
const settimana = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'].map((giorno) => {
  const o = orari.find((x) => x.giorni.some((d) => ABBR[d] === giorno));
  return { giorno, apre: o?.apre, chiude: o?.chiude };
});
---

<Base
    title="Contatti e sedi a Lainate e Rho | InBallet"
    description={`Contatti InBallet: ${TEL}, e-mail e WhatsApp. Sedi in ${sedi[0].via} a Lainate e ${sedi[1].via} a Rho (MI), orari della segreteria e informazioni sui corsi.`}
    ogTitle="Contatti e sedi | InBallet"
    ogDescription="Due sedi a Lainate e Rho: chiamaci o scrivici per scegliere il corso giusto."
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={bg.hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">Contatti e sedi</h1>
            <p class="chisiamo-hero-tagline">Due sedi a Lainate e Rho, a nord-ovest di Milano: chiamaci, scrivici o passa in segreteria.</p>
        </div>
    </section>

    <!-- Contatti: intro, poi tre blocchi distinti (scrivici, sedi, orari) -->
    <section id="contatti" class="contatti">
        <div class="container">
            <header class="contatti-intro">
                <span class="eyebrow">Scuola di danza a Lainate e Rho</span>
                <h2 class="titolo-sezione">Il primo passo è un <em>passo di danza</em></h2>
                <p class="intro-sezione">
                    Raccontaci chi sei e cosa vorresti imparare: ti aiutiamo a scegliere
                    il corso giusto per età e livello e ti diamo tutte le informazioni su orari e iscrizione.
                </p>
            </header>

            <div class="info">
                <div class="info-blocco">
                    <h3 class="info-titolo">Chiamaci o scrivici</h3>
                    <dl class="info-dati">
                        <div>
                            <dt>Telefono</dt>
                            <dd><a href={TEL_HREF}>{TEL}</a></dd>
                        </div>
                        <div>
                            <dt>E-mail</dt>
                            <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
                        </div>
                        <div>
                            <dt>WhatsApp</dt>
                            <dd><a href={scuola.whatsapp} target="_blank" rel="noopener">Scrivici su WhatsApp</a></dd>
                        </div>
                    </dl>
                    <div class="info-social">
                        <span class="info-etichetta">Seguici</span>
                        <a href={scuola.social.instagram} target="_blank" rel="noopener"><i class="fab fa-instagram" aria-hidden="true"></i> Instagram</a>
                        <a href={scuola.social.facebook} target="_blank" rel="noopener"><i class="fab fa-facebook" aria-hidden="true"></i> Facebook</a>
                    </div>
                </div>

                <div class="info-blocco">
                    <h3 class="info-titolo">Le nostre sedi</h3>
                    <dl class="info-dati">
                        {sedi.map((sede, i) => (
                            <div>
                                <dt>{sede.citta}{i === 0 && ' · sede centrale'}</dt>
                                <dd>
                                    <address class="sede-indirizzo">{sede.via}<br>{sede.cap} {sede.citta} ({sede.provincia})</address>
                                    <a href={sede.maps} target="_blank" rel="noopener" class="link-cta">
                                        Indicazioni <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </dd>
                            </div>
                        ))}
                    </dl>
                </div>

                <div class="info-blocco">
                    <h3 class="info-titolo">
                        Orari della segreteria
                        <span id="open-status" class="orari-status" aria-live="polite"></span>
                    </h3>
                    <ul class="orari-grid" id="orari-grid">
                        {settimana.map((s) => (
                            <li class="orario-item" data-giorno={s.giorno} data-apre={s.apre} data-chiude={s.chiude}>
                                <span class="orario-day">{s.giorno}</span>
                                {s.apre
                                    ? <span class="orario-time">{s.apre}–{s.chiude}</span>
                                    : <span class="orario-time chiuso">Chiuso</span>}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Galleria: la scuola dal vivo, subito dopo i contatti -->
    <Galleria
        eyebrow="Vieni a trovarci"
        titolo="Le nostre sale, <em>la nostra danza</em>"
        testo="Lezioni, spettacoli e dietro le quinte: uno sguardo su cosa succede a Lainate e Rho. Apri una foto per vederla a tutto schermo."
    />

    <Fragment slot="scripts">
        <script>
            import '../scripts/contatti';
        </script>
    </Fragment>
</Base>

<style>
  .contatti {
    padding: var(--section-y) 0;
    background: var(--white);
    /* l'ancora #contatti non deve finire sotto l'header fisso (e il banner) */
    scroll-margin-top: calc(var(--header-h) + var(--banner-height, 0px));
  }

  .contatti-intro {
    max-width: 48rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .contatti-intro .eyebrow {
    display: block;
    margin-bottom: 1rem;
  }

  .contatti-intro .titolo-sezione {
    margin-bottom: 1.5rem;
  }

  /* ---------- Tre blocchi distinti su fondo chiaro ---------- */
  .info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .info-blocco {
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
    background: var(--bg-soft);
    border-radius: var(--radius-card);
  }

  .info-titolo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem 1rem;
    margin: 0 0 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--primary-blue);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    color: var(--dark-navy);
  }

  /* Etichetta piccola sopra ogni dato */
  .info-dati {
    display: grid;
    gap: 1.5rem;
    margin: 0;
  }

  .info-dati dt,
  .info-etichetta {
    margin-bottom: .35rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-light);
  }

  .info-dati dd {
    margin: 0;
  }

  .info-dati dd > a:not(.link-cta),
  .info-social a {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--dark-navy);
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--primary-blue), var(--primary-blue)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s ease, color 0.3s ease;
  }

  .info-dati dd > a:not(.link-cta):hover,
  .info-social a:hover {
    color: var(--primary-blue-dark);
    background-size: 100% 2px;
  }

  .sede-indirizzo {
    margin: 0 0 .9rem;
    font-size: var(--text-base);
    font-style: normal;
    line-height: 1.6;
    color: var(--dark-navy);
  }

  /* Social in fondo al blocco */
  .info-social {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .5rem 1.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .info-social .info-etichetta {
    flex-basis: 100%;
    margin-bottom: 0;
  }

  .info-social a i {
    margin-right: .4rem;
    color: var(--primary-blue-dark);
  }

  /* Orari e stato: stato e giorno corrente da src/scripts/contatti.ts */
  :global(.orari-status) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--dark-navy);
  }

  :global(.orari-status:empty) {
    display: none;
  }

  :global(.orari-status i) {
    font-size: 0.5rem;
  }

  :global(.orari-status.aperto i) {
    color: #22c55e;
  }

  :global(.orari-status.chiuso i) {
    color: #ef4444;
  }

  .orari-grid {
    list-style: none;
    width: 100%;
    max-width: 22rem;
    margin: 0;
    padding: 0;
  }

  :global(.orario-item) {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: 0.3rem 0;
    font-size: var(--text-base);
    color: var(--text-dark);
  }

  :global(.orario-day) {
    font-weight: 600;
  }

  :global(.orario-time) {
    font-variant-numeric: tabular-nums;
    color: var(--text-light);
  }

  :global(.orario-time.chiuso) {
    font-style: italic;
  }

  :global(.orario-item.oggi .orario-day),
  :global(.orario-item.oggi .orario-time) {
    color: var(--primary-blue-dark);
    font-weight: 600;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .info {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Orari sotto, su tutta la larghezza */
    .info-blocco:last-child {
      grid-column: 1 / -1;
    }

    .info-blocco:last-child .orari-grid {
      max-width: 26rem;
    }
  }

  @media (max-width: 900px) {
    .contatti-intro {
      margin: 0 0 2.5rem;
      text-align: left;
    }
  }

  @media (max-width: 700px) {
    .info {
      grid-template-columns: minmax(0, 1fr);
    }

    .info-blocco {
      padding: 1.75rem 1.5rem;
    }
  }
</style>
