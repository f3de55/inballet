---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { heroPagina } from '../lib/hero-pagine';
import { categorieCorsi } from '../data/scuola';
import { enfatizza } from '../lib/text';
import '../styles/pages/corsi.css';

// Fascia d'età e frequenza di ogni corso, dalla sua pagina (es. "/hip-hop" → "Dai 6 anni · 1-2 lezioni a settimana")
const pagineCorsi = new Map((await getCollection('corsi')).map((c) => [`/${c.id}`, c.data]));
const percorsi = categorieCorsi.map((cat) => ({
    ...cat,
    corsi: cat.corsi.map((c) => {
        const pagina = pagineCorsi.get(c.url);
        if (!pagina) throw new Error(`Pagina del sottocorso non trovata: ${c.url}`);
        return { ...c, pagina };
    }),
}));
// Nel nome basta la disciplina: l'età è già nell'etichetta accanto
const nomeBreve = (nome: string) => nome.replace(/\s*\(.*\)$/, '');
const totale = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

const hero = await heroPagina('corsi');
---

<Base
    title="Corsi di danza a Lainate e Rho per tutte le età | InBallet"
    description={`I ${totale} corsi di InBallet a Lainate e Rho (MI): classica, modern, contemporanea, hip-hop, breaking, yoga e pilates per bambini dai 3 anni, ragazzi e adulti.`}
    ogTitle="I corsi di danza di InBallet"
    ogDescription="Classica, contemporanea, urban, benessere e percorsi per età: trova il corso giusto per te."
>

    <Fragment slot="head">
        {hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>
    <!-- Hero -->
    <section class="chisiamo-hero hero-banner">
        <div class="chisiamo-hero-image hero-banner-image" style={hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">I nostri corsi di danza</h1>
            <p class="hero-lead"><strong>Dai 3 anni agli adulti</strong>, dalla classica agli stili urbani, per <strong>ogni livello</strong>.</p>
        </div>
    </section>

    <!-- Catalogo: tutti i corsi, raggruppati per stile. La barra dei filtri resta in vista mentre si scorre:
         «Tutti» mostra ogni gruppo, uno stile mostra solo il suo (src/scripts/corsi.ts). Senza JavaScript i filtri
         sono link ai gruppi e si vede tutto -->
    <section class="catalogo" aria-labelledby="catalogo-titolo">
        <div class="intro-editoriale">
            <h2 class="titolo-sezione" id="catalogo-titolo">Trova il tuo <em>corso</em></h2>
            <p>Tutti i corsi a Lainate e Rho, <strong>dai 3 anni agli adulti</strong>: scegli uno stile per vedere solo i suoi.</p>
        </div>

        <div class="catalogo-filtri">
            <div class="container">
                <nav class="filtri" aria-label="Filtra per stile">
                    <a href="#catalogo-corsi" class="filtro" data-filtro="tutti">Tutti i corsi</a>
                    {percorsi.map((cat) => (
                        <a href={`#${cat.id}`} class="filtro" data-filtro={cat.id}>
                            <i class={`fas ${cat.icona}`} aria-hidden="true"></i>
                            {cat.breve}
                        </a>
                    ))}
                </nav>
            </div>
        </div>

        <div class="container" id="catalogo-corsi">
            {percorsi.map((cat) => (
                <div class="gruppo" id={cat.id} data-gruppo={cat.id} role="group" aria-labelledby={`${cat.id}-titolo`}>
                    <div class="gruppo-intestazione">
                        <h3 class="gruppo-titolo" id={`${cat.id}-titolo`}>
                            <i class={`fas ${cat.icona}`} aria-hidden="true"></i>
                            {cat.nome}
                        </h3>
                        <p class="gruppo-sintesi testo-piccolo">{cat.sintesi}</p>
                    </div>
                    <ul class="corsi-griglia">
                        {cat.corsi.map((c) => (
                            <li>
                                <a href={c.url} class="corso-card">
                                    <span class="corso-foto" aria-hidden="true">
                                        <Img src={c.pagina.introImage} alt="" fuoco={c.pagina.introFuoco} loading="lazy" decoding="async" widths={[400, 640]} sizes="(min-width: 1100px) 280px, (min-width: 801px) 33vw, (min-width: 481px) 50vw, 110px" width="450" height="300" />
                                    </span>
                                    <div class="corso-testo">
                                        <h4 class="corso-nome">{nomeBreve(c.nome)}</h4>
                                        <p class="corso-dettagli testo-piccolo">{c.pagina.badge.replace(' - ', ' · ')} · {c.pagina.frequenza}</p>
                                        <span class="corso-cta">Scopri il corso <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </section>

    <!-- Chiusura: invito al contatto (fondo opposto all'ultimo percorso) -->
    <section class="corsi-chiusura" aria-labelledby="corsi-fine-titolo">
        <div class="container">
            <aside class="corsi-fine">
                <div class="corsi-fine-testo">
                    <h3 class="corsi-fine-titolo" id="corsi-fine-titolo">Non sai quale corso scegliere?</h3>
                    <p>Raccontaci <strong>età, esperienza</strong> e cosa ti piacerebbe provare: ti aiutiamo a trovare il percorso giusto.</p>
                </div>
                <a href="/contatti" class="btn-primary">
                    Parliamone insieme
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </aside>
        </div>
    </section>
    <Fragment slot="scripts">
        <script>
            import '../scripts/corsi';
        </script>
    </Fragment>
</Base>
