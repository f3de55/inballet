---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { webp } from '../lib/images';
import { categorieCorsi, scuola } from '../data/scuola';

// Fascia d'età di ogni corso, dalla sua pagina (es. "/hip-hop" → "Ragazzi e adulti")
const eta = new Map((await getCollection('corsi')).map((c) => [`/${c.id}`, c.data.badge.replace(' - ', ' · ')]));
// Nel nome basta la disciplina: l'età è già nell'etichetta accanto
const nomeBreve = (nome: string) => nome.replace(/\s*\(.*\)$/, '');
const totale = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

const PROVA = `${scuola.whatsapp}?text=${encodeURIComponent('Ciao! Vorrei prenotare una lezione di prova.')}`;
const heroBg = await webp('gallery-10.jpg', 1920);
---

<Base
    title="Corsi di Danza a Lainate e Rho - InBallet"
    description={`Tutti i ${totale} corsi InBallet a Lainate e Rho: danza classica, modern, contemporanea, hip-hop, heels, breaking, yoga, pilates e percorsi per età dai 3 anni agli adulti.`}
    ogTitle="I Corsi di InBallet"
    ogDescription="Danza classica, contemporanea, urban, benessere e percorsi per età: trova il corso giusto per te."
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={`background-image: url('${heroBg}')`}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <span class="chisiamo-hero-badge">Lainate e Rho</span>
            <h1 class="chisiamo-hero-title">I Nostri Corsi</h1>
            <p class="chisiamo-hero-tagline">Dai 3 anni agli adulti, per ogni livello.</p>
            <a href="#corsi" class="chisiamo-scroll-arrow" aria-label="Scorri in basso">
                <i class="fas fa-chevron-down"></i>
            </a>
        </div>
    </section>

    <section id="corsi" class="corsi">
        <div class="container">
            <header class="corsi-intro intro-sezione">
                <p class="eyebrow">{totale} corsi in {categorieCorsi.length} percorsi</p>
                <h2 class="titolo titolo-sezione">Trova il tuo <em>percorso</em></h2>
                <nav class="salti" aria-label="Percorsi">
                    {categorieCorsi.map((cat) => <a href={`#${cat.id}`}>{cat.nome}</a>)}
                </nav>
            </header>

            {categorieCorsi.map((cat, i) => (
                <article class="categoria" id={cat.id} aria-labelledby={`${cat.id}-titolo`}>
                    <figure class="categoria-foto">
                        <Img src={cat.immagine.src} alt={cat.immagine.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" />
                    </figure>
                    <div class="categoria-testo">
                        <span class="categoria-numero">{String(i + 1).padStart(2, '0')}</span>
                        <h2 class="categoria-titolo" id={`${cat.id}-titolo`}>{cat.nome}</h2>
                        <p class="categoria-descrizione" set:html={cat.descrizione} />
                        <ul class="corsi-lista">
                            {cat.corsi.map((c) => (
                                <li>
                                    <a href={c.url}>
                                        <span class="corso-nome">{nomeBreve(c.nome)}</span>
                                        <span class="corso-eta">{eta.get(c.url)}</span>
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </article>
            ))}

            <footer class="corsi-fine">
                <p>Non sai quale scegliere? Vieni a provare: ti aiutiamo a trovare il corso giusto.</p>
                <a href={PROVA} target="_blank" rel="noopener" class="link-cta">
                    Prenota una lezione di prova
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </footer>
        </div>
    </section>
</Base>

<style>
  .corsi {
    padding: var(--section-y) 0;
    background: var(--white);
    scroll-margin-top: calc(80px + var(--banner-height, 0px));
  }

  /* ---------- Introduzione ---------- */
  .corsi-intro {
    max-width: 1100px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .salti {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    row-gap: 0.6rem;
    margin-top: 1.75rem;
  }

  /* Separatore "|" tra un percorso e l'altro */
  .salti a + a::before {
    content: '|';
    margin: 0 1rem;
    color: rgba(26, 26, 26, 0.25);
    font-weight: 400;
    pointer-events: none;
  }

  .salti a {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .salti a:hover {
    color: var(--primary-blue-dark);
  }

  /* ---------- Categorie: foto e corsi, alternate ---------- */
  .categoria {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 4.5rem;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 3.5rem 0;
    border-top: 1px solid rgba(26, 26, 26, 0.1);
    scroll-margin-top: calc(90px + var(--banner-height, 0px));
  }

  .categoria:nth-of-type(even) .categoria-foto {
    order: 2;
  }

  .categoria-foto {
    position: relative;
    isolation: isolate;
    margin: 0 1.5rem 1.5rem 1.5rem;
  }

  /* Cornice azzurra sfalsata, come in Contatti e nella homepage */
  .categoria-foto::before {
    content: '';
    position: absolute;
    inset: 2rem 2rem -1.5rem -1.5rem;
    border: 2px solid var(--primary-blue);
    border-radius: 24px;
    z-index: -1;
  }

  .categoria:nth-of-type(even) .categoria-foto::before {
    inset: 2rem -1.5rem -1.5rem 2rem;
  }

  .categoria-foto :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
  }

  .categoria-numero {
    display: block;
    font-size: var(--text-2xl);
    font-weight: 300;
    line-height: 1;
    color: var(--primary-blue-dark);
    margin-bottom: 0.75rem;
  }

  .categoria-titolo {
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--dark-navy);
    margin-bottom: 0.9rem;
  }

  .categoria-descrizione {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }

  .categoria-descrizione :global(strong) {
    font-weight: 500;
    color: var(--text-light);
  }

  /* ---------- Elenco corsi ---------- */
  .corsi-lista {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 2rem;
  }

  .corsi-lista a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'nome freccia' 'eta freccia';
    align-items: center;
    column-gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(26, 26, 26, 0.1);
    color: var(--dark-navy);
    text-decoration: none;
  }

  .corso-nome {
    grid-area: nome;
    font-size: 1.0625rem;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .corso-eta {
    grid-area: eta;
    font-size: 0.875rem;
    color: var(--text-light);
  }

  .corsi-lista i {
    grid-area: freccia;
    font-size: 0.8rem;
    color: var(--primary-blue-dark);
    opacity: 0.5;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .corsi-lista a:hover .corso-nome {
    color: var(--primary-blue-dark);
  }

  .corsi-lista a:hover i {
    opacity: 1;
    transform: translateX(4px);
  }

  /* ---------- Chiusura ---------- */
  .corsi-fine {
    max-width: 1100px;
    margin: 0 auto;
    padding-top: 3.5rem;
    border-top: 1px solid rgba(26, 26, 26, 0.1);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .corsi-fine p {
    font-size: var(--text-lg);
    color: var(--text-dark);
    max-width: 34rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {

    .corsi-intro {
      margin-bottom: 2.5rem;
    }

    .categoria {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3rem 0;
    }

    .categoria:nth-of-type(even) .categoria-foto {
      order: 0;
    }

    .categoria-foto {
      margin: 0 1rem 1rem 1rem;
    }

    .categoria-foto::before,
    .categoria:nth-of-type(even) .categoria-foto::before {
      inset: 1.25rem 1.25rem -1rem -1rem;
    }

    .categoria-foto :global(img) {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 520px) {
    .corsi-lista {
      column-gap: 1rem;
    }

    .corso-nome {
      font-size: 1rem;
    }

    .corso-eta {
      font-size: 0.8125rem;
    }

    /* Su più righe il separatore finirebbe a inizio riga: solo spazio */
    .salti {
      gap: 0.5rem 1.25rem;
    }

    .salti a + a::before {
      content: none;
    }
  }
</style>
