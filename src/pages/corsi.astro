---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { heroPagina } from '../lib/hero-pagine';
import { categorieCorsi } from '../data/scuola';
import { enfatizza } from '../lib/text';
import { immaginiSottocorsi } from '../data/immagini-sottocorsi';
import '../styles/pages/corsi.css';

// Fascia d'età e frequenza di ogni corso, dalla sua pagina (es. "/hip-hop" → "Dai 6 anni · 1-2 lezioni a settimana")
const pagineCorsi = new Map((await getCollection('corsi')).map((c) => [`/${c.id}`, c.data]));
const percorsi = categorieCorsi.map((cat) => ({
    ...cat,
    corsi: cat.corsi.map((c) => {
        const pagina = pagineCorsi.get(c.url);
        if (!pagina) throw new Error(`Pagina del sottocorso non trovata: ${c.url}`);
        const immagine = immaginiSottocorsi[c.url.slice(1)];
        if (!immagine) throw new Error(`Immagine del sottocorso non trovata: ${c.url}`);
        return { ...c, pagina, immagine };
    }),
}));
// Nel nome basta la disciplina: l'età è già nell'etichetta accanto
const nomeBreve = (nome: string) => nome.replace(/\s*\(.*\)$/, '');
// Titolo della sezione: l'ultima parola in corsivo, come gli altri titoli del sito
const titoloEm = (nome: string) => nome.replace(/(\S+)$/, '<em>$1</em>');
const totale = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

const hero = await heroPagina('corsi');
---

<Base
    title="Corsi di danza a Lainate e Rho per tutte le età | InBallet"
    description={`I ${totale} corsi di InBallet a Lainate e Rho (MI): classica, modern, contemporanea, hip-hop, breaking, yoga e pilates per bambini dai 3 anni, ragazzi e adulti.`}
    ogTitle="I corsi di danza di InBallet"
    ogDescription="Classica, contemporanea, urban, benessere e percorsi per età: trova il corso giusto per te."
>

    <Fragment slot="head">
        {hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>
    <!-- Hero -->
    <section class="chisiamo-hero hero-banner">
        <div class="chisiamo-hero-image hero-banner-image" style={hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">I nostri corsi di danza</h1>
            <p class="hero-lead"><strong>Dai 3 anni agli adulti</strong>, dalla classica agli stili urbani, per <strong>ogni livello</strong>.</p>
        </div>
    </section>

    <!-- Trova il tuo corso: un riquadro fotografico per stile, porta alla sua sezione qui sotto. Il contorno di ogni
         riquadro è una linea che gira cambiando colore, da un punto diverso per ognuno (--i) -->
    <section class="trova-section" aria-labelledby="trova-titolo">
        <div class="intro-editoriale">
            <h2 class="titolo-sezione" id="trova-titolo">Trova il tuo <em>corso</em></h2>
            <p>{totale} corsi a Lainate e Rho, <strong>dai 3 anni agli adulti</strong>: scegli lo stile che fa per te.</p>
        </div>
        <div class="container">
            <ul class="stili">
                {percorsi.map((cat, i) => (
                    <li style={`--i: ${i}`}>
                        <a href={`#${cat.id}`} class="stile">
                            <span class="stile-bordo" aria-hidden="true"></span>
                            <Img class="stile-foto" src={cat.immagine.src} alt="" aria-hidden="true" fuoco={cat.immagine.fuoco} loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(min-width: 1101px) 560px, (min-width: 481px) 50vw, 100vw" />
                            <div class="stile-testo">
                                <h3 class="stile-nome titolo-card">{cat.nome}</h3>
                                <p class="stile-numero">{cat.corsi.length} corsi <i class="fas fa-arrow-down" aria-hidden="true"></i></p>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- Griglie editoriali ariose: 2 + 2 o 3 + 2 corsi su desktop, tutti dello stesso formato. -->
    {percorsi.map((cat, i) => (
        <section id={cat.id} class:list={['corsi-stile', { 'corsi-stile--soft': i % 2 === 1 }, i === 0 || i === 4 ? ['decoro-onde', { 'decoro-onde--sinistra': i === 4 }] : '']} aria-labelledby={`${cat.id}-titolo`}>
            <div class="intro-editoriale">
                <p class="eyebrow corsi-stile-indice"><span aria-hidden="true">0{i + 1} / 05</span> {cat.corsi.length} percorsi da scoprire</p>
                <h2 class="titolo-sezione" id={`${cat.id}-titolo`} set:html={titoloEm(cat.nome)} />
                <p set:html={enfatizza(cat.descrizione, cat.evidenzia)} />
            </div>
            <div class="container corsi-stile-contenuto">
                <div class="corsi-stile-comandi" hidden>
                    <button type="button" class="btn-icon btn-icon--contorno" data-corsi-direzione="-1" aria-label={`Corsi precedenti: ${cat.nome}`} aria-controls={`${cat.id}-corsi`}><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
                    <button type="button" class="btn-icon btn-icon--contorno" data-corsi-direzione="1" aria-label={`Corsi successivi: ${cat.nome}`} aria-controls={`${cat.id}-corsi`}><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                </div>
                <ul class="corsi-stile-elenco" id={`${cat.id}-corsi`} tabindex="0" aria-labelledby={`${cat.id}-titolo`}>
                    {cat.corsi.map((c) => (
                        <li class="corsi-scheda">
                            <a href={c.url} class="corsi-scheda-link" aria-labelledby={`${c.url.slice(1)}-nome`}>
                                <div class="corsi-scheda-visual">
                                    <Img class="corsi-scheda-foto" src={c.immagine.src} alt={c.immagine.alt} width={1536} height={1024} loading="lazy" decoding="async" widths={[320, 480, 800]} sizes="(min-width: 1200px) 352px, (min-width: 901px) 33vw, (min-width: 601px) 50vw, 80vw" />
                                </div>
                                <div class="corsi-scheda-corpo">
                                    <p class="eyebrow corsi-scheda-eta">{c.pagina.badge.replace(' - ', ' · ')}</p>
                                    <h3 class="titolo-card" id={`${c.url.slice(1)}-nome`}>{nomeBreve(c.nome)}</h3>
                                    <div class="corsi-scheda-fondo">
                                        <p class="testo-piccolo corsi-scheda-frequenza"><i class="far fa-clock" aria-hidden="true"></i> {c.pagina.frequenza}</p>
                                        <span class="corsi-scheda-freccia" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                                    </div>
                                </div>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    ))}

    <!-- Chiusura: invito al contatto -->
    <section class="corsi-chiusura" aria-labelledby="corsi-fine-titolo">
        <div class="container">
            <aside class="corsi-fine">
                <div class="corsi-fine-testo">
                    <h3 class="corsi-fine-titolo" id="corsi-fine-titolo">Non sai quale corso scegliere?</h3>
                    <p>Raccontaci <strong>età, esperienza</strong> e cosa ti piacerebbe provare: ti aiutiamo a trovare il percorso giusto.</p>
                </div>
                <a href="/contatti" class="btn-primary">
                    Parliamone insieme
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </aside>
        </div>
    </section>
</Base>

<script>
    import '../scripts/corsi';
</script>
