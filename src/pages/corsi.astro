---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondo } from '../lib/images';
import { categorieCorsi } from '../data/scuola';

// Fascia d'età di ogni corso, dalla sua pagina (es. "/hip-hop" → "Ragazzi e adulti")
const eta = new Map((await getCollection('corsi')).map((c) => [`/${c.id}`, c.data.badge.replace(' - ', ' · ')]));
// Nel nome basta la disciplina: l'età è già nell'etichetta accanto
const nomeBreve = (nome: string) => nome.replace(/\s*\(.*\)$/, '');
const totale = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

const hero = await sfondo('gallery-3.jpg', { desktop: '50% 55%', tablet: '50% 50%' });
---

<Base
    title="Corsi di danza a Lainate e Rho per tutte le età | InBallet"
    description={`I ${totale} corsi di InBallet a Lainate e Rho (MI): classica, modern, contemporanea, hip-hop, breaking, yoga e pilates per bambini dai 3 anni, ragazzi e adulti.`}
    ogTitle="I corsi di danza di InBallet"
    ogDescription="Classica, contemporanea, urban, benessere e percorsi per età: trova il corso giusto per te."
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">I nostri corsi di danza</h1>
            <p class="chisiamo-hero-tagline">Dai 3 anni agli adulti, dalla classica agli stili urbani, per ogni livello.</p>
        </div>
    </section>

    <section id="corsi" class="corsi decoro-onde">
        <div class="container">
            <header class="corsi-intro intro-sezione">
                <p class="eyebrow">{totale} corsi in {categorieCorsi.length} percorsi</p>
                <h2 class="titolo titolo-sezione">Trova il tuo <em>percorso</em></h2>
                <p class="corsi-lead">A Lainate e Rho si comincia a 3 anni con Avviamento alla Danza e non c'è un'età per smettere: per gli adulti ci sono corsi anche per chi parte da zero.</p>
                <nav class="salti" aria-label="Vai al percorso">
                    {categorieCorsi.map((cat) => (
                        <a href={`#${cat.id}`}>
                            <i class={`fas ${cat.icona} salto-numero`} aria-hidden="true"></i>
                            <span class="salto-nome">{cat.nome}</span>
                            <i class="fas fa-arrow-down" aria-hidden="true"></i>
                        </a>
                    ))}
                </nav>
            </header>

            {categorieCorsi.map((cat, i) => (
                <article class="categoria" id={cat.id} aria-labelledby={`${cat.id}-titolo`}>
                    <figure class="categoria-foto">
                        <Img src={cat.immagine.src} alt={cat.immagine.alt} fuoco={cat.immagine.fuoco} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" />
                    </figure>
                    <div class="categoria-testo">
                        <i class={`fas ${cat.icona} categoria-numero`} aria-hidden="true"></i>
                        <h2 class="categoria-titolo" id={`${cat.id}-titolo`}>{cat.nome}</h2>
                        <p class="categoria-descrizione" set:html={cat.descrizione} />
                        <ul class="corsi-lista">
                            {cat.corsi.map((c) => (
                                <li>
                                    <a href={c.url}>
                                        <span class="corso-nome">{nomeBreve(c.nome)}</span>
                                        <span class="corso-eta">{eta.get(c.url)}</span>
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </article>
            ))}

            <!-- Chiusura: invito al contatto, stesso schema della homepage -->
            <aside class="corsi-fine" aria-labelledby="corsi-fine-titolo">
                <div class="corsi-fine-testo">
                    <h2 class="corsi-fine-titolo" id="corsi-fine-titolo">Non sai quale corso scegliere?</h2>
                    <p>Raccontaci età, esperienza e cosa ti piacerebbe provare: ti aiutiamo a trovare il percorso giusto.</p>
                </div>
                <a href="/contatti" class="btn-primary">
                    <span>Parliamone insieme</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </aside>
        </div>
    </section>
</Base>

<style>
  .corsi {
    padding: var(--section-y) 0;
    background: var(--white);
    scroll-margin-top: calc(var(--header-h) + var(--banner-height, 0px));
  }

  /* ---------- Introduzione ---------- */
  .corsi-intro {
    max-width: 1100px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .corsi-lead {
    max-width: 44rem;
    margin: 1.25rem auto 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-light);
  }

  /* Indice dei percorsi su PC: pillole centrate (nome e freccia in giù, portano più
     sotto nella pagina); il numero compare solo nella versione a righe sotto i 900px */
  .salti {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .6rem;
    margin: 2.5rem auto 0;
  }

  .salti a {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    min-height: 44px;
    padding: .6rem 1.15rem;
    border: 1px solid rgba(70, 130, 180, .35);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--dark-navy);
    text-decoration: none;
    transition: background-color .25s ease, border-color .25s ease;
  }

  .salto-numero {
    display: none;
    font-size: var(--text-sm);
    color: var(--primary-blue-dark);
  }

  .salto-nome {
    font-size: var(--text-nav);
    font-weight: 600;
    line-height: 1.3;
  }

  .salti a i {
    font-size: var(--text-xs);
    color: var(--primary-blue-dark);
    transition: transform .25s ease, color .25s ease;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 901px) {
    .salti a:hover {
      background: var(--primary-blue);
      border-color: var(--primary-blue);
    }

    .salti a:hover i {
      color: var(--dark-navy);
      transform: translateY(3px);
    }
  }

  .salti a:focus-visible {
    outline: 2px solid var(--primary-blue-dark);
    outline-offset: 4px;
  }

  /* ---------- Categorie: foto e corsi, alternate ---------- */
  /* Larghezza del container (1200px come la home), foto e testo a pari colonne */
  .categoria {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
    padding: 4.5rem 0;
    scroll-margin-top: calc(var(--header-h) + 10px + var(--banner-height, 0px));
  }

  /* Percorsi pari su fascia azzurrina a tutta larghezza: il colore si estende oltre
     il container con un'ombra piena, ritagliata solo in verticale */
  .categoria:nth-of-type(even) {
    background: var(--bg-soft);
    box-shadow: 0 0 0 100vmax var(--bg-soft);
    clip-path: inset(0 -100vmax);
  }

  .categoria:nth-of-type(even) .categoria-foto {
    order: 2;
  }

  .categoria-foto {
    position: relative;
    isolation: isolate;
    margin: 0 1.5rem 1.5rem 1.5rem;
  }

  /* Cornice azzurra sfalsata verso il testo, come in Contatti e nella homepage */
  .categoria-foto::before {
    content: '';
    position: absolute;
    inset: 2.5rem -1.5rem -1.5rem 2.5rem;
    border: 2px solid var(--primary-blue);
    border-radius: var(--radius-img);
    z-index: -1;
  }

  .categoria:nth-of-type(even) .categoria-foto::before {
    inset: 2.5rem 2.5rem -1.5rem -1.5rem;
  }

  .categoria-foto :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-img);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
  }

  /* Icona del percorso sopra il titolo */
  .categoria-numero {
    display: block;
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--primary-blue-dark);
    margin-bottom: 1rem;
  }

  .categoria-titolo {
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--dark-navy);
    margin-bottom: 0.9rem;
  }

  .categoria-descrizione {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }

  .categoria-descrizione :global(strong) {
    font-weight: 500;
    color: var(--text-light);
  }

  /* ---------- Elenco corsi ---------- */
  .corsi-lista {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 2rem;
  }

  .corsi-lista a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'nome freccia' 'eta freccia';
    align-items: center;
    column-gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(26, 26, 26, 0.1);
    color: var(--dark-navy);
    text-decoration: none;
  }

  .corso-nome {
    grid-area: nome;
    font-size: var(--text-base);
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .corso-eta {
    grid-area: eta;
    font-size: var(--text-sm);
    color: var(--text-light);
  }

  .corsi-lista i {
    grid-area: freccia;
    font-size: var(--text-xs);
    color: var(--primary-blue-dark);
    opacity: 0.5;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .corsi-lista a:hover .corso-nome {
      color: var(--primary-blue-dark);
    }

    .corsi-lista a:hover i {
      opacity: 1;
      transform: translateX(4px);
    }
  }

  /* ---------- Chiusura ---------- */
  /* Card di chiusura: titolo e testo a sinistra, pulsante principale a destra */
  .corsi-fine {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: 2.5rem;
    padding: 2.5rem 3rem;
    background: var(--bg-soft);
    border-radius: var(--radius-card);
  }

  .corsi-fine-titolo {
    margin: 0 0 .5rem;
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    color: var(--dark-navy);
  }

  .corsi-fine p {
    margin: 0;
    max-width: 38rem;
    font-size: var(--text-base);
    color: var(--text-light);
  }

  .corsi-fine .btn-primary {
    flex-shrink: 0;
  }

  /* ---------- Responsive ---------- */

  /* Colonna di testo stretta: corsi su una colonna, nomi non spezzati */
  @media (max-width: 1100px) {
    .corsi-lista {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Tablet: percorsi a righe; foto e testo restano affiancati (alternati), corsi su una colonna */
  @media (max-width: 900px) {
    /* Percorsi a righe (5 colonne non ci stanno): numero, nome, freccia a destra */
    .salti {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      max-width: 640px;
      margin-top: 1.5rem;
      border-bottom: 1px solid rgba(26, 26, 26, .12);
      text-align: left;
    }

    .salti a {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      align-items: center;
      min-height: 0;
      padding: 1rem 0;
      border: none;
      border-top: 1px solid rgba(26, 26, 26, .12);
      border-radius: 0;
      background: none;
    }

    .salto-numero {
      display: block;
    }

    .salto-nome {
      font-size: var(--text-base);
      font-weight: 700;
    }

    .corsi-intro {
      margin-bottom: 2.5rem;
    }

    .categoria {
      grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
      gap: 2.5rem;
      align-items: start;
      padding: 3.5rem 0;
    }

    .categoria-foto {
      margin: 0 1rem 1rem 1rem;
    }

    .categoria-foto::before {
      inset: 1.5rem -1rem -1rem 1.5rem;
    }

    .categoria:nth-of-type(even) .categoria-foto::before {
      inset: 1.5rem 1.5rem -1rem -1rem;
    }

    .categoria-descrizione {
      margin-bottom: 1rem;
    }

    .corsi-lista {
      grid-template-columns: minmax(0, 1fr);
    }

    .corsi-lista a {
      padding: .7rem 0;
    }
  }

  /* Mobile: foto sopra in formato basso, testo e corsi sotto; intro a sinistra */
  @media (max-width: 640px) {
    .corsi-intro {
      text-align: left;
    }

    .corsi-lead {
      margin-left: 0;
    }

    .categoria {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
      padding: 3rem 0;
    }

    .categoria:nth-of-type(even) .categoria-foto {
      order: 0;
    }

    .corsi-fine {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem 1.5rem;
    }

    .categoria-foto {
      margin: 0 .75rem .75rem 0;
    }

    .categoria-foto::before,
    .categoria:nth-of-type(even) .categoria-foto::before {
      inset: 1.25rem -.75rem -.75rem 1.25rem;
    }

    .categoria-foto :global(img) {
      aspect-ratio: 16 / 9;
    }

    /* Nome ed età sulla stessa riga: righe più basse */
    .corsi-lista a {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'nome eta freccia';
      column-gap: .75rem;
      padding: .7rem 0;
    }

    .corso-eta {
      max-width: 9.5rem;
      line-height: 1.3;
      text-align: right;
    }
  }
</style>
