---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondo } from '../lib/images';
import { categorieCorsi } from '../data/scuola';
import { enfatizza } from '../lib/text';

// Fascia d'età di ogni corso, dalla sua pagina (es. "/hip-hop" → "Ragazzi e adulti")
const eta = new Map((await getCollection('corsi')).map((c) => [`/${c.id}`, c.data.badge.replace(' - ', ' · ')]));
// Nel nome basta la disciplina: l'età è già nell'etichetta accanto
const nomeBreve = (nome: string) => nome.replace(/\s*\(.*\)$/, '');
const totale = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

const hero = await sfondo('gallery-3.jpg', { desktop: '50% 55%', tablet: '50% 50%' });
---

<Base
    title="Corsi di danza a Lainate e Rho per tutte le età | InBallet"
    description={`I ${totale} corsi di InBallet a Lainate e Rho (MI): classica, modern, contemporanea, hip-hop, breaking, yoga e pilates per bambini dai 3 anni, ragazzi e adulti.`}
    ogTitle="I corsi di danza di InBallet"
    ogDescription="Classica, contemporanea, urban, benessere e percorsi per età: trova il corso giusto per te."
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">I nostri corsi di danza</h1>
            <p class="hero-lead"><strong>Dai 3 anni agli adulti</strong>, dalla classica agli stili urbani, per <strong>ogni livello</strong>.</p>
        </div>
    </section>

    <section id="corsi" class="corsi decoro-onde">
        <div class="container">
            <header class="corsi-intro intro-sezione">
                <p class="eyebrow">{totale} corsi in {categorieCorsi.length} percorsi</p>
                <h2 class="titolo titolo-sezione">Trova il tuo <em>percorso</em></h2>
                <p class="corsi-lead">A Lainate e Rho si comincia <strong>a 3 anni</strong> con Avviamento alla Danza e <strong>non c'è un'età per smettere</strong>: per gli adulti ci sono corsi anche per chi <strong>parte da zero</strong>.</p>
                <nav class="salti" aria-label="Vai al percorso">
                    {categorieCorsi.map((cat, i) => (
                        <a href={`#${cat.id}`} style={`--i:${i}`}>
                            <i class={`fas ${cat.icona} salto-numero`} aria-hidden="true"></i>
                            <span class="salto-nome">{cat.nome}</span>
                            <i class="fas fa-arrow-down" aria-hidden="true"></i>
                        </a>
                    ))}
                </nav>
            </header>

            {categorieCorsi.map((cat, i) => (
                <article class={`categoria${i % 2 === 0 ? ' fascia-onda' : ''}`} id={cat.id} aria-labelledby={`${cat.id}-titolo`}>
                    <figure class="categoria-foto">
                        <Img src={cat.immagine.src} alt={cat.immagine.alt} fuoco={cat.immagine.fuoco} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, 30vw" />
                    </figure>
                    <div class="categoria-testo">
                        <span class="eyebrow categoria-percorso">Percorso {i + 1} di {categorieCorsi.length}</span>
                        <h2 class="categoria-titolo" id={`${cat.id}-titolo`}>{cat.nome}</h2>
                        <p class="categoria-descrizione" set:html={enfatizza(cat.descrizione, cat.evidenzia)} />
                        <ul class="corsi-lista">
                            {cat.corsi.map((c) => (
                                <li>
                                    <a href={c.url}>
                                        <span class="corso-nome titolo-card">{nomeBreve(c.nome)}</span>
                                        <span class="corso-eta">{eta.get(c.url)}</span>
                                        <i class="fas fa-arrow-right corso-freccia" aria-hidden="true"></i>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </article>
            ))}

            <!-- Chiusura: invito al contatto, stesso schema della homepage -->
            <aside class="corsi-fine" aria-labelledby="corsi-fine-titolo">
                <div class="corsi-fine-testo">
                    <h3 class="corsi-fine-titolo" id="corsi-fine-titolo">Non sai quale corso scegliere?</h3>
                    <p>Raccontaci <strong>età, esperienza</strong> e cosa ti piacerebbe provare: ti aiutiamo a trovare il percorso giusto.</p>
                </div>
                <a href="/contatti" class="btn-primary">
                    <span>Parliamone insieme</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </aside>
        </div>
    </section>
</Base>

<style>
  /* Fondo azzurrino (intro e percorsi pari); i percorsi dispari sono fasce bianche con doppia onda */
  .corsi {
    padding: 0 0 var(--section-y);
    background: var(--bg-soft);
    overflow-x: clip;
  }

  /* ---------- Introduzione ---------- */
  .corsi-intro {
    margin: 0;
    padding: var(--section-y) 0 4.5rem;
    text-align: center;
  }

  .corsi-lead {
    max-width: 44rem;
    margin: 1.25rem auto 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-light);
  }

  /* Indice dei percorsi su PC: pillole centrate (nome e freccia in giù, portano più
     sotto nella pagina); il numero compare solo nella versione a righe sotto i 900px */
  .salti {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .6rem;
    margin: 2.5rem auto 0;
  }

  .salti a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    min-height: 44px;
    padding: .6rem 1.15rem;
    border: 1px solid rgb(var(--blu-scuro-rgb) / .35);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--dark-navy);
    text-decoration: none;
    transition: background-color .25s ease, border-color .25s ease;
  }

  /* Su ogni percorso scorre di continuo un tratto azzurro lungo il bordo inferiore, come un ballerino
     alla sbarra: un percorso dopo l'altro (--i) disegna un'onda e invita a scegliere. La freccia
     accompagna il passaggio con un piccolo passo verso il basso */
  .salti a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 45%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--primary-blue) 35%, var(--primary-blue-dark) 65%, transparent);
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    animation: salto-sbarra 5.5s cubic-bezier(.4, 0, .2, 1) infinite;
    animation-delay: calc(var(--i, 0) * .7s);
  }

  /* Il tratto entra da sinistra sfumando, attraversa la riga e svanisce a destra (solo transform e
     opacità: fluido anche su telefono); poi una pausa prima del giro successivo */
  @keyframes salto-sbarra {
    0% {
      transform: translateX(-100%);
      opacity: 0;
    }

    15%,
    45% {
      opacity: 1;
    }

    60%,
    100% {
      transform: translateX(222%);
      opacity: 0;
    }
  }

  @property --angolo {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes salto-giro {
    to {
      --angolo: 360deg;
    }
  }

  @keyframes salto-passo {
    0%,
    55%,
    100% {
      transform: none;
    }

    27% {
      transform: translateY(4px);
    }
  }

  .salto-numero {
    display: none;
    font-size: var(--text-sm);
    color: var(--primary-blue-dark);
  }

  .salto-nome {
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.3;
  }

  .salti a i {
    font-size: var(--text-xs);
    color: var(--primary-blue-dark);
    transition: transform .25s ease, color .25s ease;
  }

  .salti a .fa-arrow-down {
    will-change: transform;
    animation: salto-passo 5.5s cubic-bezier(.4, 0, .2, 1) infinite;
    animation-delay: calc(var(--i, 0) * .7s);
  }

  /* "Riduci movimento": il tratto non scorre, ma resta un respiro lento di luce sotto ogni percorso
     (solo opacità): un'animazione c'è comunque su ogni dispositivo */
  @media (prefers-reduced-motion: reduce) {
    .salti a::after {
      width: 100%;
      background: linear-gradient(90deg, transparent, var(--primary-blue) 25%, var(--primary-blue) 75%, transparent);
      animation: salto-respiro 4s ease-in-out infinite;
      animation-delay: calc(var(--i, 0) * .5s);
    }

    .salti a .fa-arrow-down {
      animation: none;
    }
  }

  @keyframes salto-respiro {
    0%,
    100% {
      opacity: .15;
    }

    50% {
      opacity: 1;
    }
  }

  /* PC: pillole ben visibili, quasi un bottone da titolo di sezione */
  @media (min-width: 901px) {
    .salti {
      gap: 1rem;
      margin-top: 3rem;
    }

    .salti a {
      gap: .9rem;
      min-height: 68px;
      padding: 1rem 2rem;
      border-width: 1.5px;
      box-shadow: var(--shadow-card);
    }

    .salto-nome {
      font-size: var(--text-md);
    }

    .salti a i {
      font-size: var(--text-sm);
    }

    /* Sulle pillole il contorno è una linea continua che cambia colore girando (azzurro, blu scuro, azzurro); ogni percorso parte da un punto diverso (--i) */
    .salti a::after {
      inset: -1.5px;
      width: auto;
      height: auto;
      opacity: 1;
      transform: none;
      will-change: auto;
      padding: 3px;
      border-radius: var(--radius-pill);
      background: conic-gradient(from var(--angolo), var(--primary-blue), var(--primary-blue-dark) 50%, var(--primary-blue));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      animation: salto-giro 4.5s linear infinite;
      animation-delay: calc(var(--i, 0) * -.9s);
    }

    @media (prefers-reduced-motion: reduce) {
      .salti a::after {
        opacity: .15;
        background: var(--primary-blue);
        animation: salto-respiro 4s ease-in-out infinite;
        animation-delay: calc(var(--i, 0) * .5s);
      }
    }
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 901px) {
    .salti a:hover {
      background: var(--primary-blue);
      border-color: var(--primary-blue);
    }

    .salti a:hover i {
      color: var(--dark-navy);
      transform: translateY(3px);
      animation: none;
    }

    .salti a:hover::after {
      animation: none;
      opacity: 1;
      background: var(--primary-blue-dark);
    }
  }

  .salti a:focus-visible {
    outline: 2px solid var(--primary-blue-dark);
    outline-offset: 4px;
  }

  /* ---------- Categorie: foto e corsi, alternate ---------- */
  /* Larghezza del container (1200px come la home): il testo con i corsi ha più spazio,
     la foto è la colonna stretta, in formato fisso e centrata rispetto al testo */
  .categoria {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 4rem;
    align-items: center;
    padding: 4.5rem 0;
  }

  .categoria:nth-of-type(even) {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }

  .categoria:nth-of-type(even) .categoria-foto {
    order: 2;
  }

  .categoria-foto {
    position: relative;
    isolation: isolate;
    margin: 0 1.5rem 1.5rem 1.5rem;
  }

  /* Cornice azzurra sfalsata verso il testo, come in Contatti e nella homepage */
  .categoria-foto::before {
    content: '';
    position: absolute;
    inset: 2.5rem -1.5rem -1.5rem 2.5rem;
    border: 2px solid var(--primary-blue);
    border-radius: var(--radius-img);
    z-index: -1;
  }

  .categoria:nth-of-type(even) .categoria-foto::before {
    inset: 2.5rem 2.5rem -1.5rem -1.5rem;
  }

  .categoria-foto :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-img);
    box-shadow: 0 24px 60px rgb(var(--nero-rgb) / .14);
  }

  /* Etichetta «Percorso 1 di 5» sopra il titolo */
  .categoria-percorso {
    display: block;
    margin-bottom: 1rem;
  }

  .categoria-titolo {
    color: var(--dark-navy);
    margin-bottom: 0.9rem;
  }

  .categoria-descrizione {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }

  /* ---------- Elenco corsi ---------- */
  /* Righe separate da filetti, senza riquadri: nome e fascia d'età a sinistra, freccia a destra.
     Tutta la riga è il link; il filetto in alto chiude la lista come nelle altre sezioni del sito */
  .corsi-lista {
    list-style: none;
    border-top: 1px solid var(--linea);
  }

  .corsi-lista li {
    border-bottom: 1px solid var(--linea);
  }

  .corsi-lista a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1rem;
    padding: 1.1rem 0;
    color: var(--dark-navy);
    text-decoration: none;
  }

  .corso-nome {
    grid-column: 1;
    transition: color 0.3s ease;
  }

  .corso-eta {
    grid-column: 1;
    margin-top: .2rem;
    font-size: var(--text-md);
    line-height: 1.4;
    color: var(--text-light);
  }

  .corso-freccia {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: var(--text-sm);
    color: var(--primary-blue-dark);
    transition: transform 0.3s ease;
  }

  .corsi-lista a:focus-visible {
    outline: 2px solid var(--primary-blue-dark);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .corsi-lista a:hover .corso-nome {
      color: var(--primary-blue-dark);
    }

    .corsi-lista a:hover .corso-freccia {
      transform: translateX(4px);
    }
  }

  /* ---------- Chiusura ---------- */
  /* Card di chiusura: titolo e testo a sinistra, pulsante principale a destra */
  .corsi-fine {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    /* Stesso spazio azzurrino sopra (dopo l'onda dell'ultima fascia) e sotto (prima del footer) */
    margin-top: calc(var(--onda-h) + var(--section-y));
    padding: 2.5rem 3rem;
    background: var(--white);
    border-radius: var(--radius-card);
  }

  .corsi-fine-titolo {
    margin: 0 0 .5rem;
    color: var(--dark-navy);
  }

  .corsi-fine p {
    margin: 0;
    max-width: 38rem;
    font-size: var(--text-base);
    color: var(--text-light);
  }

  .corsi-fine .btn-primary {
    flex-shrink: 0;
  }

  /* ---------- Responsive ---------- */

  /* Tablet: percorsi a righe; foto e testo restano affiancati (alternati), corsi su una colonna */
  @media (max-width: 900px) {
    /* Percorsi a righe (5 colonne non ci stanno): numero, nome, freccia a destra */
    .salti {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      max-width: 640px;
      margin-top: 1.5rem;
      border-bottom: 1px solid var(--linea);
      text-align: left;
    }

    .salti a {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      align-items: center;
      min-height: 0;
      padding: 1rem 0;
      border: none;
      border-top: 1px solid var(--linea);
      border-radius: 0;
      background: none;
    }

    /* A righe il tratto attraversa la riga lungo il filetto in basso, senza uscire dallo schermo */
    .salti a {
      overflow: hidden;
    }

    .salto-numero {
      display: block;
    }

    .salto-nome {
      font-size: var(--text-base);
      font-weight: 700;
    }

    .corsi-intro {
      padding-bottom: 3.5rem;
    }

    .categoria {
      grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
      gap: 2.5rem;
      padding: 3.5rem 0;
    }

    .categoria:nth-of-type(even) {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    }

    .categoria-foto {
      margin: 0 1rem 1rem 1rem;
    }

    .categoria-foto::before {
      inset: 1.5rem -1rem -1rem 1.5rem;
    }

    .categoria:nth-of-type(even) .categoria-foto::before {
      inset: 1.5rem 1.5rem -1rem -1rem;
    }

    .categoria-descrizione {
      margin-bottom: 1rem;
    }
  }

  /* Mobile: foto sopra in formato basso, testo e corsi sotto; intro a sinistra */
  @media (max-width: 640px) {
    .corsi-intro {
      padding-bottom: 3rem;
      text-align: left;
    }

    .corsi-lead {
      margin-left: 0;
    }

    /* Ordine: etichetta e titolo, poi la foto, poi descrizione e corsi
       (il blocco di testo "si scioglie" così i suoi elementi si ordinano insieme alla foto) */
    .categoria,
    .categoria:nth-of-type(even) {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 3rem 0;
    }

    .categoria-testo {
      display: contents;
    }

    .categoria-percorso {
      order: 1;
    }

    .categoria-titolo {
      order: 3;
    }

    .categoria .categoria-foto,
    .categoria:nth-of-type(even) .categoria-foto {
      order: 4;
      margin: .75rem .75rem 2.75rem 0;
    }

    .categoria-descrizione {
      order: 5;
    }

    .corsi-lista {
      order: 6;
    }

    .corsi-fine {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem 1.5rem;
    }

    .categoria-foto {
      margin: 0 .75rem .75rem 0;
    }

    .categoria-foto::before,
    .categoria:nth-of-type(even) .categoria-foto::before {
      inset: 1.25rem -.75rem -.75rem 1.25rem;
    }

    .categoria-foto :global(img) {
      aspect-ratio: 16 / 9;
    }

    /* Riga alta abbastanza per un bersaglio del tocco ampio */
    .corsi-lista a {
      min-height: 4.25rem;
    }
  }
</style>
