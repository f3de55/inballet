---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import ElencoPercorsi from '../components/ElencoPercorsi.astro';
import SchedaPercorso from '../components/SchedaPercorso.astro';
import { heroPagina } from '../lib/hero-pagine';
import { categorieCorsi } from '../data/scuola';
import { enfatizza } from '../lib/text';
import { immaginiSottocorsi } from '../data/immagini-sottocorsi';
import '../styles/pages/corsi.css';

const pagineCorsi = new Map((await getCollection('corsi')).map((c) => [`/${c.id}`, c.data]));
const percorsi = categorieCorsi.map((cat) => ({
    ...cat,
    corsi: cat.corsi.map((c) => {
        const pagina = pagineCorsi.get(c.url);
        if (!pagina) throw new Error(`Pagina del sottocorso non trovata: ${c.url}`);
        const immagine = immaginiSottocorsi[c.url.slice(1)];
        if (!immagine) throw new Error(`Immagine del sottocorso non trovata: ${c.url}`);
        return { ...c, pagina, immagine };
    }),
}));
const nomeBreve = (nome: string) => nome.replace(/\s*\(.*\)$/, '');
const titoloEm = (nome: string) => nome.replace(/(\S+)$/, '<em>$1</em>');
const totale = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

const hero = await heroPagina('corsi');
---

<Base
    title="Corsi di danza a Lainate e Rho per tutte le età | InBallet"
    description={`${totale} corsi a Lainate e Rho: classica, modern, contemporanea, hip-hop, breaking, yoga e pilates, per bambini dai 3 anni, ragazzi e adulti. Trova il tuo.`}
    ogTitle="I corsi di danza di InBallet"
    ogDescription="Classica, contemporanea, urban e benessere, dai 3 anni all'età adulta: trova il corso giusto per te."
    tipo="CollectionPage"
>

    <Fragment slot="head">
        {hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>
    <HeroPagina titolo="I nostri corsi di danza" stile={hero.style}>
        <p class="hero-lead"><strong>Dai 3 anni all'età adulta</strong>, dalla classica agli stili urbani: c'è un corso anche per te, a <strong>ogni livello</strong>.</p>
        <div class="trova-scelta" id="trova-scelta" hidden>
            <button type="button" class="btn-primary btn-piccolo" id="trova-apri" aria-haspopup="dialog" aria-controls="trova-popup" aria-expanded="false">
                Trova il tuo corso
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
        <noscript>
            <ul class="trova-alternative">
                {percorsi.map((cat) => <li><a href={`#${cat.id}`}>{cat.nome}</a></li>)}
            </ul>
        </noscript>
    </HeroPagina>

    {percorsi.map((cat, i) => (
        <section id={cat.id} class:list={['corsi-stile', { 'corsi-stile--soft': i % 2 === 1 }, i % 2 === 0 ? ['decoro-onde', { 'decoro-onde--sinistra': i === 4 }] : '']} aria-labelledby={`${cat.id}-titolo`}>
            <div class="intro-editoriale">
                <p class="eyebrow">{cat.corsi.length} corsi</p>
                <h2 class="titolo-sezione" id={`${cat.id}-titolo`} set:html={titoloEm(cat.nome)} />
                <p set:html={enfatizza(cat.descrizione, cat.evidenzia)} />
            </div>
            <ElencoPercorsi class="container" id={`${cat.id}-corsi`} titolo={`${cat.id}-titolo`} nome={cat.nome}>
                {cat.corsi.map((c) => (
                    <SchedaPercorso href={c.url} nome={nomeBreve(c.nome)} idTitolo={`${c.url.slice(1)}-nome`} etichetta={c.pagina.badge.replace(' - ', ' · ')} dettaglio={c.pagina.frequenza} immagine={c.immagine} iconaDettaglio="far fa-clock" />
                ))}
            </ElencoPercorsi>
        </section>
    ))}

    <section class="corsi-chiusura" aria-labelledby="corsi-fine-titolo">
        <div class="container">
            <div class="corsi-fine">
                <div class="corsi-fine-testo">
                    <h3 class="corsi-fine-titolo" id="corsi-fine-titolo">Non sai quale corso scegliere?</h3>
                    <p>Raccontaci <strong>età, esperienza</strong> e cosa ti piacerebbe provare: lo troviamo insieme.</p>
                </div>
                <a href="/contatti" class="btn-primary">
                    Parliamone insieme
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    <Fragment slot="after-main">
        <dialog class="trova-popup" id="trova-popup" aria-labelledby="trova-popup-titolo" aria-describedby="trova-popup-intro">
            <form method="dialog" class="trova-popup-chiudi">
                <button type="submit" class="btn-icon btn-icon--contorno" aria-label="Chiudi la scelta del percorso">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </form>
            <h2 id="trova-popup-titolo">Da dove iniziamo?</h2>
            <p id="trova-popup-intro" class="trova-popup-intro">Scegli un percorso e scopri i suoi corsi.</p>
            <ul class="trova-opzioni">
                {percorsi.map((cat) => (
                    <li>
                        <a href={`#${cat.id}`} class="trova-opzione" data-percorso={cat.nome}>
                            <span class="trova-opzione-testo">
                                <span class="trova-opzione-nome valore">{cat.nome}</span>
                                <span class="testo-piccolo">{cat.corsi.length} corsi</span>
                            </span>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </li>
                ))}
            </ul>
        </dialog>
    </Fragment>

    <Fragment slot="scripts">
        <script>
            import '../scripts/trova-corso';
        </script>
    </Fragment>
</Base>
