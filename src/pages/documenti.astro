---
/**
 * Pagina Documenti: testi e PDF da scaricare modificabili dalla dashboard
 * (sezione Documenti), quindi renderizzata dal server a ogni richiesta.
 */
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { sfondo } from '../lib/images';
import { leggiDocumenti } from '../lib/documenti';

export const prerender = false;

const bg = {
  hero: await sfondo('gallery-1.jpg', { desktop: '50% 30%', tablet: '50% 50%' }),
};
const { hero, sezione, documenti } = await leggiDocumenti();
// Testo dell'hero (scritto dalla dashboard) completato con scuola e luogo, se c'è spazio
const base = hero.testo || sezione.intro;
const luogo = ' InBallet, scuola di danza a Lainate e Rho (MI).';
const description = base.length + luogo.length <= 160 ? base + luogo : base;
---

<Base
    title={`${hero.titolo} | InBallet`}
    description={description}
    ogTitle={`${hero.titolo} | InBallet`}
    ogDescription={base}
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={bg.hero.style}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">{hero.titolo}</h1>
            {hero.testo && <p class="chisiamo-hero-tagline">{hero.testo}</p>}
        </div>
    </section>

    <!-- Documenti: intestazione editoriale ed elenco dei PDF -->
    <section id="documenti" class="documenti-section" aria-labelledby="documenti-titolo">
        <div class="intro-editoriale">
            {sezione.eyebrow && <span class="eyebrow">{sezione.eyebrow}</span>}
            <h2 class="titolo-sezione" id="documenti-titolo">{sezione.titolo}{sezione.accento && <>{' '}<em>{sezione.accento}</em></>}</h2>
            {sezione.intro && <p>{sezione.intro}</p>}
        </div>
        <div class="container">
            {documenti.length > 0 && (
            <ul class="documenti-lista">
                {documenti.map((d) => (
                    <li>
                        <a class="documento" href={d.file} target="_blank" rel="noopener">
                            <i class="fas fa-file-pdf documento-icona" aria-hidden="true"></i>
                            <span class="documento-testo">
                                <span class="documento-nome">{d.titolo}</span>
                                {d.nota && <span class="documento-nota">{d.nota}</span>}
                            </span>
                            <span class="documento-azione">
                                <span class="documento-peso">{d.peso}</span>
                                <span class="link-cta documento-scarica">
                                    Scarica <i class="fas fa-download" aria-hidden="true"></i>
                                </span>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
            )}
        </div>
    </section>
</Base>

<style>
/* ---------- Documenti ---------- */
.documenti-section {
  padding: var(--section-y) 0;
  background: var(--white);
  scroll-margin-top: calc(var(--header-h) + var(--banner-height, 0px));
}

.documenti-lista {
  list-style: none;
  margin: 3.5rem 0 0;
  padding: 0;
  border-top: 1px solid rgba(26, 26, 26, 0.12);
}

.documenti-lista li {
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.documento {
  display: grid;
  grid-template-columns: 3rem minmax(0, 1fr) auto;
  align-items: center;
  gap: 1.5rem;
  padding: 2rem 0;
  color: inherit;
  text-decoration: none;
}

.documento-icona {
  font-size: var(--text-3xl);
  color: var(--primary-blue-dark);
}

.documento-testo {
  display: flex;
  flex-direction: column;
  gap: .35rem;
}

.documento-nome {
  font-size: var(--text-xl);
  font-weight: 500;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
  transition: color .3s ease;
}

.documento-nota {
  font-size: var(--text-base);
  color: var(--text-light);
}

.documento-azione {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.documento-peso {
  font-size: var(--text-sm);
  color: var(--text-light);
  white-space: nowrap;
}

.documento-scarica {
  white-space: nowrap;
}

@media (hover: hover) and (pointer: fine) {
  .documento:hover .documento-nome,
  .documento:hover .documento-scarica {
    color: var(--primary-blue-dark);
  }

  .documento:hover .documento-scarica {
    border-color: var(--primary-blue-dark);
  }

  .documento:hover .documento-scarica i {
    transform: translateY(3px);
  }
}

/* ---------- Tablet ---------- */
@media (max-width: 900px) {
  .documenti-lista {
    margin-top: 2.5rem;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  /* Documento: icona e testo, sotto peso e "Scarica" */
  .documento {
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: start;
    gap: .5rem 1rem;
    padding: 1.5rem 0;
  }

  .documento-icona {
    padding-top: .15rem;
  }

  .documento-azione {
    grid-column: 2;
    justify-content: space-between;
    margin-top: .75rem;
  }
}
</style>
