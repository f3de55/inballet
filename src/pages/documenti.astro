---
import Base from '../layouts/Base.astro';
import { heroPagina } from '../lib/hero-pagine';
import { leggiDocumenti } from '../lib/documenti';
import { scuola } from '../data/scuola';
import { grassettoDaTesto, senzaGrassetto } from '../lib/text';
import HeroPagina from '../components/HeroPagina.astro';
import '../styles/pages/documenti.css';

export const prerender = false;

const bg = {
  hero: await heroPagina('documenti'),
};
const { hero, sezione, documenti } = await leggiDocumenti();
const moduli = documenti.filter((d) => d.categoria !== 'statuto');
const statuto = documenti.find((d) => d.categoria === 'statuto');
const base = senzaGrassetto(hero.testo || sezione.intro);
const luogo = ' InBallet, scuola di danza a Lainate e Rho (MI).';
const description = base.length + luogo.length <= 160 ? base + luogo : base;
---

<Base
    title={`${hero.titolo}: scuola di danza | InBallet`}
    description={description}
    ogTitle={`${hero.titolo} | InBallet`}
    ogDescription={base}
    preload={bg.hero.preload}
>

    <HeroPagina titolo={hero.titolo} stile={bg.hero.style}>
        {hero.testo && <p class="hero-lead" set:html={grassettoDaTesto(hero.testo)} />}
    </HeroPagina>

    <section id="documenti" class="documenti-section decoro-onde" aria-labelledby="documenti-titolo">
        <div class="intro-editoriale">
            {sezione.eyebrow && <p class="eyebrow">{sezione.eyebrow}</p>}
            <h2 class="titolo-sezione" id="documenti-titolo">{sezione.titolo}{sezione.accento && <>{' '}<em>{sezione.accento}</em></>}</h2>
            {sezione.intro && <p set:html={grassettoDaTesto(sezione.intro)} />}
        </div>
        <div class="container">
            {moduli.length > 0 && (
            <ul class="documenti-lista">
                {moduli.map((d) => (
                    <li>
                        <a class="documento" href={d.file} target="_blank" rel="noopener">
                            <i class="fas fa-file-pdf documento-icona" aria-hidden="true"></i>
                            <div class="documento-testo">
                                <h3 class="documento-nome">{d.titolo}</h3>
                                {d.nota && <p class="documento-nota">{d.nota}</p>}
                            </div>
                            <div class="documento-azione">
                                <small class="documento-peso testo-piccolo">{d.peso}</small>
                                <span class="link-cta documento-scarica">
                                    Scarica <i class="fas fa-download" aria-hidden="true"></i>
                                </span>
                            </div>
                        <span class="sr-only"> (si apre in una nuova scheda)</span></a>
                    </li>
                ))}
            </ul>
            )}
        </div>
    </section>

    <section id="statuto" class="statuto-section" aria-labelledby="statuto-titolo">
        <div class="container statuto-layout">
            <header class="statuto-intro">
                <p class="eyebrow">L'associazione</p>
                <h2 class="titolo-sezione" id="statuto-titolo">Lo <em>statuto</em></h2>
                <p>Il documento che definisce finalità, organizzazione e regole di partecipazione dell'<strong>{scuola.ragioneSociale}</strong>.</p>
            </header>
            {statuto ? (
                <a class="documento statuto-documento" href={statuto.file} download>
                    <i class="fas fa-file-pdf documento-icona" aria-hidden="true"></i>
                    <div class="documento-testo">
                        <h3 class="documento-nome">{statuto.titolo}</h3>
                        {statuto.nota && <p class="documento-nota">{statuto.nota}</p>}
                    </div>
                    <div class="documento-azione">
                        <small class="documento-peso testo-piccolo">{statuto.peso}</small>
                        <span class="link-cta documento-scarica">Scarica PDF <i class="fas fa-download" aria-hidden="true"></i></span>
                    </div>
                </a>
            ) : (
                <a class="documento statuto-documento" href={`mailto:${scuola.email}?subject=${encodeURIComponent('Richiesta statuto I.N. Ballet')}`}>
                    <i class="fas fa-file-pdf documento-icona" aria-hidden="true"></i>
                    <div class="documento-testo">
                        <h3 class="documento-nome">Statuto dell'associazione</h3>
                        <p class="documento-nota">Per consultare lo statuto, contatta la segreteria.</p>
                    </div>
                    <div class="documento-azione">
                        <span class="link-cta documento-scarica">Richiedi lo statuto <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                    </div>
                </a>
            )}
        </div>
    </section>
</Base>
