---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { webp } from '../lib/images';
import { iscrizioni } from '../data/scuola';

const heroBg = await webp('gallery-1.jpg', 1920);
---

<Base
    title="Documenti - InBallet"
    description={`Documenti InBallet da scaricare: modulo di iscrizione ${iscrizioni.anno} e autocertificazione di buona salute per i bambini sotto i 6 anni.`}
    ogTitle="Documenti - InBallet"
    ogDescription={`Modulo di iscrizione ${iscrizioni.anno} e autocertificazione per i bambini sotto i 6 anni.`}
>
    <!-- Hero -->
    <section class="chisiamo-hero">
        <div class="chisiamo-hero-image" style={`background-image: url('${heroBg}')`}></div>
        <div class="chisiamo-hero-overlay"></div>
        <div class="chisiamo-hero-glass">
            <Breadcrumb />
            <h1 class="chisiamo-hero-title">Documenti</h1>
        </div>
    </section>

    <section id="documenti" class="documenti">
        <div class="container documenti-intro">
            <p class="eyebrow">Iscrizioni {iscrizioni.anno}</p>
            <h2 class="titolo titolo-sezione">Moduli da <em>scaricare</em></h2>
            <p class="invito intro-sezione">
                Per iscriverti scarica il modulo, compilalo e consegnalo firmato in segreteria.
                Dai 6 anni serve anche il certificato medico per l'attività sportiva non agonistica;
                per i bambini più piccoli basta l'autocertificazione firmata dai genitori.
            </p>
        </div>

        <ul class="container documenti-lista">
            {iscrizioni.documenti.map((d) => (
                <li>
                    <a class="documento" href={d.file} target="_blank" rel="noopener">
                        <i class="fas fa-file-pdf documento-icona" aria-hidden="true"></i>
                        <span class="documento-nome">{d.titolo}</span>
                        <span class="documento-nota">{d.nota} · {d.peso}</span>
                        <span class="documento-scarica">
                            Scarica
                            <i class="fas fa-download" aria-hidden="true"></i>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </section>
</Base>

<style>
  .documenti {
    padding: var(--section-y) 0;
    background: var(--white);
    scroll-margin-top: calc(80px + var(--banner-height, 0px));
  }

  .documenti-intro {
    max-width: 960px;
    margin-bottom: 3.5rem;
  }

  .titolo {
    margin-bottom: 1.25rem;
  }

  .invito {
    max-width: 40rem;
  }

  .documenti-lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem;
    max-width: 960px;
  }

  .documento {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 2rem;
    border-top: 2px solid var(--primary-blue);
    color: var(--dark-navy);
    text-decoration: none;
  }

  .documento-icona {
    font-size: 3.5rem;
    color: var(--primary-blue-dark);
    margin-bottom: 1rem;
    transition: transform 0.3s ease;
  }

  .documento-nome {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.25;
  }

  .documento-nota {
    font-size: var(--text-base);
    color: var(--text-light);
  }

  .documento-scarica {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--primary-blue);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .documento-scarica i {
    color: var(--primary-blue-dark);
    transition: transform 0.3s ease;
  }

  .documento:hover .documento-icona {
    transform: translateY(-4px);
  }

  .documento:hover .documento-scarica {
    color: var(--primary-blue-dark);
    border-color: var(--primary-blue-dark);
  }

  .documento:hover .documento-scarica i {
    transform: translateY(3px);
  }

  @media (max-width: 700px) {

    .documenti-intro {
      margin-bottom: 2.5rem;
    }

    .documenti-lista {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .documento-icona {
      font-size: 2.75rem;
    }
  }
</style>
