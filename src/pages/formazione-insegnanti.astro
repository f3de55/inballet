---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondo } from '../lib/images';
import { scuola } from '../data/scuola';
import logoCsen from '../assets/images/csen-logo.svg';
import logoConi from '../assets/images/logo_coni.svg';

const bg = {
  hero: await sfondo('gallery-4.jpg', { desktop: '50% 10%', tablet: '50% 30%' }),
  cta: await sfondo('bg-progetti-territorio.jpg', { desktop: '50% 35%' }),
};

const inBreve = [
  { valore: '2', unita: 'anni', testo: 'Percorso biennale' },
  { valore: 'Modern', unita: '', testo: 'Stile di specializzazione' },
  { valore: '6', unita: 'master', testo: 'Possibili dopo il biennio' },
];

const aree = [
  'Tecnica e didattica della danza Modern',
  'Moduli multidisciplinari nella danza',
  'Pedagogia applicata alla danza',
  "Sviluppo dalla prima infanzia all'età adulta",
  'Danza e disabilità, anche nei casi più complessi',
  'Sei master di approfondimento dopo il biennio',
];

const enti = [
  // scala: equilibrio ottico (il logo CONI è più largo, a parità di altezza sembrerebbe più grande)
  { sigla: 'CSEN', nome: 'Centro Sportivo Educativo Nazionale', logo: logoCsen, scala: 1 },
  { sigla: 'CONI', nome: 'Comitato Olimpico Nazionale Italiano', logo: logoConi, scala: 0.84 },
];
---

<Base
    title="Corso per Insegnanti di Danza Modern CSEN e CONI | InBallet"
    description="Corso biennale per Insegnanti di Danza Modern di InBallet, ente formativo dal 2023: titolo CSEN e CONI a valenza nazionale e sei master successivi."
    ogTitle="Corso di formazione per Insegnanti di Danza | InBallet"
    ogDescription="Percorso biennale con specializzazione Modern: titolo riconosciuto CSEN e CONI a valenza nazionale."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Corso per Insegnanti di Danza</h1>
                <p class="chisiamo-hero-tagline">Percorso biennale con specializzazione Modern, riconosciuto CSEN e CONI.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo); sotto, il corso in breve -->
        <section id="intro" class="form-intro-section">
            <div class="container form-intro-layout">
                <div class="form-intro-content">
                    <span class="form-intro-label eyebrow">Il percorso</span>
                    <h2 class="form-intro-title titolo-sezione">Diventa insegnante <em>di danza</em></h2>
                    <div class="form-intro-testo">
                        <p>Dal 2023 I.N. Ballet è ente formativo riconosciuto per il titolo di Insegnante di Danza, con specializzazione nello stile <a href="/modern">Modern</a>.</p>
                        <p>Il percorso è biennale, con sei master a seguire: moduli multidisciplinari tra danza, pedagogia e sviluppo, dalla prima infanzia all'età adulta, fino ai casi più complessi di disabilità.</p>
                    </div>
                </div>
                <div class="form-intro-visual foto-cornice">
                    <Img src="gallery-7.jpg" alt="Le insegnanti di InBallet in sala" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
            <div class="container">
                <ul class="breve-lista" aria-label="Il corso in breve">
                    {inBreve.map((b) => (
                        <li class="breve">
                            <span class="breve-valore">{b.valore}{b.unita && <span class="breve-unita"> {b.unita}</span>}</span>
                            <span class="breve-testo">{b.testo}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Aree di studio: intestazione editoriale, sotto l'elenco numerato -->
        <section class="form-aree-section" aria-labelledby="aree-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">Il programma</span>
                <h2 class="titolo-sezione" id="aree-titolo">Aree <em>di studio</em></h2>
                <p class="intro-sezione">Moduli multidisciplinari tra danza, pedagogia e sviluppo, per insegnare a ogni età e a ogni corpo.</p>
            </div>
            <div class="container">
                <ol class="aree-lista">
                    {aree.map((a, i) => (
                        <li class="area">
                            <span class="area-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                            <span class="area-nome">{a}</span>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- Diploma: intestazione editoriale, sotto gli enti che lo riconoscono -->
        <section class="form-cert-section" aria-labelledby="cert-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">Riconoscimenti</span>
                <h2 class="titolo-sezione" id="cert-titolo">Diploma a <em>valenza nazionale</em></h2>
                <p class="intro-sezione">Il titolo di Insegnante di Danza è riconosciuto dallo CSEN e dal CONI e vale su tutto il territorio nazionale: un punto di riferimento per la formazione dei maestri di danza.</p>
            </div>
            <div class="container">
                <ul class="enti-lista">
                    {enti.map((e) => (
                        <li class="ente">
                            <span class="ente-logo">
                                <img src={e.logo.src} width={e.logo.width} height={e.logo.height} alt={`Logo ${e.sigla}`} style={`height: ${e.scala * 100}%`} loading="lazy" decoding="async">
                            </span>
                            <span class="ente-nome">{e.nome}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA -->
        <section class="form-cta-section sezione-scura">
            <div class="form-cta-bg" style={bg.cta.style}></div>
            <div class="form-cta-overlay"></div>
            <div class="form-cta-wrapper">
                <h2 class="titolo-sezione">Vuoi saperne <em>di più?</em></h2>
                <p class="intro-sezione">Contattaci per informazioni su date, costi e modalità di iscrizione.</p>
                <div class="form-cta-buttons">
                    <a href={`mailto:${scuola.email}?subject=Corso%20Formazione%20Insegnanti%20-%20Richiesta%20Informazioni`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Richiedi informazioni
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
/* ---------- Intro ---------- */
.form-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.form-intro-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 5rem;
  align-items: center;
}

.form-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.form-intro-title {
  margin-bottom: 1.75rem;
}

.form-intro-testo p {
  margin-bottom: 1.25rem;
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-dark);
}

.form-intro-testo p:last-child {
  margin-bottom: 0;
}

/* La cornice sporge a sinistra e in basso: spazio dentro la colonna */
.form-intro-visual {
  max-width: 520px;
  margin: 0 0 1.5rem 1.5rem;
  justify-self: end;
}

.form-intro-visual :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

/* In breve: tre dati separati da filetti (il gap da 1px sul fondo li disegna) */
.breve-lista {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  margin: 5rem 0 0;
  padding: 0;
  border-top: 1px solid rgba(26, 26, 26, 0.12);
  background: rgba(26, 26, 26, 0.12);
}

.breve {
  display: flex;
  flex-direction: column;
  gap: .6rem;
  padding: 2rem 2rem 0;
  background: var(--white);
}

.breve:first-child {
  padding-left: 0;
}

.breve-valore {
  font-size: var(--text-5xl);
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--primary-blue-dark);
  white-space: nowrap;
}

.breve-unita {
  font-size: var(--text-base);
  font-weight: 400;
  letter-spacing: 0;
  color: var(--primary-blue-dark);
}

.breve-testo {
  font-size: var(--text-base);
  font-weight: 400;
  color: var(--text-dark);
}

/* ---------- Aree di studio ---------- */
.form-aree-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

/* Elenchi in una colonna centrata sotto l'intestazione */
.aree-lista,
.enti-lista {
  list-style: none;
  max-width: 48rem;
  margin: 3.5rem auto 0;
  padding: 0;
}


.area {
  display: grid;
  grid-template-columns: 3rem minmax(0, 1fr);
  align-items: baseline;
  gap: 1rem;
  padding: 1.6rem 0;
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.area:first-child {
  padding-top: .5rem;
}

.area:last-child {
  border-bottom: none;
}

.area-num {
  font-size: var(--text-xl);
  font-weight: 300;
  color: var(--primary-blue-dark);
  font-variant-numeric: tabular-nums;
}

.area-nome {
  font-size: var(--text-xl);
  font-weight: 500;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
}

/* ---------- Diploma ---------- */
.form-cert-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

/* Loghi in riquadri della stessa misura: altezza uguale, larghezza libera (CONI è più largo) */
.enti-lista {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;
}

.ente {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  padding: 2.25rem 1.5rem;
  background: var(--bg-soft);
  border-radius: var(--radius-card);
  text-align: center;
}

.ente-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 8.5rem;
}

.ente-logo img {
  width: auto;
  height: 100%;
  max-width: 100%;
  object-fit: contain;
}

.ente-nome {
  font-size: var(--text-base);
  font-weight: 400;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
}

/* ---------- CTA ---------- */
.form-cta-section {
  position: relative;
  padding: var(--section-y) 0;
  overflow: hidden;
}

.form-cta-bg,
.form-cta-overlay {
  position: absolute;
  inset: 0;
}

.form-cta-bg {
  background: center / cover no-repeat;
}

.form-cta-overlay {
  background: linear-gradient(135deg, rgba(26, 26, 26, .9) 0%, rgba(42, 42, 42, .85) 100%);
}

.form-cta-wrapper {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.form-cta-wrapper .titolo-sezione {
  margin-bottom: 1.25rem;
}

.form-cta-wrapper .intro-sezione {
  margin-bottom: 2.5rem;
}

.form-cta-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

/* ---------- Tablet ---------- */
@media (max-width: 1024px) {
  .breve {
    padding: 1.75rem 1.25rem 0;
  }
}

@media (max-width: 900px) {
  /* Intro: etichetta e titolo, foto, testo */
  .form-intro-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .form-intro-content {
    display: contents;
  }

  .form-intro-label {
    order: 1;
  }

  .form-intro-title {
    order: 2;
  }

  .form-intro-visual {
    order: 3;
    max-width: none;
    margin: 0 0 2.75rem 1.5rem;
  }

  .form-intro-visual :global(img) {
    aspect-ratio: 3 / 2;
  }

  .form-intro-testo {
    order: 4;
  }

  .breve-lista {
    margin-top: 3.5rem;
  }

  /* Aree e diploma: elenchi a tutta larghezza, allineati all'intestazione */
  .aree-lista,
  .enti-lista {
    max-width: none;
    margin-top: 2.5rem;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .form-intro-visual {
    margin: 0 0 2rem .75rem;
  }

  .form-intro-visual :global(img) {
    aspect-ratio: 4 / 3;
  }


  /* In breve: una riga per dato, valore a sinistra e testo a destra */
  .breve-lista {
    grid-template-columns: minmax(0, 1fr);
    margin-top: 3rem;
  }

  .breve,
  .breve:first-child {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
  }



  .breve-testo {
    text-align: right;
  }

  .area {
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: .75rem;
    padding: 1.25rem 0;
  }


  .ente {
    padding: 1.75rem 1rem;
  }

  .ente-logo {
    height: 6rem;
  }



  .form-cta-wrapper {
    padding: 0 1.5rem;
  }

  .form-cta-buttons {
    flex-direction: column;
    align-items: center;
  }
}
</style>
