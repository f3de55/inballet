---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondoCta } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import { scuola } from '../data/scuola';
import logoCsen from '../assets/images/csen-logo.svg';
import logoConi from '../assets/images/logo_coni.svg';
import '../styles/components/intro-split.css';
import '../styles/components/righe.css';
import '../styles/pages/formazione-insegnanti.css';

const bg = {
  hero: await heroPagina('formazione-insegnanti'),
  cta: await sfondoCta('foto/danza-dolce-img3.jpg', { desktop: '50% 50%' }),
};

const inBreve = [
  { valore: '2', unita: 'anni', testo: 'Percorso biennale' },
  { valore: 'Modern', unita: '', testo: 'Stile di specializzazione' },
  { valore: '6', unita: 'master', testo: 'Possibili dopo il biennio' },
];

const aree = [
  { nome: 'Tecnica e didattica della danza Modern', icona: 'fa-shoe-prints' },
  { nome: 'Pedagogia applicata alla danza', icona: 'fa-book-open' },
  { nome: "Sviluppo dall'infanzia all'età adulta", icona: 'fa-seedling' },
  { nome: 'Danza e disabilità', icona: 'fa-universal-access' },
];

const enti = [
  { sigla: 'CSEN', nome: 'Centro Sportivo Educativo Nazionale', logo: logoCsen },
  { sigla: 'CONI', nome: 'Comitato Olimpico Nazionale Italiano', logo: logoConi },
];
---

<Base
    title="Corso per Insegnanti di Danza Modern CSEN e CONI | InBallet"
    description="Corso biennale per Insegnanti di Danza Modern di InBallet, ente formativo dal 2023: titolo CSEN e CONI a valenza nazionale e sei master successivi."
    ogTitle="Corso di formazione per Insegnanti di Danza | InBallet"
    ogDescription="Percorso biennale con specializzazione Modern: titolo riconosciuto CSEN e CONI a valenza nazionale."
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Section -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Corso per Insegnanti di Danza</h1>
                <p class="hero-lead">Percorso <strong>biennale</strong> con specializzazione <strong>Modern</strong>, riconosciuto <strong>CSEN e CONI</strong>.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo); sotto, il corso in breve -->
        <section id="intro" class="intro-split decoro-onde">
            <div class="container intro-split-layout">
                <div class="intro-split-content">
                    <p class="intro-split-label eyebrow">Il percorso</p>
                    <h2 class="intro-split-title titolo-sezione">Diventa insegnante <em>di danza</em></h2>
                    <div class="intro-split-testo">
                        <p><strong>Dal 2023</strong> I.N. Ballet è <strong>ente formativo riconosciuto</strong> per il titolo di <strong>Insegnante di Danza</strong>, con specializzazione nello stile <a href="/modern">Modern</a>.</p>
                        <p>Il percorso è <strong>biennale</strong>, con <strong>sei master</strong> a seguire: moduli multidisciplinari tra danza, pedagogia e sviluppo, dalla prima infanzia all'età adulta, fino ai casi più complessi di disabilità.</p>
                    </div>
                </div>
                <div class="intro-split-visual foto-cornice">
                    <Img src="gallery-7.jpg" alt="Le insegnanti di InBallet in sala" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
            <div class="container">
                <ul class="breve-lista" aria-label="Il corso in breve">
                    {inBreve.map((b) => (
                        <li class="dato">
                            <h3 class="dato-valore">{b.valore}{b.unita && ` ${b.unita}`}</h3>
                            <p class="dato-testo testo-piccolo">{b.testo}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Aree di studio: intestazione a sinistra (fissa su desktop), elenco numerato a destra -->
        <section class="split-section split-section--soft" aria-labelledby="aree-titolo">
            <div class="container split-layout">
                <div class="split-header split-header--sticky">
                    <p class="eyebrow">Il programma</p>
                    <h2 class="titolo-sezione" id="aree-titolo">Aree <em>di studio</em></h2>
                    <p class="intro-sezione">Per insegnare a <strong>ogni età e a ogni corpo</strong>.</p>
                </div>
                <ol class="righe">
                    {aree.map((a) => (
                        <li class="riga">
                            <i class={`riga-icona fas ${a.icona}`} aria-hidden="true"></i>
                            <p class="riga-nome">{a.nome}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- Diploma: intestazione editoriale, sotto gli enti che lo riconoscono -->
        <section class="form-cert-section" aria-labelledby="cert-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">Riconoscimenti</p>
                <h2 class="titolo-sezione" id="cert-titolo">Diploma a <em>valenza nazionale</em></h2>
                <p class="intro-sezione">Il titolo di Insegnante di Danza è <strong>riconosciuto dallo CSEN e dal CONI</strong> e vale su <strong>tutto il territorio nazionale</strong>: un punto di riferimento per la formazione dei maestri di danza.</p>
            </div>
            <div class="container">
                <ul class="enti-lista">
                    {enti.map((e) => (
                        <li class="ente">
                            <div class="ente-logo">
                                <img src={e.logo.src} width={e.logo.width} height={e.logo.height} alt={`Logo ${e.sigla}`} data-sigla={e.sigla} loading="lazy" decoding="async">
                            </div>
                            <p class="ente-nome">{e.nome}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Vuoi saperne <em>di più?</em></h2>
                <p class="intro-sezione">Contattaci per informazioni su <strong>date, costi e modalità di iscrizione</strong>.</p>
                <div class="cta-pulsanti">
                    <a href={`mailto:${scuola.email}?subject=Corso%20Formazione%20Insegnanti%20-%20Richiesta%20Informazioni`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Richiedi informazioni
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>
