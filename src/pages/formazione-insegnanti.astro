---
import Base from '../layouts/Base.astro';
import { webp } from '../lib/images';

const bg: Record<string, string> = {
  'gallery-1.jpg': await webp('gallery-1.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};
---

<Base
    title="Corso Formazione Insegnanti di Danza - InBallet"
    description="Corso di Formazione per Insegnanti di Danza - Percorso biennale riconosciuto CSEN e CONI. Specializzazione Modern con moduli pedagogici."
    ogTitle="Corso Formazione Insegnanti di Danza - InBallet"
    ogDescription="Percorso biennale per diventare insegnante di danza. Diploma riconosciuto CSEN e CONI a valenza nazionale."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-1.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <span class="chisiamo-hero-badge">Ente Formativo dal 2023</span>
                <h1 class="chisiamo-hero-title">Corso Insegnanti di Danza</h1>
                <p class="chisiamo-hero-tagline">Percorso biennale con specializzazione Modern.</p>
                <a href="#intro" class="chisiamo-scroll-arrow" aria-label="Scorri in basso">
                    <i class="fas fa-chevron-down"></i>
                </a>
            </div>
        </section>

        <!-- Intro Section -->
        <section id="intro" class="form-intro-section">
            <div class="form-intro-wrapper">
                <span class="form-intro-label eyebrow">Il Percorso</span>
                <h2 class="form-intro-title titolo-sezione">Diventa insegnante di danza</h2>
                <p class="form-intro-text">
                    Un <strong>percorso biennale</strong> con moduli formativi multidisciplinari nella danza, con particolare attenzione alle interconnessioni pedagogiche e allo sviluppo evolutivo.
                </p>
                <p class="form-intro-text">
                    Il programma copre tutte le fasce d'eta': <strong>dal bambino all'adulto</strong>, fino ai casi più complessi di disabilità. Specializzazione nello stile <strong>Modern</strong> con possibilità di proseguire con sei master successivi.
                </p>
            </div>
        </section>

        <!-- Programma Section -->
        <section class="form-prog-section">
            <div class="form-prog-wrapper">
                <div class="form-prog-header">
                    <span class="form-prog-label eyebrow">Il Programma</span>
                    <h2 class="form-prog-title titolo-sezione">Aree di studio</h2>
                </div>
                <div class="form-prog-grid">
                    <div class="form-prog-item">
                        <div class="form-prog-num">1</div>
                        <p class="form-prog-text">Tecnica e didattica della danza Modern</p>
                    </div>
                    <div class="form-prog-item">
                        <div class="form-prog-num">2</div>
                        <p class="form-prog-text">Pedagogia applicata alla danza</p>
                    </div>
                    <div class="form-prog-item">
                        <div class="form-prog-num">3</div>
                        <p class="form-prog-text">Psicologia dello sviluppo</p>
                    </div>
                    <div class="form-prog-item">
                        <div class="form-prog-num">4</div>
                        <p class="form-prog-text">Metodologie per ogni fascia d'eta'</p>
                    </div>
                    <div class="form-prog-item">
                        <div class="form-prog-num">5</div>
                        <p class="form-prog-text">Approccio alla disabilità</p>
                    </div>
                    <div class="form-prog-item">
                        <div class="form-prog-num">6</div>
                        <p class="form-prog-text">Tirocinio pratico</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Certificazione Section -->
        <section class="form-cert-section sezione-scura">
            <div class="form-cert-wrapper">
                <span class="form-cert-label eyebrow">Riconoscimenti</span>
                <h2 class="form-cert-title titolo-sezione">Diploma a valenza nazionale</h2>
                <p class="form-cert-text">Il titolo rilasciato è riconosciuto dallo CSEN e dal CONI, garantendo validità su tutto il territorio nazionale per l'insegnamento della danza.</p>
                <div class="form-cert-badges">
                    <div class="form-cert-badge">
                        <div class="form-cert-badge-name">CSEN</div>
                        <div class="form-cert-badge-desc">Centro Sportivo Educativo Nazionale</div>
                    </div>
                    <div class="form-cert-badge">
                        <div class="form-cert-badge-name">CONI</div>
                        <div class="form-cert-badge-desc">Comitato Olimpico Nazionale</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="corso-contatto-section sezione-scura">
            <div class="corso-contatto-bg" style={`background: url('${bg['bg-progetti-territorio.jpg']}') center/cover no-repeat`}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2 class="titolo-sezione">Vuoi saperne di più?</h2>
                    <p class="intro-sezione">Contattaci per informazioni su date, costi e modalità di iscrizione.</p>
                    <a href="mailto:info@inballet.it?subject=Corso%20Formazione%20Insegnanti%20-%20Richiesta%20Informazioni" class="corso-btn-cta btn-primary">
                        Richiedi Informazioni <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
.form-intro-section {
  padding: var(--section-y) 0;
  background: #fff;
}

.form-intro-wrapper {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.form-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.form-intro-title {
  margin-bottom: 2rem;
}

.form-intro-text {
  font-size: var(--text-lg);
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 1.5rem;
}

.form-intro-text :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

.form-prog-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
  overflow: hidden;
}

.form-prog-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.form-prog-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.form-prog-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2rem;
}

.form-prog-header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.form-prog-label {
  display: block;
  margin-bottom: 1rem;
}

.form-prog-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 2.5rem 4rem;
  position: relative;
}

.form-prog-grid::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
  background: rgba(135,206,235,.3);
  transform: translateX(-50%);
}

.form-prog-item {
  display: grid;
  grid-template-columns: 45px 1fr;
  gap: 1rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(135,206,235,.3);
}

.form-prog-item:nth-last-child(-n+2) {
  border-bottom: none;
  padding-bottom: 0;
}

.form-prog-num {
  width: 45px;
  height: 45px;
  background: linear-gradient(135deg,var(--primary-blue) 0%,var(--primary-blue-light) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--dark-navy);
  font-weight: 700;
  font-size: var(--text-lg);
}

.form-prog-text {
  font-size: var(--text-base);
  color: var(--dark-navy);
  line-height: 1.6;
  font-weight: 500;
  padding-top: .6rem;
}

@media(max-width:768px) {
  .form-prog-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .form-prog-grid::before {
    display: none;
  }

  .form-prog-item:nth-last-child(2) {
    border-bottom: 1px solid rgba(135,206,235,.3);
    padding-bottom: 2rem;
  }
}

.form-cert-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
  position: relative;
  overflow: hidden;
}

.form-cert-section::before {
  content: '';
  position: absolute;
  top: -30%;
  left: -10%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle,rgba(135,206,235,.06) 0,transparent 70%);
  border-radius: 50%;
}

.form-cert-wrapper {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 2;
  text-align: center;
}

.form-cert-label {
  display: block;
  margin-bottom: 1rem;
}

.form-cert-title {
  margin-bottom: 1.5rem;
}

.form-cert-text {
  font-size: var(--text-lg);
  color: rgba(255,255,255,.7);
  line-height: 1.8;
  margin-bottom: 2rem;
}

.form-cert-badges {
  display: flex;
  justify-content: center;
  gap: 3rem;
  flex-wrap: wrap;
}

.form-cert-badge {
  text-align: center;
}

.form-cert-badge-name {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--primary-blue);
}

.form-cert-badge-desc {
  font-size: var(--text-sm);
  color: rgba(255,255,255,.6);
  margin-top: .3rem;
}
</style>
