---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { webp } from '../lib/images';

const bg: Record<string, string> = {
  'gallery-10.jpg': await webp('gallery-10.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};
---

<Base
    title="Formazioni su misura per educatori e terapeuti | InBallet"
    description="Formazioni su misura di InBallet per educatori, insegnanti, terapeuti e pedagogisti: linguaggi espressivi, corporeità, motricità ed esplorazione del sé."
    ogTitle="Formazioni Personalizzate | InBallet"
    ogDescription="Corsi di formazione su misura che intrecciano linguaggi espressivi, corporeità e motricità."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-10.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Formazioni Personalizzate</h1>
                <p class="chisiamo-hero-tagline">Percorsi su misura per professionisti dell'educazione, della terapia e della danza.</p>
            </div>
        </section>

        <!-- Intro Section -->
        <section id="intro" class="perso-intro-section">
            <div class="perso-intro-wrapper intro-editoriale">
                <span class="perso-intro-label eyebrow">Formazione su Misura</span>
                <h2 class="perso-intro-title titolo-sezione">Progettiamo insieme <em>il tuo percorso</em></h2>
                <p class="perso-intro-text">
                    InBallet offre ai professionisti dell'ambito educativo e terapeutico, ai pedagogisti e agli insegnanti momenti dedicati alla formazione, organizzati e studiati appositamente per le loro esigenze professionali.
                </p>
                <p class="perso-intro-text">
                    Sono corsi che intrecciano i linguaggi espressivi e la corporeità con la motricità e l'esplorazione del sé. Insieme definiamo obiettivi e contenuti: workshop, eventi formativi o cicli di incontri.
                </p>
                <p class="perso-intro-text">
                    Per chi vuole diventare insegnante di danza c'è invece il <a href="/formazione-insegnanti">corso biennale riconosciuto CSEN e CONI</a>.
                </p>
            </div>
        </section>

        <!-- Tipologie Section -->
        <section class="perso-tipo-section">
            <div class="perso-tipo-wrapper">
                <div class="perso-tipo-header">
                    <span class="perso-tipo-label eyebrow">I Percorsi</span>
                    <h2 class="perso-tipo-title titolo-sezione">A chi <em>ci rivolgiamo</em></h2>
                </div>
                <div class="perso-tipo-grid">
                    <div class="perso-tipo-item">
                        <div class="perso-tipo-num">1</div>
                        <div class="perso-tipo-content">
                            <h3>Ambito educativo</h3>
                            <p>Educatori, insegnanti e personale di nidi e scuole: il corpo e il movimento come strumenti educativi</p>
                        </div>
                    </div>
                    <div class="perso-tipo-item">
                        <div class="perso-tipo-num">2</div>
                        <div class="perso-tipo-content">
                            <h3>Ambito terapeutico</h3>
                            <p>Professionisti della cura: corporeità, motricità e approccio psicomotorio a sostegno del loro lavoro</p>
                        </div>
                    </div>
                    <div class="perso-tipo-item">
                        <div class="perso-tipo-num">3</div>
                        <div class="perso-tipo-content">
                            <h3>Pedagogisti</h3>
                            <p>Linguaggi espressivi ed esplorazione del sé, per progettare esperienze educative attraverso il movimento</p>
                        </div>
                    </div>
                    <div class="perso-tipo-item">
                        <div class="perso-tipo-num">4</div>
                        <div class="perso-tipo-content">
                            <h3>Insegnanti di danza</h3>
                            <p>Aggiornamento su didattica, pedagogia e inclusione, a partire dall'esperienza della scuola</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="corso-contatto-section sezione-scura">
            <div class="corso-contatto-bg" style={`background: url('${bg['bg-progetti-territorio.jpg']}') center/cover no-repeat`}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2 class="titolo-sezione">Hai un progetto <em>in mente?</em></h2>
                    <p class="intro-sezione">Contattaci per un primo colloquio. Definiremo insieme obiettivi e contenuti del tuo percorso formativo.</p>
                    <a href="mailto:info@inballet.it?subject=Formazione%20Personalizzata%20-%20Richiesta%20Info" class="corso-btn-cta btn-primary">
                        Richiedi Informazioni <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
.perso-intro-section {
  padding: var(--section-y) 0;
  background: #fff;
}

.perso-intro-wrapper {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.perso-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.perso-intro-title {
  margin-bottom: 2rem;
}

.perso-intro-text {
  font-size: var(--text-lg);
  color: var(--text-light);
  line-height: 1.8;
  margin-bottom: 1.5rem;
}

.perso-intro-text :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

.perso-tipo-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
  overflow: hidden;
}

.perso-tipo-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.perso-tipo-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.perso-tipo-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2rem;
}

.perso-tipo-header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.perso-tipo-label {
  display: block;
  margin-bottom: 1rem;
}

.perso-tipo-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 2.5rem 4rem;
  position: relative;
}

.perso-tipo-grid::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
  background: rgba(135,206,235,.3);
  transform: translateX(-50%);
}

.perso-tipo-item {
  display: grid;
  grid-template-columns: 45px 1fr;
  gap: 1rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(135,206,235,.3);
}

.perso-tipo-item:nth-last-child(-n+2) {
  border-bottom: none;
  padding-bottom: 0;
}

.perso-tipo-num {
  width: 45px;
  height: 45px;
  background: linear-gradient(135deg,var(--primary-blue) 0%,var(--primary-blue-light) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--dark-navy);
  font-weight: 700;
  font-size: var(--text-lg);
}

.perso-tipo-content :global(h3) {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--dark-navy);
  margin-bottom: .4rem;
}

.perso-tipo-content :global(p) {
  font-size: var(--text-sm);
  color: var(--text-light);
  margin: 0;
  line-height: 1.6;
}

@media(max-width:768px) {
  .perso-tipo-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .perso-tipo-grid::before {
    display: none;
  }

  .perso-tipo-item:nth-last-child(2) {
    border-bottom: 1px solid rgba(135,206,235,.3);
    padding-bottom: 2rem;
  }
}
</style>
