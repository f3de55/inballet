---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { sfondoCta } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import { scuola } from '../data/scuola';
import '../styles/pages/formazioni-personalizzate.css';

const bg = {
  hero: await heroPagina('formazioni-personalizzate'),
  cta: await sfondoCta('bg-progetti-territorio.jpg', { desktop: '50% 35%' }),
};
---

<Base
    title="Formazioni su misura per educatori e terapeuti | InBallet"
    description="Formazioni su misura di InBallet per educatori, insegnanti, terapeuti e pedagogisti: linguaggi espressivi, corporeità, motricità ed esplorazione del sé."
    ogTitle="Formazioni Personalizzate | InBallet"
    ogDescription="Corsi di formazione su misura che intrecciano linguaggi espressivi, corporeità e motricità."
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Section -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Formazioni Personalizzate</h1>
                <p class="hero-lead">Percorsi <strong>su misura</strong> per professionisti dell'educazione, della terapia e della danza.</p>
            </div>
        </section>

        <!-- Intro Section -->
        <section id="intro" class="perso-intro-section decoro-onde">
            <div class="perso-intro-wrapper intro-editoriale">
                <p class="perso-intro-label eyebrow">Formazione su misura</p>
                <h2 class="perso-intro-title titolo-sezione">Progettiamo insieme <em>il tuo percorso</em></h2>
                <p class="perso-intro-text">
                    Corsi per <strong>professionisti dell'educazione e della terapia</strong>, pedagogisti e insegnanti, tra linguaggi espressivi, corporeità, motricità ed esplorazione del sé.
                </p>
                <p class="perso-intro-text">
                    Ogni percorso nasce dalle esigenze di chi lo richiede: insieme definiamo <strong>obiettivi, contenuti e formato</strong>, dal workshop all'evento formativo. Per diventare insegnante di danza c'è il <a href="/formazione-insegnanti">corso biennale riconosciuto CSEN e CONI</a>.
                </p>
            </div>
        </section>

        <!-- Tipologie Section -->
        <section class="perso-tipo-section">
            <div class="perso-tipo-wrapper">
                <div class="perso-tipo-header">
                    <p class="perso-tipo-label eyebrow">I percorsi</p>
                    <h2 class="perso-tipo-title titolo-sezione">A chi <em>ci rivolgiamo</em></h2>
                </div>
                <div class="perso-tipo-grid">
                    <div class="perso-tipo-item">
                        <i class="fas fa-school perso-tipo-num" aria-hidden="true"></i>
                        <div class="perso-tipo-content">
                            <h3>Ambito educativo</h3>
                            <p><strong>Educatori, insegnanti e personale di nidi e scuole</strong>: il corpo e il movimento come strumenti educativi.</p>
                        </div>
                    </div>
                    <div class="perso-tipo-item">
                        <i class="fas fa-hand-holding-heart perso-tipo-num" aria-hidden="true"></i>
                        <div class="perso-tipo-content">
                            <h3>Ambito terapeutico</h3>
                            <p><strong>Professionisti della cura</strong>: corporeità, motricità e approccio psicomotorio a sostegno del loro lavoro.</p>
                        </div>
                    </div>
                    <div class="perso-tipo-item">
                        <i class="fas fa-book-open-reader perso-tipo-num" aria-hidden="true"></i>
                        <div class="perso-tipo-content">
                            <h3>Pedagogisti</h3>
                            <p><strong>Linguaggi espressivi ed esplorazione del sé</strong>, per progettare esperienze educative attraverso il movimento.</p>
                        </div>
                    </div>
                    <div class="perso-tipo-item">
                        <i class="fas fa-users perso-tipo-num" aria-hidden="true"></i>
                        <div class="perso-tipo-content">
                            <h3>Scuole, enti ed équipe</h3>
                            <p><strong>Percorsi per gruppi di lavoro</strong>, costruiti con l'esperienza della scuola in pedagogia, psicomotricità e inclusione.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Hai un progetto <em>in mente?</em></h2>
                <p class="intro-sezione">Contattaci per un <strong>primo colloquio</strong>: definiamo insieme obiettivi e contenuti del tuo percorso.</p>
                <div class="cta-pulsanti">
                    <a href={`mailto:${scuola.email}?subject=Formazione%20Personalizzata%20-%20Richiesta%20Info`} class="btn-primary">
                        Richiedi informazioni <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>
</Base>
