  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corsi-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

