---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SostenitoriSection from '../components/SostenitoriSection.astro';
import Galleria from '../components/Galleria.astro';
import { getImage } from 'astro:assets';
import { ANNI_ATTIVITA, categorieCorsi, faq, FONDAZIONE, scuola } from '../data/scuola';
import { getAsset, sfondo } from '../lib/images';
import { schemaHome } from '../lib/schema';
import { PUBLIC_GOOGLE_PLACE_ID } from 'astro:env/client';

// Video dell'hero (ricodificati da src/assets/video/hero-video-inballet.mp4, senza audio):
// AV1 per i browser che lo supportano, H.264 per gli altri; 1080p solo sugli schermi larghi
import heroAv1Lg from '../assets/video/hero-1080.webm?url';
import heroMp4Lg from '../assets/video/hero-1080.mp4?url';
import heroAv1 from '../assets/video/hero-720.webm?url';
import heroMp4 from '../assets/video/hero-720.mp4?url';

// Corsi: i quattro stili come indice (il dettaglio dei corsi è su /corsi); i percorsi
// per età sono un criterio diverso e stanno in una fascia a parte
const stili = categorieCorsi.filter((c) => c.id !== 'eta');
const perEta = categorieCorsi.find((c) => c.id === 'eta')!;

// Progetti sul territorio: due gruppi di link alle pagine dei progetti
const progetti = [
  { titolo: 'Eventi, scuole e famiglie', voci: [
    { nome: 'Spettacoli ed Eventi', href: '/spettacoli-eventi' },
    { nome: 'Collaborazioni con le Scuole', href: '/collaborazioni-scuole' },
    { nome: 'Sportello Psicologico', href: '/sportello-psicologico' },
  ] },
  { titolo: 'Danza integrativa', voci: [
    { nome: 'Progetto NoiConVoi', href: '/progetto-noiconvoi' },
    { nome: 'Classi Integrate', href: '/classi-integrate' },
    { nome: 'Sostenitori', href: '/sostenitori' },
  ] },
];

// Sfondi responsive: foto e punto focale per desktop, tablet e mobile.
// Nell'hero è il primo fotogramma del video: si vede finché il video non parte
// (e resta da sola con "riduci movimento" o risparmio dati)
const hero = await sfondo('hero-video-poster.jpg');
const progettiSfondo = await sfondo('bg-progetti-territorio.jpg', { desktop: '50% 35%' });

// Dati strutturati (immagine social 1200x630)
const socialImage = new URL((await getImage({ src: getAsset('gallery-3.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href;
const schema = schemaHome(socialImage);

---

<Base
    title="Scuola di Danza a Lainate e Rho | InBallet"
    description={`Scuola di danza a Lainate e Rho (MI) dal ${FONDAZIONE}: classica, modern, contemporanea, hip-hop, yoga e pilates per bambini dai 3 anni, ragazzi e adulti.`}
    ogTitle="InBallet - Scuola di Danza a Lainate e Rho"
    ogDescription={`Corsi di danza per bambini dai 3 anni, ragazzi e adulti a Lainate e Rho, dal ${FONDAZIONE}. Inclusione e formazione insegnanti CSEN e CONI.`}
    ogImage={socialImage}
    skipLinkId="skip-link"
>
    <Fragment slot="head">
        {hero.preload.map((p) => <link rel="preload" as="image" href={p.href} media={p.media} fetchpriority="high">)}
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </Fragment>


    <!-- Hero Section Personalizzata -->
    <section class="hero">
        <div class="hero-image" style={hero.style}></div>

        <!-- Decorativo: parte da hero-video.ts (mai con "riduci movimento" o risparmio dati) -->
        <video class="hero-video" muted loop playsinline preload="none" disablepictureinpicture disableRemotePlayback aria-hidden="true" tabindex="-1">
            <source src={heroAv1Lg} type='video/webm; codecs="av01.0.08M.08"' media="(min-width: 1281px)">
            <source src={heroMp4Lg} type='video/mp4; codecs="avc1.640032"' media="(min-width: 1281px)">
            <source src={heroAv1} type='video/webm; codecs="av01.0.05M.08"'>
            <source src={heroMp4} type='video/mp4; codecs="avc1.64001F"'>
        </video>

        <div class="hero-overlay"></div>

        <div class="hero-content">
            <p class="hero-badge">InBallet ASD · {ANNI_ATTIVITA} anni di danza</p>

            <h1>Scuola di Danza a Lainate e Rho</h1>

            <p class="hero-subtitle">
                Danza classica, modern, contemporanea, hip-hop, yoga e pilates: corsi per bambini dai 3 anni, ragazzi e adulti, anche principianti.
            </p>

            <div class="hero-cta">
                <a href="/corsi" class="btn-primary">
                    <span>Scopri i corsi</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/contatti" class="btn-secondary">
                    <span>Contattaci</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Sezione Corsi -->
    <section id="corsi" class="corsi-section">
        <div class="corsi-wrapper">
            <!-- Header -->
            <div class="corsi-header">
                <span class="corsi-label eyebrow">Corsi di danza a Lainate e Rho</span>
                <h2 class="corsi-title titolo-sezione">I nostri <em>corsi</em></h2>
                <p class="corsi-intro intro-sezione">Dai 3 anni all'età adulta, dalla danza classica all'hip-hop fino a yoga e pilates: scegli il corso per stile o per età.</p>
            </div>

            <ol class="corsi-indice">
                {stili.map((cat, i) => (
                    <li>
                        <a href={`/corsi#${cat.id}`}>
                            <span class="corsi-indice-numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                            <span class="corsi-indice-nome">{cat.nome}</span>
                            <span class="corsi-indice-testo">{cat.sintesi}</span>
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </li>
                ))}
            </ol>

            <!-- Stessi corsi visti per fascia d'età -->
            <div class="corsi-eta">
                <div>
                    <h3 class="voce-titolo">Oppure scegli per età</h3>
                    <p class="voce-testo">{perEta.sintesi}</p>
                </div>
                <ul class="corso-link">
                    {perEta.corsi.map((c) => (
                        <li><a href={c.url}><span>{c.nome.replace(/ \((.+)\)$/, '')}{c.nome.endsWith(')') && <> <span class="corso-eta">{c.nome.slice(c.nome.lastIndexOf('('))}</span></>}</span><i class="fas fa-arrow-right" aria-hidden="true"></i></a></li>
                    ))}
                </ul>
            </div>

            <!-- Elenco completo: subito sotto i percorsi -->
            <div class="corsi-tutti">
                <a href="/corsi" class="link-cta">
                    Tutti i corsi
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            <div class="corsi-cta">
                <p class="corsi-cta-text">Non sai quale corso scegliere? <span>Ti aiutiamo a trovare quello giusto.</span></p>
                <a href="/contatti" class="btn-primary">
                    <span>Parliamone insieme</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Chi Siamo Section -->
    <section id="chi-siamo" class="chi-siamo-section">
        <div class="container">
            <div class="story-layout">
                <div class="story-content">
                    <div class="section-header chi-siamo-header">
                        <p class="section-tagline eyebrow">Dal {FONDAZIONE} a Lainate e Rho</p>
                        <h2 class="section-title titolo-sezione">La nostra <em>storia</em></h2>
                    </div>

                    <div class="story-text">
                        <p class="story-lead">I.N. Ballet, per tutti InBallet, è la scuola di danza multidisciplinare di Lainate e Rho fondata nel {FONDAZIONE} da {scuola.fondatrice}: un luogo di vita in cui esplorare stili diversi, nelle loro sfumature tecniche e artistiche.</p>

                        <p>Qui danzano bambini dai 3 anni, ragazzi e adulti, dai primi passi ai corsi avanzati, in dialogo continuo con le famiglie.</p>

                        <p>L'inclusione riguarda tutte le età: quasi tutte le <a href="/classi-integrate">classi accolgono allievi con bisogni speciali</a> e dal 2013 il <a href="/progetto-noiconvoi">progetto NoiConVoi</a> porta la danza ai ragazzi con disabilità, con un team di volontari e il supporto psicomotorio.</p>
                    </div>

                    <blockquote class="story-quote">
                        <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                        <cite>{scuola.fondatrice}, fondatrice</cite>
                    </blockquote>

                    <a href="/chi-siamo" class="link-cta story-cta">
                        Scopri chi siamo
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                <!-- Foto verticale, alta quanto il testo accanto (su mobile torna orizzontale) -->
                <div class="story-image">
                    <div class="foto-cornice">
                        <Img src="gallery-7.jpg" alt="Insegnanti e allieve di InBallet insieme in sala" width="640" height="800" fuoco={{ desktop: '50% 50%', tablet: '50% 55%' }} loading="lazy" decoding="async" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 480px" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sezione Formazione Professionale -->
    <section class="formazione-professionale-section">
        <div class="formazione-wrapper">
            <div class="formazione-intro">
                <span class="eyebrow">Ente formativo CSEN e CONI</span>
                <h2 class="titolo-sezione">Formazione <em>professionale</em></h2>
                <p class="intro-sezione">Formiamo chi insegna danza e chi lavora in ambito educativo e terapeutico: un titolo riconosciuto a livello nazionale e formazioni su misura.</p>
            </div>

            <!-- Percorsi: righe intere cliccabili, separate da filetti -->
            <ul class="percorsi-lista">
                <li>
                    <a href="/formazione-insegnanti" class="percorso">
                        <span class="percorso-tipo">Percorso biennale</span>
                        <h3 class="percorso-titolo">Formazione Insegnanti di Danza</h3>
                        <p class="percorso-testo">Due anni nello stile Modern tra danza, pedagogia e sviluppo, dalla prima infanzia all'età adulta, fino ai casi più complessi di disabilità.</p>
                        <p class="percorso-dettagli">Titolo nazionale CSEN e CONI · Ente formativo dal 2023 · Sei master di approfondimento</p>
                        <span class="percorso-cta" aria-hidden="true">Scopri il corso <i class="fas fa-arrow-right"></i></span>
                        <i class="fas fa-arrow-right percorso-freccia" aria-hidden="true"></i>
                    </a>
                </li>
                <li>
                    <a href="/formazioni-personalizzate" class="percorso">
                        <span class="percorso-tipo">Su misura</span>
                        <h3 class="percorso-titolo">Formazioni Personalizzate</h3>
                        <p class="percorso-testo">Corsi su misura per educatori, terapeuti, pedagogisti e insegnanti, tra linguaggi espressivi, corporeità e motricità.</p>
                        <p class="percorso-dettagli">Ambito educativo e terapeutico · Workshop ed eventi formativi</p>
                        <span class="percorso-cta" aria-hidden="true">Scopri di più <i class="fas fa-arrow-right"></i></span>
                        <i class="fas fa-arrow-right percorso-freccia" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </div>
    </section>

     <section class="dicono-di-noi-section" aria-labelledby="recensioni-titolo">
        <div class="container recensioni-layout">
            <div class="recensioni-intro">
                <p class="eyebrow">Le voci della nostra community</p>
                <h2 class="titolo-sezione" id="recensioni-titolo">Dicono <em>di noi</em></h2>
                <p class="intro-sezione">Allievi e famiglie raccontano InBallet nelle recensioni pubblicate su Google.</p>
            </div>

            <!-- Valutazione media (compilata da home.ts) e link a tutte le recensioni -->
            <div class="recensioni-sintesi">
                <div class="sintesi-google" id="googleStatsCard" hidden></div>
                <a href={`https://search.google.com/local/reviews?placeid=${PUBLIC_GOOGLE_PLACE_ID}`}
                   target="_blank"
                   rel="noopener"
                   class="link-cta">
                    Tutte le recensioni su Google
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            <!-- Recensioni: una alla volta, frecce e indicatori sotto -->
            <div class="recensioni-carousel testimonials-carousel">
                <div class="testimonials-track" id="reviewsContainer" aria-live="polite">
                    <div class="testimonials-slide active">
                        <p class="recensioni-messaggio">Caricamento recensioni…</p>
                    </div>
                </div>

                <div class="recensioni-controlli" id="reviewsControls" hidden>
                    <button type="button" class="recensioni-nav" id="prevBtn" aria-label="Recensione precedente">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <div class="carousel-indicators" id="indicatorsContainer"></div>
                    <button type="button" class="recensioni-nav" id="nextBtn" aria-label="Recensione successiva">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

     <!-- Sezione Progetti Sul Territorio -->
    <section class="altri-servizi-section sezione-scura">
        <div class="altri-servizi-bg" style={progettiSfondo.style}></div>
        <div class="altri-servizi-overlay"></div>

        <div class="intro-editoriale progetti-intro">
            <span class="eyebrow">La danza fuori dalla sala</span>
            <h2 class="titolo-sezione">Progetti <em>sul territorio</em></h2>
            <p class="intro-sezione">Spettacoli in teatro, progetti con le scuole del territorio, ascolto per le famiglie e, dal 2013, danza per l'inclusione.</p>
        </div>

        <div class="progetti-gruppi">
            {progetti.map((g) => (
                <div class="progetti-gruppo">
                    <h3 class="progetti-gruppo-titolo">{g.titolo}</h3>
                    <ul class="progetti-lista">
                        {g.voci.map((v) => (
                            <li>
                                <a href={v.href}>
                                    <span class="progetto-nome">{v.nome}</span>
                                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </section>

    <!-- Galleria fotografica a scorrimento, con lightbox -->
    <Galleria />

    <!-- Sezione Sostenitori -->
    <SostenitoriSection />

    <!-- Domande frequenti -->
    <section class="faq-section" aria-labelledby="faq-titolo">
        <div class="container faq-layout">
            <div class="faq-intro">
                <p class="faq-label eyebrow">Domande frequenti</p>
                <h2 class="faq-title titolo-sezione" id="faq-titolo">Tutto quello che <em>vuoi sapere</em></h2>
                <p class="faq-text intro-sezione">Età, sedi, corsi e iscrizioni. Non trovi la risposta? Scrivici o chiamaci.</p>
                <ul class="faq-contatti">
                    <li><a href={`mailto:${scuola.email}`}><i class="fas fa-envelope" aria-hidden="true"></i>{scuola.email}</a></li>
                    <li><a href={scuola.telefonoHref}><i class="fas fa-phone" aria-hidden="true"></i>{scuola.telefono}</a></li>
                </ul>
            </div>
            <div class="faq-list">
                {faq.map((f, i) => (
                    <details class="faq-item" name="faq" open={i === 0}>
                        <summary>{f.domanda}</summary>
                        <p>{f.risposta}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>


    <Fragment slot="scripts">
        <script>
            import '../scripts/hero-video';
            import '../scripts/home';
        </script>
    </Fragment>
</Base>

<style>.hero {
  /* Altezza minima della foto; il contenuto può allungarla (testi grandi, schermi bassi) */
  min-height: calc(clamp(560px, 72vh, 800px) - var(--header-h));
  position: relative;
  overflow: hidden;
  display: flex;
  /* Testo centrato in verticale: stesso spazio sopra (sotto la navbar) e sotto */
  align-items: center;
  z-index: 1;
  padding: 4rem 0;
}

.hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: center/cover no-repeat;
  z-index: 1;
  content-visibility: auto;
}

/* Sopra la foto (primo fotogramma), compare in dissolvenza solo quando il video sta
   davvero andando: niente riquadro nero mentre carica */
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 1;
  opacity: 0;
  transition: opacity .8s ease;
  pointer-events: none;
}

.hero-video.is-playing {
  opacity: 1;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* Video in movimento e testo centrato a sinistra: velo più scuro dietro il testo,
     più leggero a destra dove il video resta protagonista */
  background:
    linear-gradient(to right, rgba(10,10,10,.78) 0%, rgba(10,10,10,.48) 55%, rgba(10,10,10,.25) 100%),
    linear-gradient(to top, rgba(10,10,10,.55) 0%, rgba(10,10,10,.2) 50%, rgba(10,10,10,.3) 100%);
  z-index: 2;
}

/* Su mobile il testo occupa tutta la larghezza: velo uniforme */
@media (max-width: 768px) {
  .hero-overlay {
    background: linear-gradient(to top, rgba(10,10,10,.85) 0%, rgba(10,10,10,.68) 50%, rgba(10,10,10,.6) 100%);
  }
}

.hero-content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  color: var(--white);
  text-align: left;
  animation: fadeInUp 1s ease-out;
}

.hero-badge {
  display: block;
  font-size: var(--text-sm);
  font-weight: 600;
  margin-bottom: 1.25rem;
  color: var(--primary-blue);
  text-transform: uppercase;
  letter-spacing: 2px;
}

.hero :global(h1) {
  font-size: var(--text-6xl);
  font-weight: 700;
  line-height: 1.05;
  margin-bottom: 1.25rem;
  color: var(--white);
  letter-spacing: -.02em;
  max-width: 14ch;
}

.hero-subtitle {
  font-size: var(--text-xl);
  margin-bottom: 2.25rem;
  color: rgba(255,255,255,.88);
  font-weight: 300;
  line-height: 1.55;
  max-width: 38rem;
}

.hero-cta {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.chi-siamo-section {
  position: relative;
  padding: var(--section-y) 0;
  background: #fff;
}

.chi-siamo-header {
  text-align: left;
  margin-bottom: 2.25rem;
}

/* Testo a sinistra, foto orizzontale (saluto finale di gruppo) più larga a destra */
.story-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
  gap: 5rem;
  align-items: stretch;
  max-width: 1200px;
  margin: 0 auto;
}

.story-text {
  max-width: 34rem;
}

.story-text :global(p) {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 1.25rem;
}

.story-text :global(p:last-child) {
  margin-bottom: 0;
}

.story-text :global(p.story-lead) {
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--dark-navy);
}

.story-quote {
  max-width: 34rem;
  margin: 2.25rem 0 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.story-quote p {
  font-size: var(--text-base);
  font-style: italic;
  line-height: 1.6;
  color: var(--dark-navy);
}

.story-quote cite {
  display: block;
  margin-top: .5rem;
  font-size: var(--text-sm);
  font-style: normal;
  font-weight: 600;
  letter-spacing: .5px;
  color: var(--text-light);
}

.story-quote cite::before {
  content: '— ';
}

.story-cta {
  margin-top: 2.25rem;
}

/* Spazio per la cornice sfalsata (in basso a sinistra) dentro la colonna */
.story-image {
  display: flex;
  padding: 0 0 1.5rem 1.5rem;
}

.story-image .foto-cornice {
  flex: 1;
  display: flex;
}

.story-image :global(img) {
  width: 100%;
  height: 100%;
  min-height: 26rem;
  object-fit: cover;
}

@media (max-width: 600px) {
  .story-image {
    padding: 0 0 .75rem .75rem;
  }
}

.corsi-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
  overflow: hidden;
}

.corsi-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corsi-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corsi-wrapper {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

.corsi-header {
  text-align: center;
  margin-bottom: 4rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.corsi-label {
  display: block;
  margin-bottom: 1.5rem;
}

.corsi-title {
  margin-bottom: 1.5rem;
}

.corsi-intro {
  max-width: 600px;
  margin: 0 auto;
}

/* Stili come indice editoriale: una riga per stile, tutta cliccabile, separata da filetti.
   Su desktop numero, nome, frase e freccia sulla stessa riga */
.corsi-indice {
  list-style: none;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0;
  border-bottom: 1px solid rgba(26, 26, 26, .12);
}

.corsi-indice li {
  border-top: 1px solid rgba(26, 26, 26, .12);
}

.corsi-indice a {
  display: grid;
  grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.3fr) auto;
  align-items: center;
  gap: 1rem 2.5rem;
  padding: 2rem 0;
  color: var(--dark-navy);
  text-decoration: none;
}

.corsi-indice-numero {
  font-size: var(--text-2xl);
  font-weight: 300;
  line-height: 1;
  color: var(--primary-blue-dark);
}

.corsi-indice-nome {
  font-size: var(--text-2xl);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -.01em;
  transition: color .25s ease;
}

.corsi-indice-testo {
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--text-light);
}

.corsi-indice a i {
  font-size: var(--text-sm);
  color: var(--primary-blue-dark);
  transition: transform .25s ease;
}

.corsi-indice a:hover .corsi-indice-nome {
  color: var(--primary-blue-dark);
}

.corsi-indice a:hover i {
  transform: translateX(5px);
}

.corsi-indice a:focus-visible {
  outline: 2px solid var(--primary-blue-dark);
  outline-offset: 4px;
}

/* Per età: fascia a parte, con le fasce come pillole (un criterio diverso dagli stili) */
.corsi-eta {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
  gap: 1.5rem 3rem;
  align-items: center;
  max-width: 1200px;
  margin: 4.5rem auto 0;
  padding-top: 2.5rem;
  border-top: 2px solid var(--primary-blue);
}

.corsi-eta .voce-testo {
  font-size: var(--text-sm);
}

.corsi-tutti {
  max-width: 1200px;
  margin: 2.5rem auto 4.5rem;
}

/* Fasce d'età come pillole: si riconoscono come cliccabili e vanno a capo da sole */
.corso-link {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
  margin: 0;
  padding: 0;
}

.corso-link a {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  min-height: 40px;
  padding: .5rem 1rem;
  border: 1px solid rgba(70, 130, 180, 0.35);
  border-radius: var(--radius-pill);
  background: var(--white);
  color: var(--dark-navy);
  font-size: var(--text-sm);
  font-weight: 500;
  line-height: 1.25;
  text-decoration: none;
  transition: background-color .25s ease, border-color .25s ease, color .25s ease;
}

.corso-link a i {
  flex-shrink: 0;
  font-size: var(--text-3xs);
  color: var(--primary-blue-dark);
  transition: transform .25s ease, color .25s ease;
}

.corso-link a:hover {
  background: var(--primary-blue);
  border-color: var(--primary-blue);
}

.corso-link a:hover i {
  color: var(--dark-navy);
  transform: translateX(3px);
}

.corso-eta {
  white-space: nowrap;
}

.corsi-cta {
  display: flex;
  align-items: center;
  /* Domanda e pulsante vicini, al centro: si leggono come un'unica proposta */
  justify-content: center;
  gap: 2.5rem;
  max-width: 1200px;
  margin: 0 auto;
  padding-top: 2.5rem;
  border-top: 1px solid rgba(26, 26, 26, 0.1);
}

.corsi-cta-text {
  font-size: var(--text-base);
  color: var(--dark-navy);
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: var(--leading-snug);
  margin: 0;
}

.corsi-cta-text span {
  display: block;
  margin-top: .35rem;
  font-size: var(--text-base);
  font-weight: 400;
  letter-spacing: 0;
  color: var(--text-light);
}

.corsi-cta .btn-primary {
  flex-shrink: 0;
}

@media (max-width: 1024px) {
  .corsi-indice a {
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    gap: .35rem 1rem;
  }

  .corsi-indice-testo {
    grid-column: 2;
    grid-row: 2;
  }

  .corsi-indice a i {
    grid-column: 3;
    grid-row: 1 / 3;
  }

  .corsi-eta {
    grid-template-columns: minmax(0, 1fr);
    margin-top: 4rem;
  }

  .corsi-cta {
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
}

@media (max-width: 600px) {
  .corsi-indice a {
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    padding: 1.5rem 0;
  }

  .corsi-indice-numero {
    font-size: var(--text-lg);
  }

  .corsi-indice-nome {
    font-size: var(--text-lg);
  }

  .corsi-eta {
    margin-top: 3.5rem;
  }

  .corsi-tutti {
    margin: 2rem 0 3rem;
  }

  .corsi-cta {
    padding-top: 0;
    border-top: none;
  }

  .corsi-wrapper {
    padding: 0 1.5rem;
  }

}

@media (max-width: 600px) {
  .corso-link a {
    padding: .45rem .9rem;
  }
}

/* Formazione: fondo azzurrino, intro a sinistra e percorsi come elenco a destra */
.formazione-professionale-section {
  position: relative;
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.formazione-wrapper {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: start;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.formazione-intro .titolo-sezione {
  margin-bottom: 1.5rem;
}

.percorsi-lista {
  list-style: none;
  border-top: 1px solid rgba(26, 26, 26, 0.12);
}

.percorsi-lista li {
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

/* Tutta la riga è il link; la freccia sta a destra, centrata */
.percorso {
  position: relative;
  display: block;
  padding: 2rem 4rem 2rem 0;
  color: inherit;
  text-decoration: none;
}

.percorso-tipo {
  display: block;
  margin-bottom: .5rem;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
}

.percorso-titolo {
  margin: 0 0 .6rem;
  font-size: var(--text-2xl);
  font-weight: 700;
  line-height: var(--leading-snug);
  letter-spacing: -0.01em;
  color: var(--dark-navy);
  transition: color .3s ease;
}

.percorso-testo {
  margin: 0;
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--text-light);
}

.percorso-dettagli {
  margin: .75rem 0 0;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--dark-navy);
}

.percorso-freccia {
  position: absolute;
  top: 50%;
  right: 0;
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  margin-top: -1.375rem;
  border: 1px solid rgba(26, 26, 26, 0.2);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--primary-blue-dark);
  transition: background-color .3s ease, border-color .3s ease, color .3s ease, transform .3s ease;
}

/* Hover solo con mouse: sul touch resterebbe attivo dopo il tocco */
@media (hover: hover) and (pointer: fine) {
  .percorso:hover .percorso-titolo {
    color: var(--primary-blue-dark);
  }

  .percorso:hover .percorso-freccia {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
    color: var(--dark-navy);
    transform: translateX(4px);
  }
}

@media (max-width: 1024px) {
  .formazione-wrapper {
    gap: 3.5rem;
  }
}

@media (max-width: 900px) {
  .formazione-wrapper {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding: 0 1.5rem;
  }
}

/* Etichetta testuale al posto della freccia tonda: solo su mobile */
.percorso-cta {
  display: none;
}

/* Mobile: niente freccia laterale, il testo usa tutta la larghezza e sotto c'è "Scopri" */
@media (max-width: 600px) {
  .percorso {
    padding: 1.75rem 0;
  }

  .percorso-freccia {
    display: none;
  }

  .percorso-cta {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-top: 1rem;
    padding-bottom: .3rem;
    border-bottom: 2px solid var(--primary-blue);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--dark-navy);
  }

  .percorso-cta i {
    font-size: var(--text-xs);
    color: var(--primary-blue-dark);
  }
}

/* ---------- Dicono di noi: intro e sintesi a sinistra, una recensione alla volta a destra ---------- */
.dicono-di-noi-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.recensioni-layout {
  display: grid;
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  grid-template-areas:
    "intro carosello"
    "sintesi carosello";
  grid-template-rows: auto 1fr;
  gap: 2.5rem 5rem;
}

.recensioni-intro {
  grid-area: intro;
}

.recensioni-intro .titolo-sezione {
  margin-bottom: 1.5rem;
}

.recensioni-sintesi {
  grid-area: sintesi;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.75rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(26, 26, 26, 0.12);
}

.sintesi-google {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-areas:
    "voto stelle"
    "voto totale";
  column-gap: 1rem;
  align-items: center;
}

.sintesi-google[hidden] {
  display: none;
}

.sintesi-google :global(.sintesi-voto) {
  grid-area: voto;
  font-size: var(--text-5xl);
  font-weight: 300;
  line-height: 1;
  color: var(--dark-navy);
}

.sintesi-google :global(.sintesi-stelle) {
  grid-area: stelle;
  align-self: end;
  font-size: var(--text-sm);
  color: #f5b301;
  letter-spacing: 2px;
}

.sintesi-google :global(.sintesi-totale) {
  grid-area: totale;
  align-self: start;
  font-size: var(--text-sm);
  color: var(--text-light);
}

/* Recensione come citazione libera, senza card */
.recensioni-carousel {
  grid-area: carosello;
  align-self: center;
}

.testimonials-track {
  position: relative;
}

:global(.testimonials-slide) {
  display: none;
  margin: 0;
  opacity: 0;
  transition: opacity .35s ease, transform .35s ease;
}

:global(.testimonials-slide.active) {
  display: block;
  opacity: 1;
}

.recensioni-carousel :global(.recensione-stelle) {
  margin-bottom: 1.25rem;
  font-size: var(--text-sm);
  color: #f5b301;
  letter-spacing: 2px;
}

.recensioni-carousel :global(.recensione-stelle .far),
.sintesi-google :global(.sintesi-stelle .far) {
  color: rgba(26, 26, 26, 0.15);
}

.recensioni-carousel :global(.recensione-testo) {
  position: relative;
  margin: 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.recensioni-carousel :global(.recensione-testo p) {
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--dark-navy);
}

.recensioni-carousel :global(.review-text) {
  transition: opacity .15s ease;
}

.recensioni-carousel :global(.read-more-btn) {
  margin-left: .35rem;
  padding: 0 0 1px;
  border: none;
  border-bottom: 1px solid var(--primary-blue);
  background: none;
  font: inherit;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--primary-blue-dark);
  cursor: pointer;
}

.recensioni-carousel :global(.recensione-autore) {
  display: flex;
  align-items: center;
  gap: .9rem;
  margin-top: 1.75rem;
  padding-left: 1.5rem;
}

.recensioni-carousel :global(.author-avatar) {
  display: grid;
  place-items: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: var(--radius-full);
  background: var(--bg-soft);
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--primary-blue-dark);
}

.recensioni-carousel :global(.recensione-autore strong) {
  display: block;
  font-weight: 600;
  color: var(--dark-navy);
}

.recensioni-carousel :global(.recensione-fonte) {
  display: block;
  font-size: var(--text-sm);
  color: var(--text-light);
}

.recensioni-carousel :global(.recensioni-messaggio) {
  font-size: var(--text-base);
  color: var(--text-light);
}

.recensioni-controlli {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-top: 2.5rem;
  padding-left: 1.5rem;
}

.recensioni-controlli[hidden] {
  display: none;
}

.recensioni-nav {
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  border: 1px solid rgba(26, 26, 26, 0.2);
  border-radius: var(--radius-full);
  background: transparent;
  font-size: var(--text-xs);
  color: var(--primary-blue-dark);
  cursor: pointer;
  transition: background-color .3s ease, border-color .3s ease, color .3s ease;
}

.recensioni-nav:hover {
  background: var(--primary-blue);
  border-color: var(--primary-blue);
  color: var(--dark-navy);
}

.carousel-indicators {
  display: flex;
  align-items: center;
  gap: .5rem;
}

.carousel-indicators :global(.indicator) {
  width: .5rem;
  height: .5rem;
  padding: 0;
  border: none;
  border-radius: var(--radius-pill);
  background: rgba(26, 26, 26, 0.15);
  cursor: pointer;
  transition: width .3s ease, background-color .3s ease;
}

.carousel-indicators :global(.indicator.active) {
  width: 1.5rem;
  background: var(--primary-blue-dark);
}

/* Una colonna: intro, valutazione Google (prova di fiducia subito visibile),
   recensione e per ultimo il link a tutte le recensioni */
@media (max-width: 900px) {
  .recensioni-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .recensioni-sintesi {
    display: contents;
  }

  .recensioni-intro {
    order: 1;
  }

  .sintesi-google {
    order: 2;
  }

  /* Frecce e pallini sopra la recensione: restano fermi senza riservare
     l'altezza della recensione più lunga (che su schermi stretti lascia un buco) */
  .recensioni-carousel {
    order: 3;
    display: flex;
    flex-direction: column;
    margin-top: .5rem;
  }

  .recensioni-controlli {
    order: -1;
    margin: 0 0 1.5rem;
    padding-left: 0;
  }

  .testimonials-track {
    min-height: 0 !important;
  }

  .recensioni-sintesi .link-cta {
    order: 4;
    align-self: flex-start;
  }
}

@media (max-width: 600px) {
  .recensioni-carousel :global(.recensione-testo),
  .recensioni-carousel :global(.recensione-autore) {
    padding-left: 1.1rem;
  }

}

.altri-servizi-section {
  padding: var(--section-y) 0;
  position: relative;
  overflow: hidden;
}

.altri-servizi-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: center/cover no-repeat;
  filter: grayscale(.5);
  z-index: 1;
}

/* La foto resta atmosfera: velo scuro uniforme, più denso in basso dove ci sono le liste */
.altri-servizi-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(18, 18, 18, 0.84) 0%, rgba(18, 18, 18, 0.92) 100%);
  z-index: 2;
}

.progetti-intro,
.progetti-gruppi {
  position: relative;
  z-index: 3;
}

.progetti-gruppi {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2.5rem 5rem;
  max-width: 1200px;
  margin: 3.5rem auto 0;
  padding: 0 2rem;
}

.progetti-gruppo-titolo {
  margin: 0 0 1rem;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue);
}

.progetti-lista {
  list-style: none;
  border-top: 1px solid rgba(255, 255, 255, 0.18);
}

.progetti-lista li {
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.progetti-lista a {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  column-gap: 1.5rem;
  align-items: center;
  padding: 1rem 0;
  color: var(--white);
  text-decoration: none;
}

.progetto-nome {
  font-size: var(--text-base);
  font-weight: 500;
  line-height: 1.35;
  transition: color .3s ease;
}

.progetti-lista a i {
  font-size: var(--text-sm);
  color: var(--primary-blue);
  transition: transform .3s ease;
}

@media (hover: hover) and (pointer: fine) {
  .progetti-lista a:hover .progetto-nome {
    color: var(--primary-blue);
  }

  .progetti-lista a:hover i {
    transform: translateX(4px);
  }
}

@media (max-width: 900px) {
  .progetti-gruppi {
    column-gap: 2.5rem;
    margin-top: 2.5rem;
    padding: 0 1.5rem;
  }
}

/* Gruppi uno sotto l'altro solo quando le colonne diventerebbero troppo strette */
@media (max-width: 640px) {
  .progetti-gruppi {
    grid-template-columns: minmax(0, 1fr);
  }

  .progetti-intro .intro-sezione {
    font-size: var(--text-base);
  }

  .progetti-lista a {
    column-gap: 1rem;
  }
}

@media (max-width:1024px) {
.story-layout {
    gap: 4rem;
  }

}

@media (max-width:900px) {
/* Una colonna: titolo, foto, testo, citazione e per ultimo il link
   (story-content "si scioglie" così i suoi figli si ordinano insieme alla foto) */
.story-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

.story-content {
    display: contents;
  }

.chi-siamo-header {
    order: 1;
    margin-bottom: 1.75rem;
  }

.story-image {
    order: 2;
    margin-bottom: 2.25rem;
  }

.story-text {
    order: 3;
  }

.story-quote {
    order: 4;
  }

.story-cta {
    order: 5;
    align-self: flex-start;
  }

.story-text,
.story-quote {
    max-width: none;
  }


.story-image :global(img) {
    height: auto;
    min-height: 0;
    aspect-ratio: 3 / 2;
  }
}

@media (max-width:768px) {
.hero {
    padding: 2.5rem 0;
    height: auto;
    min-height: calc(78vh - var(--header-h));
}

.hero-content {
    padding: 0 1.5rem;
}

.hero-badge {
    margin-bottom: .8rem;
    letter-spacing: 1.5px;
  }

.hero :global(h1) {
    max-width: none;
    font-size: var(--text-5xl);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

.hero-subtitle {
    line-height: 1.5;
    margin-bottom: 1.8rem;
    max-width: 100%;
  }

.hero-cta {
    gap: .75rem;
}

}

@media (max-width:480px) {
.hero-content {
    padding: 0 1.5rem;
}

.hero-badge {
    margin-bottom: .6rem;
  }

.hero :global(h1) {
    margin-bottom: .8rem;
  }

.hero-subtitle {
    margin-bottom: 1.5rem;
  }

.story-text :global(p) {
    line-height: 1.75;
  }

.story-text :global(p.story-lead) {
    line-height: 1.55;
  }

.corsi-header {
    margin-bottom: 3rem;
  }

}

/* ---------- Domande frequenti ---------- */
.faq-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.faq-layout {
  display: grid;
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  gap: 5rem;
  align-items: start;
}

/* L'intro resta in vista mentre si scorre l'elenco */
.faq-intro {
  position: sticky;
  top: calc(var(--header-h) + var(--banner-height, 0px) + 2rem);
}

.faq-label {
  margin-bottom: 1rem;
}

.faq-title {
  margin-bottom: 1.5rem;
}

.faq-list {
  border-top: 1px solid rgba(26, 26, 26, 0.12);
}

.faq-item {
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.faq-item summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  padding: 1.1rem 0;
  font-size: var(--text-base);
  font-weight: 600;
  line-height: 1.4;
  color: var(--dark-navy);
  cursor: pointer;
  list-style: none;
  transition: color .3s ease;
}

.faq-item summary::-webkit-details-marker {
  display: none;
}

/* "+" disegnato con due barre (non un carattere): centrato al pixel, e ruotato diventa una × centrata */
.faq-item summary::after {
  content: '';
  flex-shrink: 0;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-full);
  border: 1px solid rgba(26, 26, 26, 0.2);
  color: var(--primary-blue-dark);
  background:
    linear-gradient(currentColor, currentColor) center / 12px 2px no-repeat,
