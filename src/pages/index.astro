---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SostenitoriSection from '../components/SostenitoriSection.astro';
import { getImage } from 'astro:assets';
import { ANNI_ATTIVITA, categorieCorsi, faq, FONDAZIONE, scuola } from '../data/scuola';
import { getAsset, webp } from '../lib/images';
import { schemaHome } from '../lib/schema';

// Galleria: miniature responsive + versione grande per il lightbox
const alts = [
  'Allieve si preparano dietro le quinte prima dello spettacolo',
  'Corpo di ballo sul palco illuminato di blu',
  'Coreografia di danza contemporanea con costumi bianchi',
  "Lezione di danza contemporanea in sala con l'insegnante",
  'Allieve durante il riscaldamento a terra in sala',
  'Spettacolo di fine anno con tutto il corpo di ballo',
  'Gruppo di allievi InBallet in sala prove',
  "Abbraccio tra insegnante e allieva al termine della lezione",
  'Allieve in allungamento sul parquet della sala',
  'Coreografia sul palco con luci blu ed elementi scenici',
];
const gallery = await Promise.all(
  alts.map(async (alt, i) => {
    const file = `gallery-${i + 1}.jpg`;
    return { file, alt, full: await webp(file, 1280) };
  }),
);

// Progetti sul territorio: due gruppi di link alle pagine dei progetti
const progetti = [
  { titolo: 'Eventi e collaborazioni', voci: [
    { nome: 'Spettacoli ed Eventi', href: '/spettacoli-eventi', testo: 'Saggi, spettacoli e workshop in teatri e spazi pubblici' },
    { nome: 'Collaborazioni con le Scuole', href: '/collaborazioni-scuole', testo: 'Progetti educativi dal nido alle secondarie' },
    { nome: 'Sportello Psicologico', href: '/sportello-psicologico', testo: 'Ascolto e supporto per famiglie, bambini e ragazzi' },
  ] },
  { titolo: 'Danza integrativa', voci: [
    { nome: 'Progetto NoiConVoi', href: '/progetto-noiconvoi', testo: "Dal 2013, danza e volontariato per l'inclusione" },
    { nome: 'Classi Integrate', href: '/classi-integrate', testo: 'Percorsi di danza inclusivi per ogni bambino' },
    { nome: 'Sostenitori', href: '/sostenitori', testo: 'Come sostenere i progetti sociali' },
  ] },
];

// Sfondi in WebP (il CSS definisce solo posizione e dimensione)
const heroBg = await webp('hero-bg.jpg', 1920);
const progettiBg = await webp('bg-progetti-territorio.jpg', 1920);

// Dati strutturati (immagine social 1200x630)
const socialImage = new URL((await getImage({ src: getAsset('gallery-3.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href;
const schema = schemaHome(socialImage);

---

<Base
    title="Scuola di Danza a Lainate e Rho | InBallet"
    description={`Scuola di danza a Lainate e Rho (MI) dal ${FONDAZIONE}: corsi per bambini dai 3 anni, ragazzi e adulti. Classica, modern, contemporanea, hip-hop, yoga e pilates. Ente formativo CSEN-CONI. Lezione di prova senza impegno.`}
    ogTitle="InBallet - Scuola di Danza a Lainate e Rho"
    ogDescription={`${ANNI_ATTIVITA} anni di danza, passione e formazione per tutte le età, a Lainate e Rho.`}
    ogImage={socialImage}
    skipLinkId="skip-link"
>
    <Fragment slot="head">
        <link rel="preload" as="image" href={heroBg} fetchpriority="high">
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </Fragment>


    <!-- Hero Section Personalizzata -->
    <section class="hero">
        <div class="hero-image" style={`background-image: url('${heroBg}')`}></div>

        <div class="hero-overlay"></div>

        <div class="hero-content">
            <p class="hero-badge">InBallet ASD · {ANNI_ATTIVITA} anni di danza</p>

            <h1>Scuola di Danza a Lainate e Rho</h1>

            <p class="hero-subtitle">
                Corsi per tutte le età, dai 3 anni agli adulti: classica, contemporanea, hip-hop, breaking, yoga e pilates. Ente formativo riconosciuto CSEN e CONI.
            </p>

            <div class="hero-cta">
                <a href="/corsi" class="btn-primary">
                    <span>Scopri i corsi</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/contatti" class="btn-secondary">
                    <span>Contattaci</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Sezione Corsi -->
    <section id="corsi" class="corsi-section">
        <div class="corsi-wrapper">
            <!-- Header -->
            <div class="corsi-header">
                <span class="corsi-label eyebrow">La nostra offerta formativa</span>
                <h2 class="corsi-title titolo-sezione">I nostri <em>corsi</em></h2>
                <p class="corsi-intro intro-sezione">Scopri i percorsi di danza pensati per ogni età e livello. Dalla tecnica classica alle discipline contemporanee e urbane.</p>
            </div>

            <div class="corsi-griglia">
                {categorieCorsi.map((cat, i) => (
                    <article class="corso-card voce" aria-labelledby={`home-${cat.id}`}>
                        <span class="voce-anno" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        <h3 class="voce-titolo" id={`home-${cat.id}`}>{cat.nome}</h3>
                        <p class="voce-testo" set:html={cat.descrizione} />
                        <ul class="corso-link">
                            {cat.corsi.map((c) => (
                                <li><a href={c.url}><span>{c.nome.replace(/ \((.+)\)$/, '')}{c.nome.endsWith(')') && <> <span class="corso-eta">{c.nome.slice(c.nome.lastIndexOf('('))}</span></>}</span><i class="fas fa-arrow-right" aria-hidden="true"></i></a></li>
                            ))}
                        </ul>
                    </article>
                ))}
            </div>

            <div class="corsi-cta">
                <p class="corsi-cta-text">Non sai quale corso scegliere? <span>Ti aiutiamo a trovare quello giusto.</span></p>
                <div class="corsi-cta-azioni">
                    <a href="/contatti" class="btn-primary">
                        <span>Parliamone insieme</span>
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <a href="/corsi" class="link-cta">
                        Tutti i corsi
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Chi Siamo Section -->
    <section id="chi-siamo" class="chi-siamo-section">
        <div class="container">
            <div class="story-layout">
                <div class="story-content">
                    <div class="section-header chi-siamo-header">
                        <p class="section-tagline eyebrow">Dal {FONDAZIONE} a Lainate e Rho</p>
                        <h2 class="section-title titolo-sezione">La nostra <em>storia</em></h2>
                    </div>

                    <div class="story-text">
                        <p class="story-lead">I.N. Ballet è una scuola di danza multidisciplinare a Lainate e Rho, nata nel {FONDAZIONE} da {scuola.fondatrice}: un luogo di vita dedicato alla conoscenza e all'esplorazione dei diversi stili di danza, nelle loro sfumature tecniche e artistiche.</p>

                        <p>Accoglie bambini dai 3 anni e allievi di tutte le età, con gruppi di diversi livelli fino ai corsi avanzati e per adulti. È ente formativo CSEN e CONI per la formazione dei maestri di danza e propone corsi per professionisti dell'ambito educativo e terapeutico.</p>

                        <p>L'inclusione è centrale per tutte le fasce d'età: dal 2013 il <a href="/progetto-noiconvoi">progetto NoiConVoi</a> accoglie ragazzi con disabilità in esperienze di danza con supporto psicomotorio, insieme a un team di volontari.</p>
                    </div>

                    <blockquote class="story-quote">
                        <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                        <cite>{scuola.fondatrice}, fondatrice</cite>
                    </blockquote>

                    <a href="/chi-siamo" class="link-cta story-cta">
                        Scopri chi siamo
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                <div class="story-image">
                    <div class="foto-cornice">
                        <Img src="ballerina.jpg" alt="Allievi e insegnanti InBallet sul palco per il saluto finale dello spettacolo" width="640" height="480" loading="lazy" decoding="async" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 640px" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sezione Formazione Professionale -->
    <section class="formazione-professionale-section">
        <div class="formazione-wrapper">
            <div class="formazione-intro">
                <span class="eyebrow">Ente Formativo CSEN e CONI</span>
                <h2 class="titolo-sezione">Formazione <em>professionale</em></h2>
                <p class="intro-sezione">Oltre ai corsi, formiamo chi insegna danza e chi lavora in ambito educativo: percorsi riconosciuti e formazioni costruite su misura.</p>
            </div>

            <!-- Percorsi: righe intere cliccabili, separate da filetti -->
            <ul class="percorsi-lista">
                <li>
                    <a href="/formazione-insegnanti" class="percorso">
                        <span class="percorso-tipo">Percorso biennale</span>
                        <h3 class="percorso-titolo">Formazione Insegnanti di Danza</h3>
                        <p class="percorso-testo">Due anni in danza Modern con formazione su tecnica, pedagogia e inclusione.</p>
                        <p class="percorso-dettagli">Titolo riconosciuto CSEN e CONI · 6 master specialistici opzionali</p>
                        <span class="percorso-cta" aria-hidden="true">Scopri il corso <i class="fas fa-arrow-right"></i></span>
                        <i class="fas fa-arrow-right percorso-freccia" aria-hidden="true"></i>
                    </a>
                </li>
                <li>
                    <a href="/formazioni-personalizzate" class="percorso">
                        <span class="percorso-tipo">Su misura</span>
                        <h3 class="percorso-titolo">Formazioni Personalizzate</h3>
                        <p class="percorso-testo">Workshop tematici e percorsi costruiti per insegnanti, scuole ed enti.</p>
                        <p class="percorso-dettagli">Workshop e masterclass · Formazione per scuole ed enti</p>
                        <span class="percorso-cta" aria-hidden="true">Scopri di più <i class="fas fa-arrow-right"></i></span>
                        <i class="fas fa-arrow-right percorso-freccia" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </div>
    </section>

     <section class="dicono-di-noi-section" aria-labelledby="recensioni-titolo">
        <div class="container recensioni-layout">
            <div class="recensioni-intro">
                <p class="eyebrow">Le voci della nostra community</p>
                <h2 class="titolo-sezione" id="recensioni-titolo">Dicono <em>di noi</em></h2>
                <p class="intro-sezione">L'esperienza di chi ha scelto InBallet per crescere attraverso la danza. Recensioni autentiche dai nostri allievi e famiglie.</p>
            </div>

            <!-- Valutazione media (compilata da home.ts) e link a tutte le recensioni -->
            <div class="recensioni-sintesi">
                <div class="sintesi-google" id="googleStatsCard" hidden></div>
                <a href="https://www.google.com/search?sa=X&sca_esv=ccb8066356fd07b7&tbm=lcl&sxsrf=AE3TifONsbUe8wj4bCgnW_SAO2k4jfCpMg:1750798486383&q=I.N.+Ballet+Recensioni&rflfq=1&num=20&stick=H4sIAAAAAAAAAONgkxI2NDG1NDU3sDAHMowtDSwMLcw3MDK-YhTz1PPTU3BKzMlJLVEISk1OzSvOzM_LXMSKQwIA6ENBIkwAAAA&rldimm=1459570871453908187&hl=it-IT&ved=2ahUKEwiGturO-IqOAxUihP0HHdBWAj4Q9fQKegQIUhAF&biw=1920&bih=945&dpr=1#lkt=LocalPoiReviews"
                   target="_blank"
                   rel="noopener"
                   class="link-cta">
                    Tutte le recensioni su Google
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            <!-- Recensioni: una alla volta, frecce e indicatori sotto -->
            <div class="recensioni-carousel testimonials-carousel">
                <div class="testimonials-track" id="reviewsContainer" aria-live="polite">
                    <div class="testimonials-slide active">
                        <p class="recensioni-messaggio">Caricamento recensioni…</p>
                    </div>
                </div>

                <div class="recensioni-controlli" id="reviewsControls" hidden>
                    <button type="button" class="recensioni-nav" id="prevBtn" aria-label="Recensione precedente">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <div class="carousel-indicators" id="indicatorsContainer"></div>
                    <button type="button" class="recensioni-nav" id="nextBtn" aria-label="Recensione successiva">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

     <!-- Sezione Progetti Sul Territorio -->
    <section class="altri-servizi-section sezione-scura">
        <div class="altri-servizi-bg" style={`background-image: url('${progettiBg}')`}></div>
        <div class="altri-servizi-overlay"></div>

        <div class="intro-editoriale progetti-intro">
            <span class="eyebrow">La danza fuori dalla sala</span>
            <h2 class="titolo-sezione">Progetti <em>sul territorio</em></h2>
            <p class="intro-sezione">Portiamo la danza nelle scuole, nelle comunità e accanto a chi ha bisogno: spettacoli aperti al territorio, progetti educativi e, dal 2013, percorsi di inclusione con il progetto NoiConVoi e un team di volontari.</p>
        </div>

        <div class="progetti-gruppi">
            {progetti.map((g) => (
                <div class="progetti-gruppo">
                    <h3 class="progetti-gruppo-titolo">{g.titolo}</h3>
                    <ul class="progetti-lista">
                        {g.voci.map((v) => (
                            <li>
                                <a href={v.href}>
                                    <span class="progetto-nome">{v.nome}</span>
                                    <span class="progetto-testo">{v.testo}</span>
                                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </section>

    <!-- Sezione Galleria Infinita -->
    <section class="gallery-section">
        <div class="container">
            <div class="gallery-header">
                <p class="gallery-tagline eyebrow">I nostri momenti</p>
                <h2 class="gallery-title titolo-sezione">Emozioni <em>in movimento</em></h2>
                <p class="gallery-description intro-sezione">Lezioni, spettacoli e dietro le quinte: l'energia dei nostri allievi. Apri una foto per vederla a tutto schermo.</p>
            </div>
        </div>

        <!-- Due serie identiche: la seconda serve solo alla continuità dello scorrimento
             ed è nascosta a tastiera e screen reader -->
        <div class="gallery-infinite">
            <div class="gallery-track" id="galleryTrack">
                {[0, 1].map((set) =>
                    gallery.map((img, i) => (
                        <div class="gallery-item" aria-hidden={set === 1 ? 'true' : undefined}>
                            <button type="button" class="gallery-apri" data-index={i} data-full={img.full} data-alt={img.alt} aria-label={`Ingrandisci: ${img.alt}`} tabindex={set === 1 ? -1 : undefined}>
                                <Img src={img.file} alt="" width="300" height="420" loading="lazy" decoding="async" widths={[300, 600]} sizes="300px" />
                                <span class="gallery-zoom-icon" aria-hidden="true"><i class="fas fa-expand"></i></span>
                            </button>
                        </div>
                    ))
                )}
            </div>
        </div>
    </section>

    <!-- Sezione Sostenitori -->
    <SostenitoriSection />

    <!-- Domande frequenti -->
    <section class="faq-section" aria-labelledby="faq-titolo">
        <div class="container faq-layout">
            <div class="faq-intro">
                <p class="faq-label eyebrow">Domande frequenti</p>
                <h2 class="faq-title titolo-sezione" id="faq-titolo">Tutto quello che <em>vuoi sapere</em></h2>
                <p class="faq-text intro-sezione">Non trovi la risposta? Scrivici o chiamaci, ti rispondiamo noi.</p>
                <ul class="faq-contatti">
                    <li><a href={`mailto:${scuola.email}`}><i class="fas fa-envelope" aria-hidden="true"></i>{scuola.email}</a></li>
                    <li><a href={scuola.telefonoHref}><i class="fas fa-phone" aria-hidden="true"></i>{scuola.telefono}</a></li>
                </ul>
            </div>
            <div class="faq-list">
                {faq.map((f, i) => (
                    <details class="faq-item" name="faq" open={i === 0}>
                        <summary>{f.domanda}</summary>
                        <p>{f.risposta}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <!-- Lightbox galleria: dialog nativo (focus intrappolato, Esc, sfondo inerte) -->
    <dialog class="galleria-dialog" id="lightbox" aria-label="Galleria fotografica">
        <button type="button" class="galleria-chiudi" id="lightbox-close" aria-label="Chiudi galleria">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <figure class="galleria-figura">
            <img class="galleria-foto" id="lightbox-image" src="data:," alt="">
            <figcaption class="galleria-didascalia">
                <span id="lightbox-caption"></span>
                <span class="galleria-contatore" id="lightbox-counter" aria-live="polite"></span>
            </figcaption>
        </figure>
        <button type="button" class="galleria-nav galleria-prev" id="lightbox-prev" aria-label="Foto precedente">
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="galleria-nav galleria-next" id="lightbox-next" aria-label="Foto successiva">
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
    </dialog>

    <Fragment slot="scripts">
        <script>
            import '../scripts/home';
        </script>
    </Fragment>
</Base>

<style>.hero {
  height: 72vh;
  min-height: 560px;
  max-height: 800px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  z-index: 1;
  padding: var(--header-h) 0 4.5rem;
}

.hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: center/cover no-repeat;
  z-index: 1;
  content-visibility: auto;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to top, rgba(15,15,15,.85) 0%, rgba(15,15,15,.45) 55%, rgba(15,15,15,.2) 100%);
  z-index: 2;
}

.hero-content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  color: var(--white);
  text-align: left;
  animation: fadeInUp 1s ease-out;
}

.hero-badge {
  display: block;
  font-size: .875rem;
  font-weight: 600;
  margin-bottom: 1.25rem;
  color: var(--primary-blue);
  text-transform: uppercase;
  letter-spacing: 2px;
}

.hero :global(h1) {
  text-wrap: balance;
  font-size: var(--text-6xl);
  font-weight: 700;
  line-height: 1.05;
  margin-bottom: 1.25rem;
  color: var(--white);
  letter-spacing: -.02em;
  max-width: 14ch;
}

.hero-subtitle {
  font-size: var(--text-xl);
  margin-bottom: 2.25rem;
  color: rgba(255,255,255,.88);
  font-weight: 300;
  line-height: 1.55;
  max-width: 38rem;
}

.hero-cta {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.chi-siamo-section,
.gallery-section {
  background: #fff;
  position: relative;
}

.chi-siamo-section {
  padding: var(--section-y) 0;
}

.gallery-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.section-header {
  margin-bottom: 2.5rem;
}

.chi-siamo-section {
  position: relative;
}

.chi-siamo-header {
  text-align: left;
  margin-bottom: 2.25rem;
}

/* Testo a sinistra, foto orizzontale (saluto finale di gruppo) più larga a destra */
.story-layout {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  gap: 5rem;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
}

.story-text {
  max-width: 34rem;
}

.story-text :global(p) {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 1.25rem;
}

.story-text :global(p:last-child) {
  margin-bottom: 0;
}

.story-text :global(p.story-lead) {
  font-size: var(--text-xl);
  line-height: 1.6;
  color: var(--dark-navy);
}

.story-quote {
  max-width: 34rem;
  margin: 2.25rem 0 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.story-quote p {
  font-size: var(--text-lg);
  font-style: italic;
  line-height: 1.6;
  color: var(--dark-navy);
}

.story-quote cite {
  display: block;
  margin-top: .5rem;
  font-size: var(--text-sm);
  font-style: normal;
  font-weight: 600;
  letter-spacing: .5px;
  color: var(--text-light);
}

.story-quote cite::before {
  content: '— ';
}

.story-cta {
  margin-top: 2.25rem;
}

/* Spazio per la cornice sfalsata (in basso a sinistra) dentro la colonna */
.story-image {
  padding: 0 0 1.5rem 1.5rem;
}

.story-image :global(img) {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  object-position: 55% center;
}

@media (max-width: 600px) {
  .story-image {
    padding: 0 0 .75rem .75rem;
  }
}

.corsi-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
  overflow: hidden;
}

.corsi-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corsi-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corsi-wrapper {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

.corsi-header {
  text-align: center;
  margin-bottom: 4rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.corsi-label {
  display: block;
  margin-bottom: 1.5rem;
}

.corsi-title {
  margin-bottom: 1.5rem;
}

.corsi-intro {
  max-width: 600px;
  margin: 0 auto;
}

/* Percorsi in griglia: 3 + 2 su desktop (le ultime due più larghe, nessun buco),
   2 per riga su tablet, 1 su mobile */
.corsi-griglia {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 3.5rem 3rem;
  max-width: 1200px;
  margin: 0 auto 4.5rem;
}

.corso-card {
  grid-column: span 2;
  display: flex;
  flex-direction: column;
}

.corso-card:nth-child(n + 4) {
  grid-column: span 3;
}

.corso-card .voce-testo :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

/* Corsi come pillole: si riconoscono come cliccabili e vanno a capo da sole */
.corso-link {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
  margin: 1.5rem 0 0;
  padding: 0;
}

.corso-link a {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  min-height: 40px;
  padding: .5rem 1rem;
  border: 1px solid rgba(70, 130, 180, 0.35);
  border-radius: 999px;
  background: var(--white);
  color: var(--dark-navy);
  font-size: .9375rem;
  font-weight: 500;
  line-height: 1.25;
  text-decoration: none;
  transition: background-color .25s ease, border-color .25s ease, color .25s ease;
}

.corso-link a i {
  flex-shrink: 0;
  font-size: .6875rem;
  color: var(--primary-blue-dark);
  transition: transform .25s ease, color .25s ease;
}

.corso-link a:hover {
  background: var(--primary-blue);
  border-color: var(--primary-blue);
}

.corso-link a:hover i {
  color: var(--dark-navy);
  transform: translateX(3px);
}

.corso-eta {
  white-space: nowrap;
}

.corsi-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  padding-top: 2.5rem;
  border-top: 1px solid rgba(26, 26, 26, 0.1);
}

.corsi-cta-text {
  font-size: var(--text-xl);
  color: var(--dark-navy);
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: var(--leading-snug);
  margin: 0;
}

.corsi-cta-text span {
  display: block;
  margin-top: .35rem;
  font-size: 1.0625rem;
  font-weight: 400;
  letter-spacing: 0;
  color: var(--text-light);
}

.corsi-cta-azioni {
  display: flex;
  align-items: center;
  gap: 2rem;
  flex-shrink: 0;
}

@media (max-width: 1024px) {
  .corsi-griglia {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 2.5rem;
  }

  .corso-card,
  .corso-card:nth-child(n + 4) {
    grid-column: span 1;
  }

  /* Numero dispari: l'ultima card prende tutta la riga */
  .corso-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .corsi-cta {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 600px) {
  .corsi-griglia {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.75rem;
    margin-bottom: 3rem;
  }

  .corsi-cta {
    padding-top: 0;
    border-top: none;
  }

  .corso-card .voce-anno {
    font-size: var(--text-2xl);
  }

  .corsi-wrapper {
    padding: 0 1.5rem;
  }

  .corsi-cta-azioni {
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
  }

  .corsi-cta-azioni .btn-primary {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .corso-link {
    margin-top: 1.25rem;
  }

  .corso-link a {
    padding: .45rem .9rem;
    font-size: .875rem;
  }
}

/* Formazione: fondo azzurrino, intro a sinistra e percorsi come elenco a destra */
.formazione-professionale-section {
  position: relative;
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.formazione-wrapper {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: start;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.formazione-intro .titolo-sezione {
  margin-bottom: 1.5rem;
}

.percorsi-lista {
  list-style: none;
  border-top: 1px solid rgba(26, 26, 26, 0.12);
}

.percorsi-lista li {
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

/* Tutta la riga è il link; la freccia sta a destra, centrata */
.percorso {
  position: relative;
  display: block;
  padding: 2rem 4rem 2rem 0;
  color: inherit;
  text-decoration: none;
}

.percorso-tipo {
  display: block;
  margin-bottom: .5rem;
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
}

.percorso-titolo {
  margin: 0 0 .6rem;
  font-size: var(--text-2xl);
  font-weight: 700;
  line-height: var(--leading-snug);
  letter-spacing: -0.01em;
  color: var(--dark-navy);
  transition: color .3s ease;
}

.percorso-testo {
  margin: 0;
  font-size: 1.0625rem;
  line-height: 1.7;
  color: var(--text-light);
}

.percorso-dettagli {
  margin: .75rem 0 0;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--dark-navy);
}

.percorso-freccia {
  position: absolute;
  top: 50%;
  right: 0;
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  margin-top: -1.375rem;
  border: 1px solid rgba(26, 26, 26, 0.2);
  border-radius: 50%;
  font-size: .875rem;
  color: var(--primary-blue-dark);
  transition: background-color .3s ease, border-color .3s ease, color .3s ease, transform .3s ease;
}

/* Hover solo con mouse: sul touch resterebbe attivo dopo il tocco */
@media (hover: hover) and (pointer: fine) {
  .percorso:hover .percorso-titolo {
    color: var(--primary-blue-dark);
  }

  .percorso:hover .percorso-freccia {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
    color: var(--dark-navy);
    transform: translateX(4px);
  }
}

@media (max-width: 1024px) {
  .formazione-wrapper {
    gap: 3.5rem;
  }
}

@media (max-width: 900px) {
  .formazione-wrapper {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding: 0 1.5rem;
  }
}

/* Etichetta testuale al posto della freccia tonda: solo su mobile */
.percorso-cta {
  display: none;
}

/* Mobile: niente freccia laterale, il testo usa tutta la larghezza e sotto c'è "Scopri" */
@media (max-width: 600px) {
  .percorso {
    padding: 1.75rem 0;
  }

  .percorso-freccia {
    display: none;
  }

  .percorso-cta {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-top: 1rem;
    padding-bottom: .3rem;
    border-bottom: 2px solid var(--primary-blue);
    font-size: .8125rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--dark-navy);
  }

  .percorso-cta i {
    font-size: .75rem;
    color: var(--primary-blue-dark);
  }
}

/* ---------- Dicono di noi: intro e sintesi a sinistra, una recensione alla volta a destra ---------- */
.dicono-di-noi-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.recensioni-layout {
  display: grid;
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  grid-template-areas:
    "intro carosello"
    "sintesi carosello";
  grid-template-rows: auto 1fr;
  gap: 2.5rem 5rem;
}

.recensioni-intro {
  grid-area: intro;
}

.recensioni-intro .titolo-sezione {
  margin-bottom: 1.5rem;
}

.recensioni-sintesi {
  grid-area: sintesi;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.75rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(26, 26, 26, 0.12);
}

.sintesi-google {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-areas:
    "voto stelle"
    "voto totale";
  column-gap: 1rem;
  align-items: center;
}

.sintesi-google[hidden] {
  display: none;
}

.sintesi-google :global(.sintesi-voto) {
  grid-area: voto;
  font-size: 3.25rem;
  font-weight: 300;
  line-height: 1;
  color: var(--dark-navy);
}

.sintesi-google :global(.sintesi-stelle) {
  grid-area: stelle;
  align-self: end;
  font-size: .875rem;
  color: #f5b301;
  letter-spacing: 2px;
}

.sintesi-google :global(.sintesi-totale) {
  grid-area: totale;
  align-self: start;
  font-size: var(--text-sm);
  color: var(--text-light);
}

/* Recensione come citazione libera, senza card */
.recensioni-carousel {
  grid-area: carosello;
  align-self: center;
}

.testimonials-track {
  position: relative;
}

:global(.testimonials-slide) {
  display: none;
  margin: 0;
  opacity: 0;
  transition: opacity .35s ease, transform .35s ease;
}

:global(.testimonials-slide.active) {
  display: block;
  opacity: 1;
}

.recensioni-carousel :global(.recensione-stelle) {
  margin-bottom: 1.25rem;
  font-size: .875rem;
  color: #f5b301;
  letter-spacing: 2px;
}

.recensioni-carousel :global(.recensione-stelle .far),
.sintesi-google :global(.sintesi-stelle .far) {
  color: rgba(26, 26, 26, 0.15);
}

.recensioni-carousel :global(.recensione-testo) {
  position: relative;
  margin: 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.recensioni-carousel :global(.recensione-testo p) {
  font-size: clamp(1.125rem, 1rem + .4vw, 1.375rem);
  line-height: 1.6;
  color: var(--dark-navy);
}

.recensioni-carousel :global(.review-text) {
  transition: opacity .15s ease;
}

.recensioni-carousel :global(.read-more-btn) {
  margin-left: .35rem;
  padding: 0 0 1px;
  border: none;
  border-bottom: 1px solid var(--primary-blue);
  background: none;
  font: inherit;
  font-size: .9375rem;
  font-weight: 600;
  color: var(--primary-blue-dark);
  cursor: pointer;
}

.recensioni-carousel :global(.recensione-autore) {
  display: flex;
  align-items: center;
  gap: .9rem;
  margin-top: 1.75rem;
  padding-left: 1.5rem;
}

.recensioni-carousel :global(.author-avatar) {
  display: grid;
  place-items: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background: var(--bg-soft);
  font-size: .8125rem;
  font-weight: 700;
  color: var(--primary-blue-dark);
}

.recensioni-carousel :global(.recensione-autore strong) {
  display: block;
  font-weight: 600;
  color: var(--dark-navy);
}

.recensioni-carousel :global(.recensione-fonte) {
  display: block;
  font-size: var(--text-sm);
  color: var(--text-light);
}

.recensioni-carousel :global(.recensioni-messaggio) {
  font-size: 1.0625rem;
  color: var(--text-light);
}

.recensioni-controlli {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-top: 2.5rem;
  padding-left: 1.5rem;
}

.recensioni-controlli[hidden] {
  display: none;
}

.recensioni-nav {
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  border: 1px solid rgba(26, 26, 26, 0.2);
  border-radius: 50%;
  background: transparent;
  font-size: .8125rem;
  color: var(--primary-blue-dark);
  cursor: pointer;
  transition: background-color .3s ease, border-color .3s ease, color .3s ease;
}

.recensioni-nav:hover {
  background: var(--primary-blue);
  border-color: var(--primary-blue);
  color: var(--dark-navy);
}

.carousel-indicators {
  display: flex;
  align-items: center;
  gap: .5rem;
}

.carousel-indicators :global(.indicator) {
  width: .5rem;
  height: .5rem;
  padding: 0;
  border: none;
  border-radius: 999px;
  background: rgba(26, 26, 26, 0.15);
  cursor: pointer;
  transition: width .3s ease, background-color .3s ease;
}

.carousel-indicators :global(.indicator.active) {
  width: 1.5rem;
  background: var(--primary-blue-dark);
}

/* Una colonna: intro, valutazione Google (prova di fiducia subito visibile),
   recensione e per ultimo il link a tutte le recensioni */
@media (max-width: 900px) {
  .recensioni-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .recensioni-sintesi {
    display: contents;
  }

  .recensioni-intro {
    order: 1;
  }

  .sintesi-google {
    order: 2;
  }

  /* Frecce e pallini sopra la recensione: restano fermi senza riservare
     l'altezza della recensione più lunga (che su schermi stretti lascia un buco) */
  .recensioni-carousel {
    order: 3;
    display: flex;
    flex-direction: column;
    margin-top: .5rem;
  }

  .recensioni-controlli {
    order: -1;
    margin: 0 0 1.5rem;
    padding-left: 0;
  }

  .testimonials-track {
    min-height: 0 !important;
  }

  .recensioni-sintesi .link-cta {
    order: 4;
    align-self: flex-start;
  }
}

@media (max-width: 600px) {
  .recensioni-carousel :global(.recensione-testo),
  .recensioni-carousel :global(.recensione-autore) {
    padding-left: 1.1rem;
  }

  .sintesi-google :global(.sintesi-voto) {
    font-size: 2.75rem;
  }
}

.gallery-section {
  padding: var(--section-y) 0;
  overflow: hidden;
}

.gallery-header {
  text-align: center;
  margin-bottom: 3rem;
  position: relative;
  z-index: 2;
}

/* Mobile: allineata a sinistra come le altre sezioni, più leggibile */
@media (max-width: 600px) {
  .gallery-header {
    text-align: left;
    margin-bottom: 2rem;
  }

  .gallery-description {
    margin: 0;
  }
}

.gallery-tagline {
  margin-bottom: 1.5rem;
}

.gallery-title {
  margin-bottom: 1.5rem;
}

.gallery-description {
  max-width: 700px;
  margin: 0 auto;
}

/* ---------- Galleria a scorrimento continuo ---------- */
/* Due serie identiche di foto: la traslazione del 50% riporta all'inizio senza salti,
   qualunque sia la larghezza delle foto */
.gallery-infinite {
  overflow: hidden;
  -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
  mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
}

.gallery-track {
  display: flex;
  width: max-content;
  animation: galleria-scorri 80s linear infinite;
}

/* Pausa solo con focus da tastiera (non dopo un clic o la chiusura della lightbox)
   e con hover di un mouse vero: sul touch l'hover resterebbe attivo dopo il tocco */
.gallery-track:has(:focus-visible),
.gallery-track.paused {
  animation-play-state: paused;
}

@media (hover: hover) and (pointer: fine) {
  .gallery-infinite:hover .gallery-track {
    animation-play-state: paused;
  }
}

@keyframes galleria-scorri {
  to {
    transform: translateX(-50%);
  }
}

.gallery-item {
  flex: 0 0 auto;
  width: 300px;
  height: 420px;
  margin-right: 8px;
}

.gallery-apri {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  padding: 0;
  border: none;
  border-radius: 12px;
  overflow: hidden;
  background: var(--bg-soft);
  cursor: zoom-in;
}

.gallery-apri :global(img) {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease, filter .3s ease;
}

.gallery-apri:focus-visible {
  outline-offset: -3px;
}

/* Icona ingrandisci: compare al passaggio del mouse o col focus da tastiera */
.gallery-zoom-icon {
  position: absolute;
  right: .9rem;
  bottom: .9rem;
  display: grid;
  place-items: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  font-size: .875rem;
  color: var(--dark-navy);
  opacity: 0;
  transform: translateY(6px);
  transition: opacity .3s ease, transform .3s ease;
}

.gallery-apri:hover :global(img),
.gallery-apri:focus-visible :global(img) {
  transform: scale(1.04);
  filter: brightness(.88);
}

.gallery-apri:hover .gallery-zoom-icon,
.gallery-apri:focus-visible .gallery-zoom-icon {
  opacity: 1;
  transform: none;
}

/* Telefono e tablet (touch): niente animazione CSS, la fila si trascina col dito e
   scorre da sola via script (home.ts). Su PC resta l'animazione CSS */
@media (hover: none), (pointer: coarse) {
  .gallery-infinite {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .gallery-infinite::-webkit-scrollbar {
    display: none;
  }

  .gallery-track {
    animation: none;
  }
}

/* Movimento ridotto: niente scorrimento automatico, solo a mano, senza copie */
@media (prefers-reduced-motion: reduce) {
  .gallery-infinite {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.5rem;
    scrollbar-width: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .gallery-track {
    animation: none;
    padding: 0 1.5rem;
  }

  .gallery-item {
    scroll-snap-align: start;
  }

  .gallery-item[aria-hidden="true"] {
    display: none;
  }
}

@media (max-width: 1024px) {
  .gallery-item {
    width: 280px;
    height: 380px;
  }

  .gallery-zoom-icon {
    display: none;
  }
}

@media (max-width: 768px) {
  .gallery-track {
    animation-duration: 70s;
  }

  .gallery-item {
    width: min(44vw, 240px);
    height: 340px;
  }
}

@media (max-width: 480px) {
  .gallery-track {
    animation-duration: 60s;
  }

  .gallery-item {
    height: 300px;
  }
}

/* ---------- Lightbox: dialog a tutto schermo ---------- */
:global(html.galleria-aperta) {
  overflow: hidden;
}

.galleria-dialog {
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 4.5rem 6rem 2rem;
  border: none;
  background: rgba(12, 12, 12, 0.96);
  color: var(--white);
}

.galleria-dialog[open] {
  display: grid;
  place-items: center;
  animation: galleria-entra .25s ease;
}

.galleria-dialog::backdrop {
  background: transparent;
}

@keyframes galleria-entra {
  from {
    opacity: 0;
  }
}

/* La figura è larga quanto la foto; la didascalia non la allarga */
.galleria-figura {
  display: grid;
  justify-items: start;
  width: fit-content;
  max-width: 100%;
  margin: 0;
}

.galleria-foto {
  display: block;
  max-width: 100%;
  max-height: calc(100dvh - 10rem);
  width: auto;
  height: auto;
  border-radius: 8px;
  transition: opacity .25s ease;
}

.galleria-foto.in-caricamento {
  opacity: 0;
}

.galleria-didascalia {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1.5rem;
  width: 0;
  min-width: 100%;
  margin-top: 1rem;
  font-size: .9375rem;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.78);
}

.galleria-contatore {
  flex-shrink: 0;
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: 1px;
  color: rgba(255, 255, 255, 0.6);
}

.galleria-chiudi,
.galleria-nav {
  position: fixed;
  display: grid;
  place-items: center;
  width: 3rem;
  height: 3rem;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  background: transparent;
  color: var(--white);
  font-size: 1rem;
  cursor: pointer;
  transition: background-color .3s ease, border-color .3s ease, color .3s ease;
}

.galleria-chiudi {
  top: 1.25rem;
  right: 1.25rem;
  font-size: 1.125rem;
}

.galleria-nav {
  top: 50%;
  margin-top: -1.5rem;
}

.galleria-prev {
  left: 1.5rem;
}

.galleria-next {
  right: 1.5rem;
}

.galleria-chiudi:hover,
.galleria-nav:hover {
  background: var(--white);
  border-color: var(--white);
  color: var(--dark-navy);
}

/* Su schermi stretti le frecce scendono in basso, la foto usa tutta la larghezza */
@media (max-width: 768px) {
  .galleria-dialog {
    padding: 4.5rem 1rem 6rem;
  }

