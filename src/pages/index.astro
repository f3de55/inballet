---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SostenitoriSection from '../components/SostenitoriSection.astro';
import Galleria from '../components/Galleria.astro';
import { getImage } from 'astro:assets';
import { ANNI_ATTIVITA, categorieCorsi, faqHome, FONDAZIONE, scuola } from '../data/scuola';
import { getAsset, sfondo } from '../lib/images';
import { schemaHome } from '../lib/schema';
import { enfatizza } from '../lib/text';
import { PUBLIC_GOOGLE_PLACE_ID } from 'astro:env/client';

// Video dell'hero (ricodificati da src/assets/video/hero-video-inballet.mp4, senza audio):
// AV1 per i browser che lo supportano, H.264 per gli altri; 1080p solo sugli schermi larghi
import heroAv1Lg from '../assets/video/hero-1080.webm?url';
import heroMp4Lg from '../assets/video/hero-1080.mp4?url';
import heroAv1 from '../assets/video/hero-720.webm?url';
import heroMp4 from '../assets/video/hero-720.mp4?url';

// Corsi: i quattro stili come indice (il dettaglio dei corsi, anche per età, è su /corsi)
const stili = categorieCorsi.filter((c) => c.id !== 'eta');
const totaleCorsi = categorieCorsi.reduce((n, cat) => n + cat.corsi.length, 0);

// Formazione e progetti: tre gruppi di pagine (icona del gruppo, icona e riga di descrizione per ogni voce)
const oltre = [
  { titolo: 'Formazione', icona: 'fa-graduation-cap', foto: 'gallery-4.jpg', alt: 'Insegnante di danza con le allieve in sala', fuoco: { desktop: '50% 25%' }, voci: [
    { nome: 'Formazione Insegnanti di Danza', testo: 'Biennale, titolo nazionale CSEN e CONI', icona: 'fa-graduation-cap', href: '/formazione-insegnanti' },
    { nome: 'Formazioni Personalizzate', testo: 'Workshop per educatori e terapeuti', icona: 'fa-chalkboard-user', href: '/formazioni-personalizzate' },
  ] },
  { titolo: 'Territorio', icona: 'fa-masks-theater', foto: 'bg-progetti-territorio.jpg', alt: 'Danzatori in sala durante un progetto sul territorio', fuoco: { desktop: '50% 35%' }, voci: [
    { nome: 'Spettacoli ed Eventi', testo: 'Spettacoli, saggi e workshop', icona: 'fa-masks-theater', href: '/spettacoli-eventi' },
    { nome: 'Collaborazioni con le Scuole', testo: 'Danza a scuola, dal nido alle superiori', icona: 'fa-school', href: '/collaborazioni-scuole' },
    { nome: 'Sportello Psicologico', testo: 'Ascolto per famiglie e bambini', icona: 'fa-comments', href: '/sportello-psicologico' },
  ] },
  { titolo: 'Inclusione', icona: 'fa-heart', foto: 'gallery-8.jpg', alt: "Un'allieva abbracciata alla sua insegnante in sala", fuoco: { desktop: '50% 40%' }, voci: [
    { nome: 'Progetto NoiConVoi', testo: 'Danza per ragazzi con disabilità', icona: 'fa-heart', href: '/progetto-noiconvoi' },
    { nome: 'Classi Integrate', testo: 'Corsi aperti ai bisogni speciali', icona: 'fa-universal-access', href: '/classi-integrate' },
  ] },
];

// Sfondi responsive: foto e punto focale per desktop, tablet e mobile.
// Nell'hero è il primo fotogramma del video: si vede finché il video non parte
// (e resta da sola con "riduci movimento" o risparmio dati)
const hero = await sfondo('hero-video-poster.jpg');

// Dati strutturati (immagine social 1200x630)
const socialImage = new URL((await getImage({ src: getAsset('gallery-3.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href;
const schema = schemaHome(socialImage);

---

<Base
    title="Scuola di Danza a Lainate e Rho | InBallet"
    description={`Scuola di danza a Lainate e Rho (MI) dal ${FONDAZIONE}: classica, modern, contemporanea, hip-hop, yoga e pilates per bambini dai 3 anni, ragazzi e adulti.`}
    ogTitle="InBallet - Scuola di Danza a Lainate e Rho"
    ogDescription={`Corsi di danza per bambini dai 3 anni, ragazzi e adulti a Lainate e Rho, dal ${FONDAZIONE}. Inclusione e formazione insegnanti CSEN e CONI.`}
    ogImage={socialImage}
    skipLinkId="skip-link"
>
    <Fragment slot="head">
        {hero.preload.map((p) => <link rel="preload" as="image" href={p.href} media={p.media} fetchpriority="high">)}
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </Fragment>


    <!-- Hero Section Personalizzata -->
    <section class="hero">
        <div class="hero-image" style={hero.style}></div>

        <!-- Decorativo: parte da hero-video.ts (mai con "riduci movimento" o risparmio dati) -->
        <video class="hero-video" muted loop playsinline preload="none" disablepictureinpicture disableRemotePlayback aria-hidden="true" tabindex="-1">
            <source src={heroAv1Lg} type='video/webm; codecs="av01.0.08M.08"' media="(min-width: 1281px)">
            <source src={heroMp4Lg} type='video/mp4; codecs="avc1.640032"' media="(min-width: 1281px)">
            <source src={heroAv1} type='video/webm; codecs="av01.0.05M.08"'>
            <source src={heroMp4} type='video/mp4; codecs="avc1.64001F"'>
        </video>

        <div class="hero-overlay"></div>

        <div class="hero-content">
            <p class="hero-badge">InBallet ASD · {ANNI_ATTIVITA} anni di danza</p>

            <h1>Scuola di Danza a Lainate e Rho</h1>

            <p class="hero-subtitle">
                Corsi di danza <strong>dai 3 anni agli adulti</strong>, anche per <strong>principianti</strong>.
            </p>

            <div class="hero-cta">
                <a href="/corsi" class="btn-primary">
                    <span>Scopri i corsi</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/contatti" class="btn-secondary">
                    <span>Contattaci</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Sezione Corsi -->
    <section id="corsi" class="corsi-section decoro-onde decoro-onde--sinistra">
        <div class="corsi-wrapper">
            <!-- Header -->
            <div class="corsi-header">
                <span class="corsi-label eyebrow">Corsi di danza a Lainate e Rho</span>
                <h2 class="corsi-title titolo-sezione">I nostri <em>corsi</em></h2>
                <p class="corsi-intro intro-sezione"><strong>Dai 3 anni all'età adulta</strong>, dalla danza classica all'hip-hop fino a yoga e pilates: scegli <strong>lo stile che fa per te</strong>.</p>
            </div>

            <!-- Quattro stili: foto, nome e una frase, senza riquadri. Tutto il blocco è il link -->
            <ol class="corsi-indice">
                {stili.map((cat) => (
                    <li>
                        <a href={`/corsi#${cat.id}`} class="corsi-stile">
                            <span class="corsi-stile-foto">
                                <Img src={cat.immagine.src} alt={cat.immagine.alt} fuoco={cat.immagine.fuoco} loading="lazy" decoding="async" widths={[240, 400, 640]} sizes="(max-width: 600px) 96px, (max-width: 1024px) 45vw, 280px" />
                            </span>
                            <span class="corsi-stile-testo">
                                <span class="corsi-stile-nome">{cat.nome}</span>
                                <span class="corsi-stile-desc">{cat.sintesi}</span>
                                <span class="link-cta corsi-stile-link">Vedi di più <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                            </span>
                        </a>
                    </li>
                ))}
            </ol>

            <!-- Chiusura: l'elenco completo dei corsi -->
            <div class="corsi-cta">
                <a href="/corsi" class="btn-primary">
                    <span>Vedi tutti i {totaleCorsi} corsi</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Chi Siamo Section -->
    <section id="chi-siamo" class="chi-siamo-section">
        <div class="container">
            <div class="story-layout">
                <div class="story-content">
                    <div class="section-header chi-siamo-header">
                        <p class="section-tagline eyebrow">Dal {FONDAZIONE} a Lainate e Rho</p>
                        <h2 class="section-title titolo-sezione">La nostra <em>storia</em></h2>
                    </div>

                    <div class="story-text">
                        <p class="story-lead">I.N. Ballet, per tutti InBallet, è la <strong>scuola di danza multidisciplinare</strong> di Lainate e Rho fondata nel {FONDAZIONE} da {scuola.fondatrice}, per bambini <strong>dai 3 anni</strong>, ragazzi e adulti.</p>

                        <p>Quasi tutte le <a href="/classi-integrate">classi accolgono allievi con bisogni speciali</a> e dal 2013 il <a href="/progetto-noiconvoi">progetto NoiConVoi</a> porta la danza ai <strong>ragazzi con disabilità</strong>.</p>
                    </div>

                    <blockquote class="story-quote">
                        <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                        <cite>{scuola.fondatrice}, fondatrice</cite>
                    </blockquote>

                    <a href="/chi-siamo" class="link-cta story-cta">
                        Scopri chi siamo
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                <!-- Foto verticale, alta quanto il testo accanto (su mobile torna orizzontale) -->
                <div class="story-image">
                    <div class="foto-cornice">
                        <Img src="gallery-7.jpg" alt="Insegnanti e allieve di InBallet insieme in sala" width="640" height="800" fuoco={{ desktop: '50% 50%', tablet: '50% 55%' }} loading="lazy" decoding="async" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 480px" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Formazione e progetti: una sola sezione. Intro centrata (a sinistra su tablet e mobile) e tre gruppi
         con titolo grande: tre colonne su desktop, due su tablet (la formazione a tutta larghezza), una su mobile -->
    <section class="oltre-section" aria-labelledby="oltre-titolo">
        <div class="intro-editoriale">
            <span class="eyebrow">Ente formativo CSEN e CONI</span>
            <h2 class="titolo-sezione" id="oltre-titolo">La danza <em>oltre i corsi</em></h2>
            <p><strong>Formazione</strong> per chi insegna e <strong>progetti</strong> con scuole, famiglie e territorio.</p>
        </div>

        <div class="oltre-gruppi">
            {oltre.map((g) => (
                <div class="oltre-gruppo">
                    <div class="oltre-sfondo" aria-hidden="true">
                        <Img src={g.foto} alt="" fuoco={g.fuoco} loading="lazy" decoding="async" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 400px" />
                    </div>
                    <i class={`fas ${g.icona} oltre-gruppo-icona`} aria-hidden="true"></i>
                    <h3 class="oltre-gruppo-titolo">{g.titolo}</h3>
                    <ul class="oltre-lista">
                        {g.voci.map((v) => (
                            <li>
                                <a href={v.href} class="oltre-voce">
                                    <i class={`fas ${v.icona} oltre-icona`} aria-hidden="true"></i>
                                    <span class="oltre-testo-voce">
                                        <span class="oltre-nome">{v.nome}</span>
                                        <span class="oltre-desc">{v.testo}</span>
                                    </span>
                                    <i class="fas fa-arrow-right oltre-freccia" aria-hidden="true"></i>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </section>

     <section class="dicono-di-noi-section decoro-onde" aria-labelledby="recensioni-titolo">
        <div class="container recensioni-layout">
            <div class="recensioni-intro">
                <p class="eyebrow">Le voci della nostra community</p>
                <h2 class="titolo-sezione" id="recensioni-titolo">Dicono <em>di noi</em></h2>
                <p class="intro-sezione">Allievi e famiglie raccontano InBallet nelle <strong>recensioni pubblicate su Google</strong>.</p>
            </div>

            <!-- Valutazione media (compilata da home.ts) e link a tutte le recensioni -->
            <div class="recensioni-sintesi">
                <div class="sintesi-google" id="googleStatsCard" hidden></div>
                <a href={`https://search.google.com/local/reviews?placeid=${PUBLIC_GOOGLE_PLACE_ID}`}
                   target="_blank"
                   rel="noopener"
                   class="link-cta"
                   aria-label="Leggi tutte le recensioni su Google (si apre in una nuova scheda)">
                    Vedi tutte
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            <!-- Recensioni: una alla volta, frecce e indicatori sotto -->
            <div class="recensioni-carousel testimonials-carousel">
                <div class="testimonials-track" id="reviewsContainer" aria-live="polite">
                    <div class="testimonials-slide active">
                        <p class="recensioni-messaggio">Caricamento recensioni…</p>
                    </div>
                </div>

                <div class="recensioni-controlli" id="reviewsControls" hidden>
                    <button type="button" class="recensioni-nav" id="prevBtn" aria-label="Recensione precedente">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <div class="carousel-indicators" id="indicatorsContainer"></div>
                    <button type="button" class="recensioni-nav" id="nextBtn" aria-label="Recensione successiva">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Galleria fotografica a scorrimento, con lightbox -->
    <Galleria />

    <!-- Sezione Sostenitori -->
    <SostenitoriSection />

    <!-- Domande frequenti -->
    <section class="faq-section" aria-labelledby="faq-titolo">
        <div class="container faq-layout">
            <div class="faq-intro">
                <p class="faq-label eyebrow">Domande frequenti</p>
                <h2 class="faq-title titolo-sezione" id="faq-titolo">Tutto quello che <em>vuoi sapere</em></h2>
                <p class="faq-text intro-sezione">Età, sedi, corsi e iscrizioni. Non trovi la risposta? <strong>Scrivici o chiamaci</strong>.</p>
                <ul class="faq-contatti">
                    <li><a href={`mailto:${scuola.email}`}><i class="fas fa-envelope" aria-hidden="true"></i>{scuola.email}</a></li>
                    <li><a href={scuola.telefonoHref}><i class="fas fa-phone" aria-hidden="true"></i>{scuola.telefono}</a></li>
                </ul>
            </div>
            <div class="faq-list">
                {faqHome.map((f, i) => (
                    <details class="faq-item" name="faq" open={i === 0}>
                        <summary>{f.domanda}</summary>
                        <p set:html={enfatizza(f.risposta, f.evidenzia)} />
                    </details>
                ))}
            </div>
        </div>
    </section>


    <Fragment slot="scripts">
        <script>
            import '../scripts/hero-video';
            import '../scripts/home';
        </script>
    </Fragment>
</Base>

<style>.hero {
  /* Altezza minima della foto; il contenuto può allungarla (testi grandi, schermi bassi) */
  min-height: calc(clamp(560px, 72vh, 800px) - var(--header-h));
  position: relative;
  overflow: hidden;
  display: flex;
  /* Testo centrato in verticale: stesso spazio sopra (sotto la navbar) e sotto */
  align-items: center;
  z-index: 1;
  padding: 4rem 0;
}

.hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: center/cover no-repeat;
  z-index: 1;
  content-visibility: auto;
}

/* Sopra la foto (primo fotogramma), compare in dissolvenza solo quando il video sta
   davvero andando: niente riquadro nero mentre carica */
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 1;
  opacity: 0;
  transition: opacity .8s ease;
  pointer-events: none;
}

.hero-video.is-playing {
  opacity: 1;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* Video in movimento e testo centrato a sinistra: velo più scuro dietro il testo,
     più leggero a destra dove il video resta protagonista */
  background:
    linear-gradient(to right, rgba(10,10,10,.78) 0%, rgba(10,10,10,.48) 55%, rgba(10,10,10,.25) 100%),
    linear-gradient(to top, rgba(10,10,10,.55) 0%, rgba(10,10,10,.2) 50%, rgba(10,10,10,.3) 100%);
  z-index: 2;
}

/* Su mobile il testo occupa tutta la larghezza: velo uniforme */
@media (max-width: 768px) {
  .hero-overlay {
    background: linear-gradient(to top, rgba(10,10,10,.85) 0%, rgba(10,10,10,.68) 50%, rgba(10,10,10,.6) 100%);
  }
}

.hero-content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  color: var(--white);
  text-align: left;
  animation: fadeInUp 1s ease-out;
}

.hero-badge {
  display: block;
  font-size: var(--text-sm);
  font-weight: 600;
  margin-bottom: 1.25rem;
  color: var(--primary-blue);
  text-transform: uppercase;
  letter-spacing: 2px;
}

.hero :global(h1) {
  font-size: var(--text-6xl);
  font-weight: 700;
  line-height: 1.05;
  margin-bottom: 1.25rem;
  color: var(--white);
  letter-spacing: -.02em;
  max-width: 14ch;
}

.hero-subtitle {
  font-size: var(--text-xl);
  margin-bottom: 2.25rem;
  color: rgba(255,255,255,.88);
  font-weight: 300;
  line-height: 1.55;
  max-width: 38rem;
}

.hero-cta {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.chi-siamo-section {
  position: relative;
  padding: var(--section-y) 0;
  background: #fff;
}

.chi-siamo-header {
  text-align: left;
  margin-bottom: 2.25rem;
}

/* Testo a sinistra, foto a destra: colonne uguali, così la foto non diventa troppo verticale */
.story-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 5rem;
  align-items: stretch;
  max-width: 1200px;
  margin: 0 auto;
}

.story-text {
  max-width: 34rem;
}

.story-text :global(p) {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 1.25rem;
}

.story-text :global(p:last-child) {
  margin-bottom: 0;
}

.story-text :global(p.story-lead) {
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--dark-navy);
}

.story-quote {
  max-width: 34rem;
  margin: 2.25rem 0 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.story-quote p {
  font-size: var(--text-base);
  font-style: italic;
  line-height: 1.6;
  color: var(--dark-navy);
}

.story-quote cite {
  display: block;
  margin-top: .5rem;
  font-size: var(--text-sm);
  font-style: normal;
  font-weight: 600;
  letter-spacing: .5px;
  color: var(--text-light);
}

.story-quote cite::before {
  content: '— ';
}

.story-cta {
  margin-top: 2.25rem;
}

/* Spazio per la cornice sfalsata (in basso a sinistra) dentro la colonna */
.story-image {
  display: flex;
  padding: 0 0 1.5rem 1.5rem;
}

.story-image .foto-cornice {
  flex: 1;
  display: flex;
}

.story-image :global(img) {
  width: 100%;
  height: 100%;
  min-height: 26rem;
  object-fit: cover;
}

@media (max-width: 600px) {
  .story-image {
    padding: 0 0 .75rem .75rem;
  }
}

.corsi-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
  overflow: hidden;
}

.corsi-wrapper {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

.corsi-header {
  text-align: center;
  margin-bottom: 4rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.corsi-label {
  display: block;
  margin-bottom: 1.5rem;
}

.corsi-title {
  margin-bottom: 1.5rem;
}

.corsi-intro {
  max-width: 600px;
  margin: 0 auto;
}

/* Quattro stili: foto, nome con freccia e una frase, senza riquadri.
   Desktop 4 colonne, tablet 2, mobile righe con la foto quadrata a sinistra. */
.corsi-indice {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2.5rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0;
}

.corsi-stile {
  display: flex;
  flex-direction: column;
  height: 100%;
  color: var(--dark-navy);
  text-decoration: none;
}

.corsi-stile-foto {
  display: block;
  overflow: hidden;
  border-radius: var(--radius-img);
  box-shadow: 0 16px 40px rgba(0, 0, 0, .12);
}

.corsi-stile-foto :global(img) {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  transition: transform .6s ease;
}

.corsi-stile-testo {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-top: 1.25rem;
}

.corsi-stile-nome {
  display: block;
  font-size: var(--text-2xl);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -.01em;
  transition: color .25s ease;
}

/* «Vedi di più» con lo stile dei link d'azione del sito (.link-cta), subito sotto il testo e in fondo
   alla scheda: stessa altezza in tutte le schede della riga */
.corsi-stile-link {
  align-self: flex-start;
  margin-top: auto;
}

.corsi-stile-desc {
  margin-bottom: 1.25rem;
}

.corsi-stile-desc {
  display: block;
  margin-top: .6rem;
  font-size: var(--text-base);
  line-height: 1.55;
  color: var(--text-light);
}

@media (hover: hover) and (pointer: fine) {
  .corsi-stile:hover .corsi-stile-foto :global(img) {
    transform: scale(1.05);
  }

  .corsi-stile:hover .corsi-stile-nome {
    color: var(--primary-blue-dark);
  }

  .corsi-stile:hover .corsi-stile-link {
    color: var(--primary-blue-dark);
    border-color: var(--primary-blue-dark);
  }

  .corsi-stile:hover .corsi-stile-link i {
