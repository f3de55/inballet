---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SostenitoriSection from '../components/SostenitoriSection.astro';
import { getImage } from 'astro:assets';
import { ANNI_ATTIVITA, categorieCorsi, faq, FONDAZIONE, scuola } from '../data/scuola';
import { getAsset, webp } from '../lib/images';
import { schemaHome } from '../lib/schema';

// Galleria: miniature responsive + versione grande per il lightbox
const alts = [
  'Allieve si preparano dietro le quinte prima dello spettacolo',
  'Corpo di ballo sul palco illuminato di blu',
  'Coreografia di danza contemporanea con costumi bianchi',
  "Lezione di danza contemporanea in sala con l'insegnante",
  'Allieve durante il riscaldamento a terra in sala',
  'Spettacolo di fine anno con tutto il corpo di ballo',
  'Gruppo di allievi InBallet in sala prove',
  "Abbraccio tra insegnante e allieva al termine della lezione",
  'Allieve in allungamento sul parquet della sala',
  'Coreografia sul palco con luci blu ed elementi scenici',
];
const gallery = await Promise.all(
  alts.map(async (alt, i) => {
    const file = `gallery-${i + 1}.jpg`;
    return { file, alt, full: await webp(file, 1280) };
  }),
);

// Sfondi in WebP (il CSS definisce solo posizione e dimensione)
const heroBg = await webp('hero-bg.jpg', 1920);
const progettiBg = await webp('bg-progetti-territorio.jpg', 1920);

// Dati strutturati (immagine social 1200x630)
const socialImage = new URL((await getImage({ src: getAsset('gallery-3.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href;
const schema = schemaHome(socialImage);

---

<Base
    title="Scuola di Danza a Lainate e Rho | InBallet"
    description={`Scuola di danza a Lainate e Rho (MI) dal ${FONDAZIONE}: corsi per bambini dai 3 anni, ragazzi e adulti. Classica, modern, contemporanea, hip-hop, yoga e pilates. Ente formativo CSEN-CONI. Lezione di prova senza impegno.`}
    ogTitle="InBallet - Scuola di Danza a Lainate e Rho"
    ogDescription={`${ANNI_ATTIVITA} anni di danza, passione e formazione per tutte le età, a Lainate e Rho.`}
    ogImage={socialImage}
    skipLinkId="skip-link"
>
    <Fragment slot="head">
        <link rel="preload" as="image" href={heroBg} fetchpriority="high">
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </Fragment>


    <!-- Hero Section Personalizzata -->
    <section class="hero">
        <div class="hero-image" style={`background-image: url('${heroBg}')`}></div>

        <div class="hero-overlay"></div>

        <div class="hero-content">
            <p class="hero-badge">InBallet ASD · {ANNI_ATTIVITA} anni di danza</p>

            <h1>Scuola di Danza a Lainate e Rho</h1>

            <p class="hero-subtitle">
                Corsi per tutte le età, dai 3 anni agli adulti: classica, contemporanea, hip-hop, breaking, yoga e pilates. Ente formativo riconosciuto CSEN e CONI.
            </p>

            <div class="hero-cta">
                <a href="/corsi" class="btn-primary">
                    <span>Scopri i corsi</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/contatti" class="btn-secondary">
                    <span>Contattaci</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Sezione Corsi -->
    <section id="corsi" class="corsi-section">
        <div class="corsi-wrapper">
            <!-- Header -->
            <div class="corsi-header">
                <span class="corsi-label eyebrow">La nostra offerta formativa</span>
                <h2 class="corsi-title titolo-sezione">I nostri <em>corsi</em></h2>
                <p class="corsi-intro intro-sezione">Scopri i percorsi di danza pensati per ogni età e livello. Dalla tecnica classica alle discipline contemporanee e urbane.</p>
            </div>

            <div class="corsi-grid">
                {categorieCorsi.map((cat, i) => (
                    <article class="corso-item">
                        <div class="corso-numero">{String(i + 1).padStart(2, '0')}</div>
                        <div class="corso-contenuto">
                            <h3 class="corso-titolo">{cat.nome}</h3>
                            <p class="corso-descrizione" set:html={cat.descrizione} />
                            <div class="corso-livelli">
                                {cat.corsi.map((c) => <a class="livello" href={c.url}>{c.nome}</a>)}
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Bottom CTA -->
            <div class="corsi-cta">
                <p class="corsi-cta-text">Non sai quale corso scegliere?</p>
                <a href="/contatti" class="corsi-cta-btn btn-primary">
                    <span>Parliamone insieme</span>
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Chi Siamo Section -->
    <section id="chi-siamo" class="chi-siamo-section">
        <div class="container">
            <div class="story-layout">
                <div class="story-content">
                    <div class="section-header chi-siamo-header">
                        <p class="section-tagline eyebrow">Dal {FONDAZIONE} a Lainate e Rho</p>
                        <h2 class="section-title titolo-sezione">La nostra <em>storia</em></h2>
                    </div>

                    <div class="story-text">
                        <p class="story-lead">I.N. Ballet è una scuola di danza multidisciplinare, nata nel {FONDAZIONE} da {scuola.fondatrice}: un luogo dove esplorare stili diversi, dalla tecnica all'espressione artistica.</p>

                        <p>Accoglie bambini dai 3 anni, ragazzi e adulti di ogni livello ed è Ente Formativo CSEN e CONI per la formazione dei maestri di danza.</p>
                    </div>

                    <blockquote class="story-quote">
                        <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                        <cite>I.N.</cite>
                    </blockquote>
                </div>

                <div class="story-image">
                    <div class="story-photo">
                        <Img src="ballerina.jpg" alt="Ballerina InBallet" width="450" height="500" loading="lazy" decoding="async" widths={[450, 900]} sizes="450px" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sezione Formazione Professionale -->
    <section class="formazione-professionale-section">
        <div class="formazione-wrapper">
            <!-- Header -->
            <div class="formazione-header">
                <span class="formazione-label eyebrow">Ente Formativo CSEN e CONI</span>
                <h2 class="formazione-title titolo-sezione">Formazione <em>professionale</em></h2>
            </div>

            <!-- Percorsi Cards -->
            <div class="percorsi-container">

                <!-- Card Insegnante di Danza -->
                <article class="percorso-card voce">
                    <h3 class="percorso-card-title voce-titolo">Formazione Insegnanti di Danza</h3>
                    <p class="percorso-card-description">
                        Percorso biennale in danza Modern con formazione su tecnica, pedagogia e inclusione.
                    </p>
                    <div class="percorso-highlights">
                        <div class="highlight-item">
                            <i class="fas fa-certificate"></i>
                            <span>Titolo riconosciuto CSEN e CONI</span>
                        </div>
                        <div class="highlight-item">
                            <i class="fas fa-clock"></i>
                            <span>2 anni + 6 master specialistici opzionali</span>
                        </div>
                    </div>
                    <a href="/formazione-insegnanti" class="percorso-card-btn link-cta">
                        <span>Scopri il corso</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </article>

                <!-- Card Formazioni Personalizzate -->
                <article class="percorso-card voce">
                    <h3 class="percorso-card-title voce-titolo">Formazioni Personalizzate</h3>
                    <p class="percorso-card-description">
                        Workshop tematici e percorsi su misura per insegnanti, scuole ed enti.
                    </p>
                    <div class="percorso-highlights">
                        <div class="highlight-item">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <span>Workshop e masterclass tematiche</span>
                        </div>
                        <div class="highlight-item">
                            <i class="fas fa-school"></i>
                            <span>Formazione per scuole ed enti</span>
                        </div>
                    </div>
                    <a href="/formazioni-personalizzate" class="percorso-card-btn link-cta">
                        <span>Scopri di più</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </article>

            </div>
        </div>
    </section>

     <section class="dicono-di-noi-section">
        <div class="container">
            <!-- Header sezione -->
            <div class="testimonials-header">
                <p class="testimonials-tagline eyebrow">Le voci della nostra community</p>
                <h2 class="testimonials-title titolo-sezione">Dicono <em>di noi</em></h2>
                <p class="testimonials-description intro-sezione">
                    L'esperienza di chi ha scelto InBallet per crescere attraverso la danza. Recensioni autentiche dai nostri allievi e famiglie.
                </p>
            </div>

            <!-- Layout principale con carousel e sidebar -->
            <div class="testimonials-container">
                <div class="carousel-with-cta">
                    <!-- Stats sopra su mobile, sidebar su desktop -->
                    <div class="carousel-sidebar">
                        <div class="google-stats-card" id="googleStatsCard" style="display: none;">
                            <div class="stats-content" id="statsContent">
                                <div class="stat-item">
                                    <span class="stat-label">Caricamento...</span>
                                    <span class="stat-value">...</span>
                                </div>
                            </div>
                        </div>

                        <!-- Bottone CTA -->
                        <div class="view-all-reviews" id="viewAllSection">
                            <a href="https://www.google.com/search?sa=X&sca_esv=ccb8066356fd07b7&tbm=lcl&sxsrf=AE3TifONsbUe8wj4bCgnW_SAO2k4jfCpMg:1750798486383&q=I.N.+Ballet+Recensioni&rflfq=1&num=20&stick=H4sIAAAAAAAAAONgkxI2NDG1NDU3sDAHMowtDSwMLcw3MDK-YhTz1PPTU3BKzMlJLVEISk1OzSvOzM_LXMSKQwIA6ENBIkwAAAA&rldimm=1459570871453908187&hl=it-IT&ved=2ahUKEwiGturO-IqOAxUihP0HHdBWAj4Q9fQKegQIUhAF&biw=1920&bih=945&dpr=1#lkt=LocalPoiReviews"
                               target="_blank"
                               rel="noopener"
                               class="view-all-btn btn-primary">
                                <div class="btn-google-icon">
                                    <i class="fab fa-google"></i>
                                </div>
                                <span class="btn-main-text">Tutte le recensioni</span>
                            </a>
                        </div>
                    </div>

                    <!-- Carousel principale -->
                    <div class="carousel-main">
                        <div class="testimonials-carousel">
                            <div class="testimonials-track" id="reviewsContainer">
                                <!-- Loading state iniziale -->
                                <div class="testimonials-slide active">
                                    <div class="testimonial-card">
                                        <div class="testimonial-header">
                                            <div class="google-rating">
                                                <div class="rating-badge">
                                                    <div class="loading-spinner"></div>
                                                    <span>Caricamento...</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="testimonial-content">
                                            <div class="loading-reviews">
                                                <p>Caricamento recensioni Google Maps...</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Navigation -->
                            <button class="carousel-nav carousel-prev" id="prevBtn">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="carousel-nav carousel-next" id="nextBtn">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>

                        <!-- Indicators -->
                        <div class="carousel-indicators" id="indicatorsContainer">
                            <div class="indicator active" data-slide="0"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

     <!-- Sezione Progetti Sul Territorio -->
    <section class="altri-servizi-section sezione-scura">
        <div class="altri-servizi-bg" style={`background-image: url('${progettiBg}')`}></div>
        <div class="altri-servizi-overlay"></div>

        <div class="altri-servizi-wrapper">
            <!-- Header -->
            <div class="altri-servizi-header">
                <span class="altri-servizi-label eyebrow">La danza fuori dalla sala</span>
                <h2 class="altri-servizi-title titolo-sezione">Progetti <em>sul territorio</em></h2>
                <p class="altri-servizi-intro intro-sezione">Portiamo la danza nelle scuole, nelle comunità e accanto a chi ha bisogno.</p>
            </div>

            <!-- Testo Narrativo -->
            <div class="progetti-narrativo">
                <div class="narrativo-colonna">
                    <h3>Eventi e Collaborazioni</h3>
                    <p>
                        Organizziamo <a href="/spettacoli-eventi">Spettacoli ed Eventi</a> in teatri e spazi pubblici,
                        portiamo la danza nelle scuole con <a href="/collaborazioni-scuole">Collaborazioni Scolastiche</a>
                        e offriamo <a href="/sportello-psicologico">Supporto Psicologico</a> per allievi e famiglie.
                    </p>
                </div>

                <div class="narrativo-colonna">
                    <h3>Danza Integrativa</h3>
                    <p>
                        Dal 2013 il <a href="/progetto-noiconvoi">Progetto NoiConVoi</a> accoglie ragazzi con disabilità
                        in esperienze di danza con supporto psicomotorio, insieme a un team di volontari.
                        Con le <a href="/classi-integrate">Classi Integrate</a>, lo
                        <a href="/sportello-psicologico">Sportello del Bambino</a> e i
                        <a href="/sostenitori">Sostenitori</a> la danza diventa davvero di tutti.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Sezione Galleria Infinita -->
    <section class="gallery-section">
        <div class="container">
            <div class="gallery-header">
                <p class="gallery-tagline eyebrow">I nostri momenti</p>
                <h2 class="gallery-title titolo-sezione">Emozioni <em>in movimento</em></h2>
                <p class="gallery-description intro-sezione">Scorri tra i momenti più belli delle nostre lezioni, spettacoli e performance. L'energia e la passione dei nostri allievi in un viaggio visivo.</p>
            </div>
        </div>

        <div class="gallery-infinite">
            <div class="gallery-track" id="galleryTrack">
                {[0, 1].map((set) =>
                    gallery.map((img, i) => (
                        <div class="gallery-item" data-index={i} data-full={img.full}>
                            <Img src={img.file} alt={img.alt} width="300" height="400" loading="lazy" decoding="async" widths={[300, 600]} sizes="300px" aria-hidden={set === 1 ? 'true' : undefined} />
                            <div class="gallery-overlay">
                                <div class="gallery-zoom-icon">
                                    <i class="fas fa-expand"></i>
                                </div>
                            </div>
                        </div>
                    ))
                )}
            </div>
        </div>
    </section>

    <!-- Sezione Sostenitori -->
    <SostenitoriSection />

    <!-- Domande frequenti -->
    <section class="faq-section" aria-labelledby="faq-titolo">
        <div class="container faq-layout">
            <div class="faq-intro">
                <p class="faq-label eyebrow">Domande frequenti</p>
                <h2 class="faq-title titolo-sezione" id="faq-titolo">Tutto quello che <em>vuoi sapere</em></h2>
                <p class="faq-text intro-sezione">
                    Non trovi la risposta? Scrivici a <a href={`mailto:${scuola.email}`}>{scuola.email}</a>
                    o chiamaci al <a href={scuola.telefonoHref}>{scuola.telefono}</a>.
                </p>
            </div>
            <div class="faq-list">
                {faq.map((f, i) => (
                    <details class="faq-item" open={i === 0}>
                        <summary>{f.domanda}</summary>
                        <p>{f.risposta}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
        <div class="lightbox-content">
            <img class="lightbox-image" id="lightbox-image" src="" alt="">
            <button class="lightbox-close" id="lightbox-close" aria-label="Chiudi galleria">
                <i class="fas fa-times"></i>
            </button>
            <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Immagine precedente">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Immagine successiva">
                <i class="fas fa-chevron-right"></i>
            </button>
            <div class="lightbox-counter" id="lightbox-counter">
                1 / 10
            </div>
        </div>
    </div>

    <Fragment slot="scripts">
        <script>
            import '../scripts/home';
        </script>
    </Fragment>
</Base>

<style>
.carousel-nav:focus-visible,
.lightbox-nav:focus-visible {
  box-shadow: 0 0 0 3px var(--primary-blue);
}

:global(.indicator:focus-visible) {
  outline: 2px solid var(--primary-blue);
  outline-offset: 2px;
  transform: scale(1.1);
}

.hero {
  height: 72vh;
  min-height: 560px;
  max-height: 800px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  z-index: 1;
  padding: 80px 0 4.5rem;
}

.hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: center/cover no-repeat;
  z-index: 1;
  content-visibility: auto;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to top, rgba(15,15,15,.85) 0%, rgba(15,15,15,.45) 55%, rgba(15,15,15,.2) 100%);
  z-index: 2;
}

.hero-content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  color: var(--white);
  text-align: left;
  animation: fadeInUp 1s ease-out;
}

.hero-badge {
  display: block;
  font-size: .875rem;
  font-weight: 600;
  margin-bottom: 1.25rem;
  color: var(--primary-blue);
  text-transform: uppercase;
  letter-spacing: 2px;
}

.hero :global(h1) {
  text-wrap: balance;
  font-size: var(--text-6xl);
  font-weight: 700;
  line-height: 1.05;
  margin-bottom: 1.25rem;
  color: var(--white);
  letter-spacing: -.02em;
  max-width: 14ch;
}

.hero-subtitle {
  font-size: var(--text-xl);
  margin-bottom: 2.25rem;
  color: rgba(255,255,255,.88);
  font-weight: 300;
  line-height: 1.55;
  max-width: 38rem;
}

.hero-cta {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.chi-siamo-section,
.formazione-professionale-section,
.dicono-di-noi-section,
.gallery-section {
  background: #fff;
  position: relative;
}

.chi-siamo-section,
.formazione-professionale-section {
  padding: var(--section-y) 0;
}

.gallery-section::before,
.dicono-di-noi-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.section-header {
  margin-bottom: 2.5rem;
}

.chi-siamo-section {
  position: relative;
}

.chi-siamo-header {
  text-align: left;
  margin-bottom: 3rem;
}

.story-layout {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 5rem;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
}

.story-content {
  padding: 0;
}

.story-text {
  max-width: 580px;
}

.story-text :global(p) {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-dark);
  margin-bottom: 1.5rem;
}

.story-text :global(p:last-child) {
  margin-bottom: 0;
}

.story-lead {
  font-size: var(--text-xl);
  line-height: 1.7;
  color: var(--dark-navy);
  font-weight: 400;
}

.story-quote {
  max-width: 580px;
  margin: 2.5rem 0 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.story-quote p {
  font-size: var(--text-lg);
  font-style: italic;
  line-height: 1.6;
  color: var(--dark-navy);
}

.story-quote cite {
  display: block;
  margin-top: .5rem;
  font-size: var(--text-sm);
  font-style: normal;
  font-weight: 600;
  letter-spacing: 1px;
  color: var(--dark-navy);
}

.story-quote cite::before {
  content: '— ';
}

.story-image {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 500px;
  contain: layout;
  padding-right: 40px;
  padding-top: 40px;
}

/* Cornice azzurra sfalsata dietro la foto (come nella pagina Contatti) */
.story-photo {
  position: relative;
  isolation: isolate;
  width: 100%;
  max-width: 450px;
}

.story-photo::before {
  content: '';
  position: absolute;
  inset: 2.5rem 2.5rem -1.5rem -1.5rem;
  border: 2px solid var(--primary-blue);
  border-radius: 24px;
  z-index: -1;
}

.story-image :global(img) {
  display: block;
  width: 100%;
  max-width: 450px;
  height: 500px;
  object-fit: cover;
  border-radius: 24px;
  box-shadow: 0 24px 60px rgba(0,0,0,.14);
  aspect-ratio: 450/500;
}

.corsi-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
  position: relative;
  overflow: hidden;
}

.corsi-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corsi-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.corsi-wrapper {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

.corsi-header {
  text-align: center;
  margin-bottom: 4rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.corsi-label {
  display: block;
  margin-bottom: 1.5rem;
}

.corsi-title {
  margin-bottom: 1.5rem;
}

.corsi-intro {
  max-width: 600px;
  margin: 0 auto;
}

.corsi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3rem 4rem;
