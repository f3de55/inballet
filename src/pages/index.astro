---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import SostenitoriSection from '../components/SostenitoriSection.astro';
import { getImage } from 'astro:assets';
import { ANNI_ATTIVITA, categorieCorsi, faq, FONDAZIONE, scuola } from '../data/scuola';
import { getAsset, webp } from '../lib/images';
import { schemaHome } from '../lib/schema';

// Galleria: miniature responsive + versione grande per il lightbox
const alts = [
  'Allieve si preparano dietro le quinte prima dello spettacolo',
  'Corpo di ballo sul palco illuminato di blu',
  'Coreografia di danza contemporanea con costumi bianchi',
  "Lezione di danza contemporanea in sala con l'insegnante",
  'Allieve durante il riscaldamento a terra in sala',
  'Spettacolo di fine anno con tutto il corpo di ballo',
  'Gruppo di allievi InBallet in sala prove',
  "Abbraccio tra insegnante e allieva al termine della lezione",
  'Allieve in allungamento sul parquet della sala',
  'Coreografia sul palco con luci blu ed elementi scenici',
];
const gallery = await Promise.all(
  alts.map(async (alt, i) => {
    const file = `gallery-${i + 1}.jpg`;
    return { file, alt, full: await webp(file, 1280) };
  }),
);

// Sfondi in WebP (il CSS definisce solo posizione e dimensione)
const heroBg = await webp('gallery-3.jpg', 1920);
const progettiBg = await webp('bg-progetti-territorio.jpg', 1920);

// Dati strutturati (immagine social 1200x630)
const socialImage = new URL((await getImage({ src: getAsset('gallery-3.jpg'), width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site).href;
const schema = schemaHome(socialImage);

---

<Base
    title="Scuola di Danza a Lainate e Rho | InBallet"
    description={`Scuola di danza a Lainate e Rho (MI) dal ${FONDAZIONE}: corsi per bambini dai 3 anni, ragazzi e adulti. Classica, modern, contemporanea, hip-hop, yoga e pilates. Ente formativo CSEN-CONI. Lezione di prova gratuita.`}
    ogTitle="InBallet - Scuola di Danza a Lainate e Rho"
    ogDescription={`${ANNI_ATTIVITA} anni di danza, passione e formazione per tutte le età. Prenota una lezione di prova.`}
    ogImage={socialImage}
    skipLinkId="skip-link"
>
    <Fragment slot="head">
        <link rel="preload" as="image" href={heroBg} fetchpriority="high">
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </Fragment>


    <!-- Hero Section Personalizzata -->
    <section class="hero">
        <div class="hero-image" style={`background-image: url('${heroBg}')`}></div>

        <div class="hero-overlay"></div>

        <div class="hero-content">
            <div class="hero-badge">
                <i class="fas fa-hand-sparkles" aria-hidden="true"></i>
                InBallet ASD · {ANNI_ATTIVITA} anni di danza
            </div>

            <h1>Scuola di Danza a Lainate e Rho</h1>

            <p class="hero-subtitle">
                Corsi per <strong>tutte le età</strong>, dai 3 anni agli adulti: <strong>classica</strong>, <strong>contemporanea</strong>, <strong>hip-hop</strong>, <strong>breaking</strong>, <strong>yoga</strong> e <strong>pilates</strong>. Ente formativo riconosciuto <strong>CSEN e CONI</strong>.
            </p>

            <div class="hero-cta">
                <a href="#corsi" class="btn-primary">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <span>Scopri i Percorsi</span>
                </a>
                <a href="/contatti" class="btn-secondary">
                    <i class="fas fa-envelope" aria-hidden="true"></i>
                    <span>Contattaci</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Sezione Corsi -->
    <section id="corsi" class="corsi-section">
        <div class="corsi-wrapper">
            <!-- Header -->
            <div class="corsi-header">
                <span class="corsi-label">La nostra offerta formativa</span>
                <h2 class="corsi-title">I Nostri Corsi</h2>
                <p class="corsi-intro">Scopri i percorsi di danza pensati per <strong>ogni età e livello</strong>. Dalla <strong>tecnica classica</strong> alle <strong>discipline contemporanee e urbane</strong>.</p>
            </div>

            <div class="corsi-grid">
                {categorieCorsi.map((cat, i) => (
                    <article class="corso-item">
                        <div class="corso-numero">{String(i + 1).padStart(2, '0')}</div>
                        <div class="corso-contenuto">
                            <h3 class="corso-titolo">{cat.nome}</h3>
                            <p class="corso-descrizione" set:html={cat.descrizione} />
                            <div class="corso-livelli">
                                {cat.corsi.map((c) => <a class="livello" href={c.url}>{c.nome}</a>)}
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Bottom CTA -->
            <div class="corsi-cta">
                <p class="corsi-cta-text">Non sai quale corso scegliere?</p>
                <a href="/contatti" class="corsi-cta-btn">
                    <span>Parliamone insieme</span>
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Chi Siamo Section -->
    <section id="chi-siamo" class="chi-siamo-section">
        <div class="container">
            <div class="story-layout">
                <div class="story-content">
                    <div class="section-header chi-siamo-header">
                        <p class="section-tagline">Dal {FONDAZIONE} a Lainate e Rho</p>
                        <h2 class="section-title">La Nostra Storia</h2>
                    </div>

                    <div class="story-text">
                        <p class="story-lead"><strong>I.N. Ballet</strong> è una scuola di danza <strong>multidisciplinare</strong>: un luogo di vita dedicato alla conoscenza e all'esplorazione dei diversi stili di danza, nelle loro sfumature <strong>tecniche</strong> e <strong>artistiche</strong>.</p>

                        <p>Fondata nel <strong>{FONDAZIONE}</strong> da <strong>{scuola.fondatrice}</strong>, accoglie <strong>bambini dai 3 anni</strong>, ragazzi e adulti, con gruppi di ogni livello fino ai corsi avanzati. È uno spazio di continua ricerca corporea, in dialogo costante con le famiglie, dove la danza incontra le emozioni e le forme espressive di ciascuno.</p>

                        <p>È anche punto di riferimento per la <strong>formazione nazionale dei maestri di danza</strong> e per i professionisti dell'ambito educativo e terapeutico, come <strong>Ente Formativo CSEN e CONI</strong>.</p>
                    </div>

                    <blockquote class="story-quote">
                        <p>La Danza è capace di creare racconti in tutti i corpi ed in tutte le menti.</p>
                        <cite>I.N.</cite>
                    </blockquote>
                </div>

                <div class="story-image">
                    <div class="story-photo">
                        <Img src="ballerina.jpg" alt="Ballerina InBallet" width="450" height="500" loading="lazy" decoding="async" widths={[450, 900]} sizes="450px" />
                        <div class="image-accent">
                            <span class="accent-number">{ANNI_ATTIVITA}</span>
                            <span class="accent-text">anni</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sezione Formazione Professionale -->
    <section class="formazione-professionale-section">
        <div class="formazione-wrapper">
            <!-- Header -->
            <div class="formazione-header">
                <span class="formazione-label">Ente Formativo CSEN e CONI</span>
                <h2 class="formazione-title">Formazione Professionale</h2>
            </div>

            <!-- Percorsi Cards -->
            <div class="percorsi-container">

                <!-- Card Insegnante di Danza -->
                <article class="percorso-card">
                    <h3 class="percorso-card-title">Formazione Insegnanti di Danza</h3>
                    <p class="percorso-card-description">
                        Percorso <strong>biennale in danza Modern</strong> con formazione su <strong>tecnica, pedagogia e inclusione</strong>.
                    </p>
                    <div class="percorso-highlights">
                        <div class="highlight-item">
                            <i class="fas fa-certificate"></i>
                            <span>Titolo riconosciuto CSEN e CONI</span>
                        </div>
                        <div class="highlight-item">
                            <i class="fas fa-clock"></i>
                            <span>2 anni + 6 master specialistici opzionali</span>
                        </div>
                    </div>
                    <a href="/formazione-insegnanti" class="percorso-card-btn">
                        <span>Scopri il corso</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </article>

                <!-- Card Formazioni Personalizzate -->
                <article class="percorso-card">
                    <h3 class="percorso-card-title">Formazioni Personalizzate</h3>
                    <p class="percorso-card-description">
                        <strong>Workshop tematici</strong> e <strong>percorsi su misura</strong> per insegnanti, scuole ed enti.
                    </p>
                    <div class="percorso-highlights">
                        <div class="highlight-item">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <span>Workshop e masterclass tematiche</span>
                        </div>
                        <div class="highlight-item">
                            <i class="fas fa-school"></i>
                            <span>Formazione per scuole ed enti</span>
                        </div>
                    </div>
                    <a href="/formazioni-personalizzate" class="percorso-card-btn">
                        <span>Scopri di più</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </article>

            </div>
        </div>
    </section>

     <section class="dicono-di-noi-section">
        <div class="container">
            <!-- Header sezione -->
            <div class="testimonials-header">
                <p class="testimonials-tagline">Le voci della nostra community</p>
                <h2 class="testimonials-title">Dicono di Noi</h2>
                <p class="testimonials-description">
                    L'esperienza di chi ha scelto InBallet per crescere attraverso la danza. Recensioni autentiche dai nostri allievi e famiglie.
                </p>
            </div>

            <!-- Layout principale con carousel e sidebar -->
            <div class="testimonials-container">
                <div class="carousel-with-cta">
                    <!-- Stats sopra su mobile, sidebar su desktop -->
                    <div class="carousel-sidebar">
                        <div class="google-stats-card" id="googleStatsCard" style="display: none;">
                            <div class="stats-header">
                                <span class="stats-title">Le nostre recensioni</span>
                            </div>
                            <div class="stats-content" id="statsContent">
                                <div class="stat-item">
                                    <span class="stat-label">Caricamento...</span>
                                    <span class="stat-value">...</span>
                                </div>
                            </div>
                        </div>

                        <!-- Bottone CTA -->
                        <div class="view-all-reviews" id="viewAllSection">
                            <a href="https://www.google.com/search?sa=X&sca_esv=ccb8066356fd07b7&tbm=lcl&sxsrf=AE3TifONsbUe8wj4bCgnW_SAO2k4jfCpMg:1750798486383&q=I.N.+Ballet+Recensioni&rflfq=1&num=20&stick=H4sIAAAAAAAAAONgkxI2NDG1NDU3sDAHMowtDSwMLcw3MDK-YhTz1PPTU3BKzMlJLVEISk1OzSvOzM_LXMSKQwIA6ENBIkwAAAA&rldimm=1459570871453908187&hl=it-IT&ved=2ahUKEwiGturO-IqOAxUihP0HHdBWAj4Q9fQKegQIUhAF&biw=1920&bih=945&dpr=1#lkt=LocalPoiReviews"
                               target="_blank"
                               rel="noopener"
                               class="view-all-btn">
                                <div class="btn-google-icon">
                                    <i class="fab fa-google"></i>
                                </div>
                                <span class="btn-main-text">Visualizza tutte le recensioni</span>
                            </a>
                        </div>
                    </div>

                    <!-- Carousel principale -->
                    <div class="carousel-main">
                        <div class="testimonials-carousel">
                            <div class="testimonials-track" id="reviewsContainer">
                                <!-- Loading state iniziale -->
                                <div class="testimonials-slide active">
                                    <div class="testimonial-card">
                                        <div class="testimonial-header">
                                            <div class="google-rating">
                                                <div class="rating-badge">
                                                    <div class="loading-spinner"></div>
                                                    <span>Caricamento...</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="testimonial-content">
                                            <div class="loading-reviews">
                                                <p>Caricamento recensioni Google Maps...</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Navigation -->
                            <button class="carousel-nav carousel-prev" id="prevBtn">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="carousel-nav carousel-next" id="nextBtn">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>

                        <!-- Indicators -->
                        <div class="carousel-indicators" id="indicatorsContainer">
                            <div class="indicator active" data-slide="0"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

     <!-- Sezione Progetti Sul Territorio -->
    <section class="altri-servizi-section">
        <div class="altri-servizi-bg" style={`background-image: url('${progettiBg}')`}></div>
        <div class="altri-servizi-overlay"></div>

        <div class="altri-servizi-wrapper">
            <!-- Header -->
            <div class="altri-servizi-header">
                <span class="altri-servizi-label">La danza fuori dalla sala</span>
                <h2 class="altri-servizi-title">Progetti Sul Territorio</h2>
                <p class="altri-servizi-intro">Portiamo la danza nelle <strong>scuole</strong>, nelle <strong>comunità</strong> e accanto a chi ha <strong>bisogno</strong>.</p>
            </div>

            <!-- Testo Narrativo -->
            <div class="progetti-narrativo">
                <div class="narrativo-colonna">
                    <h3>Eventi e Collaborazioni</h3>
                    <p>
                        Organizziamo <strong><a href="/spettacoli-eventi">Spettacoli ed Eventi</a></strong> in teatri e spazi pubblici,
                        portiamo la danza nelle scuole con <strong><a href="/collaborazioni-scuole">Collaborazioni Scolastiche</a></strong>
                        e offriamo <strong><a href="/sportello-psicologico">Supporto Psicologico</a></strong> per allievi e famiglie.
                    </p>
                </div>

                <div class="narrativo-colonna">
                    <h3>Danza Integrativa</h3>
                    <p>
                        Dal 2013 il <strong><a href="/progetto-noiconvoi">Progetto NoiConVoi</a></strong> accoglie ragazzi con disabilità
                        in esperienze di danza con supporto psicomotorio, insieme a un team di volontari.
                        Con le <strong><a href="/classi-integrate">Classi Integrate</a></strong>, lo
                        <strong><a href="/sportello-psicologico">Sportello del Bambino</a></strong> e i
                        <strong><a href="/sostenitori">Sostenitori</a></strong> la danza diventa davvero di tutti.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Sezione Galleria Infinita -->
    <section class="gallery-section">
        <div class="container">
            <div class="gallery-header">
                <p class="gallery-tagline">I nostri momenti</p>
                <h2 class="gallery-title">Emozioni in Movimento</h2>
                <p class="gallery-description">Scorri tra i momenti più belli delle nostre lezioni, spettacoli e performance. L'energia e la passione dei nostri allievi in un viaggio visivo.</p>
            </div>
        </div>

        <div class="gallery-infinite">
            <div class="gallery-track" id="galleryTrack">
                {[0, 1].map((set) =>
                    gallery.map((img, i) => (
                        <div class="gallery-item" data-index={i} data-full={img.full}>
                            <Img src={img.file} alt={img.alt} width="300" height="400" loading="lazy" decoding="async" widths={[300, 600]} sizes="300px" aria-hidden={set === 1 ? 'true' : undefined} />
                            <div class="gallery-overlay">
                                <div class="gallery-zoom-icon">
                                    <i class="fas fa-expand"></i>
                                </div>
                            </div>
                        </div>
                    ))
                )}
            </div>
        </div>
    </section>

    <!-- Sezione Sostenitori -->
    <SostenitoriSection />

    <!-- Domande frequenti -->
    <section class="faq-section" aria-labelledby="faq-titolo">
        <div class="container faq-layout">
            <div class="faq-intro">
                <p class="faq-label">Domande frequenti</p>
                <h2 class="faq-title" id="faq-titolo">Tutto quello che vuoi sapere</h2>
                <p class="faq-text">
                    Non trovi la risposta? Scrivici a <a href={`mailto:${scuola.email}`}>{scuola.email}</a>
                    o chiamaci al <a href={scuola.telefonoHref}>{scuola.telefono}</a>.
                </p>
            </div>
            <div class="faq-list">
                {faq.map((f, i) => (
                    <details class="faq-item" open={i === 0}>
                        <summary>{f.domanda}</summary>
                        <p>{f.risposta}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
        <div class="lightbox-content">
            <img class="lightbox-image" id="lightbox-image" src="" alt="">
            <button class="lightbox-close" id="lightbox-close" aria-label="Chiudi galleria">
                <i class="fas fa-times"></i>
            </button>
            <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Immagine precedente">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Immagine successiva">
                <i class="fas fa-chevron-right"></i>
            </button>
            <div class="lightbox-counter" id="lightbox-counter">
                1 / 10
            </div>
        </div>
    </div>

    <Fragment slot="scripts">
        <script>
            import '../scripts/home';
        </script>
    </Fragment>
</Base>

<style>
.carousel-nav:focus-visible,
.lightbox-nav:focus-visible {
  box-shadow: 0 0 0 3px var(--primary-blue);
}

:global(.indicator:focus-visible) {
  outline: 2px solid var(--primary-blue);
  outline-offset: 2px;
  transform: scale(1.1);
}

.hero {
  height: 72vh;
  min-height: 560px;
  max-height: 800px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  padding-top: 80px;
}

.hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: center/cover no-repeat;
  z-index: 1;
  content-visibility: auto;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg,rgba(26,26,26,.6) 0,rgba(42,42,42,.4) 50%,rgba(26,26,26,.6) 100%);
  z-index: 2;
}

.hero-content {
  text-align: center;
  color: var(--white);
  z-index: 3;
  max-width: 800px;
  margin: 0 2rem;
  padding: 3rem 2rem;
  animation: fadeInUp 1s ease-out;
  background: rgba(135,206,235,.25);
  backdrop-filter: blur(6px);
  border-radius: 20px;
  border: 1px solid rgba(135,206,235,.2);
}

.hero-badge {
  display: block;
  font-size: var(--text-lg);
  font-weight: 700;
  margin-bottom: 1rem;
  color: var(--white);
  text-transform: uppercase;
  letter-spacing: 2px;
  text-shadow: 0 2px 8px rgba(0,0,0,.9);
}

.hero-badge :global(i) {
  display: none;
}

.hero :global(h1) {
  text-wrap: balance;
  font-size: var(--text-6xl);
  font-weight: 700;
  line-height: var(--leading-tight);
  margin-bottom: 1.5rem;
  color: var(--white);
  letter-spacing: -.02em;
  text-shadow: 0 4px 8px rgba(0,0,0,.3);
}

.hero-subtitle {
  font-size: var(--text-xl);
  margin-bottom: 3rem;
  opacity: .9;
  font-weight: 300;
  line-height: 1.5;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  text-shadow: 0 2px 4px rgba(0,0,0,.2);
}

.hero-cta {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 1.5rem;
}

.chi-siamo-section,
.formazione-professionale-section,
.dicono-di-noi-section,
.gallery-section {
  background: #fff;
  position: relative;
}

.chi-siamo-section,
.formazione-professionale-section {
  padding: 5rem 0;
}

.gallery-section::before,
.dicono-di-noi-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-blue);
}

.section-header {
  margin-bottom: 2.5rem;
}

.chi-siamo-section {
  position: relative;
}

.chi-siamo-header {
  text-align: left;
  margin-bottom: 3rem;
}

.story-layout {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 5rem;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
}

.story-content {
  padding: 0;
}

.story-text {
  max-width: 580px;
}

.story-text :global(p) {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-dark);
  margin-bottom: 1.5rem;
}

.story-text :global(p:last-child) {
  margin-bottom: 0;
}

.story-lead {
  font-size: var(--text-xl);
  line-height: 1.7;
  color: var(--dark-navy);
  font-weight: 400;
}

.story-quote {
  max-width: 580px;
  margin: 2.5rem 0 0;
  padding-left: 1.5rem;
  border-left: 3px solid var(--primary-blue);
}

.story-quote p {
  font-size: var(--text-lg);
  font-style: italic;
  line-height: 1.6;
  color: var(--dark-navy);
}

.story-quote cite {
  display: block;
  margin-top: .5rem;
  font-size: var(--text-sm);
  font-style: normal;
  font-weight: 600;
  letter-spacing: 1px;
  color: var(--dark-navy);
}

.story-quote cite::before {
  content: '— ';
}

.story-image {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 500px;
  contain: layout;
  padding-right: 40px;
  padding-top: 40px;
}

/* Cornice azzurra sfalsata dietro la foto (come nella pagina Contatti) */
.story-photo {
  position: relative;
  isolation: isolate;
  width: 100%;
  max-width: 450px;
}

.story-photo::before {
  content: '';
  position: absolute;
  inset: 2.5rem 2.5rem -1.5rem -1.5rem;
  border: 2px solid var(--primary-blue);
  border-radius: 24px;
  z-index: -1;
}

.story-image :global(img) {
  display: block;
  width: 100%;
  max-width: 450px;
  height: 500px;
  object-fit: cover;
  border-radius: 24px;
  box-shadow: 0 24px 60px rgba(0,0,0,.14);
  aspect-ratio: 450/500;
}

.image-accent {
  position: absolute;
  top: -20px;
  right: -20px;
  background: linear-gradient(135deg,var(--primary-blue) 0%,var(--primary-blue-light) 100%);
  color: var(--dark-navy);
  width: 100px;
  height: 100px;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12px 30px rgba(135,206,235,.4),0 4px 12px rgba(0,0,0,.15),inset 0 1px 0 rgba(255,255,255,.3);
  will-change: transform;
  transform: translateZ(0);
}

.image-accent::before,
.image-accent::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0;
}

.image-accent::before {
  border: 3px solid rgba(255,255,255,.8);
  animation: accent-pulse 4s ease-in-out infinite;
}

.image-accent::after {
  border: 3px solid rgba(135,206,235,.7);
  animation: accent-pulse 4s ease-in-out infinite;
  animation-delay: 2s;
}

.accent-number {
  font-size: 2.75rem;
  font-weight: 700;
  line-height: .9;
  letter-spacing: -1px;
  display: block;
}

.accent-text {
  font-size: .85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  display: block;
  line-height: 1;
}

.corsi-section {
  padding: 5rem 0;
  background: rgba(176, 224, 230, 0.25);
  position: relative;
  overflow: hidden;
}

.corsi-section::before {
  content: '';
