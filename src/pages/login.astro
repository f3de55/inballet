---
/**
 * Login dashboard admin. Il form invia l'Action `auth.login` (funziona anche
 * senza JavaScript); in caso di successo si va alla dashboard.
 */
import { Image } from 'astro:assets';
import { actions } from 'astro:actions';
import Admin from '../layouts/Admin.astro';
import logo from '../assets/images/logo.png';
import { isLoggedIn } from '../lib/auth';
import '../styles/admin/login.css';

export const prerender = false;

const result = Astro.getActionResult(actions.auth.login);
if (result && !result.error) return Astro.redirect('/dashboard');
if (await isLoggedIn(Astro.session)) return Astro.redirect('/dashboard');

const error = result?.error?.message ?? '';
if (result?.error) Astro.response.status = 401;
---

<Admin title="Accedi - Dashboard InBallet">
    <main class="login">
        <div class="login-box">
            <div class="login-head">
                <Image src={logo} alt="InBallet" width={300} format="webp" loading="eager" />
            </div>

            <form class="login-form" method="POST" action={actions.auth.login}>
                <h1>Area riservata</h1>
                <p class="login-sotto">Accedi per gestire eventi e calendario del sito.</p>

                {error && (
                    <p class="login-errore" role="alert">
                        <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                        {error}
                    </p>
                )}

                <label for="password">Password</label>
                <input type="password" id="password" name="password" required autofocus autocomplete="current-password">

                <button type="submit" class="login-btn">Accedi</button>
            </form>
        </div>

        <a href="/" class="login-sito"><i class="fas fa-arrow-left" aria-hidden="true"></i> Torna al sito</a>
    </main>
</Admin>
