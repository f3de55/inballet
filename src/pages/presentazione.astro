---
import '../styles/components/linee.css';
import '../styles/components/movimento.css';
import '../styles/admin/presentazione.css';
import { Image } from 'astro:assets';
import Admin from '../layouts/Admin.astro';
import { isLoggedIn } from '../lib/auth';
import { enfatizza } from '../lib/text';
import { passi, type Apertura } from '../data/presentazione';
import copertina from '../assets/images/presentazione/copertina-inballet.webp';
import sitoOggi from '../assets/images/presentazione/sito-oggi.webp';
import nuovoSito from '../assets/images/presentazione/nuovo-sito.webp';
import google from '../assets/images/presentazione/google.webp';
import scuole from '../assets/images/presentazione/scuole.webp';
import dashboard from '../assets/images/presentazione/dashboard.webp';
import prossimi from '../assets/images/presentazione/prossimi.webp';
import telefono from '../assets/images/presentazione/telefono-realistico.webp';

export const prerender = false;

if (!(await isLoggedIn(Astro.session))) return Astro.redirect('/login?da=/presentazione');

const schermi = Math.max(...passi.map((p) => (p.scena.tipo === 'siti' || p.scena.tipo === 'confronto' ? p.scena.schermi.length : 0)));
const totale = passi.length - 1;
const immagini: Record<Apertura, ImageMetadata> = { copertina, 'sito-oggi': sitoOggi, 'nuovo-sito': nuovoSito, google, scuole, dashboard, prossimi };
const nomePannello = (i: number) => {
    const scena = passi[i].scena;
    return scena.tipo === 'pannello' ? scena.pannello : '';
};
---

<Admin title="Presentazione del nuovo sito - InBallet">
    <main class="pres-palco" data-pres data-modo="apertura" tabindex="-1">
        <h1 class="sr-only">Proposta di restyling del sito InBallet</h1>
        <div class="pres-schermi" data-schermi>
            {Array.from({ length: schermi }, (_, n) => (
                <figure class="pres-schermo" data-schermo hidden>
                    <figcaption class="pres-nome" data-sito></figcaption>
                    <div class="pres-vista" data-vista>
                        <img class="pres-telefono" src={telefono.src} width={telefono.width} height={telefono.height} alt="" aria-hidden="true" />
                        <div class="pres-scala" data-scala>
                            <iframe data-frame title="Sito dal vivo"></iframe>
                            <div class="pres-faro" data-faro hidden></div>
                            <div class="pres-barrato" data-barrato hidden></div>
                            <div class="pres-tocco" data-tocco hidden></div>
                            {n === 0 && (
                                <section class="pres-serp" data-serp aria-label="Il nuovo sito su Google" hidden>
                                    <div class="pres-serp-risultato">
                                        <p class="pres-serp-nome"><img src="/favicon.ico" alt="" width="26" height="26" class="pres-serp-icona">InBallet<cite data-serp-url>https://www.inballet.it</cite></p>
                                        <h3 class="pres-serp-titolo" data-serp-titolo>Lettura in corso</h3>
                                        <p class="pres-serp-descrizione" data-serp-descrizione></p>
                                        <small class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Così apparirà il nuovo sito</small>
                                    </div>
                                </section>
                            )}
                        </div>
                        <p class="pres-bloccato" data-bloccato hidden>
                            Questa pagina non si apre dentro la presentazione.
                            <a href="/" target="_blank" rel="noopener" data-bloccato-link>Aprila in una nuova scheda<span class="sr-only"> (si apre in una nuova scheda)</span></a>
                        </p>
                    </div>
                </figure>
            ))}
        </div>

        <section class="pres-nota" data-nota aria-label="Spiegazione">
            {passi.map((p, i) => p.scena.tipo === 'siti' && (
                <article class="pres-passo" data-passo={i} data-scena={JSON.stringify(p.scena)} data-google={p.google ? "si" : undefined} aria-labelledby={`pres-passo-${i}`} hidden>
                    <h2 id={`pres-passo-${i}`}>{p.titolo}</h2>
                    <p set:html={enfatizza(p.testo, p.evidenzia ?? [])} />
                    {p.scelte && (
                        <div class="pres-scelte" role="group" aria-label="Scegli un visitatore">
                            {p.scelte.map((s, j) => (
                                <button type="button" class="pres-scelta" data-percorso={s.percorso} aria-pressed={j === 0 ? 'true' : 'false'}>
                                    <strong>{s.etichetta}</strong>
                                    «{s.domanda}»
                                </button>
                            ))}
                        </div>
                    )}
                </article>
            ))}
            {passi.map((p, i) => p.scena.tipo === 'confronto' && p.confronto && (
                <article class="pres-passo pres-confronto" data-passo={i} data-scena={JSON.stringify(p.scena)} aria-labelledby={`pres-passo-${i}`} hidden>
                    <h2 id={`pres-passo-${i}`}>{p.titolo}</h2>
                    <table class="pres-confronto-tabella">
                        <thead>
                            <tr><th scope="col">Il loro sito oggi</th><th scope="col">Il nuovo sito InBallet</th></tr>
                        </thead>
                        <tbody>
                            {p.confronto.map((r) => (
                                <tr>
                                    <td class="pres-punto pres-punto--no"><i class="fas fa-times" aria-hidden="true"></i>{r.loro}</td>
                                    <td class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>{r.noi}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </article>
            ))}
        </section>

        {passi.map((p, i) => p.scena.tipo === 'apertura' && (
            <section class="pres-copertina" data-passo={i} data-scena={JSON.stringify(p.scena)} data-immagine={p.scena.immagine} aria-labelledby={`pres-passo-${i}`} hidden={i > 0}>
                <Image src={immagini[p.scena.immagine]} alt="" widths={[960, 1600]} sizes="100vw" class="pres-copertina-foto" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
                <p class="pres-etichetta">{p.capitolo}</p>
                <h2 id={`pres-passo-${i}`} class="pres-copertina-titolo">{p.titolo}</h2>
                <p class="pres-copertina-testo">{p.testo}</p>
                <div class="pres-copertina-comandi">
                    {i > 0 && <button type="button" class="pres-freccia" data-indietro aria-label="Passo precedente"><i class="fas fa-arrow-left" aria-hidden="true"></i></button>}
                    <button type="button" class="pres-freccia pres-freccia--avanti pres-freccia--grande" data-avanti aria-label={i === 0 ? 'Inizia la presentazione' : 'Passo successivo'}><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
                </div>
            </section>
        ))}

        {passi.map((p, i) => p.scena.tipo === 'pannello' && (
            <section class="pres-pannello" data-passo={i} data-scena={JSON.stringify(p.scena)} aria-labelledby={`pres-passo-${i}`} tabindex="0" hidden>
                <div class="pres-pannello-testa">
                    <p class="pres-etichetta">{p.capitolo}</p>
                    <h2 id={`pres-passo-${i}`}>{p.titolo}</h2>
                    <p set:html={enfatizza(p.testo, p.evidenzia ?? [])} />
                </div>
                {nomePannello(i) === 'mancano' && (
        <ol class="pres-elenco">
                        <li><h3>Foto reali</h3><p>Alcune immagini sono rielaborate, altre generate con l’intelligenza artificiale come segnaposto: vanno sostituite con foto vere di corsi, sedi e insegnanti.</p><small class="pres-chi">Serve da te</small></li>
                        <li><h3>Testi da confermare</h3><p>Alcuni testi sono provvisori: età, orari, corsi e storia della scuola vanno riletti insieme.</p><small class="pres-chi">Serve da te</small></li>
                        <li><h3>Il team</h3><p>Per ogni insegnante servono nome, ruolo, una breve biografia e una foto.</p><small class="pres-chi">Serve da te</small></li>
                        <li><h3>Assistente Étoile</h3><p>Lo completiamo e lo proviamo con le domande vere delle famiglie.</p><small class="pres-chi pres-chi--noi">Tocca a noi</small></li>
                        <li><h3>Pubblicazione</h3><p>Il nuovo sito va su inballet.it, con i vecchi indirizzi già collegati alle pagine nuove.</p><small class="pres-chi pres-chi--noi">Tocca a noi</small></li>
                    </ol>
                )}
                {nomePannello(i) === 'costo' && (
                    <Fragment>
                        <div class="pres-costo">
                            <div>
                                <p class="pres-cifra">€ 1.500</p>
                                <p>Per il sito completo, modifiche concordate fino alla pubblicazione comprese.</p>
                                <div class="pres-ripartizione" aria-hidden="true"><div class="pres-quota"></div><div class="pres-quota pres-quota--ritenuta"></div></div>
                                <dl class="pres-ripartizione-voci">
                                    <div><dt>€ 1.200</dt><dd>a noi</dd></div>
                                    <div><dt>€ 300</dt><dd>ritenuta d’acconto del 20%, versata da InBallet con F24</dd></div>
                                </dl>
                            </div>
                            <ul class="pres-punti">
                                <li class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Progetto e realizzazione da zero, su misura</li>
                                <li class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Tutte le pagine, assistente Étoile e dashboard</li>
                                <li class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Modifiche a testi e foto fino alla pubblicazione</li>
                                <li class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Pubblicazione su inballet.it con i vecchi link collegati</li>
                            </ul>
                        </div>
                        <p><strong>Come funziona.</strong> Prestazione occasionale, senza IVA. <strong>Escluso</strong> il costo a consumo dei servizi esterni (assistente Étoile, Google Maps), da definire insieme prima di pubblicare.</p>
                        <small class="pres-fonte">Importi e adempimenti da confermare con il vostro commercialista.</small>
                    </Fragment>
                )}
                {nomePannello(i) === 'dopo' && (
                    <div class="pres-colonne">
                        <div>
                            <h3>Su cosa puoi contare</h3>
                            <ul class="pres-punti">
                                <li class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Eventi, documenti e insegnanti li aggiorni tu dalla dashboard, senza costi.</li>
                                <li class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Fino alla firma, i ritocchi a grafica e testi sono inclusi.</li>
                                <li class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Controllo annuale facoltativo, € 250: aggiorniamo il codice, verifichiamo che tutto funzioni, controlliamo dominio e DNS.</li>
                                <li class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Il dominio resta di InBallet; se vuoi, ne seguiamo noi il rinnovo.</li>
                            </ul>
                        </div>
                        <div>
                            <h3>I nostri limiti</h3>
                            <ul class="pres-punti">
                                <li class="pres-punto pres-punto--no"><i class="fas fa-times" aria-hidden="true"></i>Lavoriamo senza partita IVA, solo con prestazioni occasionali.</li>
                                <li class="pres-punto pres-punto--no"><i class="fas fa-times" aria-hidden="true"></i>Non possiamo garantire assistenza continuativa né reperibilità.</li>
                                <li class="pres-punto pres-punto--no"><i class="fas fa-times" aria-hidden="true"></i>Dopo la firma, una modifica grande è una nuova prestazione occasionale, ogni tanto.</li>
                                <li class="pres-punto pres-punto--info"><i class="fas fa-key" aria-hidden="true"></i>Per pubblicare ci servono gli accessi all’hosting.</li>
                            </ul>
                        </div>
                    </div>
                )}
                {nomePannello(i) === 'fine' && (
                    <Fragment>
                        <ol class="pres-elenco pres-elenco--passi">
                            <li><h3>Un incontro</h3><p>Rivediamo insieme testi, foto e schede degli insegnanti.</p></li>
                            <li><h3>Le rifiniture</h3><p>Completiamo Étoile e ti accompagniamo nella dashboard.</p></li>
                            <li><h3>Online</h3><p>Pubblichiamo su inballet.it e controlliamo che tutto funzioni.</p></li>
                        </ol>
                        <div class="pres-azioni">
                            <a class="pres-btn pres-btn--avanti" href="/" target="_blank" rel="noopener">Apri il nuovo sito<span class="sr-only"> (si apre in una nuova scheda)</span></a>
                            <a class="pres-btn" href="/dashboard" target="_blank" rel="noopener">Apri la dashboard<span class="sr-only"> (si apre in una nuova scheda)</span></a>
                        </div>
                    </Fragment>
                )}
            </section>
        ))}

        <nav class="pres-navigazione" aria-label="Passi della presentazione">
            <button type="button" class="pres-freccia" data-indietro aria-label="Passo precedente"><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
            <p class="pres-contatore" aria-live="polite"><span data-numero>1</span> / {totale}</p>
            <button type="button" class="pres-freccia pres-freccia--avanti pres-freccia--grande" data-avanti aria-label="Passo successivo"><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
        </nav>
    </main>
    <script>
        import '../scripts/presentazione';
    </script>
</Admin>
