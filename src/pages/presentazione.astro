---
import '../styles/components/linee.css';
import '../styles/components/movimento.css';
import '../styles/admin/presentazione.css';
import { Image } from 'astro:assets';
import Admin from '../layouts/Admin.astro';
import { isLoggedIn } from '../lib/auth';
import { enfatizza } from '../lib/text';
import { passi, RICERCA_GOOGLE, type Apertura } from '../data/presentazione';
import copertina from '../assets/images/presentazione/copertina-inballet.webp';
import sitoOggi from '../assets/images/presentazione/sito-oggi.webp';
import nuovoSito from '../assets/images/presentazione/nuovo-sito.webp';
import google from '../assets/images/presentazione/google.webp';
import scuole from '../assets/images/presentazione/scuole.webp';
import dashboard from '../assets/images/presentazione/dashboard.webp';
import prossimi from '../assets/images/presentazione/prossimi.webp';
import telefono from '../assets/images/presentazione/telefono-realistico.webp';
import famiglie from '../assets/images/presentazione/famiglie-danza.webp';
import adulti from '../assets/images/presentazione/adulti-danza.webp';
import insegnanti from '../assets/images/presentazione/insegnanti-danza.webp';
import scuoleAziende from '../assets/images/presentazione/scuole-aziende-danza.webp';
import sfondoTelefono from '../assets/images/presentazione/fondale-telefono.webp';
import sfondoTelefoni from '../assets/images/presentazione/fondale-telefoni.webp';
import sfondoMancano from '../assets/images/presentazione/fondale-mancano.webp';
import sfondoCosto from '../assets/images/presentazione/fondale-costo.webp';
import sfondoDopo from '../assets/images/presentazione/fondale-dopo.webp';

export const prerender = false;

if (!(await isLoggedIn(Astro.session))) return Astro.redirect('/login?da=/presentazione');

const schermi = Math.max(...passi.map((p) => (p.scena.tipo === 'siti' || p.scena.tipo === 'confronto' ? p.scena.schermi.length : 0)));
const totale = passi.length - 1;
const immagini: Record<Apertura, ImageMetadata> = { copertina, 'sito-oggi': sitoOggi, 'nuovo-sito': nuovoSito, google, scuole, dashboard, prossimi };
const immaginiVisitatori: Record<string, ImageMetadata> = { Famiglie: famiglie, Adulti: adulti, Insegnanti: insegnanti, 'Scuole e aziende': scuoleAziende };
const fondali = { telefono: sfondoTelefono, telefoni: sfondoTelefoni, mancano: sfondoMancano, costo: sfondoCosto, dopo: sfondoDopo };
const LARGO = 1600;
const onda = (y: number, ampiezza: number, onde: number) => {
    const mezza = LARGO / onde / 2;
    const tratti = Array.from({ length: onde * 4 - 1 }, (_, k) => `T ${(k + 2) * mezza} ${y}`).join(' ');
    return `M 0 ${y} Q ${mezza / 2} ${y - ampiezza} ${mezza} ${y} ${tratti}`;
};
const nastri = [onda(560, 90, 2), onda(620, 140, 1), onda(500, 60, 3), onda(700, 110, 2), onda(430, 50, 4)];
const nomePannello = (i: number) => {
    const scena = passi[i].scena;
    return scena.tipo === 'pannello' ? scena.pannello : '';
};
---

<Admin title="Presentazione del nuovo sito - InBallet">
    <main class="pres-palco" data-pres data-modo="apertura" tabindex="-1">
        <h1 class="sr-only">Proposta di restyling del sito InBallet</h1>
        {Object.entries(fondali).map(([nome, immagine]) => (
            <Image src={immagine} alt="" widths={[960, 1600, 1920]} sizes="100vw" class="pres-fondale" data-fondale-foto={nome} aria-hidden="true" loading="lazy" hidden />
        ))}
        <div class="pres-schermi" data-schermi>
            {Array.from({ length: schermi }, () => (
                <figure class="pres-schermo" data-schermo hidden>
                    <figcaption class="pres-nome" data-sito></figcaption>
                    <div class="pres-vista" data-vista>
                        <img class="pres-telefono" src={telefono.src} width={telefono.width} height={telefono.height} alt="" aria-hidden="true" />
                        <div class="pres-scala" data-scala>
                            <div class="pres-faro" data-faro hidden></div>
                            <div class="pres-tocco" data-tocco hidden></div>
                        </div>
                        <p class="pres-bloccato" data-bloccato hidden>
                            Questa pagina non si apre dentro la presentazione.
                            <a href="/" target="_blank" rel="noopener" data-bloccato-link>Aprila in una nuova scheda<span class="sr-only"> (si apre in una nuova scheda)</span></a>
                        </p>
                    </div>
                </figure>
            ))}
        </div>

        <section class="pres-nota" data-nota aria-label="Spiegazione">
            <button type="button" class="pres-chiudi" data-chiudi-nota aria-label="Chiudi la spiegazione"><i class="fas fa-xmark" aria-hidden="true"></i></button>
            {passi.map((p, i) => p.scena.tipo === 'siti' && (
                <article class="pres-passo" data-passo={i} data-scena={JSON.stringify(p.scena)} data-fondale={p.scena.schermi[0]?.dispositivo === 'telefono' ? (p.scena.schermi.length === 1 ? 'telefono' : 'telefoni') : undefined} data-google={p.google ? "si" : undefined} data-riapri={p.scelte ? 'Riapri la scelta' : undefined} aria-labelledby={`pres-passo-${i}`} hidden>
                    <h2 id={`pres-passo-${i}`}>{p.titolo}</h2>
                    {p.testo && <p set:html={enfatizza(p.testo, p.evidenzia ?? [])} />}
                    {p.google && (
                        <section class="pres-serp" aria-label="Il sito su Google, oggi e con il nuovo sito">
                            <div class="pres-serp-risultato pres-serp-risultato--oggi">
                                <p class="pres-serp-nome"><span class="pres-serp-icona"><i class="fas fa-globe" aria-hidden="true"></i></span>inballet.it<cite>https://www.inballet.it</cite></p>
                                <h3 class="pres-serp-titolo">Home</h3>
                                <small class="pres-punto pres-punto--no"><i class="fas fa-times" aria-hidden="true"></i>Così è il sito attuale</small>
                            </div>
                            <div class="pres-serp-risultato">
                                <p class="pres-serp-nome"><img src="/favicon.ico" alt="" width="26" height="26" class="pres-serp-icona">InBallet<cite data-serp-url>https://www.inballet.it</cite></p>
                                <h3 class="pres-serp-titolo" data-serp-titolo>Lettura in corso</h3>
                                <p class="pres-serp-descrizione" data-serp-descrizione></p>
                                <small class="pres-punto pres-punto--si"><i class="fas fa-check" aria-hidden="true"></i>Così apparirà il nuovo sito</small>
                            </div>
                        </section>
                    )}
                    {p.google && <a class="pres-link" href={RICERCA_GOOGLE} target="_blank" rel="noopener">Apri la ricerca vera su Google<span class="sr-only"> (si apre in una nuova scheda)</span></a>}
                    {p.scelte && (
                        <div class="pres-scelte" role="group" aria-label="Scegli un visitatore">
                            {p.scelte.map((s, j) => (
                                <button type="button" class="pres-scelta" data-percorso={s.percorso} aria-pressed={j === 0 ? 'true' : 'false'}>
                                    <Image class="pres-scelta-illustrazione" src={immaginiVisitatori[s.etichetta]} alt="" aria-hidden="true" widths={[160, 320]} sizes="160px" loading="eager" decoding="async" />
                                    <strong>{s.etichetta}</strong>
                                    «{s.domanda}»
                                </button>
                            ))}
                        </div>
                    )}
                </article>
            ))}
            {passi.map((p, i) => p.scena.tipo === 'confronto' && p.difetti && (
                <article class="pres-passo pres-confronto" data-passo={i} data-scena={JSON.stringify(p.scena)} data-riapri="Rivedi cosa non va" aria-labelledby={`pres-passo-${i}`} hidden>
                    <p class="pres-etichetta">Cosa non va</p>
                    <h2 id={`pres-passo-${i}`}>{p.titolo}</h2>
                    <ul class="pres-difetti">
                        {p.difetti.map((d) => (
                            <li class="pres-punto pres-punto--no"><i class="fas fa-times" aria-hidden="true"></i>{d}</li>
                        ))}
                    </ul>
                </article>
            ))}
        </section>

        {passi.map((p, i) => p.scena.tipo === 'apertura' && (
            <section class="pres-copertina" data-passo={i} data-scena={JSON.stringify(p.scena)} data-immagine={p.scena.immagine} aria-labelledby={`pres-passo-${i}`} hidden={i > 0}>
                <Image src={immagini[p.scena.immagine]} alt="" widths={[960, 1600]} sizes="100vw" class="pres-copertina-foto" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
                <div class="pres-nastri" aria-hidden="true">
                    {nastri.map((d) => (
                        <svg class="pres-nastro" viewBox={`0 0 ${LARGO * 2} 900`} preserveAspectRatio="none"><path d={d} /></svg>
                    ))}
                </div>
                <p class="pres-etichetta">{p.capitolo}</p>
                <h2 id={`pres-passo-${i}`} class="pres-copertina-titolo">{p.titolo}</h2>
                <p class="pres-copertina-testo">{p.testo}</p>
            </section>
        ))}

        {passi.map((p, i) => p.scena.tipo === 'pannello' && (
            <section class="pres-pannello" data-passo={i} data-scena={JSON.stringify(p.scena)} data-fondale={nomePannello(i)} aria-labelledby={`pres-passo-${i}`} tabindex="0" hidden>
                <div class="pres-pannello-testa">
                    <p class="pres-etichetta">{p.capitolo}</p>
                    <h2 id={`pres-passo-${i}`}>{p.titolo}</h2>
                </div>
                {nomePannello(i) === 'mancano' && (
                    <div class="pres-colonne">
                        <div>
                            <h3>Da parte vostra</h3>
                            <ul class="pres-righe">
                                <li>Le foto vere di lezioni, spettacoli e sedi</li>
                                <li>Una rilettura dei testi: età, orari, storia</li>
                                <li>Nome, foto e due righe per ogni insegnante</li>
                            </ul>
                        </div>
                        <div>
                            <h3>Da parte nostra</h3>
                            <ul class="pres-righe">
                                <li>Finire Étoile e provarlo con domande vere</li>
                                <li>Mettere il sito online su inballet.it</li>
                            </ul>
                        </div>
                    </div>
                )}
                {nomePannello(i) === 'costo' && (
                    <Fragment>
                        <div class="pres-colonne">
                            <div>
                                <p class="pres-cifra">1.500 €</p>
                                <p>Una volta sola, per tutto il sito.</p>
                            </div>
                            <div>
                                <h3>Cosa comprende</h3>
                                <ul class="pres-righe">
                                    <li>Il sito, fatto su misura</li>
                                    <li>Étoile e la dashboard</li>
                                    <li>Le modifiche fino al lancio</li>
                                </ul>
                            </div>
                        </div>
                        <small class="pres-fonte">1.200 € a noi e 300 € di ritenuta d’acconto, che versate voi con l’F24. Restano fuori i costi a consumo dei servizi esterni.</small>
                    </Fragment>
                )}
                {nomePannello(i) === 'dopo' && (
                    <Fragment>
                        <ul class="pres-righe">
                            <li>Eventi, documenti e insegnanti li aggiornate voi dalla dashboard, <strong>senza costi</strong>.</li>
                            <li>Se volete, una volta l’anno controlliamo che tutto funzioni: <strong>250 €</strong>.</li>
                            <li>Il dominio inballet.it <strong>resta vostro</strong>.</li>
                        </ul>
                        <small class="pres-fonte">Lavoriamo con prestazioni occasionali: niente partita IVA e nessuna reperibilità continua.</small>
                    </Fragment>
                )}
            </section>
        ))}

        <button type="button" class="pres-riapri" data-riapri-nota>Riapri la spiegazione</button>

        <nav class="pres-navigazione" aria-label="Passi della presentazione">
            <button type="button" class="pres-freccia" data-indietro aria-label="Passo precedente"><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
            <p class="pres-contatore" aria-live="polite"><span data-numero>1</span> / {totale}</p>
            <button type="button" class="pres-freccia pres-freccia--avanti pres-freccia--grande" data-avanti aria-label="Passo successivo"><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
        </nav>
    </main>
    <script>
        import '../scripts/presentazione';
    </script>
</Admin>
