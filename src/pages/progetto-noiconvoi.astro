---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondoCta } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import { scuola } from '../data/scuola';
import '../styles/components/intro-split.css';
import '../styles/components/righe.css';
import '../styles/pages/progetto-noiconvoi.css';

const bg = {
  hero: await heroPagina('progetto-noiconvoi'),
  cta: await sfondoCta('foto/bambini-gioco.jpg', { desktop: '50% 40%' }),
};

const fasi = [
  { nome: 'Pratica psicomotoria', icona: 'fa-child', testo: 'Ogni lezione si apre con elementi di <strong>Pratica Psicomotoria Aucouturier (PPA)</strong>: il supporto psicomotorio è la base del progetto.' },
  { nome: 'Didattica artistica', icona: 'fa-music', testo: 'Segue la <strong>parte artistica</strong>, con una didattica costruita sui bisogni dei ragazzi e sul progetto annuale della scuola.' },
];

const destinatari = [
  'Ragazzi con disabilità',
  'Le loro famiglie, accolte fin dal primo incontro',
  'Volontari, anche non danzatori',
  'Aziende e realtà che vogliono fare volontariato',
];

const info = [
  { nome: 'Quando', icona: 'fa-calendar-days', testo: 'Il <strong>lunedì sera</strong>, nella sede di Lainate.' },
  { nome: 'Spettacolo di fine anno', icona: 'fa-masks-theater', testo: 'Ogni anno i ragazzi <strong>salgono sul palco</strong> insieme a tutti gli altri allievi della scuola.' },
  { nome: 'Volontariato', icona: 'fa-hand-holding-heart', testo: '<strong>Volontari, anche non danzatori</strong>, in un team guidato dalla coordinatrice del progetto.' },
  { nome: 'Dal 2013', icona: 'fa-seedling', testo: 'Un progetto che evolve ogni anno e fa della scuola una <strong>comunità educante</strong>.' },
];
---

<Base
    title="Progetto NoiConVoi: danza e disabilità dal 2013 | InBallet"
    description="NoiConVoi, il progetto di volontariato di InBallet: dal 2013 ragazzi con disabilità in sala a Lainate (MI), con danza, supporto psicomotorio e volontari."
    ogTitle="Progetto NoiConVoi, la danza è per tutti | InBallet"
    ogDescription="Dal 2013 ragazzi con disabilità e volontari insieme in sala: psicomotricità, danza e spettacolo di fine anno."
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Section -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Progetto NoiConVoi</h1>
                <p class="hero-lead"><strong>Dal 2013</strong> la danza è per tutti: ragazzi con disabilità, volontari e famiglie insieme in sala.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="intro-split">
            <div class="container intro-split-layout">
                <div class="intro-split-content">
                    <p class="intro-split-label eyebrow">La nostra missione</p>
                    <h2 class="intro-split-title titolo-sezione">La danza come <em>strumento di inclusione</em></h2>
                    <div class="intro-split-testo">
                        <p>NoiConVoi è il <strong>progetto di volontariato</strong> nato nel 2013 da un'idea della Direttrice Artistica {scuola.fondatrice}: la danza è per tutti, e ognuno può portare il proprio <strong>contributo artistico</strong>.</p>
                        <p>Accoglie <strong>ragazzi con disabilità</strong> in esperienze di danza con <strong>supporto psicomotorio</strong>, insieme a un <strong>team di volontari</strong>. Quasi tutti i corsi della scuola sono anche <a href="/classi-integrate">classi integrate</a>.</p>
                    </div>
                    <div class="intro-split-highlight">
                        <p>La danza è capace di creare racconti in tutti i corpi e in tutte le menti.</p>
                        <cite>{scuola.fondatrice}</cite>
                    </div>
                </div>
                <div class="intro-split-visual foto-cornice">
                    <Img src="foto/bambini-mani.jpg" alt="Una mano adulta stringe quella di una bambina durante la lezione" fuoco={{ desktop: '55% 50%' }} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Metodo: intestazione editoriale e due fasi -->
        <section class="noi-metodo-section" aria-labelledby="metodo-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">La metodologia</p>
                <h2 class="titolo-sezione" id="metodo-titolo">Un approccio pedagogico <em>strutturato</em></h2>
                <p>Ogni lezione del <strong>lunedì sera</strong> si articola in due momenti: prima la <strong>pratica psicomotoria</strong>, poi la <strong>danza</strong>.</p>
            </div>
            <div class="container">
                <ol class="fasi-lista">
                    {fasi.map((f) => (
                        <li class="voce">
                            <i class={`fas ${f.icona} voce-icona`} aria-hidden="true"></i>
                            <h3 class="voce-titolo">{f.nome}</h3>
                            <p class="voce-testo" set:html={f.testo} />
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- Destinatari: intestazione a sinistra, elenco a destra -->
        <section class="split-section decoro-onde" aria-labelledby="target-titolo">
            <div class="container split-layout">
                <div class="split-header">
                    <p class="eyebrow">A chi è rivolto</p>
                    <h2 class="titolo-sezione" id="target-titolo">Un progetto <em>aperto a tutti</em></h2>
                    <p class="intro-sezione">NoiConVoi mette insieme ragazzi, famiglie e volontari. Dal 2024 accoglie anche <strong>volontari da aziende</strong> e realtà del territorio, grazie ai <a href="/sostenitori">sostenitori dei progetti sociali</a>.</p>
                </div>
                <ul class="righe">
                    {destinatari.map((d) => (
                        <li class="riga">
                            <i class="riga-icona fas fa-check" aria-hidden="true"></i>
                            <p class="riga-nome">{d}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Informazioni pratiche: intestazione editoriale e quattro voci -->
        <section class="noi-info-section" aria-labelledby="info-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">Come funziona</p>
                <h2 class="titolo-sezione" id="info-titolo">Informazioni <em>pratiche</em></h2>
                <p>Tutto quello che serve sapere per partecipare al progetto.</p>
            </div>
            <div class="container">
                <ul class="info-lista">
                    {info.map((v) => (
                        <li class="voce">
                            <i class={`fas ${v.icona} voce-icona`} aria-hidden="true"></i>
                            <h3 class="voce-titolo">{v.nome}</h3>
                            <p class="voce-testo" set:html={v.testo} />
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Unisciti a <em>NoiConVoi</em></h2>
                <p class="intro-sezione">Vuoi <strong>partecipare</strong> o <strong>diventare volontario</strong>? Contattaci per scoprire come far parte del progetto.</p>
                <div class="cta-pulsanti">
                    <a href={`mailto:${scuola.email}?subject=Progetto%20NoiConVoi%20-%20Richiesta%20Informazioni`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Scrivici
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>
