---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondo } from '../lib/images';
import { scuola } from '../data/scuola';

const bg = {
  hero: await sfondo('gallery-8.jpg', { desktop: '50% 40%', tablet: '50% 45%' }),
  cta: await sfondo('bg-progetti-territorio.jpg', { desktop: '50% 35%' }),
};

const fasi = [
  { nome: 'Pratica psicomotoria', testo: 'Ogni lezione si apre con elementi di Pratica Psicomotoria Aucouturier (PPA): il supporto psicomotorio è la base del progetto.' },
  { nome: 'Didattica artistica', testo: 'Segue la parte artistica, con una didattica costruita sui bisogni dei ragazzi e sul progetto annuale della scuola.' },
];

const destinatari = [
  'Ragazzi con disabilità',
  'Le loro famiglie, accolte fin dal primo incontro',
  'Volontari, anche non danzatori',
  'Aziende e realtà che vogliono fare volontariato',
];

const info = [
  { nome: 'Quando', testo: 'Il lunedì sera, nella sede di Lainate.' },
  { nome: 'Spettacolo di fine anno', testo: 'Ogni anno i ragazzi salgono sul palco insieme a tutti gli altri allievi della scuola.' },
  { nome: 'Volontariato', testo: 'Volontari, anche non danzatori, in un team guidato dalla coordinatrice del progetto.' },
  { nome: 'Dal 2013', testo: 'Un progetto che evolve ogni anno e fa della scuola una comunità educante.' },
];
---

<Base
    title="Progetto NoiConVoi: danza e disabilità dal 2013 | InBallet"
    description="NoiConVoi, il progetto di volontariato di InBallet: dal 2013 ragazzi con disabilità in sala a Lainate (MI), con danza, supporto psicomotorio e volontari."
    ogTitle="Progetto NoiConVoi, la danza è per tutti | InBallet"
    ogDescription="Dal 2013 ragazzi con disabilità e volontari insieme in sala: psicomotricità, danza e spettacolo di fine anno."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Progetto NoiConVoi</h1>
                <p class="chisiamo-hero-tagline">Dal 2013 la danza è per tutti: ragazzi con disabilità, volontari e famiglie insieme in sala.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="noi-intro-section">
            <div class="container noi-intro-layout">
                <div class="noi-intro-content">
                    <span class="noi-intro-label eyebrow">La nostra missione</span>
                    <h2 class="noi-intro-title titolo-sezione">La danza come <em>strumento di inclusione</em></h2>
                    <div class="noi-intro-testo">
                        <p>NoiConVoi è il progetto di volontariato nato nel 2013 da un'idea della Direttrice Artistica {scuola.fondatrice}: la danza è per tutti, e ognuno può portare il proprio contributo artistico.</p>
                        <p>Accoglie ragazzi con disabilità in esperienze di danza con supporto psicomotorio, insieme a un team di volontari. Quasi tutti i corsi della scuola sono anche <a href="/classi-integrate">classi integrate</a>.</p>
                    </div>
                    <div class="noi-intro-highlight">
                        <p>«La danza è capace di creare racconti in tutti i corpi e in tutte le menti.» ({scuola.fondatrice})</p>
                    </div>
                </div>
                <div class="noi-intro-visual foto-cornice">
                    <Img src="foto/bambini-mani.jpg" alt="Una mano adulta stringe quella di una bambina durante la lezione" fuoco={{ desktop: '55% 50%' }} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Metodo: intestazione editoriale e due fasi -->
        <section class="noi-metodo-section" aria-labelledby="metodo-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">La metodologia</span>
                <h2 class="titolo-sezione" id="metodo-titolo">Un approccio pedagogico <em>strutturato</em></h2>
                <p>Ogni lezione del lunedì sera si articola in due momenti: prima la pratica psicomotoria, poi la danza.</p>
            </div>
            <div class="container">
                <ol class="fasi-lista">
                    {fasi.map((f, i) => (
                        <li class="voce">
                            <span class="voce-anno" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                            <h3 class="voce-titolo">{f.nome}</h3>
                            <p class="voce-testo">{f.testo}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- Destinatari: intestazione a sinistra, elenco a destra -->
        <section class="noi-target-section" aria-labelledby="target-titolo">
            <div class="container noi-target-layout">
                <div class="noi-target-header">
                    <span class="eyebrow">A chi è rivolto</span>
                    <h2 class="titolo-sezione" id="target-titolo">Un progetto <em>aperto a tutti</em></h2>
                    <p class="intro-sezione">NoiConVoi mette insieme ragazzi, famiglie e volontari. Dal 2024 accoglie anche volontari da aziende e realtà del territorio, grazie ai <a href="/sostenitori">sostenitori dei progetti sociali</a>.</p>
                </div>
                <ul class="target-lista">
                    {destinatari.map((d) => (
                        <li class="target">
                            <i class="fas fa-check" aria-hidden="true"></i>
                            <span>{d}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Informazioni pratiche: intestazione editoriale e quattro voci -->
        <section class="noi-info-section" aria-labelledby="info-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">Come funziona</span>
                <h2 class="titolo-sezione" id="info-titolo">Informazioni <em>pratiche</em></h2>
                <p>Tutto quello che serve sapere per partecipare al progetto.</p>
            </div>
            <div class="container">
                <ul class="info-lista">
                    {info.map((v) => (
                        <li class="voce">
                            <h3 class="voce-titolo">{v.nome}</h3>
                            <p class="voce-testo">{v.testo}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA -->
        <section class="noi-cta-section sezione-scura">
            <div class="noi-cta-bg" style={bg.cta.style}></div>
            <div class="noi-cta-overlay"></div>
            <div class="noi-cta-wrapper">
                <h2 class="titolo-sezione">Unisciti a <em>NoiConVoi</em></h2>
                <p class="intro-sezione">Vuoi partecipare o diventare volontario? Contattaci per scoprire come far parte del progetto.</p>
                <div class="noi-cta-buttons">
                    <a href={`mailto:${scuola.email}?subject=Progetto%20NoiConVoi%20-%20Richiesta%20Informazioni`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Scrivici
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
/* ---------- Intro ---------- */
.noi-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.noi-intro-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 5rem;
  align-items: center;
}

.noi-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.noi-intro-title {
  margin-bottom: 1.75rem;
}

.noi-intro-testo p {
  margin-bottom: 1.25rem;
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-dark);
}

.noi-intro-testo p:last-child {
  margin-bottom: 0;
}

/* La cornice sporge a sinistra e in basso: spazio dentro la colonna */
.noi-intro-visual {
  max-width: 520px;
  margin: 0 0 1.5rem 1.5rem;
  justify-self: end;
}

.noi-intro-visual :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

/* ---------- Metodo e informazioni: voci in colonne ---------- */
.noi-metodo-section,
.noi-info-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.fasi-lista,
.info-lista {
  list-style: none;
  display: grid;
  gap: 3rem;
  margin: 3.5rem 0 0;
  padding: 0;
}

.fasi-lista {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.info-lista {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2.5rem;
}

.fasi-lista .voce-testo {
  font-size: var(--text-base);
}

/* ---------- Destinatari ---------- */
.noi-target-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.noi-target-layout {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: start;
}

.noi-target-header .titolo-sezione {
  margin-bottom: 1.25rem;
}

.target-lista {
  list-style: none;
  margin: 0;
  padding: 0;
}

.target {
  display: grid;
  grid-template-columns: 2rem minmax(0, 1fr);
  align-items: baseline;
  gap: .75rem;
  padding: 1.5rem 0;
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.target:first-child {
  padding-top: .5rem;
}

.target:last-child {
  border-bottom: none;
}

.target i {
  font-size: var(--text-base);
  color: var(--primary-blue-dark);
}

.target span {
  font-size: var(--text-base);
  font-weight: 500;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
}

/* ---------- CTA ---------- */
.noi-cta-section {
  position: relative;
  padding: var(--section-y) 0;
  overflow: hidden;
}

.noi-cta-bg,
.noi-cta-overlay {
  position: absolute;
  inset: 0;
}

.noi-cta-bg {
  background: center / cover no-repeat;
}

.noi-cta-overlay {
  background: linear-gradient(135deg, rgba(26, 26, 26, .9) 0%, rgba(42, 42, 42, .85) 100%);
}

.noi-cta-wrapper {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.noi-cta-wrapper .titolo-sezione {
  margin-bottom: 1.25rem;
}

.noi-cta-wrapper .intro-sezione {
  margin-bottom: 2.5rem;
}

.noi-cta-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

/* ---------- Tablet ---------- */
@media (max-width: 1024px) {
  /* Informazioni: griglia 2x2 */
  .info-lista {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  /* Intro: etichetta e titolo, foto, testo, citazione */
  .noi-intro-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .noi-intro-content {
    display: contents;
  }

  .noi-intro-label {
    order: 1;
  }

  .noi-intro-title {
    order: 2;
  }

  .noi-intro-visual {
    order: 3;
    max-width: none;
    margin: 0 0 2.75rem 1.5rem;
  }

  .noi-intro-visual :global(img) {
    aspect-ratio: 3 / 2;
  }

  .noi-intro-testo {
    order: 4;
  }

  .noi-intro-highlight {
    order: 5;
  }

  .fasi-lista,
  .info-lista {
    margin-top: 2.5rem;
  }

  /* Destinatari: intestazione sopra l'elenco */
  .noi-target-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .noi-intro-visual {
    margin: 0 0 2rem .75rem;
  }

  .noi-intro-visual :global(img) {
    aspect-ratio: 4 / 3;
  }

  .fasi-lista,
  .info-lista {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
  }

  .target {
    padding: 1.25rem 0;
  }


  .noi-cta-wrapper {
    padding: 0 1.5rem;
  }

  .noi-cta-buttons {
    flex-direction: column;
    align-items: center;
  }
}
</style>
