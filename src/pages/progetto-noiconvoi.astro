---
import Base from '../layouts/Base.astro';
import { webp } from '../lib/images';

const bg: Record<string, string> = {
  'gallery-4.jpg': await webp('gallery-4.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};
---

<Base
    title="Progetto NoiConVoi - InBallet"
    description="Progetto NoiConVoi InBallet - Iniziativa di volontariato per l'inclusione attraverso la danza. La danza è per tutti, dal 2013."
    ogTitle="Progetto NoiConVoi - InBallet"
    ogDescription="Iniziativa di volontariato dove la danza diventa strumento di inclusione. Perché la danza è per tutti."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-4.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <span class="chisiamo-hero-badge">Dal 2013</span>
                <h1 class="chisiamo-hero-title">Progetto NoiConVoi</h1>
                <p class="chisiamo-hero-tagline">La danza e' per tutti. Inclusione attraverso il movimento.</p>
                <a href="#intro" class="chisiamo-scroll-arrow" aria-label="Scorri in basso">
                    <i class="fas fa-chevron-down"></i>
                </a>
            </div>
        </section>

        <!-- Intro Section -->
        <section id="intro" class="noi-intro-section">
            <div class="noi-intro-wrapper">
                <span class="noi-intro-label">La Nostra Missione</span>
                <h2 class="noi-intro-title">La danza come strumento di inclusione</h2>
                <p class="noi-intro-text">
                    Il progetto <strong>NoiConVoi</strong> rappresenta un'iniziativa di volontariato fondata nel 2013, nata dalla convinzione della Direttrice Artistica che <strong>la danza è per tutti</strong>.
                </p>
                <p class="noi-intro-text">
                    Crediamo che chiunque possa contribuire artisticamente secondo le proprie capacità, trasformando le differenze in ricchezza espressiva e creativa.
                </p>
                <div class="noi-intro-highlight">
                    <p>"La danza non conosce barriere. Ogni persona porta con sé un universo di possibilità espressive che meritano di essere scoperte e valorizzate."</p>
                </div>
            </div>
        </section>

        <!-- Metodo Section - CARD -->
        <section class="noi-metodo-section">
            <div class="noi-metodo-wrapper">
                <div class="noi-metodo-header">
                    <span class="noi-metodo-label">La Metodologia</span>
                    <h2 class="noi-metodo-title">Un approccio pedagogico strutturato</h2>
                    <p class="noi-metodo-subtitle">La nostra struttura pedagogica si articola in due fasi complementari.</p>
                </div>
                <div class="noi-metodo-grid">
                    <div class="noi-metodo-card">
                        <div class="noi-metodo-icon">
                            <i class="fas fa-brain"></i>
                        </div>
                        <h3 class="noi-metodo-name">Pratica Psicomotoria</h3>
                        <p class="noi-metodo-desc">La prima parte della lezione integra elementi di Pratica Psicomotoria Aucouturier (PPA), favorendo lo sviluppo armonico attraverso il gioco e il movimento spontaneo.</p>
                    </div>
                    <div class="noi-metodo-card">
                        <div class="noi-metodo-icon">
                            <i class="fas fa-music"></i>
                        </div>
                        <h3 class="noi-metodo-name">Didattica Artistica</h3>
                        <p class="noi-metodo-desc">La seconda parte propone una didattica artistica adattata alle necessità specifiche dei partecipanti, seguendo la programmazione annuale della scuola.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Target Section -->
        <section class="noi-target-section">
            <div class="noi-target-wrapper">
                <div class="noi-target-header">
                    <span class="noi-target-label">A Chi è Rivolto</span>
                    <h2 class="noi-target-title">Un progetto aperto a tutti</h2>
                    <p class="noi-target-subtitle">NoiConVoi accoglie partecipanti con profili diversi, creando un ambiente di condivisione unico.</p>
                </div>
                <div class="noi-target-list">
                    <div class="noi-target-item">
                        <i class="fas fa-check"></i>
                        <span>Ragazzi con difficoltà e bisogni speciali</span>
                    </div>
                    <div class="noi-target-item">
                        <i class="fas fa-check"></i>
                        <span>Normodotati in classi integrate</span>
                    </div>
                    <div class="noi-target-item">
                        <i class="fas fa-check"></i>
                        <span>Volontari (non necessariamente danzatori)</span>
                    </div>
                    <div class="noi-target-item">
                        <i class="fas fa-check"></i>
                        <span>Famiglie che credono nell'inclusione</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Info Section -->
        <section class="noi-info-section">
            <div class="noi-info-wrapper">
                <div class="noi-info-header">
                    <span class="noi-info-label">Come Funziona</span>
                    <h2 class="noi-info-title">Informazioni pratiche</h2>
                    <p class="noi-info-subtitle">Tutto quello che serve sapere per partecipare al progetto.</p>
                </div>
                <div class="noi-info-grid">
                    <div class="noi-info-item">
                        <div class="noi-info-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="noi-info-content">
                            <h3>Quando</h3>
                            <p>Le lezioni si tengono ogni lunedì sera presso la nostra sede di Lainate.</p>
                        </div>
                    </div>
                    <div class="noi-info-item">
                        <div class="noi-info-icon">
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="noi-info-content">
                            <h3>Spettacolo di Fine Anno</h3>
                            <p>Partecipazione annuale allo spettacolo, esibendosi insieme ai compagni delle classi integrate.</p>
                        </div>
                    </div>
                    <div class="noi-info-item">
                        <div class="noi-info-icon">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div class="noi-info-content">
                            <h3>Volontariato</h3>
                            <p>Progetto basato sul volontariato: non serve essere danzatori per partecipare e contribuire.</p>
                        </div>
                    </div>
                    <div class="noi-info-item">
                        <div class="noi-info-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="noi-info-content">
                            <h3>Ambiente Inclusivo</h3>
                            <p>Un gruppo dove le differenze diventano ricchezza e occasione di crescita per tutti.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="corso-contatto-section">
            <div class="corso-contatto-bg" style={`background: url('${bg['bg-progetti-territorio.jpg']}') center/cover no-repeat`}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2>Unisciti a NoiConVoi</h2>
                    <p>Vuoi partecipare o diventare volontario? Contattaci per scoprire come far parte di questo progetto.</p>
                    <a href="mailto:info@inballet.it?subject=Progetto%20NoiConVoi%20-%20Richiesta%20Informazioni" class="corso-btn-cta">
                        Contattaci <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
.noi-intro-section {
  padding: 5rem 0;
  background: #fff;
}

.noi-intro-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
}

.noi-intro-label {
  display: block;
  font-size: var(--text-sm);
  color: var(--primary-blue-dark);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 1rem;
  text-align: center;
}

.noi-intro-title {
  font-size: var(--text-4xl);
  font-weight: 700;
  color: var(--dark-navy);
  line-height: var(--leading-tight);
  margin-bottom: 2rem;
  text-align: center;
}

.noi-intro-text {
  font-size: var(--text-lg);
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 1.5rem;
  text-align: center;
}

.noi-intro-text :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

.noi-intro-highlight {
  background: rgba(135,206,235,.1);
  border-left: 4px solid var(--primary-blue);
  padding: 1.5rem 2rem;
  border-radius: 0 12px 12px 0;
  margin-top: 2.5rem;
  max-width: 750px;
  margin-left: auto;
  margin-right: auto;
}

.noi-intro-highlight :global(p) {
  font-size: var(--text-base);
  color: var(--dark-navy);
  font-weight: 500;
  margin: 0;
  line-height: 1.7;
  font-style: italic;
}

.noi-metodo-section {
  padding: 5rem 0;
  background: rgba(176,224,230,.1);
}

.noi-metodo-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2rem;
}

.noi-metodo-header {
  text-align: center;
  margin-bottom: 4rem;
}

.noi-metodo-label {
  display: block;
  font-size: var(--text-sm);
  color: var(--primary-blue-dark);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 1rem;
}

.noi-metodo-title {
  font-size: var(--text-4xl);
  font-weight: 700;
  color: var(--dark-navy);
  line-height: var(--leading-tight);
  margin-bottom: 1rem;
}

.noi-metodo-subtitle {
  font-size: var(--text-base);
  color: var(--text-light);
  max-width: 600px;
  margin: 0 auto;
}

.noi-metodo-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 2.5rem;
}

.noi-metodo-card {
  background: #fff;
  padding: 2.5rem 2rem;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,.05);
  border: 1px solid rgba(135,206,235,.15);
  transition: all .3s ease;
  text-align: center;
}

.noi-metodo-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 35px rgba(135,206,235,.2);
  border-color: var(--primary-blue);
}

.noi-metodo-icon {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg,var(--primary-blue) 0%,var(--primary-blue-light) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  color: var(--dark-navy);
  font-size: 2rem;
}

.noi-metodo-name {
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--dark-navy);
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: .5px;
}

.noi-metodo-desc {
  font-size: var(--text-sm);
  color: var(--text-light);
  line-height: 1.7;
}

.noi-target-section {
  padding: 5rem 0;
  background: var(--dark-navy);
  position: relative;
  overflow: hidden;
}

.noi-target-section::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle,rgba(135,206,235,.06) 0,transparent 70%);
  border-radius: 50%;
}

.noi-target-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 2;
}

.noi-target-header {
  text-align: center;
  margin-bottom: 3rem;
}

.noi-target-label {
  display: block;
  font-size: var(--text-sm);
  color: var(--primary-blue);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 1rem;
}

.noi-target-title {
  font-size: var(--text-4xl);
  font-weight: 700;
  color: #fff;
  line-height: var(--leading-tight);
  margin-bottom: 1rem;
}

.noi-target-subtitle {
  font-size: var(--text-lg);
  color: rgba(255,255,255,.7);
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.7;
}

.noi-target-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem 3rem;
  margin-top: 2.5rem;
}

.noi-target-item {
  display: flex;
  align-items: center;
  gap: .8rem;
}

.noi-target-item :global(i) {
  color: var(--primary-blue);
  font-size: 1.1rem;
}

.noi-target-item :global(span) {
  font-size: var(--text-base);
  color: #fff;
  font-weight: 500;
}

.noi-info-section {
  padding: 5rem 0;
  background: #fff;
}

.noi-info-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
}

.noi-info-header {
  text-align: center;
  margin-bottom: 3rem;
}

.noi-info-label {
  display: block;
  font-size: var(--text-sm);
  color: var(--primary-blue-dark);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 1rem;
}

.noi-info-title {
  font-size: var(--text-4xl);
  font-weight: 700;
  color: var(--dark-navy);
  line-height: var(--leading-tight);
  margin-bottom: 1rem;
}

.noi-info-subtitle {
  font-size: var(--text-base);
  color: var(--text-light);
  max-width: 600px;
  margin: 0 auto;
}

.noi-info-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 2rem;
  margin-top: 2.5rem;
}

.noi-info-item {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
}

.noi-info-icon {
  width: 50px;
  height: 50px;
  background: linear-gradient(135deg,var(--primary-blue) 0%,var(--primary-blue-light) 100%);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--dark-navy);
  font-size: 1.2rem;
  flex-shrink: 0;
}

.noi-info-content :global(h3) {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--dark-navy);
  margin-bottom: .3rem;
}

.noi-info-content :global(p) {
  font-size: var(--text-sm);
  color: var(--text-light);
  line-height: 1.6;
  margin: 0;
}

@media(max-width:992px) {
  .noi-metodo-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

@media(max-width:600px) {
  .noi-target-list {
    grid-template-columns: 1fr;
  }

  .noi-info-grid {
    grid-template-columns: 1fr;
  }
}
</style>
