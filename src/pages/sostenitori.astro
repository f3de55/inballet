---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import SostenitoriSection from '../components/SostenitoriSection.astro';
import { webp } from '../lib/images';
import { scuola } from '../data/scuola';

const bg: Record<string, string> = {
  'gallery-2.jpg': await webp('gallery-2.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};

const paypal = 'https://www.paypal.com/cgi-bin/webscr?business=inballetasd%40gmail.com&cmd=_donations&item_name=Custom%20Item&item_number=donazione&currency_code=EUR';

const destinazioni: { nome: string; href?: string }[] = [
  { nome: 'Accoglienza di giovani e adulti con disabilità e delle loro famiglie' },
  { nome: 'Progetto NoiConVoi, danza inclusiva dal 2013', href: '/progetto-noiconvoi' },
  { nome: 'Classi integrate per bambini con bisogni speciali', href: '/classi-integrate' },
  { nome: 'Spettacoli inclusivi aperti alla comunità' },
];
---

<Base
    title="Sostieni i progetti sociali di danza inclusiva | InBallet"
    description="Dal 2013 InBallet accoglie giovani e adulti con disabilità in provincia di Milano. Sostieni i progetti sociali con una donazione o con il volontariato d'impresa."
    ogTitle="Sostieni i progetti sociali | InBallet"
    ogDescription="Donazioni e volontariato d'impresa per la danza inclusiva: dal 2013 in provincia di Milano."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-2.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Sostieni i Nostri Progetti</h1>
                <p class="chisiamo-hero-tagline">Donazioni e volontariato d'impresa per la danza inclusiva, dal 2013.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section class="sost-intro-section">
            <div class="container sost-intro-layout">
                <div class="sost-intro-content">
                    <span class="sost-intro-label eyebrow">La nostra missione</span>
                    <h2 class="sost-intro-title titolo-sezione">Inclusione <em>attraverso la danza</em></h2>
                    <div class="sost-intro-testo">
                        <p>Dal 2013 l'Associazione Sportiva Dilettantistica I.N. Ballet si occupa, oltre che dell'arte della danza, della sua diffusione come disciplina educativa e di sostegno a numerose difficoltà.</p>
                        <p>Ogni anno costruiamo progetti di grande impegno per offrire al territorio della provincia di Milano spazio e tempo per accogliere giovani e adulti con disabilità, come il <a href="/progetto-noiconvoi">progetto NoiConVoi</a>. L'accoglienza parte dalle famiglie, con un momento di conoscenza accurata.</p>
                    </div>
                </div>
                <div class="sost-intro-visual foto-cornice">
                    <Img src="gallery-6.jpg" alt="Allievi in scena durante uno spettacolo" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Volontariato d'impresa: intestazione editoriale -->
        <section class="sost-impresa-section" aria-labelledby="impresa-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">Aziende ed enti, dal 2024</span>
                <h2 class="titolo-sezione" id="impresa-titolo">Volontariato <em>d'impresa</em></h2>
                <p>Dal 2024 abbiamo ampliato i nostri progetti cercando società, aziende, imprese, ditte ed enti con cui collaborare in modo concreto: chi lo desidera può vivere un'esperienza di volontariato, inserendosi nel contesto educativo e di sostegno ai ragazzi.</p>
                <p>Crediamo servano esperienze di vita, anche nel contesto del lavoro, capaci di far nascere riflessioni utili e di spingere ognuno di noi verso azioni di umanità per il prossimo, anche dentro le grandi aziende.</p>
                <p>Il nostro team interno di volontari e i volontari che arrivano dalle realtà lavorative, guidati da chi dirige il progetto educativo, continuano a creare esperienze ricche e indimenticabili, da cui nascono sempre nuovi progetti.</p>
                <div class="sost-impresa-highlight">
                    <p>Siamo sempre alla ricerca di realtà interessate al volontariato e di sostenitori per i nostri progetti sociali: scrivi alla Direzione progettuale ed educativa della scuola.</p>
                </div>
            </div>
        </section>

        <!-- Dona: testo a sinistra, pulsante PayPal a destra -->
        <section id="dona" class="sost-dona-section sezione-scura" aria-labelledby="dona-titolo">
            <div class="container sost-dona-layout">
                <div class="sost-dona-testo">
                    <span class="eyebrow">Dona ora</span>
                    <h2 class="titolo-sezione" id="dona-titolo">Il tuo contributo <em>fa la differenza</em></h2>
                    <p class="intro-sezione">Ogni donazione ci aiuta a continuare il nostro lavoro di inclusione e permette a più persone di vivere l'esperienza della danza.</p>
                </div>
                <div class="sost-dona-azione">
                    <a href={paypal} target="_blank" rel="noopener" class="btn-primary sost-dona-btn">
                        <i class="fab fa-paypal" aria-hidden="true"></i> Dona con PayPal
                    </a>
                    <p class="sost-dona-nota">
                        <i class="fas fa-lock" aria-hidden="true"></i>
                        Pagamento sicuro tramite PayPal
                    </p>
                </div>
            </div>
        </section>

        <!-- Destinazioni: intestazione a sinistra, elenco a destra (con link ai progetti che hanno una pagina) -->
        <section class="sost-utilizzo-section" aria-labelledby="utilizzo-titolo">
            <div class="container sost-utilizzo-layout">
                <div class="sost-utilizzo-header">
                    <span class="eyebrow">I progetti che sostieni</span>
                    <h2 class="titolo-sezione" id="utilizzo-titolo">Dove va <em>la tua donazione</em></h2>
                    <p class="intro-sezione">Le donazioni sostengono i progetti sociali di InBallet.</p>
                </div>
                <ul class="utilizzo-lista">
                    {destinazioni.map((d) => (
                        <li>
                            {d.href ? (
                                <a class="utilizzo utilizzo--link" href={d.href}>
                                    <i class="fas fa-check" aria-hidden="true"></i>
                                    <span class="utilizzo-nome">{d.nome}</span>
                                    <i class="fas fa-arrow-right utilizzo-freccia" aria-hidden="true"></i>
                                </a>
                            ) : (
                                <div class="utilizzo">
                                    <i class="fas fa-check" aria-hidden="true"></i>
                                    <span class="utilizzo-nome">{d.nome}</span>
                                </div>
                            )}
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Loghi dei sostenitori (stessa sezione della homepage, senza il link a questa pagina) -->
        <SostenitoriSection link={false} />

        <!-- CTA -->
        <section class="sost-cta-section sezione-scura">
            <div class="sost-cta-bg" style={`background-image: url('${bg['bg-progetti-territorio.jpg']}')`}></div>
            <div class="sost-cta-overlay"></div>
            <div class="sost-cta-wrapper">
                <h2 class="titolo-sezione">Vuoi saperne <em>di più?</em></h2>
                <p class="intro-sezione">Contatta la Direzione per informazioni sui progetti o per proporre un'esperienza di volontariato con la tua azienda.</p>
                <div class="sost-cta-buttons">
                    <a href={`mailto:${scuola.email}?subject=Informazioni%20Progetti%20Sociali`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Scrivici
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
/* ---------- Intro ---------- */
.sost-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.sost-intro-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 5rem;
  align-items: center;
}

.sost-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.sost-intro-title {
  margin-bottom: 1.75rem;
}

.sost-intro-testo p {
  margin-bottom: 1.25rem;
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--text-dark);
}

.sost-intro-testo p:last-child {
  margin-bottom: 0;
}

/* La cornice sporge a sinistra e in basso: spazio dentro la colonna */
.sost-intro-visual {
  max-width: 520px;
  margin: 0 0 1.5rem 1.5rem;
  justify-self: end;
}

.sost-intro-visual :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

/* ---------- Volontariato d'impresa ---------- */
.sost-impresa-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

/* ---------- Dona ---------- */
.sost-dona-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
}

.sost-dona-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
  gap: 5rem;
  align-items: center;
}

.sost-dona-testo .eyebrow {
  display: block;
  margin-bottom: 1rem;
}

.sost-dona-testo .titolo-sezione {
  margin-bottom: 1.25rem;
}

.sost-dona-azione {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.25rem;
  padding-left: 3rem;
  border-left: 2px solid var(--primary-blue);
}

.sost-dona-btn {
  padding: 1.15rem 2.75rem;
  font-size: 1rem;
}

.sost-dona-btn i {
  font-size: 1.25rem;
}

.sost-dona-nota {
  display: flex;
  align-items: center;
  gap: .6rem;
  margin: 0;
  font-size: .9375rem;
  color: rgba(255, 255, 255, .65);
}

.sost-dona-nota i {
  color: var(--primary-blue);
}

/* ---------- Destinazioni ---------- */
.sost-utilizzo-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.sost-utilizzo-layout {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: start;
}

.sost-utilizzo-header .titolo-sezione {
  margin-bottom: 1.25rem;
}

.utilizzo-lista {
  list-style: none;
  margin: 0;
  padding: 0;
}

.utilizzo-lista li {
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.utilizzo-lista li:last-child {
  border-bottom: none;
}

.utilizzo {
  display: grid;
  grid-template-columns: 2rem minmax(0, 1fr) auto;
  align-items: baseline;
  gap: .75rem;
  padding: 1.5rem 0;
  color: var(--dark-navy);
  text-decoration: none;
}

.utilizzo-lista li:first-child .utilizzo {
  padding-top: .5rem;
}

.utilizzo > .fa-check {
  font-size: 1rem;
  color: var(--primary-blue-dark);
}

.utilizzo-nome {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-snug);
  transition: color .3s ease;
}

.utilizzo-freccia {
  font-size: .9375rem;
  color: var(--primary-blue-dark);
  transition: transform .3s ease;
}

@media (hover: hover) and (pointer: fine) {
  .utilizzo--link:hover .utilizzo-nome {
    color: var(--primary-blue-dark);
  }

  .utilizzo--link:hover .utilizzo-freccia {
    transform: translateX(6px);
  }
}

/* ---------- CTA ---------- */
.sost-cta-section {
  position: relative;
  padding: var(--section-y) 0;
  overflow: hidden;
}

.sost-cta-bg,
.sost-cta-overlay {
  position: absolute;
  inset: 0;
}

.sost-cta-bg {
  background: center / cover no-repeat;
}

.sost-cta-overlay {
  background: linear-gradient(135deg, rgba(26, 26, 26, .9) 0%, rgba(42, 42, 42, .85) 100%);
}

.sost-cta-wrapper {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.sost-cta-wrapper .titolo-sezione {
  margin-bottom: 1.25rem;
}

.sost-cta-wrapper .intro-sezione {
  margin-bottom: 2.5rem;
}

.sost-cta-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

/* ---------- Tablet ---------- */
@media (max-width: 900px) {
  /* Intro: etichetta e titolo, foto, testo */
  .sost-intro-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .sost-intro-content {
    display: contents;
  }

  .sost-intro-label {
    order: 1;
  }

  .sost-intro-title {
    order: 2;
  }

  .sost-intro-visual {
    order: 3;
    max-width: none;
    margin: 0 0 2.75rem 1.5rem;
  }

  .sost-intro-visual :global(img) {
    aspect-ratio: 3 / 2;
  }

  .sost-intro-testo {
    order: 4;
  }

  /* Dona e destinazioni: una colonna */
  .sost-dona-layout,
  .sost-utilizzo-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  .sost-dona-azione {
    padding: .25rem 0 .25rem 1.5rem;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .sost-intro-visual {
    margin: 0 0 2rem .75rem;
  }

  .sost-intro-visual :global(img) {
    aspect-ratio: 4 / 3;
  }

  .sost-intro-testo p {
    font-size: 1rem;
  }

  /* Dona: pulsante a tutta larghezza, senza filetto laterale */
  .sost-dona-azione {
    align-items: stretch;
    padding: 0;
    border-left: none;
  }

  .sost-dona-nota {
    justify-content: center;
    font-size: .875rem;
  }

  .utilizzo {
    padding: 1.25rem 0;
  }

  .utilizzo-nome {
    font-size: 1.125rem;
  }

  .sost-cta-wrapper {
    padding: 0 1.5rem;
  }

  .sost-cta-buttons {
    flex-direction: column;
    align-items: stretch;
  }
}
</style>
