---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import SostenitoriSection from '../components/SostenitoriSection.astro';
import { sfondoCta } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import { scuola } from '../data/scuola';
import '../styles/components/intro-split.css';
import '../styles/components/righe.css';
import '../styles/pages/sostenitori.css';

const bg = {
  hero: await heroPagina('sostenitori'),
  cta: await sfondoCta('gallery-3.jpg', { desktop: '50% 45%' }),
};

const paypal = 'https://www.paypal.com/cgi-bin/webscr?business=inballetasd%40gmail.com&cmd=_donations&item_name=Donazione%20progetti%20sociali%20InBallet&item_number=donazione&currency_code=EUR';

const destinazioni: { nome: string; href?: string }[] = [
  { nome: 'Accoglienza di giovani e adulti con disabilità e delle loro famiglie' },
  { nome: 'Progetto NoiConVoi, danza inclusiva dal 2013', href: '/progetto-noiconvoi' },
  { nome: 'Classi integrate per bambini con bisogni speciali', href: '/classi-integrate' },
];
---

<Base
    title="Sostieni i progetti sociali di danza inclusiva | InBallet"
    description="Dal 2013 InBallet accoglie giovani e adulti con disabilità in provincia di Milano: sostieni i progetti sociali con una donazione o il volontariato d'impresa."
    ogTitle="Sostieni i progetti sociali | InBallet"
    ogDescription="Donazioni e volontariato d'impresa per la danza inclusiva: dal 2013 in provincia di Milano."
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Section -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Sostieni i nostri progetti sociali</h1>
                <p class="hero-lead">Donazioni e <strong>volontariato d'impresa</strong> per la danza inclusiva, dal 2013.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section class="intro-split decoro-onde">
            <div class="container intro-split-layout">
                <div class="intro-split-content">
                    <p class="intro-split-label eyebrow">La nostra missione</p>
                    <h2 class="intro-split-title titolo-sezione">Inclusione <em>attraverso la danza</em></h2>
                    <div class="intro-split-testo">
                        <p><strong>Dal 2013</strong> I.N. Ballet diffonde la danza anche come <strong>disciplina educativa e di sostegno</strong> a chi vive una difficoltà.</p>
                        <p>Ogni anno costruiamo progetti per accogliere in provincia di Milano <strong>giovani e adulti con disabilità</strong>, come il <a href="/progetto-noiconvoi">progetto NoiConVoi</a>, a partire da un momento di conoscenza con le famiglie.</p>
                    </div>
                </div>
                <div class="intro-split-visual foto-cornice">
                    <Img src="gallery-6.jpg" alt="Allievi in scena durante uno spettacolo" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Volontariato d'impresa: intestazione editoriale -->
        <section class="sost-impresa-section" aria-labelledby="impresa-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">Aziende ed enti, dal 2024</p>
                <h2 class="titolo-sezione" id="impresa-titolo">Volontariato <em>d'impresa</em></h2>
                <p>Dipendenti di aziende ed enti possono vivere un'<strong>esperienza di volontariato</strong> accanto ai ragazzi, nel contesto educativo della scuola.</p>
                <p>Crediamo che anche il lavoro possa offrire <strong>esperienze di umanità</strong>: da ogni collaborazione nascono nuovi progetti.</p>
                <div class="sost-impresa-highlight">
                    <p>La tua azienda vuole partecipare o sostenere i progetti sociali? <strong>Scrivi alla Direzione</strong> della scuola.</p>
                </div>
            </div>
        </section>

        <!-- Dona: intestazione editoriale, sotto il pulsante PayPal -->
        <section id="dona" class="sost-dona-section sezione-scura" aria-labelledby="dona-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">Dona ora</p>
                <h2 class="titolo-sezione" id="dona-titolo">Il tuo contributo <em>fa la differenza</em></h2>
                <p class="intro-sezione"><strong>Ogni donazione</strong> ci aiuta a continuare il nostro lavoro di <strong>inclusione</strong> e permette a più persone di vivere l'esperienza della danza.</p>
            </div>
            <div class="container">
                <div class="sost-dona-azione">
                    <a href={paypal} target="_blank" rel="noopener" class="btn-primary sost-dona-btn">
                        <i class="fab fa-paypal" aria-hidden="true"></i> Dona con PayPal
                    </a>
                    <p class="sost-dona-nota testo-piccolo">
                        <i class="fas fa-lock" aria-hidden="true"></i>
                        Pagamento sicuro tramite PayPal
                    </p>
                </div>
            </div>
        </section>

        <!-- Destinazioni: intestazione a sinistra, elenco a destra (con link ai progetti che hanno una pagina) -->
        <section class="split-section split-section--soft decoro-onde decoro-onde--sinistra" aria-labelledby="utilizzo-titolo">
            <div class="container split-layout">
                <div class="split-header">
                    <p class="eyebrow">I progetti che sostieni</p>
                    <h2 class="titolo-sezione" id="utilizzo-titolo">Dove va <em>la tua donazione</em></h2>
                    <p class="intro-sezione">Le donazioni sostengono i <strong>progetti sociali</strong> di InBallet.</p>
                </div>
                <ul class="righe">
                    {destinazioni.map((d) => (
                        <li>
                            {d.href ? (
                                <a class="riga" href={d.href}>
                                    <i class="riga-icona fas fa-check" aria-hidden="true"></i>
                                    <p class="riga-nome">{d.nome}</p>
                                    <i class="riga-freccia fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            ) : (
                                <div class="riga">
                                    <i class="riga-icona fas fa-check" aria-hidden="true"></i>
                                    <p class="riga-nome">{d.nome}</p>
                                </div>
                            )}
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Loghi dei sostenitori (stessa sezione della homepage, senza il link a questa pagina) -->
        <SostenitoriSection link={false} />

        <!-- CTA -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Vuoi saperne <em>di più?</em></h2>
                <p class="intro-sezione">Contatta la Direzione per informazioni sui progetti o per proporre un'<strong>esperienza di volontariato con la tua azienda</strong>.</p>
                <div class="cta-pulsanti">
                    <a href={`mailto:${scuola.email}?subject=Informazioni%20Progetti%20Sociali`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Scrivici
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>
