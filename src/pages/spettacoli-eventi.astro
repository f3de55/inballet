---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { webp } from '../lib/images';

const bg: Record<string, string> = {
  'ballerina.jpg': await webp('ballerina.jpg', 1920),
};
---

<Base
    title="Spettacoli ed Eventi - InBallet"
    description="Spettacoli ed eventi InBallet - Calendario completo di workshop, saggi, spettacoli e corsi aperti della scuola di danza a Lainate e Rho."
    mainFocusable={false}
>
        <!-- Hero -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['ballerina.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Spettacoli ed Eventi</h1>
                <p class="chisiamo-hero-tagline">Scopri tutti gli appuntamenti in programma: spettacoli, workshop, saggi e corsi aperti.</p>
            </div>
        </section>

        <!-- Calendario -->
        <section id="calendario" class="eventi-section">
            <div class="eventi-wrapper">
                <!-- Messaggio Nessun Evento -->
                <div id="noEventiMsg" style="display:none;text-align:center;padding:4rem 2rem">
                    <i class="fas fa-calendar-times" style="font-size:4rem;color:#ccc;margin-bottom:1.5rem"></i>
                    <h3 style="font-size:1.5rem;color:var(--dark-navy);margin-bottom:.5rem">Nessun evento disponibile</h3>
                    <p style="color:var(--text-light);font-size:1rem">Al momento non ci sono eventi in programma. Torna presto per scoprire le novità!</p>
                </div>

                <!-- Calendario Content -->
                <div id="calendarioContent">
                    <!-- Tabs -->
                    <div class="vista-tabs">
                        <button class="vista-tab active" data-vista="mese">Mese</button>
                        <button class="vista-tab" data-vista="settimana">Settimana</button>
                    </div>

                    <!-- Vista Mese -->
                    <div class="vista-mese active" id="vistaMese">
                    <div class="calendario-nav">
                        <div class="nav-mese"><button id="btnMesePrev" title="Mese precedente"><i class="fas fa-chevron-left"></i></button></div>
                        <h2 class="mese-corrente" id="meseCorrente"></h2>
                        <div class="nav-mese"><button id="btnMeseNext" title="Mese successivo"><i class="fas fa-chevron-right"></i></button></div>
                    </div>
                    <div class="calendario-container">
                        <div class="calendario-grid" id="calendarioGrid"></div>
                    </div>
                </div>

                <!-- Vista Settimana -->
                <div class="vista-settimana" id="vistaSettimana">
                    <div class="calendario-nav">
                        <div class="nav-mese"><button id="btnSettPrev" title="Settimana precedente"><i class="fas fa-chevron-left"></i></button></div>
                        <h2 class="mese-corrente" id="rangeSettimana"></h2>
                        <div class="nav-mese"><button id="btnSettNext" title="Settimana successiva"><i class="fas fa-chevron-right"></i></button></div>
                    </div>
                    <div class="settimana-calendario-container">
                        <div class="settimana-headers" id="settimanaHeaders"></div>
                        <div class="settimana-grid" id="settimanaGrid"></div>
                    </div>
                </div>
                </div>
            </div>
        </section>

    <Fragment slot="after-main">
    <!-- Modale Evento -->
    <div class="evento-modal" id="eventoModal">
        <div class="modal-content">
            <button type="button" class="modal-close" data-chiudi-evento title="Chiudi" aria-label="Chiudi"><i class="fas fa-times"></i></button>
            <div class="modal-header">
                <div class="modal-badges" id="modalBadges"></div>
                <h2 class="modal-titolo" id="modalTitolo"></h2>
                <div class="modal-data-row">
                    <span class="modal-data" id="modalData"></span>
                    <button type="button" class="modal-share-btn" id="btnCondividi" title="Condividi evento" aria-label="Condividi evento"><i class="fas fa-share-alt"></i></button>
                </div>
            </div>
            <div class="modal-body">
                <div class="modal-main-grid" id="modalMainGrid">
                    <div class="modal-dettagli">
                        <div class="modal-dettagli-title">Dettagli dell'Evento</div>
                        <p class="modal-descrizione" id="modalDescrizione"></p>
                    </div>
                    <div class="modal-locandina" id="modalLocandinaWrap" style="display:none">
                        <img id="modalLocandina" alt="Locandina evento">
                    </div>
                </div>

                <div class="modal-info-grid" id="modalInfoGrid"></div>

                <div class="modal-calendar-section">
                    <div class="modal-calendar-title"><i class="fas fa-calendar-plus"></i> Aggiungi al tuo calendario</div>
                    <div class="modal-calendar-btns">
                        <button type="button" class="btn-calendar" id="btnGoogle" style="border:none;cursor:pointer">
                            <svg viewBox="0 0 24 24" width="20" height="20"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                            Google Calendar
                        </button>
                        <button type="button" class="btn-calendar" id="btnApple" style="border:none;cursor:pointer">
                            <i class="fab fa-apple"></i>
                            Apple Calendar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modale Lista Eventi (multi-evento) -->
    <div class="lista-modal" id="listaModal">
        <div class="lista-modal-content">
            <div class="lista-modal-header">
                <h3 id="listaModalTitolo">Eventi del giorno</h3>
                <button type="button" class="modal-close" data-chiudi-lista aria-label="Chiudi"><i class="fas fa-times"></i></button>
            </div>
            <div class="lista-modal-body" id="listaModalBody"></div>
        </div>
    </div>

    <!-- Lightbox Immagine -->
    <div class="lightbox" id="lightbox">
        <button type="button" class="lightbox-close" data-chiudi-lightbox title="Chiudi" aria-label="Chiudi"><i class="fas fa-times"></i></button>
        <img id="lightboxImg" alt="Locandina ingrandita">
    </div>
    </Fragment>

    <Fragment slot="scripts">
    <script>
        import '../scripts/calendario';
    </script>
    </Fragment>
</Base>

<style>
.eventi-section {
  padding: var(--section-y) 0;
  background: #fff;
}

.eventi-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.vista-tabs {
  display: flex;
  justify-content: center;
  gap: .5rem;
  margin-bottom: 2rem;
}

.vista-tab {
  padding: .8rem 1.5rem;
  background: #f0f4f8;
  border: none;
  border-radius: 25px;
  cursor: pointer;
  font-weight: 600;
  font-size: var(--text-sm);
  color: var(--text-light);
  transition: all .3s;
}

.vista-tab.active {
  background: var(--primary-blue);
  color: var(--dark-navy);
}

.vista-tab:hover:not(.active) {
  background: #e2e8f0;
}

.calendario-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding: 1rem 1.5rem;
  background: #f8fafc;
  border-radius: 16px;
}

.mese-corrente {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--dark-navy);
}

.nav-mese {
  display: flex;
  gap: .5rem;
}

.nav-mese :global(button) {
  width: 44px;
  height: 44px;
  border: 1px solid rgba(135,206,235,.3);
  background: #fff;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
  color: var(--text-dark);
  font-size: 1rem;
}

.nav-mese :global(button:hover:not(:disabled)) {
  background: var(--primary-blue);
  border-color: var(--primary-blue);
}

.nav-mese :global(button:disabled) {
  opacity: .3;
  cursor: not-allowed;
}

:global(.nav-mese button.hidden) {
  visibility: hidden;
}

.calendario-container {
  background: #fff;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid #e2e8f0;
}

.calendario-grid {
  display: grid;
  grid-template-columns: repeat(7,1fr);
}

:global(.giorno-header) {
  padding: 1rem .5rem;
  text-align: center;
  font-weight: 600;
  font-size: var(--text-xs);
  color: var(--primary-blue-dark);
  text-transform: uppercase;
  letter-spacing: 1px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

:global(.giorno-cella) {
  min-height: 110px;
  background: #fff;
  padding: .8rem;
  position: relative;
  border-right: 1px solid #e9ecef;
  border-bottom: 1px solid #e9ecef;
  transition: all .2s;
  cursor: pointer;
}

:global(.giorno-cella:nth-child(7n)) {
  border-right: none;
}

:global(.giorno-cella:hover) {
  background: #f8fafc;
}

:global(.giorno-cella.vuoto) {
  background: #fafafa;
  cursor: default;
}

:global(.giorno-cella.vuoto:hover) {
  background: #fafafa;
}

:global(.giorno-cella.oggi) {
  background: rgba(135,206,235,.15);
  border: 2px solid var(--primary-blue);
}

:global(.giorno-cella.passato) {
  background: #f7f7f7;
}

:global(.giorno-cella.passato .giorno-numero) {
  color: #aaa;
}

:global(.giorno-numero) {
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--dark-navy);
  margin-bottom: .5rem;
}

:global(.giorno-cella.oggi .giorno-numero) {
  color: var(--primary-blue-dark);
  font-size: 1.2rem;
}

:global(.evento-mini) {
  font-size: 11px;
  padding: 5px 8px;
  margin-bottom: 4px;
  border-radius: 6px;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 500;
  background: rgba(135,206,235,.3);
  color: var(--dark-navy);
  transition: all .2s;
}

:global(.evento-mini:hover) {
  background: rgba(135,206,235,.5);
}

:global(.evento-mini.passato) {
  background: #e0e0e0;
  color: #888;
}

:global(.piu-eventi) {
  font-size: 11px;
  color: var(--primary-blue-dark);
  font-weight: 600;
  cursor: pointer;
  padding: 2px 0;
}

.vista-settimana {
  display: none;
}

.vista-settimana.active,
.vista-mese.active {
  display: block;
}

.vista-mese {
  display: none;
}

.settimana-calendario-container {
  background: #fff;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid #e2e8f0;
}

.settimana-headers {
  display: none;
}

.settimana-grid {
  display: grid;
  grid-template-columns: repeat(7,1fr);
  gap: 1rem;
  padding: 1rem;
}

:global(.settimana-giorno) {
  background: #fff;
  border-radius: 12px;
  padding: 1.2rem;
  min-height: 200px;
  border: 1px solid #e2e8f0;
  position: relative;
  cursor: pointer;
}

:global(.settimana-giorno.oggi) {
  border-color: var(--primary-blue);
  background: rgba(135,206,235,.08);
}

:global(.settimana-giorno.passato) {
  background: #f9f9f9;
}

:global(.settimana-giorno-info) {
  margin-bottom: .8rem;
}

:global(.settimana-giorno-eventi) {
  display: flex;
  flex-direction: column;
  gap: .3rem;
}

:global(.settimana-data) {
  font-weight: 700;
  font-size: 1.5rem;
  color: var(--dark-navy);
  margin-bottom: .3rem;
}

:global(.settimana-nome) {
  font-size: var(--text-xs);
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: .5px;
  margin-bottom: .3rem;
}

:global(.piu-eventi-sett) {
  font-size: 11px;
  color: var(--primary-blue-dark);
  font-weight: 600;
  cursor: pointer;
  padding: 2px 0;
}

.evento-modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.65);
  z-index: 100000;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  backdrop-filter: blur(4px);
}

.evento-modal.open {
  display: flex;
}

.modal-content {
  background: #fff;
  border-radius: 20px;
  max-width: 680px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 25px 80px rgba(0,0,0,.25);
  animation: modalSlide .3s ease;
  position: relative;
}

@keyframes modalSlide {from{opacity:0;transform:translateY(30px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}

.modal-close {
  position: absolute;
  top: 1.2rem;
  right: 1.2rem;
  width: 40px;
  height: 40px;
  border: none;
  background: #f5f5f5;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s,color .2s;
  color: #666;
  font-size: 1rem;
  z-index: 10;
}

.modal-close:hover {
  background: #eee;
  color: #333;
}

.modal-header {
  padding: 2rem 2rem 1.5rem;
  border-bottom: 1px solid #f0f0f0;
}

.modal-badges {
  display: flex;
  gap: .5rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

:global(.modal-tipo-badge) {
  display: inline-block;
  padding: .4rem 1rem;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .5px;
  background: var(--primary-blue);
  color: var(--dark-navy);
}

:global(.modal-tipo-badge.passato) {
  background: #e0e0e0;
  color: #666;
}

.modal-titolo {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--dark-navy);
  margin: 0 0 .8rem;
  line-height: 1.25;
  letter-spacing: -.02em;
}

.modal-data-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.modal-data {
  color: var(--primary-blue-dark);
  font-weight: 500;
  font-size: 1rem;
}

.modal-share-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--primary-blue);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--dark-navy);
  transition: all .2s;
  flex-shrink: 0;
}

.modal-share-btn:hover {
  transform: scale(1.08);
  box-shadow: 0 4px 12px rgba(135,206,235,.4);
}

.modal-body {
  padding: 1.5rem 2rem 2rem;
}

.modal-main-grid {
  display: grid;
  grid-template-columns: 1fr 180px;
  gap: 2rem;
  margin-bottom: 1.5rem;
}

.modal-main-grid.no-image {
  grid-template-columns: 1fr;
}

.modal-dettagli-title {
  font-size: .85rem;
  font-weight: 600;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: .8px;
  margin-bottom: .8rem;
}

.modal-descrizione {
  font-size: 1rem;
  line-height: 1.75;
  color: var(--text-dark);
}

.modal-descrizione :global(ul) {
  margin: .8rem 0;
  padding-left: 1.5rem;
}

.modal-descrizione :global(li) {
  margin: .4rem 0;
}

.modal-descrizione :global(b),
.modal-descrizione :global(strong) {
  font-weight: 600;
}

.modal-descrizione :global(i),
.modal-descrizione :global(em) {
  font-style: italic;
}

.modal-locandina {
  width: 180px;
  height: auto;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0,0,0,.12);
  cursor: pointer;
  flex-shrink: 0;
}

.modal-locandina :global(img) {
  width: 100%;
  height: auto;
  display: block;
}

.modal-info-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: .8rem;
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid #f0f0f0;
}

:global(.modal-info-card) {
  display: flex;
  align-items: center;
  gap: .7rem;
  padding: .7rem .9rem;
  background: #f8fafc;
  border-radius: 10px;
}

:global(.modal-info-icon) {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: rgba(135,206,235,.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-blue-dark);
  flex-shrink: 0;
  font-size: .85rem;
}

:global(.modal-info-text) {
  display: flex;
  flex-direction: column;
  gap: 0;
}

:global(.modal-info-label) {
  font-weight: 600;
  color: var(--dark-navy);
  font-size: .7rem;
  text-transform: uppercase;
  letter-spacing: .3px;
}

:global(.modal-info-value) {
  color: var(--text-dark);
  font-size: .9rem;
}

.modal-calendar-section {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid #f0f0f0;
}

.modal-calendar-title {
  display: flex;
  align-items: center;
  gap: .6rem;
  font-size: .8rem;
  font-weight: 600;
  color: var(--text-light);
  text-transform: uppercase;
  letter-spacing: .5px;
  margin-bottom: 1rem;
}

.modal-calendar-title :global(i) {
  color: var(--primary-blue-dark);
}

.modal-calendar-btns {
  display: flex;
  gap: .8rem;
  flex-wrap: wrap;
}

.btn-calendar {
  display: flex;
  align-items: center;
  gap: .7rem;
  padding: .9rem 1.3rem;
  border-radius: 10px;
  text-decoration: none;
  font-weight: 600;
  font-size: .9rem;
  transition: all .2s;
  border: 1px solid var(--primary-blue);
  background: rgba(135,206,235,.08);
  color: var(--dark-navy);
  cursor: pointer;
}

.btn-calendar :global(svg),
.btn-calendar :global(i) {
  flex-shrink: 0;
}

.btn-calendar :global(i) {
  font-size: 1.1rem;
}

.lista-modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.65);
  z-index: 100000;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  backdrop-filter: blur(4px);
}

.lista-modal.open {
  display: flex;
}

.lista-modal-content {
  background: #fff;
  border-radius: 16px;
  max-width: 400px;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 25px 80px rgba(0,0,0,.25);
  animation: modalSlide .3s ease;
}

.lista-modal-header {
  padding: 1.5rem;
  border-bottom: 1px solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lista-modal-header :global(h3) {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--dark-navy);
  margin: 0;
}

.lista-modal-header .modal-close {
  position: static;
  width: 36px;
  height: 36px;
}

.lista-modal-body {
  padding: 1rem;
}

:global(.lista-evento-item) {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  border-radius: 12px;
  cursor: pointer;
  transition: background .2s;
  border: 1px solid #f0f0f0;
  margin-bottom: .5rem;
}

:global(.lista-evento-item:last-child) {
  margin-bottom: 0;
}

:global(.lista-evento-item:hover) {
  background: #f8fafc;
}

:global(.lista-evento-dot) {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary-blue);
  flex-shrink: 0;
}

:global(.lista-evento-dot.passato) {
  background: #ccc;
}

:global(.lista-evento-info) {
  flex: 1;
  min-width: 0;
}

:global(.lista-evento-titolo) {
  font-weight: 600;
  color: var(--dark-navy);
  font-size: .95rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

:global(.lista-evento-ora) {
  font-size: .8rem;
  color: var(--text-light);
}

.lightbox {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.92);
  z-index: 200000;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  cursor: zoom-out;
  opacity: 0;
}

.lightbox.open {
  display: flex;
  opacity: 1;
}

.lightbox :global(img) {
  max-width: 90%;
  max-height: 90vh;
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0,0,0,.5);
  cursor: default;
  opacity: 1;
}

