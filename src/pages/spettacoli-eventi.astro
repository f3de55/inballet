---
/**
 * Spettacoli ed eventi: calendario degli appuntamenti salvati dalla dashboard,
 * renderizzato dal server a ogni richiesta (l'elenco è nell'HTML, leggibile dai
 * motori di ricerca, con i dati strutturati schema.org/Event).
 * Il dettaglio di un evento si apre in un modale; il link ?evento=<slug> lo apre
 * direttamente e, condiviso, mostra titolo e locandina nell'anteprima social.
 * La vista "Calendario" (griglia del mese) è disegnata dal browser.
 */
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { sfondo } from '../lib/images';
import {
  datiStrutturati,
  ETICHETTE_STATO,
  eventiPubblici,
  linkGoogleCalendar,
  maiuscola,
  passato,
  quando,
  sedeDi,
  srcImmagine,
  testoDescrizione,
  trovaEvento,
  urlEvento,
  urlIcs,
  type Evento,
} from '../lib/eventi';
import { romeDate } from '../lib/time';

export const prerender = false;

const site = Astro.site ?? new URL(Astro.url.origin);

// ?evento=<slug> (anche uno slug precedente o il vecchio id): il modale si apre da solo
const richiesto = Astro.url.searchParams.get('evento');
const trovato = richiesto ? await trovaEvento(richiesto) : null;
const aperto = trovato && trovato.evento.stato !== 'bozza' ? trovato.evento : null;

const bg = {
  hero: await sfondo('ballerina.jpg'),
};

/** Eventi curati dalla Direzione oltre al calendario della scuola. */
const tipiEvento = [
  { nome: 'Spettacolo annuale in teatro', testo: 'Ogni anno uno Spettacolo in teatro, con gli allievi e i progetti artistici e pedagogici della scuola.' },
  { nome: 'Eventi celebrativi', testo: 'La danza come fulcro o come arricchimento di eventi celebrativi one-shot e occasioni speciali.' },
  { nome: 'Nelle scuole', testo: "Momenti su misura nelle scuole dell'infanzia, primarie e secondarie, nell'ambito delle <a href=\"/collaborazioni-scuole\">collaborazioni con le scuole</a>." },
  { nome: 'Team building aziendali', testo: 'Progetti esperienziali su misura per aziende e gruppi di lavoro.' },
  { nome: 'Eventi formativi', testo: 'Incontri che attivano linguaggi diversi tra loro, come le <a href="/formazioni-personalizzate">formazioni personalizzate</a>.' },
  { nome: 'Sul territorio', testo: 'Spesso ospiti di iniziative a Milano e in provincia.' },
];

const MESI = ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre'];
const GIORNI_BREVI = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];

const adesso = Date.now();
const oggi = romeDate(adesso);
const domani = romeDate(adesso + 86_400_000);

const eventi = await eventiPubblici();
const prossimi = eventi.filter((e) => !passato(e, adesso));
const passati = eventi.filter((e) => passato(e, adesso)).reverse();

/** Eventi raggruppati per mese di inizio, nell'ordine ricevuto. */
function perMese(lista: Evento[]) {
  const gruppi = new Map<string, Evento[]>();
  for (const e of lista) gruppi.set(e.data.slice(0, 7), [...(gruppi.get(e.data.slice(0, 7)) ?? []), e]);
  return [...gruppi].map(([k, ev]) => {
    const [y, m] = k.split('-').map(Number);
    return { titolo: `${MESI[m - 1]} ${y}`, eventi: ev };
  });
}

/** Dati di una riga dell'elenco. */
function voce(e: Evento) {
  const [y, m, d] = e.data.split('-').map(Number);
  const finito = passato(e, adesso);
  const inCorso = !finito && e.data < oggi;
  const vicino = e.data === oggi || inCorso ? (e.dataFine ? 'In corso' : 'Oggi') : e.data === domani ? 'Domani' : '';
  let fino = '';
  if (e.dataFine) {
    const [, mf, df] = e.dataFine.split('-').map(Number);
    fino = `Fino a ${GIORNI_BREVI[new Date(Date.UTC(y, mf - 1, df)).getUTCDay()].toLowerCase()} ${df}${mf !== m ? ` ${MESI[mf - 1].toLowerCase()}` : ''}`;
  }
  return {
    e,
    giorno: d,
    settimana: GIORNI_BREVI[new Date(Date.UTC(y, m - 1, d)).getUTCDay()],
    vicino: finito ? '' : vicino,
    stato: e.stato === 'pubblicato' ? '' : ETICHETTE_STATO[e.stato],
    ora: e.ora ? `${e.ora}${e.oraFine ? `–${e.oraFine}` : ''}` : '',
    fino,
    finito,
  };
}

const gruppiProssimi = perMese(prossimi);
const gruppiPassati = perMese(passati);

// Dati per la vista calendario (griglia del mese disegnata dal browser)
const datiCalendario = {
  oggi,
  eventi: eventi.map((e) => ({ titolo: e.titolo, url: urlEvento(e), data: e.data, dataFine: e.dataFine, passato: passato(e, adesso), annullato: e.stato === 'annullato' })),
};
---

<Base
    title="Spettacoli ed eventi di danza a Lainate e Rho | InBallet"
    description="Spettacoli, saggi e workshop di InBallet a Lainate e Rho, più eventi su misura: spettacolo annuale in teatro, eventi nelle scuole e team building aziendali."
    ogTitle="Spettacoli ed Eventi | InBallet"
    ogDescription="Il calendario degli appuntamenti e gli eventi curati dalla Direzione: teatro, scuole, aziende e territorio."
>
        <!-- Hero -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Spettacoli ed eventi</h1>
                <p class="chisiamo-hero-tagline">Scopri tutti gli appuntamenti in programma: spettacoli, workshop, saggi e corsi aperti.</p>
            </div>
        </section>

        <!-- Calendario: elenco dei prossimi appuntamenti (vista principale) o griglia del mese.
             Escluso dal testo letto dal chatbot: gli eventi gli arrivano già aggiornati. -->
        <section id="calendario" class="eventi-section" aria-labelledby="eventi-titolo" data-chatbot-escludi>
            <div class="container">
                <header class="eventi-header">
                    <div class="eventi-intro">
                        <span class="eyebrow">Calendario</span>
                        <h2 class="titolo-sezione" id="eventi-titolo">Prossimi <em>appuntamenti</em></h2>
                        <p class="intro-sezione">Spettacoli, saggi, workshop e lezioni aperte a Lainate e Rho. Apri un evento per leggere i dettagli e aggiungerlo al tuo calendario.</p>
                    </div>
                    {eventi.length > 0 && (
                        <div class="vista-switch" id="vistaSwitch" role="group" aria-label="Visualizzazione" hidden>
                            <button type="button" data-vista="elenco" aria-pressed="true"><i class="fas fa-list" aria-hidden="true"></i> Elenco</button>
                            <button type="button" data-vista="calendario" aria-pressed="false"><i class="fas fa-calendar-alt" aria-hidden="true"></i> Calendario</button>
                        </div>
                    )}
                </header>

                <!-- Nessun appuntamento futuro (gli eventi passati restano consultabili sotto) -->
                {prossimi.length === 0 && (
                    <div class="eventi-vuoto">
                        <h3>Nessun appuntamento in programma</h3>
                        <p>Stiamo preparando le prossime date: spettacoli, saggi e workshop vengono pubblicati qui appena confermati.</p>
                        <a href="/contatti" class="link-cta">
                            Chiedi informazioni
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                )}

                <!-- Vista elenco -->
                <div class="vista-elenco" id="vistaElenco">
                    {[{ gruppi: gruppiProssimi, passati: false }, { gruppi: gruppiPassati, passati: true }].map(({ gruppi, passati: sonoPassati }) => {
                        const elenco = gruppi.map((mese) => (
                            <div class="agenda-gruppo">
                                <h3 class="agenda-mese">{mese.titolo}</h3>
                                <ul class="agenda">
                                    {mese.eventi.map(voce).map((v) => (
                                        <li class:list={{ passato: v.finito, annullato: v.e.stato === 'annullato' }}>
                                            <a class="agenda-voce" href={urlEvento(v.e)}>
                                                <span class="agenda-data">
                                                    <span class="agenda-giorno">{v.giorno}</span>
                                                    <span class="agenda-settimana">{v.settimana}</span>
                                                </span>
                                                <span class="agenda-testo">
                                                    {(v.e.tipo || v.vicino || v.stato) && (
                                                        <span class="agenda-sopra">
                                                            {v.vicino && <span class="agenda-vicino">{v.vicino}</span>}
                                                            {v.stato && <span class="agenda-stato">{v.stato}</span>}
                                                            {v.e.tipo && <span class="agenda-tipo">{v.e.tipo}</span>}
                                                        </span>
                                                    )}
                                                    <span class="agenda-titolo">{v.e.titolo}</span>
                                                    {(v.fino || v.ora || v.e.luogo) && (
                                                        <span class="agenda-meta">
                                                            {v.fino && <span><i class="fas fa-calendar-alt" aria-hidden="true"></i>{v.fino}</span>}
                                                            {v.ora && <span><i class="fas fa-clock" aria-hidden="true"></i>{v.ora}</span>}
                                                            {v.e.luogo && <span><i class="fas fa-map-marker-alt" aria-hidden="true"></i>{v.e.luogo}</span>}
                                                        </span>
                                                    )}
                                                </span>
                                                <span class="link-cta agenda-cta" aria-hidden="true">Vedi dettagli <i class="fas fa-arrow-right"></i></span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ));
                        if (!sonoPassati) return elenco;
                        return passati.length > 0 && (
                            <details class="agenda-passati">
                                <summary>
                                    Eventi passati <span class="agenda-passati-n">({passati.length})</span>
                                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                                </summary>
                                {elenco}
                            </details>
                        );
                    })}
                </div>

                <!-- Vista calendario: griglia del mese (disegnata da scripts/calendario.ts) -->
                {eventi.length > 0 && (
                    <div class="vista-calendario" id="vistaCalendario" hidden>
                        <div class="calendario-nav">
                            <h3 class="calendario-mese" id="meseCorrente" aria-live="polite"></h3>
                            <div class="calendario-frecce">
                                <button type="button" id="btnMesePrev" aria-label="Mese precedente"><i class="fas fa-chevron-left" aria-hidden="true"></i></button>
                                <button type="button" id="btnMeseNext" aria-label="Mese successivo"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <div class="calendario-grid" id="calendarioGrid"></div>
                    </div>
                )}
            </div>
        </section>

        <!-- Eventi curati dalla Direzione: intestazione editoriale e sei voci -->
        <section class="eventi-cura-section" aria-labelledby="cura-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">Eventi su misura</span>
                <h2 class="titolo-sezione" id="cura-titolo">Spettacoli ed eventi <em>a cura di InBallet</em></h2>
                <p>La Direzione di I.N. Ballet cura la parte artistica e organizzativa di eventi di diversa natura: eventi con la danza come fulcro, oppure eventi celebrativi one-shot in cui la danza arricchisce l'occasione. Con cadenza annuale porta in scena uno Spettacolo in teatro con allievi e progetti della scuola, ed è spesso ospite di iniziative sul territorio di Milano e provincia.</p>
                <p>Allievi, progetti artistici e progetti pedagogici della scuola incontrano così ospiti, pubblico e nuove collaborazioni, che fanno della danza uno strumento concreto di arricchimento di vita.</p>
            </div>
            <div class="container">
                <ul class="cura-lista">
                    {tipiEvento.map((t) => (
                        <li class="voce">
                            <h3 class="voce-titolo">{t.nome}</h3>
                            <p class="voce-testo" set:html={t.testo} />
                        </li>
                    ))}
                </ul>
            </div>
        </section>

    <Fragment slot="scripts">
    {eventi.length > 0 && (
        <script type="application/json" id="datiCalendario" set:html={JSON.stringify(datiCalendario).replace(/</g, '\\u003c')} />
    )}
    <script>
        import '../scripts/calendario';
    </script>
    </Fragment>
</Base>

<style>
.eventi-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

/* ---------- Eventi su misura ---------- */
.eventi-cura-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.cura-lista {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 3rem;
  margin: 3.5rem 0 0;
  padding: 0;
}

@media (max-width: 900px) {
  .cura-lista {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    margin-top: 2.5rem;
  }
}

@media (max-width: 600px) {
  .cura-lista {
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
}

.eventi-section [hidden] {
  display: none !important;
}

/* ---------- Intestazione: testo a sinistra, scelta della vista a destra ---------- */
.eventi-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 2rem 4rem;
  margin-bottom: 3rem;
}

.eventi-intro {
  max-width: 40rem;
}

.eventi-intro .titolo-sezione {
  margin-bottom: 1.25rem;
}

.eventi-intro .intro-sezione {
  margin: 0;
}

.vista-switch {
  display: inline-flex;
  flex-shrink: 0;
  padding: 4px;
  border-radius: var(--radius-pill);
  background: var(--bg-soft);
}

.vista-switch button {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  min-height: 44px;
  padding: 0 1.25rem;
  border: none;
  border-radius: var(--radius-pill);
  background: none;
  font: inherit;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--text-light);
  cursor: pointer;
  transition: background-color .3s ease, color .3s ease;
}

.vista-switch button i {
  font-size: var(--text-xs);
}

.vista-switch button[aria-pressed="true"] {
  background: var(--white);
  color: var(--dark-navy);
  box-shadow: var(--shadow-sm);
}

/* ---------- Nessun evento futuro ---------- */
.eventi-vuoto {
  max-width: 40rem;
  padding: 2.5rem 0 1rem;
}

.eventi-vuoto h3 {
  margin-bottom: .75rem;
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--dark-navy);
}

.eventi-vuoto p {
  margin-bottom: 1.75rem;
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--text-light);
}

/* ---------- Elenco: mese, poi righe con data grande, testo e freccia ---------- */
/* Un blocco per mese: azzurrino e bianco con bordo, alternati */
.agenda-gruppo {
  padding: 1.75rem 2rem .25rem;
  border: 1px solid transparent;
  border-radius: var(--radius-card);
  background: var(--bg-soft);
}

.agenda-gruppo:nth-of-type(even) {
  background: var(--white);
  border-color: rgba(26, 26, 26, 0.12);
}

.agenda-gruppo + .agenda-gruppo {
  margin-top: 1.25rem;
}

.agenda-mese {
  margin: 0;
  padding-bottom: 1rem;
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.agenda {
  list-style: none;
  margin: 0;
  padding: 0;
}

.agenda > li {
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.agenda > li:last-child {
  border-bottom: none;
}

.agenda-voce {
  display: grid;
  grid-template-columns: 5rem minmax(0, 1fr) auto;
  align-items: center;
  gap: 2rem;
  padding: 1.75rem 0;
  color: inherit;
  text-decoration: none;
}

.agenda-data {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1;
}

.agenda-giorno {
  font-size: var(--text-4xl);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--dark-navy);
  font-variant-numeric: tabular-nums;
}

.agenda-settimana {
  margin-top: .4rem;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text-light);
}

.agenda-testo {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: .4rem;
}

.agenda-sopra {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .4rem .75rem;
}

.agenda-vicino,
.agenda-stato {
  padding: .2rem .6rem;
  border-radius: var(--radius-pill);
  background: var(--primary-blue);
  font-size: var(--text-3xs);
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--dark-navy);
}

.agenda-stato {
  background: var(--dark-navy);
  color: var(--white);
}

.agenda-tipo {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
}

.agenda-titolo {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
  transition: color .3s ease;
}

.annullato .agenda-titolo {
  text-decoration: line-through;
  text-decoration-thickness: 1px;
}

.agenda-meta {
  display: flex;
  flex-wrap: wrap;
  gap: .25rem 1.25rem;
  font-size: var(--text-sm);
  color: var(--text-light);
}

.agenda-meta i {
  margin-right: .4rem;
  font-size: var(--text-xs);
  color: var(--primary-blue-dark);
}

.agenda-cta {
  white-space: nowrap;
}

@media (hover: hover) and (pointer: fine) {
  .agenda-voce:hover .agenda-titolo,
  .agenda-voce:hover .agenda-cta {
    color: var(--primary-blue-dark);
  }

  .agenda-voce:hover .agenda-cta {
    border-color: var(--primary-blue-dark);
  }

  .agenda-voce:hover .agenda-cta i {
    transform: translateX(6px);
  }
}

/* Eventi passati: in fondo, chiusi, con colori spenti */
.agenda-passati {
  margin-top: 3.5rem;
}

.agenda-passati summary {
  display: inline-flex;
  align-items: center;
  gap: .6rem;
  min-height: 44px;
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--dark-navy);
  cursor: pointer;
  list-style: none;
}

.agenda-passati summary::-webkit-details-marker {
  display: none;
}

.agenda-passati-n {
  color: var(--text-light);
  font-weight: 400;
}

.agenda-passati summary i {
  font-size: var(--text-xs);
  color: var(--primary-blue-dark);
  transition: transform .3s ease;
}

.agenda-passati[open] summary i {
  transform: rotate(180deg);
}

.agenda-passati[open] summary {
  margin-bottom: 1.5rem;
  color: var(--primary-blue-dark);
}

.passato .agenda-giorno,
.passato .agenda-titolo {
  color: var(--text-light);
}

/* ---------- Calendario del mese ---------- */
.calendario-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.calendario-mese {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--dark-navy);
}

.calendario-frecce {
  display: flex;
  gap: .5rem;
}

.calendario-frecce button {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(26, 26, 26, 0.2);
  border-radius: var(--radius-full);
  background: var(--white);
  font-size: var(--text-sm);
  color: var(--dark-navy);
  cursor: pointer;
  transition: background-color .3s ease, border-color .3s ease;
}

.calendario-frecce button:disabled {
  opacity: .3;
  cursor: default;
}

@media (hover: hover) and (pointer: fine) {
  .calendario-frecce button:not(:disabled):hover {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
  }
}

/* Il gap da 1px sul fondo grigio disegna i filetti tra le celle */
.calendario-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 1px;
  background: rgba(26, 26, 26, 0.1);
  border: 1px solid rgba(26, 26, 26, 0.1);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.calendario-grid :global(.cal-intestazione) {
  padding: .75rem .5rem;
  background: var(--white);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 1.5px;
  text-align: center;
  color: var(--primary-blue-dark);
}

.calendario-grid :global(.cal-giorno) {
  display: flex;
  flex-direction: column;
  gap: .3rem;
  min-height: 7rem;
  padding: .6rem;
  background: var(--white);
  color: inherit;
  text-decoration: none;
}

.calendario-grid :global(.cal-giorno.vuoto) {
  background: #fafafa;
}

.calendario-grid :global(.cal-numero) {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--dark-navy);
}

.calendario-grid :global(.cal-giorno.passato .cal-numero) {
  color: #aaa;
}

.calendario-grid :global(.cal-giorno.oggi .cal-numero) {
  background: var(--dark-navy);
  color: var(--white);
}

.calendario-grid :global(.cal-evento) {
  display: block;
