---
/**
 * Spettacoli ed eventi: calendario degli appuntamenti salvati dalla dashboard,
 * renderizzato dal server a ogni richiesta (l'elenco è nell'HTML, leggibile dai
 * motori di ricerca, con i dati strutturati schema.org/Event).
 * Il dettaglio di un evento si apre in un modale; il link ?evento=<slug> lo apre
 * direttamente e, condiviso, mostra titolo e locandina nell'anteprima social.
 * La vista "Calendario" (griglia del mese) è disegnata dal browser.
 */
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { heroPagina } from '../lib/hero-pagine';
import {
  datiStrutturati,
  ETICHETTE_STATO,
  eventiPubblici,
  linkGoogleCalendar,
  maiuscola,
  passato,
  quando,
  sedeDi,
  srcImmagine,
  testoDescrizione,
  trovaEvento,
  urlEvento,
  urlIcs,
  type Evento,
} from '../lib/eventi';
import { romeDate } from '../lib/time';
import '../styles/pages/spettacoli-eventi.css';

export const prerender = false;

const site = Astro.site ?? new URL(Astro.url.origin);

// ?evento=<slug> (anche uno slug precedente o il vecchio id): il modale si apre da solo
const richiesto = Astro.url.searchParams.get('evento');
const trovato = richiesto ? await trovaEvento(richiesto) : null;
const aperto = trovato && trovato.evento.stato !== 'bozza' ? trovato.evento : null;

const bg = {
  hero: await heroPagina('spettacoli-eventi'),
};

/** Eventi curati dalla Direzione oltre al calendario della scuola. */
const tipiEvento = [
  { nome: 'Spettacolo annuale in teatro', icona: 'fa-masks-theater', testo: 'Ogni anno uno <strong>spettacolo in teatro</strong> con gli allievi e i progetti artistici e pedagogici della scuola.' },
  { nome: 'Eventi celebrativi', icona: 'fa-champagne-glasses', testo: 'La danza come fulcro o arricchimento di <strong>eventi one-shot</strong> e occasioni speciali.' },
  { nome: 'Nelle scuole', icona: 'fa-school', testo: "Momenti su misura nelle <strong>scuole dell'infanzia, primarie e secondarie</strong>, nell'ambito delle <a href=\"/collaborazioni-scuole\">collaborazioni con le scuole</a>." },
  { nome: 'Team building aziendali', icona: 'fa-handshake', testo: 'Progetti esperienziali su misura per <strong>aziende e gruppi di lavoro</strong>.' },
  { nome: 'Eventi formativi', icona: 'fa-chalkboard-user', testo: 'Incontri che attivano <strong>linguaggi diversi</strong> tra loro, come le <a href="/formazioni-personalizzate">formazioni personalizzate</a>.' },
  { nome: 'Sul territorio', icona: 'fa-map-location-dot', testo: 'Spesso ospiti di iniziative a <strong>Milano e in provincia</strong>.' },
];

const MESI = ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre'];
const GIORNI_BREVI = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];

const adesso = Date.now();
const oggi = romeDate(adesso);
const domani = romeDate(adesso + 86_400_000);

const eventi = await eventiPubblici();
const prossimi = eventi.filter((e) => !passato(e, adesso));
const passati = eventi.filter((e) => passato(e, adesso)).reverse();

/** Eventi raggruppati per mese di inizio, nell'ordine ricevuto. */
function perMese(lista: Evento[]) {
  const gruppi = new Map<string, Evento[]>();
  for (const e of lista) gruppi.set(e.data.slice(0, 7), [...(gruppi.get(e.data.slice(0, 7)) ?? []), e]);
  return [...gruppi].map(([k, ev]) => {
    const [y, m] = k.split('-').map(Number);
    return { titolo: `${MESI[m - 1]} ${y}`, eventi: ev };
  });
}

/** Dati di una riga dell'elenco. */
function voce(e: Evento) {
  const [y, m, d] = e.data.split('-').map(Number);
  const finito = passato(e, adesso);
  const inCorso = !finito && e.data < oggi;
  const vicino = e.data === oggi || inCorso ? (e.dataFine ? 'In corso' : 'Oggi') : e.data === domani ? 'Domani' : '';
  let fino = '';
  if (e.dataFine) {
    const [, mf, df] = e.dataFine.split('-').map(Number);
    fino = `Fino a ${GIORNI_BREVI[new Date(Date.UTC(y, mf - 1, df)).getUTCDay()].toLowerCase()} ${df}${mf !== m ? ` ${MESI[mf - 1].toLowerCase()}` : ''}`;
  }
  return {
    e,
    giorno: d,
    settimana: GIORNI_BREVI[new Date(Date.UTC(y, m - 1, d)).getUTCDay()],
    vicino: finito ? '' : vicino,
    stato: e.stato === 'pubblicato' ? '' : ETICHETTE_STATO[e.stato],
    ora: e.ora ? `${e.ora}${e.oraFine ? `–${e.oraFine}` : ''}` : '',
    fino,
    finito,
  };
}

const gruppiProssimi = perMese(prossimi);
const gruppiPassati = perMese(passati);

// Dati per il browser: griglia del mese e contenuto del modale, già pronti da mostrare
const datiEventi = {
  oggi,
  aperto: aperto?.slug ?? null,
  eventi: eventi.map((e) => {
    const finito = passato(e, adesso);
    return {
      id: e.id,
      slug: e.slug,
      titolo: e.titolo,
      data: e.data,
      dataFine: e.dataFine,
      passato: finito,
      stato: e.stato,
      etichettaStato: ETICHETTE_STATO[e.stato],
      tipo: e.tipo,
      quando: maiuscola(quando(e)),
      luogo: e.luogo,
      mappa: sedeDi(e.luogo)?.maps ?? '',
      destinatari: e.destinatari,
      costo: e.costo,
      descrizione: e.descrizione,
      immagine: e.immagine ? srcImmagine(e.immagine) : '',
      prenotazione: !finito && e.stato === 'pubblicato' ? e.prenotazione : '',
      google: !finito && e.stato !== 'annullato' ? linkGoogleCalendar(e, site) : '',
      ics: !finito && e.stato !== 'annullato' ? urlIcs(e) : '',
      condividi: `${e.titolo}, ${quando(e)}${e.luogo ? ` - ${e.luogo}` : ''}`,
    };
  }),
};

// Dati strutturati per Google: gli appuntamenti in programma (non i demo)
const schemaEventi = prossimi.filter((e) => !e.demo).map((e) => datiStrutturati(e, site));

// Link condiviso a un evento: anteprima social con titolo, data e locandina
const descrizioneAperto = aperto ? testoDescrizione(aperto.descrizione).replace(/\s+/g, ' ') : '';
const og = aperto
  ? {
      title: `${aperto.titolo} · ${maiuscola(quando(aperto))}`,
      description: (descrizioneAperto.length > 155 ? descrizioneAperto.slice(0, 154).replace(/\s+\S*$/, '') + '…' : descrizioneAperto) || aperto.luogo || 'Spettacoli ed eventi InBallet',
      image: aperto.immagine ? new URL(srcImmagine(aperto.immagine), site).href : undefined,
    }
  : null;
---

<Base
    title="Spettacoli ed eventi di danza a Lainate e Rho | InBallet"
    description="Spettacoli, saggi e workshop di InBallet a Lainate e Rho ed eventi su misura: spettacolo annuale in teatro, eventi nelle scuole e team building aziendali."
    ogTitle={og?.title ?? 'Spettacoli ed Eventi | InBallet'}
    ogDescription={og?.description ?? 'Il calendario degli appuntamenti e gli eventi curati dalla Direzione: teatro, scuole, aziende e territorio.'}
    ogImage={og?.image}
    mainFocusable={false}
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>
        <!-- Hero -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Spettacoli ed eventi</h1>
                <p class="hero-lead">Il <strong>calendario degli appuntamenti</strong> di InBallet a Lainate e Rho.</p>
            </div>
        </section>

        <!-- Calendario: elenco dei prossimi appuntamenti (vista principale) o griglia del mese.
             Escluso dal testo letto dal chatbot: gli eventi gli arrivano già aggiornati. -->
        <section id="calendario" class="eventi-section" aria-labelledby="eventi-titolo" data-chatbot-escludi>
            <div class="container">
                <header class="eventi-header">
                    <div class="eventi-intro">
                        <p class="eyebrow">Calendario</p>
                        <h2 class="titolo-sezione" id="eventi-titolo">Prossimi <em>appuntamenti</em></h2>
                        <p class="intro-sezione"><strong>Spettacoli, saggi, workshop e lezioni aperte</strong>: apri un evento per i dettagli e per aggiungerlo al tuo calendario.</p>
                    </div>
                    {eventi.length > 0 && (
                        <div class="vista-switch" id="vistaSwitch" role="group" aria-label="Visualizzazione" hidden>
                            <button type="button" data-vista="elenco" aria-pressed="true"><i class="fas fa-list" aria-hidden="true"></i> Elenco</button>
                            <button type="button" data-vista="calendario" aria-pressed="false"><i class="fas fa-calendar-alt" aria-hidden="true"></i> Calendario</button>
                        </div>
                    )}
                </header>

                <!-- Nessun appuntamento futuro (gli eventi passati restano consultabili sotto) -->
                {prossimi.length === 0 && (
                    <div class="eventi-vuoto">
                        <h3>Nessun appuntamento in programma</h3>
                        <p>Stiamo preparando le <strong>prossime date</strong>: le pubblichiamo qui appena confermate.</p>
                        <a href="/contatti" class="link-cta">
                            Chiedi informazioni
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                )}

                <!-- Vista elenco -->
                <div class="vista-elenco" id="vistaElenco">
                    {[{ gruppi: gruppiProssimi, passati: false }, { gruppi: gruppiPassati, passati: true }].map(({ gruppi, passati: sonoPassati }) => {
                        const elenco = gruppi.map((mese) => (
                            <div class="agenda-gruppo">
                                <h3 class="agenda-mese titoletto">{mese.titolo}</h3>
                                <ul class="agenda">
                                    {mese.eventi.map(voce).map((v) => (
                                        <li class:list={{ passato: v.finito, annullato: v.e.stato === 'annullato' }}>
                                            <a class="agenda-voce" href={urlEvento(v.e)} data-evento={v.e.slug}>
                                                <div class="agenda-data">
                                                    <p class="agenda-giorno">{v.giorno}</p>
                                                    <p class="agenda-settimana titoletto">{v.settimana}</p>
                                                </div>
                                                <div class="agenda-testo">
                                                    {(v.e.tipo || v.vicino || v.stato) && (
                                                        <div class="agenda-sopra">
                                                            {v.vicino && <p class="agenda-vicino">{v.vicino}</p>}
                                                            {v.stato && <p class="agenda-stato">{v.stato}</p>}
                                                            {v.e.tipo && <p class="agenda-tipo titoletto">{v.e.tipo}</p>}
                                                        </div>
                                                    )}
                                                    <h4 class="agenda-titolo">{v.e.titolo}</h4>
                                                    {(v.fino || v.ora || v.e.luogo) && (
                                                        <div class="agenda-meta testo-piccolo">
                                                            {v.fino && <p><i class="fas fa-calendar-alt" aria-hidden="true"></i>{v.fino}</p>}
                                                            {v.ora && <p><i class="fas fa-clock" aria-hidden="true"></i>{v.ora}</p>}
                                                            {v.e.luogo && <p><i class="fas fa-map-marker-alt" aria-hidden="true"></i>{v.e.luogo}</p>}
                                                        </div>
                                                    )}
                                                </div>
                                                <p class="link-cta agenda-cta" aria-hidden="true">Vedi dettagli <i class="fas fa-arrow-right"></i></p>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ));
                        if (!sonoPassati) return elenco;
                        return passati.length > 0 && (
                            <details class="agenda-passati">
                                <summary>
                                    Eventi passati <span class="agenda-passati-n">({passati.length})</span>
                                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                                </summary>
                                {elenco}
                            </details>
                        );
                    })}
                </div>

                <!-- Vista calendario: griglia del mese (disegnata da scripts/calendario.ts) -->
                {eventi.length > 0 && (
                    <div class="vista-calendario" id="vistaCalendario" hidden>
                        <div class="calendario-nav">
                            <h3 class="calendario-mese" id="meseCorrente" aria-live="polite"></h3>
                            <div class="calendario-frecce">
                                <button type="button" id="btnMesePrev" aria-label="Mese precedente"><i class="fas fa-chevron-left" aria-hidden="true"></i></button>
                                <button type="button" id="btnMeseNext" aria-label="Mese successivo"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <div class="calendario-grid" id="calendarioGrid"></div>
                    </div>
                )}
            </div>
        </section>

        <!-- Eventi curati dalla Direzione: intestazione editoriale e sei voci -->
        <section class="eventi-cura-section decoro-onde" aria-labelledby="cura-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">Eventi su misura</p>
                <h2 class="titolo-sezione" id="cura-titolo">Spettacoli ed eventi <em>a cura di InBallet</em></h2>
                <p>La Direzione di I.N. Ballet cura la <strong>parte artistica e organizzativa</strong> di <strong>eventi di diversa natura</strong>: allievi e progetti della scuola incontrano così pubblico e nuove collaborazioni.</p>
            </div>
            <div class="container">
                <ul class="cura-lista">
                    {tipiEvento.map((t) => (
                        <li class="voce">
                            <i class={`fas ${t.icona} voce-icona`} aria-hidden="true"></i>
                            <h3 class="voce-titolo">{t.nome}</h3>
                            <p class="voce-testo" set:html={t.testo} />
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        {schemaEventi.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schemaEventi).replace(/</g, '\\u003c')} />}

    <Fragment slot="after-main">
    <!-- Dettaglio evento (riempito da scripts/calendario.ts) -->
    <dialog class="evento-dialog" id="eventoDialog" aria-labelledby="dialogTitolo">
        <div class="evento-dialog-barra">
            <button type="button" class="btn-icon evento-chiudi" data-chiudi aria-label="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="evento-dialog-corpo" id="dialogCorpo">
            <button type="button" class="evento-locandina" id="dialogLocandinaBtn" aria-label="Ingrandisci la locandina" hidden>
                <img id="dialogLocandina" src="data:," alt="">
                <span class="evento-locandina-zoom" aria-hidden="true"><i class="fas fa-expand"></i></span>
            </button>
            <div class="evento-dialog-testo">
                <p class="evento-etichette titoletto" id="dialogEtichette"></p>
                <h2 class="evento-dialog-titolo" id="dialogTitolo"></h2>
                <dl class="evento-dettagli" id="dialogDettagli"></dl>
                <div class="evento-descrizione" id="dialogDescrizione"></div>
                <div class="evento-azioni">
                    <a class="btn-primary" id="dialogPrenota" href="#" target="_blank" rel="noopener" hidden>
                        Prenota <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <div class="evento-azioni-calendario" id="dialogCalendario">
                        <p class="evento-azioni-label titoletto">Aggiungi al calendario</p>
                        <div class="evento-azioni-btn">
                            <a class="evento-azione" id="btnGoogle" href="#" target="_blank" rel="noopener noreferrer">Google Calendar</a>
                            <a class="evento-azione" id="btnApple" href="#" download>Apple / Outlook</a>
                        </div>
                    </div>
                    <button type="button" class="evento-condividi" id="btnCondividi">
                        <i class="fas fa-share-alt" aria-hidden="true"></i>
                        <span id="btnCondividiTesto">Condividi</span>
                    </button>
                </div>
            </div>
        </div>
    </dialog>

    <!-- Locandina a tutto schermo -->
    <dialog class="locandina-dialog" id="locandinaDialog" aria-label="Locandina">
        <button type="button" class="btn-icon btn-icon--scuro locandina-chiudi" data-chiudi aria-label="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
        <img id="locandinaGrande" src="data:," alt="">
    </dialog>
    </Fragment>

    <Fragment slot="scripts">
    <script type="application/json" id="datiEventi" set:html={JSON.stringify(datiEventi).replace(/</g, '\\u003c')} />
    <script>
        import '../scripts/calendario';
    </script>
    </Fragment>
</Base>
