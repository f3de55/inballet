---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { sfondo } from '../lib/images';

const bg = {
  hero: await sfondo('ballerina.jpg'),
};

/** Eventi curati dalla Direzione oltre al calendario della scuola. */
const tipiEvento = [
  { nome: 'Spettacolo annuale in teatro', testo: "Ogni anno il progetto di uno spettacolo, presentato in teatro con gli allievi e i progetti artistici e pedagogici della scuola." },
  { nome: 'Eventi celebrativi', testo: 'La danza come protagonista o come arricchimento di eventi one-shot e occasioni speciali.' },
  { nome: 'Nelle scuole', testo: "Momenti personalizzati nelle scuole dell'infanzia, primarie e secondarie, nell'ambito delle <a href=\"/collaborazioni-scuole\">collaborazioni con le scuole</a>." },
  { nome: 'Team building aziendali', testo: 'Progetti esperienziali costruiti su misura per aziende e gruppi di lavoro.' },
  { nome: 'Eventi formativi', testo: 'Incontri su materie che connettono e attivano linguaggi diversi tra loro, come le <a href="/formazioni-personalizzate">formazioni personalizzate</a>.' },
  { nome: 'Sul territorio', testo: 'Siamo spesso ospiti di iniziative a Milano e nella sua provincia.' },
];
---

<Base
    title="Spettacoli ed eventi di danza a Lainate e Rho | InBallet"
    description="Spettacoli, saggi e workshop di InBallet a Lainate e Rho, più eventi su misura: spettacolo annuale in teatro, eventi nelle scuole e team building aziendali."
    ogTitle="Spettacoli ed Eventi | InBallet"
    ogDescription="Il calendario degli appuntamenti e gli eventi curati dalla Direzione: teatro, scuole, aziende e territorio."
    mainFocusable={false}
>
        <!-- Hero -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Spettacoli ed eventi</h1>
                <p class="chisiamo-hero-tagline">Scopri tutti gli appuntamenti in programma: spettacoli, workshop, saggi e corsi aperti.</p>
            </div>
        </section>

        <!-- Calendario: elenco dei prossimi appuntamenti (vista principale) o griglia del mese -->
        <section id="calendario" class="eventi-section" aria-labelledby="eventi-titolo">
            <div class="container">
                <header class="eventi-header">
                    <div class="eventi-intro">
                        <span class="eyebrow">Calendario</span>
                        <h2 class="titolo-sezione" id="eventi-titolo">Prossimi <em>appuntamenti</em></h2>
                        <p class="intro-sezione">Spettacoli, saggi, workshop e lezioni aperte a Lainate e Rho. Apri un evento per leggere i dettagli e aggiungerlo al tuo calendario.</p>
                    </div>
                    <div class="vista-switch" id="vistaSwitch" role="group" aria-label="Visualizzazione" hidden>
                        <button type="button" data-vista="elenco" aria-pressed="true"><i class="fas fa-list" aria-hidden="true"></i> Elenco</button>
                        <button type="button" data-vista="calendario" aria-pressed="false"><i class="fas fa-calendar-alt" aria-hidden="true"></i> Calendario</button>
                    </div>
                </header>

                <p class="eventi-stato" id="eventiStato" aria-live="polite">Caricamento degli appuntamenti…</p>

                <!-- Nessun appuntamento futuro (gli eventi passati restano consultabili sotto) -->
                <div class="eventi-vuoto" id="eventiVuoto" hidden>
                    <h3>Nessun appuntamento in programma</h3>
                    <p>Stiamo preparando le prossime date: spettacoli, saggi e workshop vengono pubblicati qui appena confermati.</p>
                    <a href="/contatti" class="link-cta">
                        Chiedi informazioni
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                <!-- Vista elenco -->
                <div class="vista-elenco" id="vistaElenco" hidden>
                    <div id="agendaProssimi"></div>
                    <details class="agenda-passati" id="agendaPassatiWrap" hidden>
                        <summary>
                            Eventi passati <span class="agenda-passati-n" id="passatiConteggio"></span>
                            <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        </summary>
                        <div id="agendaPassati"></div>
                    </details>
                </div>

                <!-- Vista calendario: griglia del mese -->
                <div class="vista-calendario" id="vistaCalendario" hidden>
                    <div class="calendario-nav">
                        <h3 class="calendario-mese" id="meseCorrente" aria-live="polite"></h3>
                        <div class="calendario-frecce">
                            <button type="button" id="btnMesePrev" aria-label="Mese precedente"><i class="fas fa-chevron-left" aria-hidden="true"></i></button>
                            <button type="button" id="btnMeseNext" aria-label="Mese successivo"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
                        </div>
                    </div>
                    <div class="calendario-grid" id="calendarioGrid"></div>
                </div>
            </div>
        </section>

        <!-- Eventi curati dalla Direzione: intestazione editoriale e sei voci -->
        <section class="eventi-cura-section" aria-labelledby="cura-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">Eventi su misura</span>
                <h2 class="titolo-sezione" id="cura-titolo">Spettacoli ed eventi <em>a cura di InBallet</em></h2>
                <p>La Direzione di I.N. Ballet cura la parte artistica e organizzativa di eventi di diversa natura: eventi con la danza come fulcro, oppure eventi celebrativi one-shot in cui la danza arricchisce l'occasione. Con cadenza annuale porta in scena uno Spettacolo in teatro con allievi e progetti della scuola, ed è spesso ospite di iniziative sul territorio di Milano e provincia.</p>
                <p>Allievi, progetti artistici e progetti pedagogici della scuola incontrano così ospiti, pubblico e nuove collaborazioni, che fanno della danza uno strumento concreto di arricchimento di vita.</p>
            </div>
            <div class="container">
                <ul class="cura-lista">
                    {tipiEvento.map((t) => (
                        <li class="voce">
                            <h3 class="voce-titolo">{t.nome}</h3>
                            <p class="voce-testo" set:html={t.testo} />
                        </li>
                    ))}
                </ul>
            </div>
        </section>

    <Fragment slot="after-main">
    <!-- Dettaglio evento -->
    <dialog class="evento-dialog" id="eventoDialog" aria-labelledby="dialogTitolo">
        <div class="evento-dialog-barra">
            <button type="button" class="evento-chiudi" data-chiudi aria-label="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="evento-dialog-corpo" id="dialogCorpo">
            <button type="button" class="evento-locandina" id="dialogLocandinaBtn" aria-label="Ingrandisci la locandina" hidden>
                <img id="dialogLocandina" src="data:," alt="">
                <span class="evento-locandina-zoom" aria-hidden="true"><i class="fas fa-expand"></i></span>
            </button>
            <div class="evento-dialog-testo">
                <p class="evento-etichette" id="dialogEtichette"></p>
                <h2 class="evento-dialog-titolo" id="dialogTitolo"></h2>
                <dl class="evento-dettagli" id="dialogDettagli"></dl>
                <div class="evento-descrizione" id="dialogDescrizione"></div>
                <div class="evento-azioni">
                    <div class="evento-azioni-calendario" id="dialogCalendario">
                        <span class="evento-azioni-label">Aggiungi al calendario</span>
                        <div class="evento-azioni-btn">
                            <button type="button" class="evento-azione" id="btnGoogle">Google Calendar</button>
                            <button type="button" class="evento-azione" id="btnApple">Apple / Outlook</button>
                        </div>
                    </div>
                    <button type="button" class="evento-condividi" id="btnCondividi">
                        <i class="fas fa-share-alt" aria-hidden="true"></i>
                        <span id="btnCondividiTesto">Condividi</span>
                    </button>
                </div>
            </div>
        </div>
    </dialog>

    <!-- Locandina a tutto schermo -->
    <dialog class="locandina-dialog" id="locandinaDialog" aria-label="Locandina">
        <button type="button" class="locandina-chiudi" data-chiudi aria-label="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
        <img id="locandinaGrande" src="data:," alt="">
    </dialog>
    </Fragment>

    <Fragment slot="scripts">
    <script>
        import '../scripts/calendario';
    </script>
    </Fragment>
</Base>

<style>
.eventi-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

/* ---------- Eventi su misura ---------- */
.eventi-cura-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.cura-lista {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 3rem;
  margin: 3.5rem 0 0;
  padding: 0;
}

@media (max-width: 900px) {
  .cura-lista {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    margin-top: 2.5rem;
  }
}

@media (max-width: 600px) {
  .cura-lista {
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
}

.eventi-section [hidden],
.evento-dialog [hidden] {
  display: none !important;
}

/* ---------- Intestazione: testo a sinistra, scelta della vista a destra ---------- */
.eventi-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 2rem 4rem;
  margin-bottom: 3rem;
}

.eventi-intro {
  max-width: 40rem;
}

.eventi-intro .titolo-sezione {
  margin-bottom: 1.25rem;
}

.eventi-intro .intro-sezione {
  margin: 0;
}

.vista-switch {
  display: inline-flex;
  flex-shrink: 0;
  padding: 4px;
  border-radius: var(--radius-pill);
  background: var(--bg-soft);
}

.vista-switch button {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  min-height: 44px;
  padding: 0 1.25rem;
  border: none;
  border-radius: var(--radius-pill);
  background: none;
  font: inherit;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--text-light);
  cursor: pointer;
  transition: background-color .3s ease, color .3s ease;
}

.vista-switch button i {
  font-size: var(--text-xs);
}

.vista-switch button[aria-pressed="true"] {
  background: var(--white);
  color: var(--dark-navy);
  box-shadow: var(--shadow-sm);
}

.eventi-stato {
  padding: 2rem 0;
  color: var(--text-light);
}

/* ---------- Nessun evento futuro ---------- */
.eventi-vuoto {
  max-width: 40rem;
  padding: 2.5rem 0 1rem;
}

.eventi-vuoto h3 {
  margin-bottom: .75rem;
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--dark-navy);
}

.eventi-vuoto p {
  margin-bottom: 1.75rem;
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--text-light);
}

/* ---------- Elenco: mese, poi righe con data grande, testo e freccia ---------- */
/* Un blocco per mese: azzurrino e bianco con bordo, alternati */
.eventi-section :global(.agenda-gruppo) {
  padding: 1.75rem 2rem .25rem;
  border: 1px solid transparent;
  border-radius: var(--radius-card);
  background: var(--bg-soft);
}

.eventi-section :global(.agenda-gruppo:nth-child(even)) {
  background: var(--white);
  border-color: rgba(26, 26, 26, 0.12);
}

.eventi-section :global(.agenda-gruppo + .agenda-gruppo) {
  margin-top: 1.25rem;
}

.eventi-section :global(.agenda-mese) {
  margin: 0;
  padding-bottom: 1rem;
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.eventi-section :global(.agenda-mese:first-child) {
  margin-top: 0;
}

.eventi-section :global(.agenda) {
  list-style: none;
  margin: 0;
  padding: 0;
}

.eventi-section :global(.agenda > li) {
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.eventi-section :global(.agenda > li:last-child) {
  border-bottom: none;
}

.eventi-section :global(.agenda-voce) {
  display: grid;
  grid-template-columns: 5rem minmax(0, 1fr) auto;
  align-items: center;
  gap: 2rem;
  padding: 1.75rem 0;
  color: inherit;
  text-decoration: none;
}

.eventi-section :global(.agenda-data) {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1;
}

.eventi-section :global(.agenda-giorno) {
  font-size: var(--text-4xl);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--dark-navy);
  font-variant-numeric: tabular-nums;
}

.eventi-section :global(.agenda-settimana) {
  margin-top: .4rem;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text-light);
}

.eventi-section :global(.agenda-testo) {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: .4rem;
}

.eventi-section :global(.agenda-sopra) {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .4rem .75rem;
}

.eventi-section :global(.agenda-vicino) {
  padding: .2rem .6rem;
  border-radius: var(--radius-pill);
  background: var(--primary-blue);
  font-size: var(--text-3xs);
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--dark-navy);
}

.eventi-section :global(.agenda-tipo) {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--primary-blue-dark);
}

.eventi-section :global(.agenda-titolo) {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
  transition: color .3s ease;
}

.eventi-section :global(.agenda-meta) {
  display: flex;
  flex-wrap: wrap;
  gap: .25rem 1.25rem;
  font-size: var(--text-sm);
  color: var(--text-light);
}

.eventi-section :global(.agenda-meta i) {
  margin-right: .4rem;
  font-size: var(--text-xs);
  color: var(--primary-blue-dark);
}

.eventi-section :global(.agenda-cta) {
  white-space: nowrap;
}

@media (hover: hover) and (pointer: fine) {
  .eventi-section :global(.agenda-voce:hover .agenda-titolo),
  .eventi-section :global(.agenda-voce:hover .agenda-cta) {
    color: var(--primary-blue-dark);
  }

  .eventi-section :global(.agenda-voce:hover .agenda-cta) {
    border-color: var(--primary-blue-dark);
  }

  .eventi-section :global(.agenda-voce:hover .agenda-cta i) {
    transform: translateX(6px);
  }
}

/* Eventi passati: in fondo, chiusi, con colori spenti */
.agenda-passati {
  margin-top: 3.5rem;
}

.agenda-passati summary {
  display: inline-flex;
  align-items: center;
  gap: .6rem;
  min-height: 44px;
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--dark-navy);
  cursor: pointer;
  list-style: none;
}

.agenda-passati summary::-webkit-details-marker {
  display: none;
}

.agenda-passati-n {
  color: var(--text-light);
  font-weight: 400;
}

.agenda-passati summary i {
  font-size: var(--text-xs);
  color: var(--primary-blue-dark);
  transition: transform .3s ease;
}

.agenda-passati[open] summary i {
  transform: rotate(180deg);
}

.agenda-passati[open] summary {
  margin-bottom: 1.5rem;
  color: var(--primary-blue-dark);
}

.eventi-section :global(.passato .agenda-giorno),
.eventi-section :global(.passato .agenda-titolo) {
  color: var(--text-light);
}

/* ---------- Calendario del mese ---------- */
.calendario-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.calendario-mese {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--dark-navy);
}

.calendario-frecce {
  display: flex;
  gap: .5rem;
}

.calendario-frecce button {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(26, 26, 26, 0.2);
  border-radius: var(--radius-full);
  background: var(--white);
  font-size: var(--text-sm);
  color: var(--dark-navy);
  cursor: pointer;
  transition: background-color .3s ease, border-color .3s ease;
}

.calendario-frecce button:disabled {
  opacity: .3;
  cursor: default;
}

@media (hover: hover) and (pointer: fine) {
  .calendario-frecce button:not(:disabled):hover {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
  }
}

/* Il gap da 1px sul fondo grigio disegna i filetti tra le celle */
.calendario-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 1px;
  background: rgba(26, 26, 26, 0.1);
  border: 1px solid rgba(26, 26, 26, 0.1);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.calendario-grid :global(.cal-intestazione) {
  padding: .75rem .5rem;
  background: var(--white);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 1.5px;
  text-align: center;
  color: var(--primary-blue-dark);
}

.calendario-grid :global(.cal-giorno) {
  display: flex;
  flex-direction: column;
  gap: .3rem;
  min-height: 7rem;
  padding: .6rem;
  background: var(--white);
}

.calendario-grid :global(.cal-giorno.vuoto) {
  background: #fafafa;
}

.calendario-grid :global(.cal-numero) {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--dark-navy);
}

.calendario-grid :global(.cal-giorno.passato .cal-numero) {
  color: #aaa;
}

.calendario-grid :global(.cal-giorno.oggi .cal-numero) {
  background: var(--dark-navy);
  color: var(--white);
}

.calendario-grid :global(.cal-evento) {
  display: block;
  width: 100%;
  padding: .3rem .5rem;
  border: none;
  border-left: 3px solid var(--primary-blue);
  border-radius: var(--radius-xs);
  background: var(--bg-soft);
  font: inherit;
  font-size: var(--text-xs);
  font-weight: 600;
  line-height: 1.35;
  text-align: left;
  color: var(--dark-navy);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  cursor: pointer;
  transition: background-color .3s ease;
}

.calendario-grid :global(.cal-evento.passato) {
  border-left-color: #ccc;
  background: #f3f3f3;
  color: var(--text-light);
}

@media (hover: hover) and (pointer: fine) {
  .calendario-grid :global(.cal-evento:hover) {
    background: rgba(135, 206, 235, 0.35);
  }
}

/* Punto sotto il numero: usato al posto dei titoli sugli schermi stretti */
.calendario-grid :global(.cal-punti) {
  display: none;
}

/* ---------- Dialog dettaglio evento ---------- */
.evento-dialog {
  width: min(52rem, calc(100% - 3rem));
  max-height: min(48rem, calc(100dvh - 3rem));
  margin: auto;
  padding: 0;
  border: none;
  border-radius: var(--radius-card);
  background: var(--white);
  color: var(--text-dark);
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.25);
  overflow-y: auto;
  overscroll-behavior: contain;
  /* Non la barra della pagina (blu su nero): sottile e discreta sul bianco */
  scrollbar-width: thin;
  scrollbar-color: rgba(26, 26, 26, 0.22) transparent;
}

.evento-dialog[open] {
  animation: evento-entra .3s ease;
}

.evento-dialog::backdrop {
  background: rgba(12, 12, 12, 0.6);
}

@keyframes evento-entra {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
}

:global(html:has(dialog[open])) {
  overflow: hidden;
}

/* Barra con la X: resta in alto mentre il contenuto scorre */
.evento-dialog-barra {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  justify-content: flex-end;
  height: 0;
}

.evento-chiudi {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin: 1rem 1rem 0 0;
  border: none;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-sm);
  font-size: var(--text-base);
  color: var(--dark-navy);
  cursor: pointer;
}

.evento-dialog-corpo {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 2.5rem;
  padding: 3rem;
}

/* PC: locandina a sinistra, ferma mentre il testo scorre */
.evento-dialog-corpo.con-locandina {
  grid-template-columns: 17rem minmax(0, 1fr);
  align-items: start;
}

/* Locandina: stesso riquadro per tutti gli eventi. L'immagine è sempre intera
   (contain); attorno, la stessa immagine sfocata. */
.evento-locandina {
  position: sticky;
  top: 3rem;
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  padding: 0;
  border: none;
  border-radius: var(--radius-md);
  background: var(--dark-navy);
  overflow: hidden;
  isolation: isolate;
  cursor: zoom-in;
}

.evento-locandina::before {
  content: '';
  position: absolute;
  inset: -2rem;
  z-index: -1;
  background: var(--locandina, none) center / cover no-repeat;
  filter: blur(24px) brightness(.75);
}

.evento-locandina img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

