---
/**
 * Pagina di un evento: /spettacoli-eventi/<slug>. Renderizzata dal server a
 * ogni richiesta, con i dati strutturati schema.org/Event (risultati di Google
 * con data, luogo e prezzo) e la locandina come anteprima social.
 * - slug vecchio (titolo o data cambiati) o id → 301 al nuovo indirizzo
 * - bozza: visibile solo a chi ha fatto il login nella dashboard (anteprima)
 */
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { sfondo } from '../../lib/images';
import { isLoggedIn } from '../../lib/auth';
import {
  datiStrutturati,
  linkGoogleCalendar,
  maiuscola,
  passato,
  quando,
  sedeDi,
  srcImmagine,
  testoDescrizione,
  trovaEvento,
  urlEvento,
} from '../../lib/eventi';

export const prerender = false;

const trovato = await trovaEvento(Astro.params.slug ?? '');
if (trovato?.vecchio) return Astro.redirect(urlEvento(trovato.evento), 301);

const bozza = trovato?.evento.stato === 'bozza';
const e = trovato && (!bozza || (await isLoggedIn(Astro.session))) ? trovato.evento : null;
if (!e) Astro.response.status = 404;

const site = Astro.site ?? new URL(Astro.url.origin);
const bg = { hero: await sfondo('ballerina.jpg') };

const finito = e ? passato(e) : false;
const data = e ? maiuscola(quando(e)) : '';
const sede = e ? sedeDi(e.luogo) : undefined;
const img = e?.immagine ? srcImmagine(e.immagine) : '';
const testo = e ? testoDescrizione(e.descrizione).replace(/\s+/g, ' ') : '';
const descrizioneMeta = e ? (testo.length > 155 ? testo.slice(0, 154).replace(/\s+\S*$/, '') + '…' : testo) || `${data}${e.luogo ? ` · ${e.luogo}` : ''}` : '';
const avviso = !e
  ? ''
  : bozza
    ? 'Bozza: questa pagina la vedi solo tu perché hai effettuato l’accesso alla dashboard.'
    : e.stato === 'annullato'
      ? 'Questo evento è stato annullato.'
      : finito
        ? 'Evento concluso.'
        : e.stato === 'esaurito'
          ? 'Posti esauriti.'
          : '';
// Azioni solo per eventi ancora da fare
const prenota = e && e.prenotazione && !finito && e.stato !== 'annullato' && e.stato !== 'esaurito';
const calendario = e && !finito && e.stato !== 'annullato';
---

{e ? (
    <Base
        title={`${e.titolo} | InBallet`}
        description={descrizioneMeta}
        ogTitle={`${e.titolo} · ${data}`}
        ogDescription={descrizioneMeta}
        ogImage={img ? new URL(img, site).href : undefined}
        ogType="article"
        noindex={bozza || !!e.demo}
    >
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb genitore="/spettacoli-eventi" nome={e.titolo} />
                <h1 class="chisiamo-hero-title">{e.titolo}</h1>
                <p class="chisiamo-hero-tagline">{data}{e.luogo && ` · ${e.luogo}`}</p>
            </div>
        </section>

        <section class="evento-section" aria-label="Dettagli dell'evento">
            <div class="container">
                <div class:list={['evento-corpo', { 'con-locandina': img }]}>
                    {img && (
                        <button type="button" class="evento-locandina" id="locandinaBtn" style={`--locandina:url("${img}")`} aria-label="Ingrandisci la locandina">
                            <img src={img} alt={`Locandina: ${e.titolo}`} fetchpriority="high">
                            <span class="evento-locandina-zoom" aria-hidden="true"><i class="fas fa-expand"></i></span>
                        </button>
                    )}

                    <div class="evento-testo">
                        {avviso && <p class:list={['evento-avviso', { 'evento-avviso--forte': e.stato === 'annullato' || bozza }]}>{avviso}</p>}
                        {e.tipo && <span class="eyebrow">{e.tipo}</span>}

                        <dl class="evento-dettagli">
                            <div><dt>Quando</dt><dd>{data}</dd></div>
                            {e.luogo && (
                                <div>
                                    <dt>Dove</dt>
                                    <dd>
                                        {e.luogo}
                                        {sede && <a class="evento-mappa" href={sede.maps} target="_blank" rel="noopener">Indicazioni</a>}
                                    </dd>
                                </div>
                            )}
                            {e.destinatari && <div><dt>Per chi</dt><dd>{e.destinatari}</dd></div>}
                            {e.costo && <div><dt>Costo</dt><dd>{e.costo}</dd></div>}
                        </dl>

                        {e.descrizione && <div class="evento-descrizione" set:html={e.descrizione} />}

                        <div class="evento-azioni">
                            {prenota && (
                                <a class="btn-primary" href={e.prenotazione} target="_blank" rel="noopener">
                                    Prenota <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            )}
                            {calendario && (
                                <div class="evento-azioni-calendario">
                                    <span class="evento-azioni-label">Aggiungi al calendario</span>
                                    <div class="evento-azioni-btn">
                                        <a class="evento-azione" href={linkGoogleCalendar(e, site)} target="_blank" rel="noopener noreferrer">Google Calendar</a>
                                        <a class="evento-azione" href={`${urlEvento(e)}/calendario.ics`} download>Apple / Outlook</a>
                                    </div>
                                </div>
                            )}
                            <button type="button" class="evento-condividi" id="btnCondividi" data-titolo={e.titolo} data-testo={`${e.titolo}, ${quando(e)}${e.luogo ? ` - ${e.luogo}` : ''}`} hidden>
                                <i class="fas fa-share-alt" aria-hidden="true"></i>
                                <span id="btnCondividiTesto">Condividi</span>
                            </button>
                        </div>

                        <a href="/spettacoli-eventi" class="link-cta evento-tutti">
                            Tutti gli appuntamenti
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <script type="application/ld+json" set:html={JSON.stringify(datiStrutturati(e, site)).replace(/</g, '\\u003c')} />

        <Fragment slot="after-main">
            {img && (
                <dialog class="locandina-dialog" id="locandinaDialog" aria-label="Locandina">
                    <button type="button" class="locandina-chiudi" aria-label="Chiudi"><i class="fas fa-times" aria-hidden="true"></i></button>
                    <img src={img} alt={`Locandina: ${e.titolo}`} loading="lazy">
                </dialog>
            )}
        </Fragment>

        <Fragment slot="scripts">
            <script>
                import '../../scripts/evento';
            </script>
        </Fragment>
    </Base>
) : (
    <Base title="Evento non trovato | InBallet" description="L'evento cercato non è disponibile." noindex>
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb genitore="/spettacoli-eventi" nome="Evento non trovato" />
                <h1 class="chisiamo-hero-title">Evento non trovato</h1>
                <p class="chisiamo-hero-tagline">Potrebbe essere stato spostato o rimosso dal calendario.</p>
            </div>
        </section>
        <section class="evento-section">
            <div class="container">
                <a href="/spettacoli-eventi" class="link-cta">
                    Vedi tutti gli appuntamenti
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </section>
    </Base>
)}

<style>
.evento-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

/* PC: locandina a sinistra, ferma mentre il testo scorre */
.evento-corpo {
  display: grid;
  grid-template-columns: minmax(0, 46rem);
  gap: 4rem;
}

.evento-corpo.con-locandina {
  grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
  align-items: start;
}

/* Locandina: stesso riquadro per tutti gli eventi. L'immagine è sempre intera
   (contain); attorno, la stessa immagine sfocata. */
.evento-locandina {
  position: sticky;
  top: calc(var(--header-h) + 2rem + var(--banner-height, 0px));
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  padding: 0;
  border: none;
  border-radius: var(--radius-img);
  background: var(--dark-navy);
  overflow: hidden;
  isolation: isolate;
  cursor: zoom-in;
}

.evento-locandina::before {
  content: '';
  position: absolute;
  inset: -2rem;
  z-index: -1;
  background: var(--locandina, none) center / cover no-repeat;
  filter: blur(24px) brightness(.75);
}

.evento-locandina img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.evento-locandina-zoom {
  position: absolute;
  right: .6rem;
  bottom: .6rem;
  display: grid;
  place-items: center;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.55);
  font-size: var(--text-xs);
  color: var(--white);
}

.evento-avviso {
  margin: 0 0 1.75rem;
  padding: .9rem 1.1rem;
  border-left: 3px solid var(--primary-blue);
  background: var(--bg-soft);
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--dark-navy);
}

.evento-avviso--forte {
  border-left-color: var(--dark-navy);
}

/* Dettagli: etichetta e valore su righe separate da filetti */
.evento-dettagli {
  margin: 0 0 2rem;
}

.evento-dettagli div {
  display: grid;
  grid-template-columns: 6.5rem minmax(0, 1fr);
  gap: 1rem;
  padding: .9rem 0;
  border-bottom: 1px solid rgba(26, 26, 26, 0.1);
}

.evento-dettagli div:first-child {
  padding-top: 0;
}

.evento-dettagli dt {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  line-height: 1.6;
  color: var(--text-light);
}

.evento-dettagli dd {
  margin: 0;
  font-size: var(--text-md);
  font-weight: 600;
  line-height: 1.5;
  color: var(--dark-navy);
}

.evento-mappa {
  margin-left: .75rem;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--primary-blue-dark);
}

.evento-descrizione {
  font-size: var(--text-md);
  line-height: 1.75;
  color: var(--text-dark);
}

.evento-descrizione :global(ul) {
  margin: .75rem 0;
  padding-left: 1.25rem;
}

.evento-descrizione :global(li) {
  margin: .3rem 0;
}

.evento-descrizione :global(b),
.evento-descrizione :global(strong) {
  font-weight: 600;
}

.evento-descrizione :global(i),
.evento-descrizione :global(em) {
  font-style: italic;
}

.evento-azioni {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 1.5rem 2rem;
  margin-top: 2.5rem;
}

.evento-azioni-label {
  display: block;
  margin-bottom: .6rem;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text-light);
}

.evento-azioni-btn {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
}

.evento-azione {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 0 1.25rem;
  border: 1px solid rgba(70, 130, 180, 0.35);
  border-radius: var(--radius-pill);
  background: var(--white);
  font-size: var(--text-btn);
  font-weight: 600;
  color: var(--dark-navy);
  text-decoration: none;
  transition: background-color .3s ease, border-color .3s ease;
}

.evento-condividi {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  min-height: 44px;
  padding: 0 .25rem;
  border: none;
  background: none;
  font: inherit;
  font-size: var(--text-btn);
  font-weight: 600;
  color: var(--primary-blue-dark);
  cursor: pointer;
}

.evento-condividi[hidden] {
  display: none;
}

.evento-tutti {
  margin-top: 3rem;
}

@media (hover: hover) and (pointer: fine) {
  .evento-azione:hover {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
  }

  .evento-condividi:hover {
    color: var(--dark-navy);
  }
}

/* ---------- Locandina a tutto schermo ---------- */
.locandina-dialog {
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 4.5rem 1.5rem 2rem;
  border: none;
  background: rgba(12, 12, 12, 0.96);
  cursor: zoom-out;
}

.locandina-dialog[open] {
  display: grid;
  place-items: center;
  animation: locandina-entra .25s ease;
}

.locandina-dialog::backdrop {
  background: transparent;
}

@keyframes locandina-entra {
  from {
    opacity: 0;
  }
}

:global(html:has(dialog[open])) {
  overflow: hidden;
}

.locandina-dialog img {
  max-width: 100%;
  max-height: calc(100dvh - 7rem);
  border-radius: var(--radius-sm);
}

.locandina-chiudi {
  position: absolute;
  top: 1rem;
  right: 1rem;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.15);
  font-size: var(--text-base);
  color: var(--white);
  cursor: pointer;
}

@media (prefers-reduced-motion: reduce) {
  .locandina-dialog[open] {
    animation: none;
  }
}

/* ---------- Tablet: locandina sopra il testo ---------- */
@media (max-width: 900px) {
  .evento-corpo,
  .evento-corpo.con-locandina {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  .evento-locandina {
    position: relative;
    top: auto;
    max-width: 28rem;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .evento-dettagli div {
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: .75rem;
  }

  .evento-azioni {
    flex-direction: column;
    align-items: flex-start;
  }

  .evento-azioni-btn {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .evento-azione {
    justify-content: center;
    padding: 0 .75rem;
  }

  .locandina-dialog {
    padding: 4.5rem 1rem 1.5rem;
  }
}
</style>
