---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { webp } from '../lib/images';
import { scuola } from '../data/scuola';

const bg: Record<string, string> = {
  'gallery-8.jpg': await webp('gallery-8.jpg', 1920),
  'gallery-5.jpg': await webp('gallery-5.jpg', 1920),
};

const pilastri = [
  { nome: 'Confusione', testo: 'Consultare uno specialista rappresenta un supporto durante momenti particolarmente difficili, quando le emozioni e i pensieri sembrano troppo complessi da gestire da soli.' },
  { nome: 'Pensieri', testo: 'Il trattamento psichico agisce sulla psiche umana principalmente attraverso la parola e il dialogo come strumenti terapeutici fondamentali per elaborare pensieri ed emozioni.' },
  { nome: 'Relazioni', testo: 'Lo sportello accoglie individui singoli, coppie e si dedica principalmente alla tutela del rapporto genitore-figlio, favorendo comunicazione e comprensione reciproca.' },
];

const servizi = [
  'Colloqui individuali per genitori',
  'Consulenze di coppia',
  'Supporto al rapporto genitore-figlio',
  'Riservatezza garantita',
];
---

<Base
    title="Sportello Psicologico - InBallet"
    description="Sportello Psicologico InBallet - Sostegno alle famiglie, ascolto e supporto psicologico per genitori, bambini e adolescenti a Lainate."
    ogTitle="Sportello Psicologico - InBallet"
    ogDescription="Sostegno psicologico e ascolto per famiglie. Uno spazio sicuro per affrontare difficoltà e momenti delicati."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-8.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Sportello Psicologico</h1>
                <p class="chisiamo-hero-tagline">Uno spazio sicuro di ascolto e sostegno per famiglie, genitori e bambini.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="sport-intro-section">
            <div class="container sport-intro-layout">
                <div class="sport-intro-content">
                    <span class="sport-intro-label eyebrow">Il nostro servizio</span>
                    <h2 class="sport-intro-title titolo-sezione">Sostegno alle famiglie <em>attraverso l'ascolto</em></h2>
                    <div class="sport-intro-testo">
                        <p>Il servizio si concentra sull'ascolto come abilità sociale fondamentale per instaurare fiducia e comprensione. Offriamo sostegno alle famiglie riconoscendo difficoltà e necessità che spesso rimangono inespresse da bambini e genitori.</p>
                        <p>In un ambiente accogliente e privo di giudizio, creiamo uno spazio dove la parola e il dialogo diventano strumenti fondamentali per affrontare i momenti più delicati.</p>
                    </div>
                    <div class="sport-intro-highlight">
                        <p>Un supporto concreto durante i momenti più difficili del percorso educativo e di crescita.</p>
                    </div>
                </div>
                <div class="sport-intro-visual foto-cornice">
                    <Img src="gallery-9.jpg" alt="Due allieve abbracciate in sala" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Pilastri: intestazione editoriale e tre voci -->
        <section class="sport-pilastri-section" aria-labelledby="pilastri-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">I tre pilastri</span>
                <h2 class="titolo-sezione" id="pilastri-titolo">Come possiamo <em>aiutarti</em></h2>
                <p>Tre aree di intervento per sostenere il benessere psicologico di individui, coppie e famiglie.</p>
            </div>
            <div class="container">
                <ul class="pilastri-lista">
                    {pilastri.map((p) => (
                        <li class="voce">
                            <h3 class="voce-titolo">{p.nome}</h3>
                            <p class="voce-testo">{p.testo}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Accesso: intestazione a sinistra, elenco dei servizi a destra -->
        <section class="sport-accesso-section" aria-labelledby="accesso-titolo">
            <div class="container sport-accesso-layout">
                <div class="sport-accesso-header">
                    <span class="eyebrow">Come accedere</span>
                    <h2 class="titolo-sezione" id="accesso-titolo">Incontri con la dottoressa <em>psicoterapeuta</em></h2>
                    <p class="intro-sezione">Lo sportello è attivo su appuntamento. Contatta la Direzione per fissare un primo colloquio conoscitivo.</p>
                </div>
                <ul class="servizi-lista">
                    {servizi.map((s) => (
                        <li class="servizio">
                            <i class="fas fa-check" aria-hidden="true"></i>
                            <span>{s}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA -->
        <section class="sport-cta-section sezione-scura">
            <div class="sport-cta-bg" style={`background-image: url('${bg['gallery-5.jpg']}')`}></div>
            <div class="sport-cta-overlay"></div>
            <div class="sport-cta-wrapper">
                <h2 class="titolo-sezione">Prenota un colloquio <em>conoscitivo</em></h2>
                <p class="intro-sezione">Il primo passo è sempre il più importante. Scrivici o chiamaci: fissiamo insieme il primo incontro, nella massima riservatezza.</p>
                <div class="sport-cta-buttons">
                    <a href={`mailto:${scuola.email}?subject=Richiesta%20Sportello%20Psicologico`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Scrivici
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
/* ---------- Intro ---------- */
.sport-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.sport-intro-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 5rem;
  align-items: center;
}

.sport-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.sport-intro-title {
  margin-bottom: 1.75rem;
}

.sport-intro-testo p {
  margin-bottom: 1.25rem;
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--text-dark);
}

.sport-intro-testo p:last-child {
  margin-bottom: 0;
}

/* La cornice sporge a sinistra e in basso: spazio dentro la colonna */
.sport-intro-visual {
  max-width: 520px;
  margin: 0 0 1.5rem 1.5rem;
  justify-self: end;
}

.sport-intro-visual :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

/* ---------- Pilastri ---------- */
.sport-pilastri-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.pilastri-lista {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 3rem;
  margin: 3.5rem 0 0;
  padding: 0;
}

.pilastri-lista .voce-testo {
  font-size: 1.0625rem;
}

/* ---------- Accesso ---------- */
.sport-accesso-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.sport-accesso-layout {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: start;
}

.sport-accesso-header .titolo-sezione {
  margin-bottom: 1.25rem;
}

.servizi-lista {
  list-style: none;
  margin: 0;
  padding: 0;
}

.servizio {
  display: grid;
  grid-template-columns: 2rem minmax(0, 1fr);
  align-items: baseline;
  gap: .75rem;
  padding: 1.5rem 0;
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.servizio:first-child {
  padding-top: .5rem;
}

.servizio:last-child {
  border-bottom: none;
}

.servizio i {
  font-size: 1rem;
  color: var(--primary-blue-dark);
}

.servizio span {
  font-size: var(--text-xl);
  font-weight: 700;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
}

/* ---------- CTA ---------- */
.sport-cta-section {
  position: relative;
  padding: var(--section-y) 0;
  overflow: hidden;
}

.sport-cta-bg,
.sport-cta-overlay {
  position: absolute;
  inset: 0;
}

.sport-cta-bg {
  background: center / cover no-repeat;
}

.sport-cta-overlay {
  background: linear-gradient(135deg, rgba(26, 26, 26, .9) 0%, rgba(42, 42, 42, .85) 100%);
}

.sport-cta-wrapper {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.sport-cta-wrapper .titolo-sezione {
  margin-bottom: 1.25rem;
}

.sport-cta-wrapper .intro-sezione {
  margin-bottom: 2.5rem;
}

.sport-cta-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

/* ---------- Tablet ---------- */
@media (max-width: 900px) {
  /* Intro: etichetta e titolo, foto, testo, citazione */
  .sport-intro-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .sport-intro-content {
    display: contents;
  }

  .sport-intro-label {
    order: 1;
  }

  .sport-intro-title {
    order: 2;
  }

  .sport-intro-visual {
    order: 3;
    max-width: none;
    margin: 0 0 2.75rem 1.5rem;
  }

  .sport-intro-visual :global(img) {
    aspect-ratio: 3 / 2;
  }

  .sport-intro-testo {
    order: 4;
  }

  .sport-intro-highlight {
    order: 5;
  }

  /* Pilastri: una colonna */
  .pilastri-lista {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  /* Accesso: intestazione sopra l'elenco */
  .sport-accesso-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .sport-intro-visual {
    margin: 0 0 2rem .75rem;
  }

  .sport-intro-visual :global(img) {
    aspect-ratio: 4 / 3;
  }

  .sport-intro-testo p,
  .pilastri-lista .voce-testo {
    font-size: 1rem;
  }

  .servizio {
    padding: 1.25rem 0;
  }

  .servizio span {
    font-size: 1.125rem;
  }

  .sport-cta-wrapper {
    padding: 0 1.5rem;
  }

  .sport-cta-buttons {
    flex-direction: column;
    align-items: stretch;
  }
}
</style>
