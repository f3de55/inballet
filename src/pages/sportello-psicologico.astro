---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { webp } from '../lib/images';

const bg: Record<string, string> = {
  'gallery-8.jpg': await webp('gallery-8.jpg', 1920),
  'bg-progetti-territorio.jpg': await webp('bg-progetti-territorio.jpg', 1920),
};
---

<Base
    title="Sportello Psicologico - InBallet"
    description="Sportello Psicologico InBallet - Sostegno alle famiglie, ascolto e supporto psicologico per genitori, bambini e adolescenti a Lainate."
    ogTitle="Sportello Psicologico - InBallet"
    ogDescription="Sostegno psicologico e ascolto per famiglie. Uno spazio sicuro per affrontare difficoltà e momenti delicati."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={`background-image: url('${bg['gallery-8.jpg']}')`}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Sportello Psicologico</h1>
                <p class="chisiamo-hero-tagline">Uno spazio sicuro di ascolto e sostegno per famiglie, genitori e bambini.</p>
            </div>
        </section>

        <!-- Intro Section -->
        <section id="intro" class="sport-intro-section">
            <div class="sport-intro-wrapper intro-editoriale">
                <span class="sport-intro-label eyebrow">Il Nostro Servizio</span>
                <h2 class="sport-intro-title titolo-sezione">Sostegno alle famiglie <em>attraverso l'ascolto</em></h2>
                <p class="sport-intro-text">
                    Il servizio si concentra sull'ascolto come abilità sociale fondamentale per instaurare fiducia e comprensione. Offriamo sostegno alle famiglie riconoscendo difficoltà e necessità che spesso rimangono inespresse da bambini e genitori.
                </p>
                <p class="sport-intro-text">
                    In un ambiente accogliente e privo di giudizio, creiamo uno spazio dove la parola e il dialogo diventano strumenti terapeutici fondamentali per affrontare momenti particolarmente delicati.
                </p>
                <div class="sport-intro-highlight">
                    <p>Il trattamento psichico agisce sulla psiche umana principalmente attraverso la parola e il dialogo, offrendo un supporto concreto durante i momenti più difficili del percorso educativo e di crescita.</p>
                </div>
            </div>
        </section>

        <!-- Pilastri Section - CARD -->
        <section class="sport-pilastri-section">
            <div class="sport-pilastri-wrapper">
                <div class="sport-pilastri-header">
                    <span class="sport-pilastri-label eyebrow">I Tre Pilastri</span>
                    <h2 class="sport-pilastri-title titolo-sezione">Come possiamo <em>aiutarti</em></h2>
                    <p class="sport-pilastri-subtitle intro-sezione">Tre aree di intervento per supportare il benessere psicologico di individui, coppie e famiglie.</p>
                </div>
                <div class="sport-pilastri-grid">
                    <div class="sport-pilastro-card voce">
                        <div class="sport-pilastro-icon voce-icona">
                            <i class="fas fa-question-circle"></i>
                        </div>
                        <h3 class="sport-pilastro-name voce-titolo">Confusione</h3>
                        <p class="sport-pilastro-desc voce-testo">Consultare uno specialista rappresenta un supporto durante momenti particolarmente difficili, quando le emozioni e i pensieri sembrano troppo complessi da gestire da soli.</p>
                    </div>
                    <div class="sport-pilastro-card voce">
                        <div class="sport-pilastro-icon voce-icona">
                            <i class="fas fa-brain"></i>
                        </div>
                        <h3 class="sport-pilastro-name voce-titolo">Pensieri</h3>
                        <p class="sport-pilastro-desc voce-testo">Il trattamento psichico agisce sulla psiche umana principalmente attraverso la parola e il dialogo come strumenti terapeutici fondamentali per elaborare pensieri ed emozioni.</p>
                    </div>
                    <div class="sport-pilastro-card voce">
                        <div class="sport-pilastro-icon voce-icona">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3 class="sport-pilastro-name voce-titolo">Relazioni</h3>
                        <p class="sport-pilastro-desc voce-testo">Lo sportello accoglie individui singoli, coppie e si dedica principalmente alla tutela del rapporto genitore-figlio, favorendo comunicazione e comprensione reciproca.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Accesso Section -->
        <section class="sport-accesso-section sezione-scura">
            <div class="sport-accesso-wrapper">
                <div class="sport-accesso-header">
                    <span class="sport-accesso-label eyebrow">Come Accedere</span>
                    <h2 class="sport-accesso-title titolo-sezione">Incontri con la dottoressa <em>psicoterapeuta</em></h2>
                    <p class="sport-accesso-subtitle intro-sezione">Il nostro sportello è attivo su appuntamento. Contatta la Direzione per fissare un primo colloquio conoscitivo.</p>
                </div>
                <div class="sport-accesso-list">
                    <div class="sport-accesso-item">
                        <i class="fas fa-check"></i>
                        <span>Colloqui individuali per genitori</span>
                    </div>
                    <div class="sport-accesso-item">
                        <i class="fas fa-check"></i>
                        <span>Consulenze di coppia</span>
                    </div>
                    <div class="sport-accesso-item">
                        <i class="fas fa-check"></i>
                        <span>Supporto rapporto genitore-figlio</span>
                    </div>
                    <div class="sport-accesso-item">
                        <i class="fas fa-check"></i>
                        <span>Riservatezza garantita</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section - Stile corso-contatto -->
        <section class="corso-contatto-section sezione-scura">
            <div class="corso-contatto-bg" style={`background: url('${bg['bg-progetti-territorio.jpg']}') center/cover no-repeat`}></div>
            <div class="corso-contatto-overlay"></div>
            <div class="corso-contatto-wrapper">
                <div class="corso-contatto-content">
                    <h2 class="titolo-sezione">Prenota un colloquio <em>conoscitivo</em></h2>
                    <p class="intro-sezione">Il primo passo è sempre il più importante. Siamo qui per ascoltarti.</p>
                    <a href="mailto:info@inballet.it?subject=Richiesta%20Sportello%20Psicologico" class="corso-btn-cta btn-primary">
                        Contattaci <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
.sport-intro-section {
  padding: var(--section-y) 0;
  background: #fff;
}

.sport-intro-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
}

.sport-intro-label {
  display: block;
  margin-bottom: 1rem;
  text-align: center;
}

.sport-intro-title {
  margin-bottom: 2rem;
  text-align: center;
}

.sport-intro-text {
  font-size: var(--text-lg);
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 1.5rem;
  text-align: center;
}

.sport-intro-text :global(strong) {
  color: var(--dark-navy);
  font-weight: 600;
}

.sport-intro-highlight {
  background: rgba(135,206,235,.1);
  border-left: 4px solid var(--primary-blue);
  padding: 1.5rem 2rem;
  border-radius: 0 12px 12px 0;
  margin-top: 2.5rem;
  max-width: 750px;
  margin-left: auto;
  margin-right: auto;
}

.sport-intro-highlight :global(p) {
  font-size: var(--text-base);
  color: var(--dark-navy);
  font-weight: 500;
  margin: 0;
  line-height: 1.7;
}

.sport-pilastri-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.sport-pilastri-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2rem;
}

.sport-pilastri-header {
  text-align: center;
  margin-bottom: 4rem;
}

.sport-pilastri-label {
  display: block;
  margin-bottom: 1rem;
}

.sport-pilastri-title {
  margin-bottom: 1rem;
}

.sport-pilastri-subtitle {
  max-width: 600px;
  margin: 0 auto;
}

.sport-pilastri-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 2.5rem;
}

.sport-accesso-section {
  padding: var(--section-y) 0;
  background: var(--dark-navy);
  position: relative;
  overflow: hidden;
}

.sport-accesso-section::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle,rgba(135,206,235,.06) 0,transparent 70%);
  border-radius: 50%;
}

.sport-accesso-wrapper {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 2;
}

.sport-accesso-header {
  text-align: center;
  margin-bottom: 3rem;
}

.sport-accesso-label {
  display: block;
  margin-bottom: 1rem;
}

.sport-accesso-title {
  margin-bottom: 1rem;
}

.sport-accesso-subtitle {
  max-width: 600px;
  margin: 0 auto;
}

.sport-accesso-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem 3rem;
  margin-top: 2.5rem;
}

.sport-accesso-item {
  display: flex;
  align-items: center;
  gap: .8rem;
}

.sport-accesso-item :global(i) {
  color: var(--primary-blue);
  font-size: 1.1rem;
}

.sport-accesso-item :global(span) {
  font-size: var(--text-base);
  color: #fff;
  font-weight: 500;
}

@media(max-width:992px) {
  .sport-pilastri-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

@media(max-width:600px) {
  .sport-accesso-list {
    grid-template-columns: 1fr;
  }
}
</style>
