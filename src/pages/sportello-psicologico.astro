---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { immaginiPagine } from '../data/immagini-pagine';
import { sfondoCta } from '../lib/images';
import { heroPagina } from '../lib/hero-pagine';
import '../styles/components/intro-split.css';
import SezioneElenco from '../components/SezioneElenco.astro';
import '../styles/pages/sportello-psicologico.css';

const bg = {
  hero: await heroPagina('sportello-psicologico'),
  cta: await sfondoCta('ascolto'),
};

const pilastri = [
  { nome: 'Confusione', icona: 'fa-lightbulb', testo: 'Quando emozioni e pensieri sono difficili da gestire da soli, un <strong>colloquio con uno specialista</strong> aiuta a fare chiarezza.' },
  { nome: 'Ascolto', icona: 'fa-ear-listen', testo: 'Uno spazio dedicato in cui <strong>dare voce alle difficoltà</strong> che, in famiglia, spesso restano inespresse.' },
  { nome: 'Relazioni', icona: 'fa-house-user', testo: 'Incontri per singoli e coppie, ma soprattutto per la <strong>tutela del rapporto genitore-figlio</strong>.' },
];

const servizi = [
  'Colloqui <strong>individuali</strong>',
  'Incontri <strong>per coppie</strong>',
  'Tutela del <strong>rapporto genitore-figlio</strong>',
  '<strong>Riservatezza</strong> garantita',
];
---

<Base
    title="Sportello psicologico per genitori e bambini | InBallet"
    description="Lo sportello psicologico di InBallet, scuola di danza a Lainate e Rho: uno spazio di ascolto per genitori, bambini e coppie, con una psicoterapeuta."
    ogTitle="Sportello Psicologico | InBallet"
    ogDescription="Ascolto e sostegno per le famiglie: incontri con la psicoterapeuta, su richiesta alla Direzione."
>

    <Fragment slot="head">
        {bg.hero.preload.map((image) => <link rel="preload" as="image" href={image.href} media={image.media} />)}
    </Fragment>

        <!-- Hero Section -->
        <section class="chisiamo-hero hero-banner">
            <div class="chisiamo-hero-image hero-banner-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Sportello Psicologico</h1>
                <p class="hero-lead">Ascolto e sostegno per famiglie, genitori e bambini, con una <strong>psicoterapeuta</strong>.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="intro-split">
            <div class="container intro-split-layout">
                <div class="intro-split-content">
                    <p class="intro-split-label eyebrow">Il nostro servizio</p>
                    <h2 class="intro-split-title titolo-sezione">Sostegno alle famiglie <em>attraverso l'ascolto</em></h2>
                    <div class="intro-split-testo">
                        <p>Lo Sportello Psicologico di InBallet è uno spazio di ascolto per le famiglie: <strong>su richiesta alla Direzione</strong>, si fissano incontri con una <strong>dottoressa psicoterapeuta</strong>.</p>
                        <p>Uno spazio per <strong>riconoscere fatiche e bisogni</strong> che bambini e genitori spesso non riescono a esprimere apertamente.</p>
                    </div>
                    <div class="intro-split-highlight">
                        <p>Un <strong>sostegno concreto</strong> nei momenti di difficoltà, nella <strong>massima riservatezza</strong>.</p>
                    </div>
                </div>
                <div class="intro-split-visual foto-cornice">
                    <Img {...immaginiPagine['sportello-psicologico']} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Pilastri: intestazione editoriale e tre voci -->
        <section class="sport-pilastri-section" aria-labelledby="pilastri-titolo">
            <div class="intro-editoriale">
                <p class="eyebrow">I tre pilastri</p>
                <h2 class="titolo-sezione" id="pilastri-titolo">Come possiamo <em>aiutarti</em></h2>
                <p>Quando <strong>rivolgersi a uno specialista</strong> può aiutare te e la tua famiglia.</p>
            </div>
            <div class="container">
                <ul class="pilastri-lista">
                    {pilastri.map((p) => (
                        <li class="voce">
                            <i class={`fas ${p.icona} voce-icona`} aria-hidden="true"></i>
                            <h3 class="voce-titolo">{p.nome}</h3>
                            <p class="voce-testo" set:html={p.testo} />
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Accesso: intestazione illustrata e servizi a filetti. -->
        <SezioneElenco titoloId="accesso-titolo" illustrazione="sportello-psicologico">
            <Fragment slot="introduzione">
                <p class="eyebrow">Come accedere</p>
                <h2 class="titolo-sezione" id="accesso-titolo">Incontri con la dottoressa <em>psicoterapeuta</em></h2>
                <p class="intro-sezione">Lo sportello è <strong>attivo su richiesta</strong>: <a href="/contatti#contatti">contatta la Direzione</a> per fissare un <strong>primo colloquio</strong>.</p>
            </Fragment>
            <ul class="righe">
                {servizi.map((s) => (
                    <li class="riga">
                        <p class="riga-nome" set:html={s} />
                    </li>
                ))}
            </ul>
        </SezioneElenco>

        <!-- CTA -->
        <section class="cta-contatto sezione-scura">
            <div class="cta-bg" style={bg.cta.style}></div>
            <div class="cta-overlay"></div>
            <div class="cta-wrapper">
                <h2 class="titolo-sezione">Prenota un colloquio <em>conoscitivo</em></h2>
                <p class="intro-sezione"><strong>Scrivici o chiamaci</strong>: fissiamo insieme il primo incontro, nella <strong>massima riservatezza</strong>.</p>
                <div class="cta-pulsanti">
                    <a href="/contatti" class="btn-primary">
                        Contattaci <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>
</Base>
