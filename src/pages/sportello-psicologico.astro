---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { sfondo, sfondoCta } from '../lib/images';
import { scuola } from '../data/scuola';

const bg = {
  hero: await sfondo({ desktop: 'foto/sportello-banner.jpg', tablet: 'foto/sportellopsicologico-adulti.jpg' }, { desktop: '50% 50%', tablet: '50% 50%', mobile: '58% 50%' }),
  cta: await sfondoCta('foto/sportello-psicologico-img2.jpg'),
};

const pilastri = [
  { nome: 'Confusione', icona: 'fa-lightbulb', testo: 'Quando emozioni e pensieri sono difficili da gestire da soli, un <strong>colloquio con uno specialista</strong> aiuta a fare chiarezza.' },
  { nome: 'Ascolto', icona: 'fa-ear-listen', testo: 'Uno spazio dedicato in cui <strong>dare voce alle difficoltà</strong> che, in famiglia, spesso restano inespresse.' },
  { nome: 'Relazioni', icona: 'fa-house-user', testo: 'Incontri per singoli e coppie, ma soprattutto per la <strong>tutela del rapporto genitore-figlio</strong>.' },
];

const servizi = [
  'Colloqui individuali',
  'Incontri per coppie',
  'Tutela del rapporto genitore-figlio',
  'Riservatezza garantita',
];
---

<Base
    title="Sportello psicologico per genitori e bambini | InBallet"
    description="Lo sportello psicologico di InBallet, scuola di danza a Lainate e Rho (MI): ascolto per genitori, bambini e coppie, con una psicoterapeuta su richiesta."
    ogTitle="Sportello Psicologico | InBallet"
    ogDescription="Ascolto e sostegno per le famiglie: incontri con la psicoterapeuta, su richiesta alla Direzione."
>

        <!-- Hero Section -->
        <section class="chisiamo-hero">
            <div class="chisiamo-hero-image" style={bg.hero.style}></div>
            <div class="chisiamo-hero-overlay"></div>
            <div class="chisiamo-hero-glass">
                <Breadcrumb />
                <h1 class="chisiamo-hero-title">Sportello Psicologico</h1>
                <p class="chisiamo-hero-tagline">Ascolto e sostegno per famiglie, genitori e bambini, con una <strong>psicoterapeuta</strong>.</p>
            </div>
        </section>

        <!-- Intro: testo a sinistra, foto a destra (sotto i 900px: titolo, foto, testo) -->
        <section id="intro" class="sport-intro-section">
            <div class="container sport-intro-layout">
                <div class="sport-intro-content">
                    <span class="sport-intro-label eyebrow">Il nostro servizio</span>
                    <h2 class="sport-intro-title titolo-sezione">Sostegno alle famiglie <em>attraverso l'ascolto</em></h2>
                    <div class="sport-intro-testo">
                        <p>Lo Sportello Psicologico di InBallet sostiene le famiglie della scuola: <strong>su richiesta alla Direzione</strong>, si fissano incontri con una <strong>dottoressa psicoterapeuta</strong>.</p>
                        <p>Uno spazio per <strong>riconoscere fatiche e bisogni</strong> che bambini e genitori spesso non riescono a esprimere apertamente.</p>
                    </div>
                    <div class="sport-intro-highlight">
                        <p>Un <strong>sostegno concreto</strong> nei momenti di difficoltà, nella <strong>massima riservatezza</strong>.</p>
                    </div>
                </div>
                <div class="sport-intro-visual foto-cornice">
                    <Img src="foto/sportello-psicologico-img4.jpg" alt="Due mani si sfiorano con la punta delle dita" fuoco={{ desktop: '50% 50%' }} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 560px" />
                </div>
            </div>
        </section>

        <!-- Pilastri: intestazione editoriale e tre voci -->
        <section class="sport-pilastri-section" aria-labelledby="pilastri-titolo">
            <div class="intro-editoriale">
                <span class="eyebrow">I tre pilastri</span>
                <h2 class="titolo-sezione" id="pilastri-titolo">Come possiamo <em>aiutarti</em></h2>
                <p>Perché <strong>rivolgersi a uno specialista</strong>, come lavora la parola e a chi si rivolge lo sportello.</p>
            </div>
            <div class="container">
                <ul class="pilastri-lista">
                    {pilastri.map((p) => (
                        <li class="voce">
                            <i class={`fas ${p.icona} voce-icona`} aria-hidden="true"></i>
                            <h3 class="voce-titolo">{p.nome}</h3>
                            <p class="voce-testo" set:html={p.testo} />
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- Accesso: intestazione a sinistra, elenco dei servizi a destra -->
        <section class="sport-accesso-section decoro-onde" aria-labelledby="accesso-titolo">
            <div class="container sport-accesso-layout">
                <div class="sport-accesso-header">
                    <span class="eyebrow">Come accedere</span>
                    <h2 class="titolo-sezione" id="accesso-titolo">Incontri con la dottoressa <em>psicoterapeuta</em></h2>
                    <p class="intro-sezione">Lo sportello è <strong>attivo su richiesta</strong>: contatta la Direzione per fissare un <strong>primo colloquio</strong>.</p>
                </div>
                <ul class="servizi-lista">
                    {servizi.map((s) => (
                        <li class="servizio">
                            <i class="fas fa-check" aria-hidden="true"></i>
                            <span>{s}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- CTA -->
        <section class="sport-cta-section sezione-scura">
            <div class="sport-cta-bg" style={bg.cta.style}></div>
            <div class="sport-cta-overlay"></div>
            <div class="sport-cta-wrapper">
                <h2 class="titolo-sezione">Prenota un colloquio <em>conoscitivo</em></h2>
                <p class="intro-sezione"><strong>Scrivici o chiamaci</strong>: fissiamo insieme il primo incontro, nella <strong>massima riservatezza</strong>.</p>
                <div class="sport-cta-buttons">
                    <a href={`mailto:${scuola.email}?subject=Richiesta%20Sportello%20Psicologico`} class="btn-primary">
                        <i class="fas fa-envelope" aria-hidden="true"></i> Scrivici
                    </a>
                    <a href={scuola.telefonoHref} class="btn-secondary">
                        <i class="fas fa-phone" aria-hidden="true"></i> Chiamaci
                    </a>
                </div>
            </div>
        </section>
</Base>

<style>
/* ---------- Intro ---------- */
.sport-intro-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.sport-intro-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 5rem;
  align-items: center;
}

.sport-intro-label {
  display: block;
  margin-bottom: 1rem;
}

.sport-intro-title {
  margin-bottom: 1.75rem;
}

.sport-intro-testo p {
  margin-bottom: 1.25rem;
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-dark);
}

.sport-intro-testo p:last-child {
  margin-bottom: 0;
}

/* La cornice sporge a sinistra e in basso: spazio dentro la colonna */
.sport-intro-visual {
  max-width: 520px;
  margin: 0 0 1.5rem 1.5rem;
  justify-self: end;
}

.sport-intro-visual :global(img) {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

/* ---------- Pilastri ---------- */
.sport-pilastri-section {
  padding: var(--section-y) 0;
  background: var(--bg-soft);
}

.pilastri-lista {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 3rem;
  margin: 3.5rem 0 0;
  padding: 0;
}

.pilastri-lista .voce-testo {
  font-size: var(--text-base);
}

/* ---------- Accesso ---------- */
.sport-accesso-section {
  padding: var(--section-y) 0;
  background: var(--white);
}

.sport-accesso-layout {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: 5rem;
  align-items: start;
}

.sport-accesso-header .titolo-sezione {
  margin-bottom: 1.25rem;
}

.servizi-lista {
  list-style: none;
  margin: 0;
  padding: 0;
}

.servizio {
  display: grid;
  grid-template-columns: 2rem minmax(0, 1fr);
  align-items: baseline;
  gap: .75rem;
  padding: 1.5rem 0;
  border-bottom: 1px solid rgba(26, 26, 26, 0.12);
}

.servizio:first-child {
  padding-top: .5rem;
}

.servizio:last-child {
  border-bottom: none;
}

.servizio i {
  font-size: var(--text-base);
  color: var(--primary-blue-dark);
}

.servizio span {
  font-size: var(--text-base);
  font-weight: 500;
  line-height: var(--leading-snug);
  color: var(--dark-navy);
}

/* ---------- CTA ---------- */
.sport-cta-section {
  position: relative;
  padding: var(--section-y) 0;
  overflow: hidden;
}

.sport-cta-bg,
.sport-cta-overlay {
  position: absolute;
  inset: 0;
}

.sport-cta-bg {
  background: center / cover no-repeat;
}

.sport-cta-overlay {
  background: linear-gradient(135deg, rgba(26, 26, 26, .66) 0%, rgba(42, 42, 42, .62) 100%);
}

.sport-cta-wrapper {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
  text-align: center;
}

.sport-cta-wrapper .titolo-sezione {
  margin-bottom: 1.25rem;
}

.sport-cta-wrapper .intro-sezione {
  margin-bottom: 2.5rem;
}

.sport-cta-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

/* ---------- Tablet ---------- */
@media (max-width: 900px) {
  /* Intro: etichetta e titolo, foto, testo, citazione */
  .sport-intro-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .sport-intro-content {
    display: contents;
  }

  .sport-intro-label {
    order: 1;
  }

  .sport-intro-title {
    order: 2;
  }

  .sport-intro-visual {
    order: 3;
    max-width: none;
    margin: 0 0 3.75rem 1.5rem;
  }

  .sport-intro-visual :global(img) {
    aspect-ratio: 3 / 2;
  }

  .sport-intro-testo {
    order: 4;
  }

  .sport-intro-highlight {
    order: 5;
  }

  /* Pilastri: una colonna */
  .pilastri-lista {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  /* Accesso: intestazione sopra l'elenco */
  .sport-accesso-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
}

/* ---------- Mobile ---------- */
@media (max-width: 600px) {
  .sport-intro-visual {
    margin: 0 0 3rem .75rem;
  }

  .sport-intro-visual :global(img) {
    aspect-ratio: 4 / 3;
  }

  .servizio {
    padding: 1.25rem 0;
  }


  .sport-cta-wrapper {
    padding: 0 1.5rem;
  }

  .sport-cta-buttons {
    flex-direction: column;
    align-items: center;
  }
}
</style>
